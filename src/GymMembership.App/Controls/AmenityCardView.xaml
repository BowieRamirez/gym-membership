<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:c="clr-namespace:GymMembership.App.Controls"
             xmlns:svc="clr-namespace:GymMembership.Core.Services;assembly=GymMembership.Core"
             x:Class="GymMembership.App.Controls.AmenityCardView" x:DataType="svc:AmenityCard">

    <Border Style="{StaticResource Panel}">
        <!-- a stack, not a grid: a hidden photo then takes no spacing -->
        <VerticalStackLayout Spacing="12">
            <!-- the photo only when there is one: an empty grey box with initials took a third of the card (Phase 9) -->
            <Border StrokeThickness="0" Padding="0" HeightRequest="{OnIdiom Phone=160, Default=120}" StrokeShape="RoundRectangle 10"
                    IsVisible="{Binding PhotoUrl, Converter={StaticResource IsNotNull}}"
                    BackgroundColor="{AppThemeBinding Light={StaticResource LineLight}, Dark={StaticResource LineDark}}">
                <Image Source="{Binding PhotoUrl}" Aspect="AspectFill" SemanticProperties.Description="{Binding Amenity.Name, StringFormat='Photo of {0}'}" />
            </Border>
            <VerticalStackLayout Spacing="4">
                <Label Text="{Binding Amenity.Name}" Style="{StaticResource Heading}" />
                <c:StatusChip Status="{Binding Availability}" />
                <Label Text="{Binding Reason}" FontFamily="BarlowMedium" IsVisible="{Binding HasReason}" />
                <Label Text="{Binding BackAt, Converter={StaticResource LocalDate}, ConverterParameter='ddd d MMM, h:mm tt', StringFormat='Back about {0}'}"
                       Style="{StaticResource Caption}" IsVisible="{Binding HasBackAt}" />
                <Label Text="{Binding Amenity.Description}" Style="{StaticResource Muted}" />
                <!-- members only: the session price, or where their pass stands -->
                <Label Text="{Binding PassText}" FontFamily="BarlowSemiBold" IsVisible="{Binding CanFollow}" />
                <!-- F14: who runs it; an amenity nobody runs works with any coach in the gym -->
                <Label Text="{Binding RunText}" Style="{StaticResource Caption}" IsVisible="{Binding RunText, Converter={StaticResource HasText}}" />
            </VerticalStackLayout>
            <!-- coaches: "I run this" -->
            <HorizontalStackLayout Spacing="10" IsVisible="{Binding IsCoach}">
                <Switch x:Name="Runs" IsToggled="{Binding RunsThis, Mode=OneWay}" Toggled="OnRunsToggled" VerticalOptions="Center"
                        SemanticProperties.Description="I run this" AutomationId="RunsThisSwitch" />
                <Label Text="I run this" FontFamily="BarlowMedium" VerticalOptions="Center" />
            </HorizontalStackLayout>
            <FlexLayout Wrap="Wrap">
                <!-- F12: Book opens the booking sheet (members, when the page offers it) -->
                <Button x:Name="Book" Text="Book" Style="{StaticResource SmallButton}" Margin="0,0,8,0" IsVisible="False" Clicked="OnBook" />
                <!-- Notify me / Following is a toggle: a chip beside Book -->
                <Button x:Name="Action" Style="{StaticResource FilterChip}" VerticalOptions="Center" IsVisible="False" />
            </FlexLayout>
        </VerticalStackLayout>
    </Border>
</ContentView>
