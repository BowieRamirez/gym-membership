<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:c="clr-namespace:GymMembership.App.Controls">

    <!-- ===== Type scale (ratio 1.25 from 16) ===== -->
    <x:Double x:Key="TextCaption">13</x:Double>
    <x:Double x:Key="TextBody">16</x:Double>
    <x:Double x:Key="TextTitle3">20</x:Double>
    <x:Double x:Key="TextTitle2">25</x:Double>
    <x:Double x:Key="TextTitle1">31</x:Double>
    <x:Double x:Key="TextDisplay">39</x:Double>
    <x:Double x:Key="TextNumeral">52</x:Double>

    <!-- ===== Page + shell ===== -->
    <Style TargetType="Page" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource PageLight}, Dark={StaticResource PageDark}}" />
    </Style>

    <Style TargetType="Shell" ApplyToDerivedTypes="True">
        <Setter Property="Shell.BackgroundColor" Value="{AppThemeBinding Light={StaticResource BackdropLight}, Dark={StaticResource BackdropDark}}" />
        <Setter Property="Shell.ForegroundColor" Value="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}" />
        <Setter Property="Shell.TitleColor" Value="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}" />
        <!-- the front desk's phone bar (layout unchanged, D22): white or near-black, the current tab in ink (light) or yellow (dark) -->
        <Setter Property="Shell.TabBarBackgroundColor" Value="{AppThemeBinding Light={StaticResource CardLight}, Dark={StaticResource RailDark}}" />
        <Setter Property="Shell.TabBarForegroundColor" Value="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource Signal}}" />
        <Setter Property="Shell.TabBarTitleColor" Value="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}" />
        <Setter Property="Shell.TabBarUnselectedColor" Value="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}" />
    </Style>

    <!-- ===== Text ===== -->
    <Style x:Key="BaseLabel" TargetType="Label">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}" />
        <Setter Property="FontFamily" Value="Barlow" />
        <Setter Property="FontSize" Value="{StaticResource TextBody}" />
        <Setter Property="LineHeight" Value="1.4" />
    </Style>
    <Style TargetType="Label" BasedOn="{StaticResource BaseLabel}" />
    <Style x:Key="Display" TargetType="Label" BasedOn="{StaticResource BaseLabel}">
        <Setter Property="FontFamily" Value="BarlowMedium" />
        <Setter Property="FontSize" Value="{StaticResource TextDisplay}" />
        <Setter Property="LineHeight" Value="1.05" />
        <Setter Property="CharacterSpacing" Value="-0.6" />
    </Style>
    <!-- Windows page titles: big and light, like the reference dashboard -->
    <Style x:Key="PageTitle" TargetType="Label" BasedOn="{StaticResource BaseLabel}">
        <Setter Property="FontFamily" Value="BarlowMedium" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="LineHeight" Value="1.05" />
        <Setter Property="CharacterSpacing" Value="-0.4" />
    </Style>
    <Style x:Key="Title" TargetType="Label" BasedOn="{StaticResource BaseLabel}">
        <Setter Property="FontFamily" Value="BarlowSemiBold" />
        <Setter Property="FontSize" Value="{StaticResource TextTitle2}" />
        <Setter Property="LineHeight" Value="1.15" />
    </Style>
    <Style x:Key="Heading" TargetType="Label" BasedOn="{StaticResource BaseLabel}">
        <Setter Property="FontFamily" Value="BarlowSemiBold" />
        <Setter Property="FontSize" Value="{StaticResource TextTitle3}" />
        <Setter Property="LineHeight" Value="1.2" />
    </Style>
    <Style x:Key="Muted" TargetType="Label" BasedOn="{StaticResource BaseLabel}">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}" />
    </Style>
    <Style x:Key="Caption" TargetType="Label" BasedOn="{StaticResource Muted}">
        <Setter Property="FontFamily" Value="BarlowMedium" />
        <Setter Property="FontSize" Value="{StaticResource TextCaption}" />
    </Style>
    <!-- Prices, days left, counts: condensed numerals read like gym-floor signage -->
    <Style x:Key="Numeral" TargetType="Label" BasedOn="{StaticResource BaseLabel}">
        <Setter Property="FontFamily" Value="BarlowCondensedSemiBold" />
        <Setter Property="FontSize" Value="{StaticResource TextNumeral}" />
        <Setter Property="LineHeight" Value="1" />
    </Style>

    <!-- Card prices: smaller on phones, where the price sits above a full-width button -->
    <Style x:Key="PriceNumeral" TargetType="Label" BasedOn="{StaticResource Numeral}">
        <Setter Property="FontSize" Value="{OnIdiom Phone=34, Default=52}" />
    </Style>

    <!-- ===== Inputs ===== -->
    <Style TargetType="Entry">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}" />
        <Setter Property="PlaceholderColor" Value="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}" />
        <Setter Property="FontFamily" Value="Barlow" />
        <Setter Property="FontSize" Value="{StaticResource TextBody}" />
        <Setter Property="MinimumHeightRequest" Value="48" />
    </Style>
    <Style TargetType="Editor">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}" />
        <Setter Property="FontFamily" Value="Barlow" />
        <Setter Property="FontSize" Value="{StaticResource TextBody}" />
    </Style>

    <!-- A field is an entry framed by a 3:1 edge so it reads as a box; the frame turns ink (light) or yellow (dark) while focused (Controls.FieldFocus) -->
    <Style x:Key="Field" TargetType="Border">
        <Setter Property="StrokeShape" Value="RoundRectangle 14" />
        <Setter Property="StrokeThickness" Value="1.5" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource EdgeLight}, Dark={StaticResource EdgeDark}}" />
    </Style>

    <!-- ===== Buttons: pills. The main action is black (light) or yellow (dark); outline is secondary ===== -->
    <Style x:Key="BaseButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource Signal}}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Black}}" />
        <Setter Property="FontFamily" Value="BarlowSemiBold" />
        <Setter Property="FontSize" Value="{StaticResource TextBody}" />
        <Setter Property="CornerRadius" Value="24" />
        <Setter Property="MinimumHeightRequest" Value="48" />
        <Setter Property="Padding" Value="20,0" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <!-- disabled: a grey block with muted words, not a faded yellow (it read as a muddy olive in dark, 9.6 polish) -->
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LineLight}, Dark={StaticResource SurfaceDark}}" />
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.85" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource BaseButton}" />
    <Style x:Key="OutlineButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}" />
        <Setter Property="BorderWidth" Value="1.5" />
        <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}" />
    </Style>

    <!-- ===== Page layout: wide canvas, section titles, white rows inside a card, at most one highlight card per page ===== -->
    <!-- pages fill the window (full-page layout, 2026-10-31); this only stops lines running on forever on very wide screens -->
    <x:Double x:Key="PageWidth">2400</x:Double>
    <Style x:Key="SectionTitle" TargetType="Label" BasedOn="{StaticResource BaseLabel}">
        <Setter Property="FontFamily" Value="BarlowMedium" />
        <Setter Property="FontSize" Value="{OnIdiom Phone=19, Default=22}" />
        <Setter Property="Margin" Value="0,10,0,0" />
    </Style>
    <Style x:Key="Row" TargetType="Border">
        <Setter Property="StrokeShape" Value="RoundRectangle 14" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="Padding" Value="14,11" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}" />
    </Style>
    <!-- the highlight card: black in light, yellow in dark (D23). Its labels use TextColor White (light) / Black (dark) and its buttons
         HeroButton/HeroSmallButton, which flip the other way (PageLayoutTests). -->
    <Style x:Key="HeroPanel" TargetType="Border">
        <Setter Property="StrokeShape" Value="RoundRectangle 16" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="Padding" Value="14" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource Signal}}" />
    </Style>


    <!-- ===== Surfaces: rounded cards, flat, no shadow; light mode adds a hairline so white cards keep their edge ===== -->
    <Style x:Key="Panel" TargetType="Border">
        <Setter Property="StrokeShape" Value="RoundRectangle 16" />
        <Setter Property="StrokeThickness" Value="{AppThemeBinding Light=1, Dark=0}" />
        <Setter Property="Padding" Value="14" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource CardLight}, Dark={StaticResource CardDark}}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource LineLight}, Dark={StaticResource LineDark}}" />
    </Style>


    <!-- ===== Full-page layout pieces: page frame, number strip, tables, side panel ===== -->
    <Thickness x:Key="PagePadding">16,12,16,20</Thickness>
    <!-- a row of filters or actions above the page's content -->
    <Style x:Key="Toolbar" TargetType="FlexLayout">
        <Setter Property="Wrap" Value="Wrap" />
        <Setter Property="AlignItems" Value="Center" />
    </Style>
    <!-- a number card in the strip at the top of a page: a small label, then the number -->
    <Style x:Key="Kpi" TargetType="Border">
        <Setter Property="StrokeShape" Value="RoundRectangle 14" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource CardLight}, Dark={StaticResource CardDark}}" />
    </Style>
    <Style x:Key="KpiValue" TargetType="Label" BasedOn="{StaticResource Numeral}">
        <Setter Property="FontSize" Value="34" />
    </Style>
    <!-- tables: a header of captions, then rows split by hairlines, all inside one Panel with no padding -->
    <Style x:Key="TablePanel" TargetType="Border" BasedOn="{StaticResource Panel}">
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style x:Key="TableHead" TargetType="Grid">
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="ColumnSpacing" Value="12" />
    </Style>
    <Style x:Key="TableRow" TargetType="Grid">
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="ColumnSpacing" Value="12" />
        <Setter Property="MinimumHeightRequest" Value="44" />
    </Style>
    <Style x:Key="Hairline" TargetType="BoxView">
        <Setter Property="HeightRequest" Value="1" />
        <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource LineLight}, Dark={StaticResource LineDark}}" />
    </Style>
    <!-- the page's form or selected item, on the right (SideLayout) -->
    <Style x:Key="SidePanel" TargetType="Border" BasedOn="{StaticResource Panel}">
        <Setter Property="VerticalOptions" Value="Start" />
    </Style>

    <!-- ===== Status chips: a coloured dot AND a word, so colour is never the only signal ===== -->
    <Style x:Key="Chip" TargetType="Border">
        <Setter Property="StrokeShape" Value="RoundRectangle 12" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="HorizontalOptions" Value="Start" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}" />
    </Style>
    <!-- pending is the signal yellow; on white it needs an ink ring to show (1.2:1 alone) -->
    <Style x:Key="DotPending" TargetType="Ellipse">
        <Setter Property="WidthRequest" Value="8" /><Setter Property="HeightRequest" Value="8" /><Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="Fill" Value="{StaticResource Signal}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource Signal}}" />
        <Setter Property="StrokeThickness" Value="1.5" />
    </Style>
    <Style x:Key="DotVerified" TargetType="Ellipse">
        <Setter Property="WidthRequest" Value="8" /><Setter Property="HeightRequest" Value="8" /><Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="Fill" Value="{AppThemeBinding Light={StaticResource GoodLight}, Dark={StaticResource GoodDark}}" />
    </Style>
    <Style x:Key="DotRejected" TargetType="Ellipse">
        <Setter Property="WidthRequest" Value="8" /><Setter Property="HeightRequest" Value="8" /><Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="Fill" Value="{AppThemeBinding Light={StaticResource BadLight}, Dark={StaticResource BadDark}}" />
    </Style>
    <Style x:Key="DotScheduled" TargetType="Ellipse">
        <Setter Property="WidthRequest" Value="8" /><Setter Property="HeightRequest" Value="8" /><Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="Fill" Value="{AppThemeBinding Light={StaticResource ScheduledLight}, Dark={StaticResource ScheduledDark}}" />
    </Style>

    <!-- Inline error: a red edge, plain words saying what happened and what to do -->
    <Style x:Key="ErrorPanel" TargetType="Border" BasedOn="{StaticResource Panel}">
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource BadLight}, Dark={StaticResource BadDark}}" />
        <Setter Property="StrokeThickness" Value="1.5" />
    </Style>


    <Style x:Key="NoticePanel" TargetType="Border" BasedOn="{StaticResource Panel}">
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource GoodLight}, Dark={StaticResource GoodDark}}" />
        <Setter Property="StrokeThickness" Value="1.5" />
    </Style>

    <!-- Compact buttons for actions inside list rows -->
    <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="MinimumHeightRequest" Value="{OnPlatform Android=48, iOS=48, Default=40}" />
        <Setter Property="CornerRadius" Value="{OnPlatform Android=24, iOS=24, Default=20}" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="FontSize" Value="14" />
    </Style>
    <Style x:Key="SmallOutlineButton" TargetType="Button" BasedOn="{StaticResource OutlineButton}">
        <Setter Property="MinimumHeightRequest" Value="{OnPlatform Android=48, iOS=48, Default=40}" />
        <Setter Property="CornerRadius" Value="{OnPlatform Android=24, iOS=24, Default=20}" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <!-- The buttons on a highlight card: yellow on the black card (light), black on the yellow card (dark) -->
    <Style x:Key="HeroButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Signal}, Dark={StaticResource Black}}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />
    </Style>
    <Style x:Key="HeroSmallButton" TargetType="Button" BasedOn="{StaticResource SmallButton}">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Signal}, Dark={StaticResource Black}}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />
    </Style>
    <!-- Yellow in both themes: the one main action of a sign-in or registration page (black text, so it works in light too) -->
    <Style x:Key="SignalButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="BackgroundColor" Value="{StaticResource Signal}" />
        <Setter Property="TextColor" Value="{StaticResource Black}" />
    </Style>
    <!-- Yellow: a selected choice (a filled surface, so it works in light too) -->
    <Style x:Key="SignalSmallButton" TargetType="Button" BasedOn="{StaticResource SmallButton}">
        <Setter Property="BackgroundColor" Value="{StaticResource Signal}" />
        <Setter Property="TextColor" Value="{StaticResource Black}" />
    </Style>

    <!-- Chips (Material 3 filter / assist chips): status filters and small actions inside list rows. Rounded rectangles, not pills, so a
         filter never reads as a main action; 48 tall on phones (Android's touch minimum; they were 40 until the 9.6 polish) and 34 on
         Windows. FilterChipOn is the filter in use.
         Never shrunk in a wrapping FlexLayout: it wraps to the next line instead of cutting the word ("Declin"). -->
    <Style x:Key="FilterChip" TargetType="Button" BasedOn="{StaticResource OutlineButton}">
        <Setter Property="FlexLayout.Shrink" Value="0" />
        <Setter Property="MinimumHeightRequest" Value="{OnPlatform Android=48, iOS=48, Default=34}" />
        <Setter Property="HeightRequest" Value="{OnPlatform Android=48, iOS=48, Default=34}" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource EdgeLight}, Dark={StaticResource EdgeDark}}" />
        <Setter Property="FontFamily" Value="BarlowMedium" />
        <Setter Property="FontSize" Value="14" />
    </Style>
    <Style x:Key="FilterChipOn" TargetType="Button" BasedOn="{StaticResource FilterChip}">
        <Setter Property="BackgroundColor" Value="{StaticResource Signal}" />
        <Setter Property="TextColor" Value="{StaticResource Black}" />
        <Setter Property="BorderColor" Value="{StaticResource Signal}" />
    </Style>

    <!-- A two-way view switch (the coach Dashboard's Month | Week, as approved): a quiet track, the chosen side a darker or lighter
         block in bold. Not yellow: choosing a view is not the page's main action. -->
    <Style x:Key="SegmentTrack" TargetType="Border">
        <Setter Property="StrokeShape" Value="RoundRectangle 12" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="Padding" Value="3" />
        <Setter Property="HorizontalOptions" Value="Start" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LineLight}, Dark={StaticResource PageDark}}" />
    </Style>
    <!-- the track's own colour, not Transparent: Android drew a Transparent segment as a black block with no label -->
    <Style x:Key="Segment" TargetType="Button" BasedOn="{StaticResource FilterChip}">
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LineLight}, Dark={StaticResource PageDark}}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}" />
    </Style>
    <!-- the chosen side (bold, InkLight / SurfaceDark) is set by the page's DataTriggers, not by a second style -->

    <!-- Card action cells: beside the text on wide screens, under it (full width) on phones. Parent Grid needs RowDefinitions="Auto,Auto". -->
    <Style x:Key="CardActions" TargetType="VerticalStackLayout">
        <Setter Property="Margin" Value="{OnIdiom Phone='0,10,0,0', Default=0}" />
        <Setter Property="Grid.Row" Value="{OnIdiom Phone=1, Default=0}" />
        <Setter Property="Grid.Column" Value="{OnIdiom Phone=0, Default=1}" />
        <Setter Property="Grid.ColumnSpan" Value="{OnIdiom Phone=2, Default=1}" />
        <Setter Property="HorizontalOptions" Value="{OnIdiom Phone=Fill, Default=End}" />
    </Style>
    <Style x:Key="CardButton" TargetType="Button" BasedOn="{StaticResource SmallButton}">
        <Setter Property="Margin" Value="{OnIdiom Phone='0,10,0,0', Default=0}" />
        <Setter Property="Grid.Row" Value="{OnIdiom Phone=1, Default=0}" />
        <Setter Property="Grid.Column" Value="{OnIdiom Phone=0, Default=1}" />
        <Setter Property="Grid.ColumnSpan" Value="{OnIdiom Phone=2, Default=1}" />
    </Style>
    <Style x:Key="CardOutlineButton" TargetType="Button" BasedOn="{StaticResource SmallOutlineButton}">
        <Setter Property="Margin" Value="{OnIdiom Phone='0,10,0,0', Default=0}" />
        <Setter Property="Grid.Row" Value="{OnIdiom Phone=1, Default=0}" />
        <Setter Property="Grid.Column" Value="{OnIdiom Phone=0, Default=1}" />
        <Setter Property="Grid.ColumnSpan" Value="{OnIdiom Phone=2, Default=1}" />
    </Style>

    <!-- A text link: secondary actions beside a form (forgot password, create an account, resend code) -->
    <Style x:Key="LinkButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <!-- ink, not blue: in this palette blue means "scheduled" -->
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource Signal}}" />
        <Setter Property="FontFamily" Value="BarlowSemiBold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="4,0" />
        <Setter Property="MinimumHeightRequest" Value="{OnPlatform Android=44, iOS=44, Default=32}" />
    </Style>
    <!-- What is wrong with one field, under it -->
    <Style x:Key="FieldError" TargetType="Label" BasedOn="{StaticResource Caption}">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource BadLight}, Dark={StaticResource BadDark}}" />
        <Setter Property="IsVisible" Value="False" />
    </Style>

    <!-- ===== Sign in, reset and create account share one layout: the brand panel with the badge beside the form, or a band above it
         when the window is narrow and on phones (Controls.AuthLayout) ===== -->
    <ControlTemplate x:Key="AuthShell">
        <c:AuthLayout />
    </ControlTemplate>

    <Style TargetType="Picker">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}" />
        <Setter Property="TitleColor" Value="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}" />
        <Setter Property="FontFamily" Value="Barlow" />
        <Setter Property="MinimumHeightRequest" Value="44" />
    </Style>
    <Style TargetType="DatePicker">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}" />
        <Setter Property="FontFamily" Value="Barlow" />
        <!-- the app's own date words ("Mon 9 Nov 2026"), not the system's 11/9/2026, which reads as 11 September here -->
        <Setter Property="Format" Value="ddd d MMM yyyy" />
    </Style>
    <Style TargetType="TimePicker">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}" />
        <Setter Property="FontFamily" Value="Barlow" />
    </Style>
    <Style TargetType="SearchBar">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}" />
        <Setter Property="FontFamily" Value="Barlow" />
    </Style>
</ResourceDictionary>
