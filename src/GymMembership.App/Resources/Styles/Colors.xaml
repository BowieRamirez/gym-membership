<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Surfaces: sage canvas, lime highlight. Chalk = page, Card = panels, Surface = fields and rows inside cards. -->
    <Color x:Key="ChalkLight">#F2F4F0</Color>
    <Color x:Key="SurfaceLight">#FFFFFF</Color>
    <Color x:Key="CardLight">#E7EBE4</Color>
    <Color x:Key="InkLight">#000000</Color>
    <Color x:Key="MutedLight">#5A6159</Color>
    <Color x:Key="LineLight">#D4DAD0</Color>

    <Color x:Key="ChalkDark">#161816</Color>
    <Color x:Key="SurfaceDark">#2C302B</Color>
    <Color x:Key="CardDark">#212521</Color>
    <Color x:Key="InkDark">#EEF1EC</Color>
    <Color x:Key="MutedDark">#A3AAA1</Color>
    <Color x:Key="LineDark">#3A3F39</Color>

    <!-- Behind the side menu and title bar -->
    <Color x:Key="BackdropLight">#DDE3DA</Color>
    <Color x:Key="BackdropDark">#0E100E</Color>
    <!-- Windows side menu -->
    <Color x:Key="RailLight">#FFFFFF</Color>
    <Color x:Key="RailDark">#212521</Color>

    <!-- Highlight: the current item, selected choices, the dark-mode primary button. Not a status. -->
    <Color x:Key="Lime">#E4F58A</Color>

    <!-- Icons are black in both themes and always sit on a light chip -->
    <Color x:Key="IconInk">#000000</Color>
    <Color x:Key="IconChipLight">#FFFFFF</Color>
    <Color x:Key="IconChipDark">#E7EBE4</Color>

    <!-- Plate colours: colour only ever means status. Never decoration. -->
    <Color x:Key="PlateBlueLight">#2F62D9</Color>    <!-- scheduled, focus -->
    <Color x:Key="PlateBlueDark">#7AA2FF</Color>
    <Color x:Key="PlateYellowLight">#A47600</Color>  <!-- pending; was #B58200 (2.96:1 on ChalkLight), now 3.52:1 -->
    <Color x:Key="PlateYellowDark">#F2C230</Color>
    <Color x:Key="PlateGreenLight">#1B7F45</Color>   <!-- verified, active -->
    <Color x:Key="PlateGreenDark">#4CC585</Color>
    <Color x:Key="PlateRedLight">#C8372D</Color>     <!-- rejected, expired, errors -->
    <Color x:Key="PlateRedDark">#FF7B70</Color>

    <!-- Theme-aware brushes/colours used by styles and pages -->
    <Color x:Key="Chalk"       >#F2F4F0</Color>
    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#000000</Color>
</ResourceDictionary>
