<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Phase 9 (D23): yellow and black, after the owner's reference dashboard; mockup docs/mockups/yellow-black.html.
         Page = window background, Card = panels, Surface = fields and rows inside panels. ContrastTests checks every pair. -->
    <Color x:Key="PageLight">#EEEEEE</Color>
    <Color x:Key="SurfaceLight">#F5F5F5</Color>
    <Color x:Key="CardLight">#FFFFFF</Color>
    <Color x:Key="InkLight">#111111</Color>
    <Color x:Key="MutedLight">#5B5B5B</Color>
    <Color x:Key="LineLight">#E4E4E4</Color>
    <Color x:Key="EdgeLight">#808080</Color>      <!-- a field's border: 3:1, so the box shows as a control -->

    <Color x:Key="PageDark">#0E0E0E</Color>
    <Color x:Key="SurfaceDark">#242424</Color>
    <Color x:Key="CardDark">#1A1A1A</Color>
    <Color x:Key="InkDark">#F2F2F2</Color>
    <Color x:Key="MutedDark">#A6A6A6</Color>
    <Color x:Key="LineDark">#2A2A2A</Color>
    <Color x:Key="EdgeDark">#757575</Color>

    <!-- Behind the side menu and title bar: the page colour, so the page has no frame round it -->
    <Color x:Key="BackdropLight">#EEEEEE</Color>
    <Color x:Key="BackdropDark">#0E0E0E</Color>
    <!-- Windows side menu: yellow with black icons (light), near-black with light icons (dark) -->
    <Color x:Key="RailLight">#FFEC00</Color>
    <Color x:Key="RailDark">#161616</Color>

    <!-- The signal colour: the selected item, the highlight (dark), attention, the main action. Text on it is always black.
         On white it is 1.2:1, so in light mode it is only ever a filled surface, never text, a thin line or a focus ring. -->
    <Color x:Key="Signal">#FFEC00</Color>

    <!-- Icons: black on a light chip (light), light on a dark chip (dark) -->
    <Color x:Key="IconInk">#111111</Color>
    <Color x:Key="IconChipLight">#EEEEEE</Color>
    <Color x:Key="IconChipDark">#2A2A2A</Color>

    <!-- Status colours: only ever beside their word, never decoration (item 15, D23) -->
    <Color x:Key="ScheduledLight">#5B5B5B</Color>   <!-- scheduled, booked: neutral -->
    <Color x:Key="ScheduledDark">#A6A6A6</Color>
    <Color x:Key="PendingLight">#7A5C00</Color>     <!-- pending, late, cooldown as words; the pending dot is yellow with an ink ring -->
    <Color x:Key="PendingDark">#FFEC00</Color>
    <Color x:Key="GoodLight">#1B7A3E</Color>        <!-- verified, active, present -->
    <Color x:Key="GoodDark">#4CC585</Color>
    <Color x:Key="BadLight">#C42B21</Color>         <!-- rejected, expired, errors -->
    <Color x:Key="BadDark">#FF7B70</Color>

    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#111111</Color>
</ResourceDictionary>
