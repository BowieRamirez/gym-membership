<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Surfaces: cool concrete (light) / rubber flooring (dark) -->
    <Color x:Key="ChalkLight">#EDEFF1</Color>
    <Color x:Key="SurfaceLight">#FFFFFF</Color>
    <Color x:Key="InkLight">#1F2226</Color>
    <Color x:Key="MutedLight">#5C646C</Color>
    <Color x:Key="LineLight">#CDD3D9</Color>

    <Color x:Key="ChalkDark">#1A1D20</Color>
    <Color x:Key="SurfaceDark">#24282C</Color>
    <Color x:Key="InkDark">#ECEEF0</Color>
    <Color x:Key="MutedDark">#9AA3AB</Color>
    <Color x:Key="LineDark">#3A4047</Color>

    <!-- Plate colours: colour only ever means status. Never decoration. -->
    <Color x:Key="PlateBlueLight">#2F62D9</Color>    <!-- scheduled, focus -->
    <Color x:Key="PlateBlueDark">#7AA2FF</Color>
    <Color x:Key="PlateYellowLight">#B58200</Color>  <!-- pending -->
    <Color x:Key="PlateYellowDark">#F2C230</Color>
    <Color x:Key="PlateGreenLight">#1B7F45</Color>   <!-- verified, active -->
    <Color x:Key="PlateGreenDark">#4CC585</Color>
    <Color x:Key="PlateRedLight">#C8372D</Color>     <!-- rejected, expired, errors -->
    <Color x:Key="PlateRedDark">#FF7B70</Color>

    <!-- Theme-aware brushes/colours used by styles and pages -->
    <Color x:Key="Chalk"       >#EDEFF1</Color>
    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#000000</Color>
</ResourceDictionary>
