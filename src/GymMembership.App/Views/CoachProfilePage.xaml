<?xml version="1.0" encoding="utf-8" ?>
<v:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
            xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
            xmlns:v="clr-namespace:GymMembership.App.Views"
            xmlns:c="clr-namespace:GymMembership.App.Controls"
            xmlns:vm="clr-namespace:GymMembership.Core.ViewModels;assembly=GymMembership.Core"
            x:Class="GymMembership.App.Views.CoachProfilePage" x:DataType="vm:CoachProfileViewModel" Title="Settings">

    <ScrollView MaximumWidthRequest="{StaticResource PageWidth}">
        <VerticalStackLayout Padding="{OnIdiom Phone='16,12,16,24', Default='16,12,16,20'}" Spacing="16">
            <c:Banner Message="{Binding ErrorMessage}" />
            <c:Banner Kind="notice" Message="{Binding Notice}" />
            <!-- F17 and the owner's sketch (2026-11-11): Account first (SettingsPage's content, hosted below); this coach section is moved
                 into its main column under name and email, so Theme and password stay in the right column beside it (code-behind).
                 The picture is changed in one place only, Account's "Change picture". -->
            <Label Text="Account" Style="{StaticResource SectionTitle}" />
            <ContentView x:Name="Account" />
            <VerticalStackLayout x:Name="CoachSection" Spacing="12" Margin="0,8,0,0">
            <Label Text="Your coach profile" Style="{StaticResource SectionTitle}" />
            <!-- the profile form, and beside it (above it on phones and narrow windows) check-in -->
            <c:SideLayout x:Name="CoachColumn" SideWidth="420" Spacing="16">
            <Border Style="{StaticResource Panel}">
            <VerticalStackLayout Spacing="16">

            <VerticalStackLayout Spacing="6">
                <Label Text="Specialty" Style="{StaticResource Caption}" />
                <Border Style="{StaticResource Field}"><Entry Text="{Binding Specialty}" /></Border>
            </VerticalStackLayout>
            <VerticalStackLayout Spacing="6">
                <Label Text="Hourly rate (₱ per hour)" Style="{StaticResource Caption}" />
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                    <Label Text="₱" FontFamily="BarlowSemiBold" FontSize="18" VerticalOptions="Center" />
                    <Border Grid.Column="1" Style="{StaticResource Field}">
                        <Entry Text="{Binding RateInput}" Keyboard="Numeric" Placeholder="For example 350.00" SemanticProperties.Description="Hourly rate in pesos" />
                    </Border>
                </Grid>
            </VerticalStackLayout>
            <VerticalStackLayout Spacing="6">
                <Label Text="About you" Style="{StaticResource Caption}" />
                <Border Style="{StaticResource Field}" Padding="14,6"><Editor Text="{Binding Bio}" HeightRequest="120" AutoSize="Disabled" /></Border>
            </VerticalStackLayout>

            <HorizontalStackLayout Spacing="12">
                <Switch IsToggled="{Binding IsAvailable}" SemanticProperties.Description="Taking new members" VerticalOptions="Center" />
                <Label VerticalOptions="Center">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="Taking new members: " />
                            <Span Text="{Binding HiringText}" FontFamily="BarlowSemiBold" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
            </HorizontalStackLayout>
            <Label Text="Separate from checking in: Off keeps you listed while you are in the gym, but members can't hire you." Style="{StaticResource Caption}" />

            <Button Text="Save profile" Command="{Binding SaveCommand}" HorizontalOptions="Start" />
            </VerticalStackLayout>
            </Border>
            <VerticalStackLayout Spacing="16">
            <Border Style="{StaticResource Panel}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                    <VerticalStackLayout Spacing="8" VerticalOptions="Center">
                        <c:CardTitle Text="At the gym" />
                        <Label Text="{Binding VisitText}" Style="{StaticResource Caption}" />
                    </VerticalStackLayout>
                    <Button Grid.Column="1" Text="{Binding VisitButton}" Command="{Binding ToggleVisitCommand}" Style="{StaticResource SmallOutlineButton}" VerticalOptions="Center" />
                </Grid>
            </Border>
            </VerticalStackLayout>
            </c:SideLayout>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</v:BasePage>
