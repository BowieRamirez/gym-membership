<?xml version="1.0" encoding="utf-8" ?>
<v:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
            xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
            xmlns:v="clr-namespace:GymMembership.App.Views"
            xmlns:c="clr-namespace:GymMembership.App.Controls"
            xmlns:vm="clr-namespace:GymMembership.Core.ViewModels;assembly=GymMembership.Core"
            xmlns:svc="clr-namespace:GymMembership.Core.Services;assembly=GymMembership.Core"
            x:Class="GymMembership.App.Views.DiscountsPage" x:DataType="vm:DiscountsViewModel" Title="Discounts">

    <!-- Phase 2 of the 2026-11-12 plan (approved mockup docs/mockups/discount-codes.html): a code says what it's for (G3) and can't be
         edited (G2); each row has one Actions button like Users and roles (G1); narrow windows stack the same facts -->
    <v:BasePage.Resources>
        <DataTemplate x:Key="CodeRow" x:DataType="svc:DiscountRow">
            <VerticalStackLayout>
                <Grid Style="{StaticResource TableRow}" ColumnDefinitions="1.1*,60,1.6*,110,*,110,100" ColumnSpacing="12">
                    <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                        <Label Text="{Binding Discount.Code}" FontFamily="BarlowSemiBold" />
                        <Label Text="Hidden from members" Style="{StaticResource Caption}">
                            <Label.Triggers><DataTrigger TargetType="Label" Binding="{Binding Discount.ShowOnPackages}" Value="True"><Setter Property="Text" Value="Shown to members" /></DataTrigger></Label.Triggers>
                        </Label>
                    </VerticalStackLayout>
                    <Label Grid.Column="1" Text="{Binding Discount.Percent, StringFormat='{0}%'}" VerticalOptions="Center" />
                    <Label Grid.Column="2" Text="{Binding FitsText}" VerticalOptions="Center" />
                    <Label Grid.Column="3" Text="{Binding LastDay, Converter={StaticResource LocalDate}, ConverterParameter='d MMM yyyy'}" VerticalOptions="Center" />
                    <Label Grid.Column="4" Text="{Binding Usage}" Style="{StaticResource Muted}" VerticalOptions="Center" />
                    <c:StatusChip Grid.Column="5" Status="{Binding StatusText}" VerticalOptions="Center" />
                    <Button Grid.Column="6" Text="Actions" Style="{StaticResource SmallOutlineButton}" HorizontalOptions="End" VerticalOptions="Center"
                            Clicked="OnCodeActions" AutomationId="DiscountActions"
                            SemanticProperties.Description="{Binding Discount.Code, StringFormat='Actions for code {0}'}" SemanticProperties.Hint="Turn off or on, archive or delete" />
                </Grid>
                <BoxView Style="{StaticResource Hairline}" />
            </VerticalStackLayout>
        </DataTemplate>
        <DataTemplate x:Key="CodeCard" x:DataType="svc:DiscountRow">
            <VerticalStackLayout>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Padding="14,12">
                    <VerticalStackLayout Spacing="3">
                        <HorizontalStackLayout Spacing="10">
                            <Label Text="{Binding Discount.Code}" FontFamily="BarlowSemiBold" VerticalOptions="Center" />
                            <c:StatusChip Status="{Binding StatusText}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <Label Style="{StaticResource Caption}">
                            <Label.Text>
                                <MultiBinding StringFormat="{}{0}% off, last day {1}">
                                    <Binding Path="Discount.Percent" />
                                    <Binding Path="LastDay" Converter="{StaticResource LocalDate}" ConverterParameter="d MMM yyyy" />
                                </MultiBinding>
                            </Label.Text>
                        </Label>
                        <Label Text="{Binding ForText}" Style="{StaticResource Caption}" />
                        <Label Text="{Binding Usage}" Style="{StaticResource Caption}" />
                        <Label Text="Hidden from members" Style="{StaticResource Caption}">
                            <Label.Triggers><DataTrigger TargetType="Label" Binding="{Binding Discount.ShowOnPackages}" Value="True"><Setter Property="Text" Value="Shown to members" /></DataTrigger></Label.Triggers>
                        </Label>
                    </VerticalStackLayout>
                    <Button Grid.Column="1" Text="Actions" Style="{StaticResource SmallOutlineButton}" VerticalOptions="Center"
                            Clicked="OnCodeActions" AutomationId="DiscountActions"
                            SemanticProperties.Description="{Binding Discount.Code, StringFormat='Actions for code {0}'}" SemanticProperties.Hint="Turn off or on, archive or delete" />
                </Grid>
                <BoxView Style="{StaticResource Hairline}" />
            </VerticalStackLayout>
        </DataTemplate>

        <!-- one package or amenity to tick; greyed while "All" is ticked above it -->
        <DataTemplate x:Key="ItemTick" x:DataType="vm:ItemChoice">
            <HorizontalStackLayout Spacing="6">
                <CheckBox WidthRequest="{OnPlatform WinUI=32, Default=-1}" MinimumWidthRequest="0" IsChecked="{Binding IsChosen}" Color="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource Signal}}" VerticalOptions="Center"
                          SemanticProperties.Description="{Binding Name}" />
                <Label Text="{Binding Name}" VerticalOptions="Center" />
            </HorizontalStackLayout>
        </DataTemplate>
    </v:BasePage.Resources>

    <ScrollView MaximumWidthRequest="{StaticResource PageWidth}">
        <VerticalStackLayout Padding="{OnIdiom Phone='20,16,20,24', Default='16,12,16,20'}" Spacing="14">
            <Label Text="Percent-off codes for packages and amenities. A code can't be changed after it's added: turn it off and add a new one." Style="{StaticResource Muted}" />
            <c:Banner Message="{Binding ErrorMessage}" />
            <c:Banner Kind="notice" Message="{Binding Notice}" />

            <Border Style="{StaticResource Panel}">
                <VerticalStackLayout Spacing="12">
                    <c:CardTitle Text="Add a code" />
                    <FlexLayout Wrap="Wrap" AlignItems="End">
                        <VerticalStackLayout Spacing="4" Margin="0,0,12,8" WidthRequest="200">
                            <Label Text="Code" Style="{StaticResource Caption}" />
                            <Border Style="{StaticResource Field}"><Entry Text="{Binding NewCode}" Placeholder="SUMMER15" MaxLength="30" AutomationId="NewCode" /></Border>
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="4" Margin="0,0,12,8" WidthRequest="110">
                            <Label Text="Percent off" Style="{StaticResource Caption}" />
                            <Border Style="{StaticResource Field}"><Entry Text="{Binding NewPercent}" Keyboard="Numeric" /></Border>
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="4" Margin="0,0,12,8" WidthRequest="110">
                            <Label Text="Max uses" Style="{StaticResource Caption}" />
                            <Border Style="{StaticResource Field}"><Entry Text="{Binding NewLimit}" Keyboard="Numeric" SemanticProperties.Description="How many times the code can be used" /></Border>
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="4" Margin="0,0,12,8">
                            <Label Text="Last day" Style="{StaticResource Caption}" />
                            <Border Style="{StaticResource Field}"><DatePicker Date="{Binding ValidUntil}" MinimumDate="{x:Static x:DateTime.Today}" SemanticProperties.Description="Last day the code works" /></Border>
                        </VerticalStackLayout>
                    </FlexLayout>

                    <!-- G3: what the code is for; "All" also covers ones added later -->
                    <Label Text="Use it for" Style="{StaticResource Caption}" />
                    <c:CardGrid Columns="2" MinColumnWidth="260" Spacing="14">
                        <Border Style="{StaticResource Panel}" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}" Padding="12,8">
                            <VerticalStackLayout>
                                <HorizontalStackLayout Spacing="6">
                                    <CheckBox WidthRequest="{OnPlatform WinUI=32, Default=-1}" MinimumWidthRequest="0" IsChecked="{Binding AllPackages}" Color="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource Signal}}" VerticalOptions="Center"
                                              AutomationId="AllPackages" SemanticProperties.Description="All packages" />
                                    <Label Text="All packages" FontFamily="BarlowSemiBold" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                                <BoxView Style="{StaticResource Hairline}" Margin="0,2,0,4" />
                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding PackageChoices}" BindableLayout.ItemTemplate="{StaticResource ItemTick}"
                                                     IsEnabled="{Binding AllPackages, Converter={StaticResource Not}}">
                                    <BindableLayout.EmptyView><Label Text="No packages on sale." Style="{StaticResource Muted}" /></BindableLayout.EmptyView>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                        <Border Style="{StaticResource Panel}" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}" Padding="12,8">
                            <VerticalStackLayout>
                                <HorizontalStackLayout Spacing="6">
                                    <CheckBox WidthRequest="{OnPlatform WinUI=32, Default=-1}" MinimumWidthRequest="0" IsChecked="{Binding AllAmenities}" Color="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource Signal}}" VerticalOptions="Center"
                                              AutomationId="AllAmenities" SemanticProperties.Description="All amenities" />
                                    <Label Text="All amenities" FontFamily="BarlowSemiBold" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                                <BoxView Style="{StaticResource Hairline}" Margin="0,2,0,4" />
                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding AmenityChoices}" BindableLayout.ItemTemplate="{StaticResource ItemTick}"
                                                     IsEnabled="{Binding AllAmenities, Converter={StaticResource Not}}">
                                    <BindableLayout.EmptyView><Label Text="No amenities on sale." Style="{StaticResource Muted}" /></BindableLayout.EmptyView>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                    </c:CardGrid>

                    <FlexLayout Wrap="Wrap" AlignItems="Center" JustifyContent="SpaceBetween">
                        <HorizontalStackLayout Spacing="8" Margin="0,0,12,8">
                            <Switch IsToggled="{Binding NewShowToMembers}" AutomationId="NewCodeShowToMembers" SemanticProperties.Description="Show to members, so they can see and use it" VerticalOptions="Center" />
                            <Label Text="Show to members" VerticalOptions="Center" />
                            <Label Text="Off keeps it private, for a code you give one person." Style="{StaticResource Caption}" VerticalOptions="Center" Margin="6,0,0,0" />
                        </HorizontalStackLayout>
                        <Button Text="Add code" Style="{StaticResource SmallButton}" Margin="0,0,0,8" Command="{Binding AddCommand}" AutomationId="AddCode" />
                    </FlexLayout>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource TablePanel}">
                <VerticalStackLayout>
                    <VerticalStackLayout x:Name="CodeHead">
                        <Grid Style="{StaticResource TableHead}" ColumnDefinitions="1.1*,60,1.6*,110,*,110,100" ColumnSpacing="12">
                            <Label Text="Code" Style="{StaticResource Caption}" />
                            <Label Grid.Column="1" Text="Off" Style="{StaticResource Caption}" />
                            <Label Grid.Column="2" Text="For" Style="{StaticResource Caption}" />
                            <Label Grid.Column="3" Text="Last day" Style="{StaticResource Caption}" />
                            <Label Grid.Column="4" Text="Uses" Style="{StaticResource Caption}" />
                            <Label Grid.Column="5" Text="Status" Style="{StaticResource Caption}" />
                        </Grid>
                        <BoxView Style="{StaticResource Hairline}" />
                    </VerticalStackLayout>
                    <c:TableBody BindableLayout.ItemsSource="{Binding Discounts}" Header="{x:Reference CodeHead}" WideFrom="1000"
                                 RowTemplate="{StaticResource CodeRow}" CardTemplate="{StaticResource CodeCard}"
                                 BindableLayout.ItemTemplate="{OnIdiom Phone={StaticResource CodeCard}, Default={StaticResource CodeRow}}">
                        <BindableLayout.EmptyView><Label Text="No discount codes yet. Add one above." Style="{StaticResource Muted}" Margin="14" /></BindableLayout.EmptyView>
                    </c:TableBody>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</v:BasePage>
