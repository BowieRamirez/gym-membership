<?xml version="1.0" encoding="utf-8" ?>
<v:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
            xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
            xmlns:v="clr-namespace:GymMembership.App.Views"
            xmlns:c="clr-namespace:GymMembership.App.Controls"
            xmlns:vm="clr-namespace:GymMembership.Core.ViewModels;assembly=GymMembership.Core"
            xmlns:svc="clr-namespace:GymMembership.Core.Services;assembly=GymMembership.Core"
            x:Class="GymMembership.App.Views.BookAmenityPage" x:DataType="vm:BookAmenityViewModel" Title="Book an amenity">

    <v:BasePage.Resources>
        <!-- cell sizes; on Windows the page resizes these to fill the window (see FitGrid) -->
        <x:Double x:Key="SlotWidth">46</x:Double>
        <x:Double x:Key="SlotHeight">26</x:Double>
        <x:Double x:Key="AmenityWidth">94</x:Double>
        <x:Double x:Key="SlotFont">11</x:Double>
        <!-- One half-hour cell (D30, approved mockup). Open: a white box (dark: raised) with a field's 3:1 edge, so free time shows
             as something to tap. Booked: a solid grey block, so taken never looks free. Yours, cooldown and closed: their plate colour on
             the outline and text, no fill. Your picks: solid ink. Always enabled so the disabled look never hides the status; tapping a
             cell that can't be picked does nothing. -->
        <Style x:Key="SlotButton" TargetType="Button" x:DataType="vm:SlotCell">
            <Setter Property="WidthRequest" Value="{DynamicResource SlotWidth}" />
            <Setter Property="HeightRequest" Value="{DynamicResource SlotHeight}" />
            <Setter Property="MinimumHeightRequest" Value="26" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="{DynamicResource SlotFont}" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="BorderWidth" Value="1.5" />
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource CardLight}, Dark={StaticResource SurfaceDark}}" />
            <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource EdgeLight}, Dark={StaticResource EdgeDark}}" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}" />
            <Style.Triggers>
                <DataTrigger TargetType="Button" Binding="{Binding State}" Value="yours">
                    <Setter Property="BackgroundColor" Value="Transparent" />
                    <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource GoodLight}, Dark={StaticResource GoodDark}}" />
                    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource GoodLight}, Dark={StaticResource GoodDark}}" />
                </DataTrigger>
                <DataTrigger TargetType="Button" Binding="{Binding State}" Value="booked">
                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource TakenLight}, Dark={StaticResource LineDark}}" />
                    <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource TakenLight}, Dark={StaticResource LineDark}}" />
                    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}" />
                </DataTrigger>
                <DataTrigger TargetType="Button" Binding="{Binding State}" Value="cooldown">
                    <Setter Property="BackgroundColor" Value="Transparent" />
                    <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource PendingLight}, Dark={StaticResource PendingDark}}" />
                    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource PendingLight}, Dark={StaticResource PendingDark}}" />
                </DataTrigger>
                <DataTrigger TargetType="Button" Binding="{Binding State}" Value="closed">
                    <Setter Property="BackgroundColor" Value="Transparent" />
                    <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource BadLight}, Dark={StaticResource BadDark}}" />
                    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource BadLight}, Dark={StaticResource BadDark}}" />
                </DataTrigger>
                <DataTrigger TargetType="Button" Binding="{Binding State}" Value="outside">
                    <Setter Property="BackgroundColor" Value="Transparent" />
                    <Setter Property="BorderColor" Value="Transparent" />
                </DataTrigger>
                <!-- over: no box at all (D31), so on an evening visit only real choices have edges -->
                <DataTrigger TargetType="Button" Binding="{Binding State}" Value="past">
                    <Setter Property="BackgroundColor" Value="Transparent" />
                    <Setter Property="BorderColor" Value="Transparent" />
                </DataTrigger>
                <!-- can't be picked and has no plate colour: faded, so it never passes for a free cell -->

                <DataTrigger TargetType="Button" Binding="{Binding State}" Value="blocked">
                    <Setter Property="Opacity" Value="0.3" />
                </DataTrigger>
                <DataTrigger TargetType="Button" Binding="{Binding Selected}" Value="True">
                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}" />
                    <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}" />
                    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </v:BasePage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="{OnIdiom Phone='16,12,16,24', Default='16,12,16,20'}" Spacing="10">
            <!-- the booking rules: shown on Windows, behind a link on phones; the colour key stays visible everywhere -->
            <Button Text="How booking works" Style="{StaticResource LinkButton}" HorizontalOptions="Start" Margin="-4,-8,0,-8" Clicked="OnToggleRules"
                    IsVisible="{OnIdiom Phone=True, Default=False}" />
            <Label x:Name="Rules" Text="Pick open half-hours, then book them together. Touching slots make one session of up to 2 hours, with 30 minutes of cooldown after it."
                   Style="{StaticResource Caption}" IsVisible="{OnIdiom Phone=False, Default=True}" />
            <Label Style="{StaticResource Caption}">
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="Yours" TextColor="{AppThemeBinding Light={StaticResource GoodLight}, Dark={StaticResource GoodDark}}" FontFamily="BarlowMedium" />
                        <Span Text=", " />
                        <Span Text="booked" TextColor="{AppThemeBinding Light={StaticResource ScheduledLight}, Dark={StaticResource ScheduledDark}}" FontFamily="BarlowMedium" />
                        <Span Text=", " />
                        <Span Text="cooldown" TextColor="{AppThemeBinding Light={StaticResource PendingLight}, Dark={StaticResource PendingDark}}" FontFamily="BarlowMedium" />
                        <Span Text=", " />
                        <Span Text="closed" TextColor="{AppThemeBinding Light={StaticResource BadLight}, Dark={StaticResource BadDark}}" FontFamily="BarlowMedium" />
                        <Span Text="." />
                    </FormattedString>
                </Label.FormattedText>
            </Label>
            <c:Banner Message="{Binding ErrorMessage}" />
            <c:Banner Kind="notice" Message="{Binding Notice}" />

            <!-- phones: the day on its own line, then the two day chips, then the one yellow action at full width -->
            <VerticalStackLayout Spacing="10" IsVisible="{OnIdiom Phone=True, Default=False}">
                <Label Text="{Binding DayText}" Style="{StaticResource Heading}" />
                <HorizontalStackLayout Spacing="8">
                    <Button Text="Previous day" Style="{StaticResource FilterChip}" Command="{Binding PreviousDayCommand}" />
                    <Button Text="Next day" Style="{StaticResource FilterChip}" Command="{Binding NextDayCommand}" />
                </HorizontalStackLayout>
                <Button Text="{Binding BookText}" Style="{StaticResource SignalButton}" Command="{Binding BookCommand}" />
            </VerticalStackLayout>
            <FlexLayout Wrap="Wrap" AlignItems="Center" IsVisible="{OnIdiom Phone=False, Default=True}">
                <Button Text="Previous day" Style="{StaticResource FilterChip}" Margin="0,0,8,6" Command="{Binding PreviousDayCommand}" />
                <Label Text="{Binding DayText}" Style="{StaticResource Heading}" Margin="0,0,8,6" VerticalOptions="Center" />
                <Button Text="Next day" Style="{StaticResource FilterChip}" Margin="0,0,16,6" Command="{Binding NextDayCommand}" />
                <Button Text="{Binding BookText}" Style="{StaticResource SmallButton}" Margin="0,0,0,6" Command="{Binding BookCommand}" />
            </FlexLayout>

            <!-- wide screens: grid on the left, your bookings beside it; phones: one column -->
            <Grid ColumnDefinitions="{OnIdiom Phone='*', Default='*,300'}" RowDefinitions="{OnIdiom Phone='Auto,Auto', Default='Auto'}" ColumnSpacing="20" RowSpacing="16">
                <!-- a row per hour; each amenity has its :00 and :30 cell side by side. Scrolls sideways when amenities don't fit. -->
                <ScrollView x:Name="GridArea" Orientation="Horizontal" HorizontalOptions="Fill" SizeChanged="OnGridAreaSized">
                    <VerticalStackLayout Spacing="3">
                        <HorizontalStackLayout Spacing="10">
                            <Label WidthRequest="40" />
                            <HorizontalStackLayout BindableLayout.ItemsSource="{Binding Amenities}" Spacing="10">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Label Text="{Binding .}" WidthRequest="{DynamicResource AmenityWidth}" FontFamily="BarlowMedium" FontSize="13" LineBreakMode="TailTruncation" HorizontalTextAlignment="Center" />
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </HorizontalStackLayout>
                        </HorizontalStackLayout>
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Rows}" Spacing="3">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:SlotRow">
                                    <HorizontalStackLayout Spacing="10">
                                        <Label Text="{Binding Time}" WidthRequest="40" FontSize="12" VerticalOptions="Center"
                                               TextColor="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}" />
                                        <HorizontalStackLayout BindableLayout.ItemsSource="{Binding Amenities}" Spacing="10">
                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate x:DataType="vm:AmenityHour">
                                                    <HorizontalStackLayout Spacing="2">
                                                        <ContentView BindingContext="{Binding Early}">
                                                            <Button x:DataType="vm:SlotCell" Style="{StaticResource SlotButton}" Text="{Binding Short}"
                                                                    SemanticProperties.Description="{Binding Label}" Clicked="OnCell" />
                                                        </ContentView>
                                                        <ContentView BindingContext="{Binding Late}">
                                                            <Button x:DataType="vm:SlotCell" Style="{StaticResource SlotButton}" Text="{Binding Short}"
                                                                    SemanticProperties.Description="{Binding Label}" Clicked="OnCell" />
                                                        </ContentView>
                                                    </HorizontalStackLayout>
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </HorizontalStackLayout>
                                    </HorizontalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </ScrollView>

                <VerticalStackLayout Grid.Column="{OnIdiom Phone=0, Default=1}" Grid.Row="{OnIdiom Phone=1, Default=0}" Spacing="8">
                    <c:CardTitle Text="Your bookings" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Bookings}" Spacing="8">
                        <BindableLayout.EmptyView><Label Text="No upcoming bookings. Pick open slots to book one." Style="{StaticResource Muted}" /></BindableLayout.EmptyView>
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="svc:BookingRow">
                                <Border Style="{StaticResource Row}" Padding="12,10">
                                    <VerticalStackLayout Spacing="6">
                                        <Label Text="{Binding Amenity}" FontFamily="BarlowMedium" />
                                        <Label Text="{Binding When}" Style="{StaticResource Caption}" />
                                        <HorizontalStackLayout Spacing="8">
                                            <Button Text="Cancel" Style="{StaticResource SmallOutlineButton}" IsVisible="{Binding CanCancel}" Clicked="OnCancel" />
                                            <Button Text="End now" Style="{StaticResource SmallOutlineButton}" IsVisible="{Binding CanEnd}" Clicked="OnEnd"
                                                    SemanticProperties.Hint="Ends the session early. The amenity cools down for 30 minutes from now." />
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</v:BasePage>
