<?xml version="1.0" encoding="utf-8" ?>
<v:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
            xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
            xmlns:v="clr-namespace:GymMembership.App.Views"
            xmlns:c="clr-namespace:GymMembership.App.Controls"
            xmlns:vm="clr-namespace:GymMembership.Core.ViewModels;assembly=GymMembership.Core"
            xmlns:m="clr-namespace:GymMembership.Core.Models;assembly=GymMembership.Core"            xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
            x:Class="GymMembership.App.Views.PackagesPage" x:DataType="vm:PackagesViewModel" Title="Packages">

    <v:BasePage.Resources>
        <toolkit:IntToBoolConverter x:Key="Any" />
        <!-- the same pay options as the booking sheet (BookAmenityPage) -->
        <Style x:Key="PayOption" TargetType="Border" BasedOn="{StaticResource Row}">
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="StrokeShape" Value="RoundRectangle 12" />
        </Style>
        <!-- phone: name and length on the left, the price on the right, one line about it, then the button at its own width -->
        <DataTemplate x:Key="PackagePhone" x:DataType="m:MembershipPackage">
            <Border Style="{StaticResource Panel}" Padding="16,14">
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                            <Label Text="{Binding Name}" FontFamily="BarlowSemiBold" FontSize="18" />
                            <Label Text="{Binding LengthText}" Style="{StaticResource Caption}" />
                        </VerticalStackLayout>
                        <Label Grid.Column="1" Text="{Binding Price, StringFormat='₱{0:N0}'}" Style="{StaticResource Numeral}" FontSize="30" VerticalOptions="Center" />
                    </Grid>
                    <Label Text="{Binding Description}" Style="{StaticResource Muted}" FontSize="15" IsVisible="{Binding Description, Converter={StaticResource HasText}}" />
                    <VerticalStackLayout Spacing="2" BindableLayout.ItemsSource="{Binding Benefits}" IsVisible="{Binding Benefits.Count, Converter={StaticResource Any}}">
                        <BindableLayout.ItemTemplate><DataTemplate x:DataType="x:String"><Label Text="{Binding ., StringFormat='• {0}'}" FontSize="14" /></DataTemplate></BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    <Button Text="Choose next term" Style="{StaticResource SmallOutlineButton}" HorizontalOptions="Start" Clicked="OnAvail" />
                </VerticalStackLayout>
            </Border>
        </DataTemplate>
        <!-- Windows: name, then the price on its own line, what it is, and an outline button (three yellow buttons side by side shouted in dark) -->
        <DataTemplate x:Key="PackageWide" x:DataType="m:MembershipPackage">
            <Border Style="{StaticResource Panel}" Padding="18,16">
                <VerticalStackLayout Spacing="6">
                    <Label Text="{Binding Name}" FontFamily="BarlowSemiBold" FontSize="18" />
                    <Label Text="{Binding Price, StringFormat='₱{0:N0}'}" Style="{StaticResource Numeral}" FontSize="44" />
                    <Label Text="{Binding LengthText}" Style="{StaticResource Caption}" />
                    <Label Text="{Binding Description}" Style="{StaticResource Muted}" IsVisible="{Binding Description, Converter={StaticResource HasText}}" />
                    <VerticalStackLayout Spacing="2" BindableLayout.ItemsSource="{Binding Benefits}" IsVisible="{Binding Benefits.Count, Converter={StaticResource Any}}">
                        <BindableLayout.ItemTemplate><DataTemplate x:DataType="x:String"><Label Text="{Binding ., StringFormat='• {0}'}" FontSize="14" /></DataTemplate></BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    <Button Text="Choose next term" Style="{StaticResource SmallOutlineButton}" HorizontalOptions="Start" Margin="0,8,0,0" Clicked="OnAvail" />
                </VerticalStackLayout>
            </Border>
        </DataTemplate>
    </v:BasePage.Resources>

    <Grid>
    <Grid RowDefinitions="Auto,*" Padding="{OnIdiom Phone='16,12,16,0', Default='16,12,16,0'}" MaximumWidthRequest="{StaticResource PageWidth}">
        <VerticalStackLayout Spacing="10" Padding="0,0,0,10">
            <!-- the rules: shown on Windows, folded behind a link on phones so the packages come first -->
            <Button Text="How buying a package works" Style="{StaticResource LinkButton}" HorizontalOptions="Start" Margin="-4,-8,0,-8" Clicked="OnToggleRules"
                    IsVisible="{OnIdiom Phone=True, Default=False}" />
            <!-- G23 (2026-11-15): the refund rule is said before anyone pays; the last sentence is RefundRules.Line (RefundLineTests checks it) -->
            <Label x:Name="Rules" Text="Choose your next package. Pay online on this page by GCash or QR Ph (scan it with Maya or any bank app), or in cash at the front desk. Once paid, it starts right away, or when your current term ends. No upgrades or automatic charges.&#10;Refunds: only in a term's first 7 days, for the days not used."
                   Style="{OnIdiom Phone={StaticResource Caption}, Default={StaticResource Muted}}" MaximumWidthRequest="760" HorizontalOptions="Start" IsVisible="{OnIdiom Phone=False, Default=True}" />
            <c:Banner Message="{Binding ErrorMessage}" />
            <c:Banner Kind="notice" Message="{Binding Notice}" />
        </VerticalStackLayout>

        <!-- the pay card is the side panel: on the right on wide windows, above the packages on phones and narrow windows; hidden, the packages take the width -->
        <ScrollView Grid.Row="1"><c:SideLayout StackedSideWidth="600"><VerticalStackLayout Spacing="10">
            <c:CardGrid Columns="{OnIdiom Phone=1, Default=3}" MinColumnWidth="260" Padding="0,0,0,16" BindableLayout.ItemsSource="{Binding Packages}"
                     BindableLayout.ItemTemplate="{OnIdiom Phone={StaticResource PackagePhone}, Default={StaticResource PackageWide}}">
            <BindableLayout.EmptyView>
                <Label Text="No packages are on sale right now. Check back soon." Style="{StaticResource Muted}" />
            </BindableLayout.EmptyView>

        </c:CardGrid></VerticalStackLayout>
                <!-- Pay online (Xendit plan; moved here from My membership, owner 2026-11-16): one action. The amount is the title; the deadline sits
                     right under what is bought; the methods are named under the button so nobody wonders whether GCash works. Coming back re-checks it (Checking). -->
                <!-- SideLayout takes one side child: both cards sit in it; only one shows (one pending package payment at a time) -->
                <VerticalStackLayout IsVisible="{Binding HasPayCard}" VerticalOptions="Start">
                <Border Style="{StaticResource SidePanel}" IsVisible="{Binding PayNow, Converter={StaticResource IsNotNull}}" VerticalOptions="Start">
                    <VerticalStackLayout Spacing="12">
                        <VerticalStackLayout Spacing="4">
                            <c:CardTitle Text="{Binding PayNow.Amount, StringFormat='Pay ₱{0:N2} online'}" />
                            <Label Text="{Binding PayNow.What}" />
                            <Label Text="{Binding PayNow.ExpiresAt, Converter={StaticResource LocalDate}, ConverterParameter='ddd d MMM, h:mm tt', StringFormat='Pay by {0}, or this payment expires.'}"
                                   Style="{StaticResource Caption}" IsVisible="{Binding PayNow.ExpiresAt, Converter={StaticResource IsNotNull}}" />
                        </VerticalStackLayout>
                        <HorizontalStackLayout Spacing="8" IsVisible="{Binding Checking}">
                            <ActivityIndicator IsRunning="{Binding Checking}" WidthRequest="18" HeightRequest="18" Color="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource Signal}}" />
                            <Label Text="Checking your payment with Xendit" Style="{StaticResource Caption}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <VerticalStackLayout Spacing="6">
                            <Button Text="Pay online" Style="{StaticResource SmallButton}" Command="{Binding PayOnlineCommand}" AutomationId="PayOnline"
                                    IsEnabled="{Binding Checking, Converter={StaticResource Not}}" />
                            <Label Text="GCash or QR Ph, on Xendit's checkout page. Come back here when you're done." Style="{StaticResource Caption}" />
                        </VerticalStackLayout>
                        <Label Text="{Binding PayNow.PaymentCode, StringFormat='Payment code {0}'}" Style="{StaticResource Caption}" SemanticProperties.Description="Payment code, for the front desk if you need help" />
                        <Button Text="Cancel this payment" Style="{StaticResource SmallOutlineButton}" Clicked="OnCancelPayment" />
                    </VerticalStackLayout>
                </Border>
                <!-- cash plan 2026-11-17: chosen cash; the code is what the desk looks for, the deadline is the same as online -->
                <Border Style="{StaticResource SidePanel}" IsVisible="{Binding PayAtDesk, Converter={StaticResource IsNotNull}}" VerticalOptions="Start">
                    <VerticalStackLayout Spacing="12">
                        <VerticalStackLayout Spacing="4">
                            <c:CardTitle Text="{Binding PayAtDesk.Amount, StringFormat='Pay ₱{0:N2} at the front desk'}" />
                            <Label Text="{Binding PayAtDesk.What}" />
                            <Label Text="{Binding PayAtDesk.ExpiresAt, Converter={StaticResource LocalDate}, ConverterParameter='ddd d MMM, h:mm tt', StringFormat='Pay by {0}, or this payment expires.'}"
                                   Style="{StaticResource Caption}" IsVisible="{Binding PayAtDesk.ExpiresAt, Converter={StaticResource IsNotNull}}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="2">
                            <Label Text="{Binding PayAtDesk.PaymentCode}" Style="{StaticResource Numeral}" FontSize="26" SemanticProperties.Description="Payment code to show at the front desk" />
                            <Label Text="Show this code and pay in cash. Your membership starts once the desk verifies it." Style="{StaticResource Caption}" />
                        </VerticalStackLayout>
                        <Button Text="Cancel this payment" Style="{StaticResource SmallOutlineButton}" Clicked="OnCancelPayment" />
                    </VerticalStackLayout>
                </Border>
                </VerticalStackLayout>
        </c:SideLayout></ScrollView>
    </Grid>

    <!-- plan 2026-11-17 Z7 (owner's sketch): the Buy popup. Step 1 the code and the package, step 2 online or cash, then Pay.
         Same frame as the booking sheet (BookAmenityPage): the page dims behind it; a centred card on Windows, a bottom sheet on a phone -->
    <Grid IsVisible="{Binding IsBuying}">
        <BoxView Color="#9E000000">
            <BoxView.GestureRecognizers><TapGestureRecognizer Command="{Binding CloseBuyCommand}" /></BoxView.GestureRecognizers>
        </BoxView>
        <Border Style="{StaticResource Panel}" Padding="0" StrokeShape="{OnIdiom Phone='RoundRectangle 18,18,0,0', Default='RoundRectangle 18'}" Margin="{OnIdiom Phone=0, Default=24}"
                WidthRequest="{OnIdiom Phone=-1, Default=520}" VerticalOptions="{OnIdiom Phone=End, Default=Center}" HorizontalOptions="{OnIdiom Phone=Fill, Default=Center}">
            <ScrollView>
                <VerticalStackLayout Padding="20,16,20,20" Spacing="14">
                    <!-- head: the package; X closes -->
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                            <Label Text="{Binding Buying.Name, StringFormat='Buy {0}'}" Style="{StaticResource Heading}" />
                            <Label Text="{Binding Buying.LengthText}" Style="{StaticResource Caption}" />
                        </VerticalStackLayout>
                        <Grid Grid.Column="1" WidthRequest="44" HeightRequest="44" VerticalOptions="Start">
                            <Button Style="{StaticResource SmallOutlineButton}" Padding="0" Command="{Binding CloseBuyCommand}" SemanticProperties.Description="Close" AutomationId="CloseBuy" />
                            <c:IconView Icon="x" Size="18" ChipSize="32" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Grid>
                    </Grid>
                    <c:Banner Message="{Binding ErrorMessage}" />

                    <!-- step 1: the code first (the sketch), the member's codes for this package as chips, then what they get -->
                    <VerticalStackLayout Spacing="14" IsVisible="{Binding OnCodeStep}">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Discount code (optional)" Style="{StaticResource Caption}" />
                            <Border Style="{StaticResource Field}" HorizontalOptions="{OnIdiom Phone=Fill, Default=Start}" WidthRequest="{OnIdiom Phone=-1, Default=240}">
                                <Entry Text="{Binding DiscountCode}" Placeholder="Enter a code from the gym" SemanticProperties.Description="Discount code" AutomationId="BuyCode" />
                            </Border>
                            <FlexLayout Wrap="Wrap" BindableLayout.ItemsSource="{Binding BuyCodes}" IsVisible="{Binding BuyCodes.Count, Converter={StaticResource Any}}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="m:AvailableCode">
                                        <Button Text="{Binding Code}" Style="{StaticResource FilterChip}" Margin="0,0,8,8" Clicked="OnUseCode"
                                                SemanticProperties.Description="{Binding Code, StringFormat='Use code {0}'}" ToolTipProperties.Text="{Binding LastDayText}" />
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </FlexLayout>
                        </VerticalStackLayout>
                        <Label Text="{Binding Buying.Price, StringFormat='₱{0:N0}'}" Style="{StaticResource Numeral}" FontSize="40" />
                        <Label Text="{Binding Buying.Description}" Style="{StaticResource Muted}" IsVisible="{Binding Buying.Description, Converter={StaticResource HasText}}" />
                        <VerticalStackLayout Spacing="2" BindableLayout.ItemsSource="{Binding Buying.Benefits}" IsVisible="{Binding Buying.Benefits.Count, Converter={StaticResource Any}}">
                            <BindableLayout.ItemTemplate><DataTemplate x:DataType="x:String"><Label Text="{Binding ., StringFormat='• {0}'}" FontSize="14" /></DataTemplate></BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                        <Label Text="{Binding BuyTerms}" Style="{StaticResource Caption}" />
                        <Button Text="Buy" Style="{StaticResource SmallButton}" Command="{Binding NextCommand}" HorizontalOptions="{OnIdiom Phone=Fill, Default=Start}" AutomationId="BuyNext" />
                    </VerticalStackLayout>

                    <!-- step 2: how they pay (cash plan 2026-11-17); at the desk waits for the front desk to verify it -->
                    <VerticalStackLayout Spacing="14" IsVisible="{Binding OnPayStep}">
                        <Label Text="How you'll pay" FontFamily="BarlowSemiBold" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Border Style="{StaticResource PayOption}">
                            <Border.Triggers><DataTrigger TargetType="Border" Binding="{Binding PayCash}" Value="False"><Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource Signal}}" /><Setter Property="StrokeThickness" Value="2" /></DataTrigger></Border.Triggers>
                            <Grid>
                                <VerticalStackLayout Spacing="2"><Label Text="Online" FontFamily="BarlowSemiBold" /><Label Text="GCash or QR Ph, here" Style="{StaticResource Caption}" /></VerticalStackLayout>
                                <Button Margin="-12,-10" BackgroundColor="Transparent" BorderWidth="0" Text="" Command="{Binding PickMethodCommand}" CommandParameter="qr"
                                        SemanticProperties.Description="Pay online on this page" AutomationId="PayMethodOnline" />
                            </Grid>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource PayOption}">
                            <Border.Triggers><DataTrigger TargetType="Border" Binding="{Binding PayCash}" Value="True"><Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource Signal}}" /><Setter Property="StrokeThickness" Value="2" /></DataTrigger></Border.Triggers>
                            <Grid>
                                <VerticalStackLayout Spacing="2"><Label Text="At the desk" FontFamily="BarlowSemiBold" /><Label Text="Cash" Style="{StaticResource Caption}" /></VerticalStackLayout>
                                <Button Margin="-12,-10" BackgroundColor="Transparent" BorderWidth="0" Text="" Command="{Binding PickMethodCommand}" CommandParameter="cash"
                                        SemanticProperties.Description="Pay in cash at the front desk" AutomationId="PayMethodCash" />
                            </Grid>
                        </Border>
                    </Grid>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <Button Text="Back" Style="{StaticResource SmallOutlineButton}" Command="{Binding BackCommand}" />
                            <Button Grid.Column="1" Text="Pay" Style="{StaticResource SmallButton}" Command="{Binding PayCommand}" AutomationId="BuyPay" />
                        </Grid>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>
        </Border>
    </Grid>
    </Grid>
</v:BasePage>
