<?xml version="1.0" encoding="utf-8" ?>
<v:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
            xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
            xmlns:v="clr-namespace:GymMembership.App.Views"
            xmlns:c="clr-namespace:GymMembership.App.Controls"
            xmlns:vm="clr-namespace:GymMembership.Core.ViewModels;assembly=GymMembership.Core"
            xmlns:m="clr-namespace:GymMembership.Core.Models;assembly=GymMembership.Core"
            xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
            x:Class="GymMembership.App.Views.PackagesPage" x:DataType="vm:PackagesViewModel" Title="Packages">

    <v:BasePage.Resources>
        <toolkit:IntToBoolConverter x:Key="Any" />
        <!-- phone: name and length on the left, the price on the right, one line about it, then the button at its own width -->
        <DataTemplate x:Key="PackagePhone" x:DataType="m:MembershipPackage">
            <Border Style="{StaticResource Panel}" Padding="16,14">
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                            <Label Text="{Binding Name}" FontFamily="BarlowSemiBold" FontSize="18" />
                            <Label Text="{Binding DurationDays, StringFormat='{0} days of access'}" Style="{StaticResource Caption}" />
                        </VerticalStackLayout>
                        <Label Grid.Column="1" Text="{Binding Price, StringFormat='₱{0:N0}'}" Style="{StaticResource Numeral}" FontSize="30" VerticalOptions="Center" />
                    </Grid>
                    <Label Text="{Binding Description}" Style="{StaticResource Muted}" FontSize="15" IsVisible="{Binding Description, Converter={StaticResource HasText}}" />
                    <VerticalStackLayout Spacing="2" BindableLayout.ItemsSource="{Binding Benefits}" IsVisible="{Binding Benefits.Count, Converter={StaticResource Any}}">
                        <BindableLayout.ItemTemplate><DataTemplate x:DataType="x:String"><Label Text="{Binding ., StringFormat='• {0}'}" FontSize="14" /></DataTemplate></BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    <Button Text="Choose next term" Style="{StaticResource SmallOutlineButton}" HorizontalOptions="Start" Clicked="OnAvail" />
                </VerticalStackLayout>
            </Border>
        </DataTemplate>
        <!-- Windows: name, then the price on its own line, what it is, and an outline button (three yellow buttons side by side shouted in dark) -->
        <DataTemplate x:Key="PackageWide" x:DataType="m:MembershipPackage">
            <Border Style="{StaticResource Panel}" Padding="18,16">
                <VerticalStackLayout Spacing="6">
                    <Label Text="{Binding Name}" FontFamily="BarlowSemiBold" FontSize="18" />
                    <Label Text="{Binding Price, StringFormat='₱{0:N0}'}" Style="{StaticResource Numeral}" FontSize="44" />
                    <Label Text="{Binding DurationDays, StringFormat='{0} days of access'}" Style="{StaticResource Caption}" />
                    <Label Text="{Binding Description}" Style="{StaticResource Muted}" IsVisible="{Binding Description, Converter={StaticResource HasText}}" />
                    <VerticalStackLayout Spacing="2" BindableLayout.ItemsSource="{Binding Benefits}" IsVisible="{Binding Benefits.Count, Converter={StaticResource Any}}">
                        <BindableLayout.ItemTemplate><DataTemplate x:DataType="x:String"><Label Text="{Binding ., StringFormat='• {0}'}" FontSize="14" /></DataTemplate></BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    <Button Text="Choose next term" Style="{StaticResource SmallOutlineButton}" HorizontalOptions="Start" Margin="0,8,0,0" Clicked="OnAvail" />
                </VerticalStackLayout>
            </Border>
        </DataTemplate>
    </v:BasePage.Resources>

    <Grid RowDefinitions="Auto,*" Padding="{OnIdiom Phone='16,12,16,0', Default='16,12,16,0'}" MaximumWidthRequest="{StaticResource PageWidth}">
        <VerticalStackLayout Spacing="10" Padding="0,0,0,10">
            <!-- the rules: shown on Windows, folded behind a link on phones so the packages come first -->
            <Button Text="How buying a package works" Style="{StaticResource LinkButton}" HorizontalOptions="Start" Margin="-4,-8,0,-8" Clicked="OnToggleRules"
                    IsVisible="{OnIdiom Phone=True, Default=False}" />
            <Label x:Name="Rules" Text="Choose your next package. Pay by QR and send proof on My membership. After verification, a paid extension starts after your last paid term, or immediately if it has ended. No upgrades, automatic charges or unused-time credits."
                   Style="{OnIdiom Phone={StaticResource Caption}, Default={StaticResource Muted}}" MaximumWidthRequest="760" HorizontalOptions="Start" IsVisible="{OnIdiom Phone=False, Default=True}" />
            <c:Banner Message="{Binding ErrorMessage}" />
            <c:Banner Kind="notice" Message="{Binding Notice}" />
            <VerticalStackLayout Spacing="4" HorizontalOptions="{OnIdiom Phone=Fill, Default=Start}" WidthRequest="{OnIdiom Phone=-1, Default=260}">
                <Label Text="Discount code (optional)" Style="{StaticResource Caption}" />
                <Border Style="{StaticResource Field}"><Entry Text="{Binding DiscountCode}" Placeholder="Enter a code from the gym" SemanticProperties.Description="Discount code" /></Border>
            </VerticalStackLayout>
        </VerticalStackLayout>

        <ScrollView Grid.Row="1"><VerticalStackLayout Spacing="10">
            <!-- G4 (approved mockup docs/mockups/discount-codes.html): shown codes this member can still use that fit a package, each with what
                 it's for, its last day and a "New" mark for a week; "Use code" fills the box above. Hidden when there are none -->
            <VerticalStackLayout Spacing="6" IsVisible="{Binding HasCodes}">
                <Label Text="Codes you can use" Style="{StaticResource Caption}" />
                <!-- CardGrid, not FlexLayout: a column FlexLayout clipped the card's height on Android -->
                <c:CardGrid Columns="{OnIdiom Phone=1, Default=4}" MinColumnWidth="260" BindableLayout.ItemsSource="{Binding Codes}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="m:AvailableCode">
                            <Border Style="{StaticResource Panel}" Padding="14,12">
                                <Grid ColumnDefinitions="{OnIdiom Phone='*', Default='*,Auto'}" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="8">
                                    <VerticalStackLayout Spacing="2">
                                        <HorizontalStackLayout Spacing="8">
                                            <Label Text="{Binding Code}" FontFamily="BarlowSemiBold" VerticalOptions="Center" />
                                            <Border IsVisible="{Binding IsNew}" StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="8,1" VerticalOptions="Center"
                                                    BackgroundColor="{AppThemeBinding Light={StaticResource ChosenLight}, Dark={StaticResource Signal}}">
                                                <Label Text="New" FontFamily="BarlowSemiBold" FontSize="12"
                                                       TextColor="{AppThemeBinding Light={StaticResource OnChosenLight}, Dark={StaticResource Black}}" />
                                            </Border>
                                        </HorizontalStackLayout>
                                        <Label Text="{Binding Percent, StringFormat='{0}% off'}" FontFamily="BarlowMedium" FontSize="20" />
                                        <Label Text="{Binding ForText}" Style="{StaticResource Caption}" />
                                        <Label Text="{Binding LastDayText}" Style="{StaticResource Caption}" />
                                    </VerticalStackLayout>
                                    <Button Grid.Row="{OnIdiom Phone=1, Default=0}" Grid.Column="{OnIdiom Phone=0, Default=1}" Text="Use code" Style="{StaticResource FilterChip}"
                                            VerticalOptions="Center" HorizontalOptions="Start" Clicked="OnUseCode"
                                            SemanticProperties.Description="{Binding Code, StringFormat='Use code {0}'}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </c:CardGrid>
            </VerticalStackLayout>
            <c:CardGrid Columns="{OnIdiom Phone=1, Default=3}" MinColumnWidth="260" Padding="0,0,0,16" BindableLayout.ItemsSource="{Binding Packages}"
                     BindableLayout.ItemTemplate="{OnIdiom Phone={StaticResource PackagePhone}, Default={StaticResource PackageWide}}">
            <BindableLayout.EmptyView>
                <Label Text="No packages are on sale right now. Check back soon." Style="{StaticResource Muted}" />
            </BindableLayout.EmptyView>

        </c:CardGrid></VerticalStackLayout></ScrollView>
    </Grid>
</v:BasePage>
