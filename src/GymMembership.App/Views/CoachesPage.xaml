<?xml version="1.0" encoding="utf-8" ?>
<v:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
            xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
            xmlns:v="clr-namespace:GymMembership.App.Views"
            xmlns:c="clr-namespace:GymMembership.App.Controls"
            xmlns:vm="clr-namespace:GymMembership.Core.ViewModels;assembly=GymMembership.Core"
            xmlns:svc="clr-namespace:GymMembership.Core.Services;assembly=GymMembership.Core"
            x:Class="GymMembership.App.Views.CoachesPage" x:DataType="vm:CoachesViewModel" Title="Coaches">

    <Grid RowDefinitions="Auto,*" Padding="{OnIdiom Phone='16,12,16,0', Default='20,16,20,0'}" MaximumWidthRequest="920">
        <VerticalStackLayout Spacing="10" Padding="0,0,0,10">
            <Label Text="Hire a coach to request one-to-one sessions. You need an active membership." Style="{StaticResource Muted}" />
            <c:Banner Message="{Binding ErrorMessage}" />
        </VerticalStackLayout>

        <CollectionView Grid.Row="1" ItemsSource="{Binding Cards}">
            <CollectionView.ItemsLayout><LinearItemsLayout Orientation="Vertical" ItemSpacing="10" /></CollectionView.ItemsLayout>
            <CollectionView.EmptyView><Label Text="No coaches are taking new members right now." Style="{StaticResource Muted}" /></CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="svc:CoachCard">
                    <Border Style="{StaticResource Panel}">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding Closed}" Value="True"><Setter Property="Opacity" Value="0.55" /></DataTrigger>
                        </Border.Triggers>
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="16">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="{Binding Name}" Style="{StaticResource Heading}" />
                                <Label Text="{Binding Coach.Specialty}" FontFamily="BarlowMedium" />
                                <Label Text="{Binding Coach.Bio}" Style="{StaticResource Muted}" />
                                <Label Text="On the floor" FontFamily="BarlowMedium" Margin="0,6,0,0" />
                                <Label Text="{Binding ShiftsText}" Style="{StaticResource Caption}" />
                                <Label Text="Not taking new members right now." Style="{StaticResource Caption}" FontFamily="BarlowSemiBold"
                                       IsVisible="{Binding Closed}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Style="{StaticResource CardActions}" Spacing="6">
                                <Label Text="{Binding Coach.HourlyRate, StringFormat='₱{0:N0}'}" Style="{StaticResource PriceNumeral}" HorizontalOptions="{OnIdiom Phone=Start, Default=End}" />
                                <Label Text="per hour" Style="{StaticResource Caption}" HorizontalOptions="{OnIdiom Phone=Start, Default=End}" />
                                <Button Text="Hire" Style="{StaticResource SmallButton}" IsVisible="{Binding Hired, Converter={StaticResource Not}}"
                                        IsEnabled="{Binding Closed, Converter={StaticResource Not}}" Clicked="OnHire" />
                                <Button Text="Message" Style="{StaticResource SmallButton}" IsVisible="{Binding Hired}"
                                        Clicked="OnMessage" />
                                <Button Text="End hire" Style="{StaticResource SmallOutlineButton}" IsVisible="{Binding Hired}"
                                        Clicked="OnEndHire" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</v:BasePage>
