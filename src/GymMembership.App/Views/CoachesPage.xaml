<?xml version="1.0" encoding="utf-8" ?>
<v:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
            xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
            xmlns:v="clr-namespace:GymMembership.App.Views"
            xmlns:c="clr-namespace:GymMembership.App.Controls"
            xmlns:vm="clr-namespace:GymMembership.Core.ViewModels;assembly=GymMembership.Core"
            xmlns:svc="clr-namespace:GymMembership.Core.Services;assembly=GymMembership.Core"
            x:Class="GymMembership.App.Views.CoachesPage" x:DataType="vm:CoachesViewModel" Title="Coaches">

    <!-- F12 reverses D30: amenities moved to Book an amenity, so this page is coaches only again -->
    <Grid RowDefinitions="Auto,*" Padding="{OnIdiom Phone='16,12,16,0', Default='16,12,16,0'}" MaximumWidthRequest="{StaticResource PageWidth}">
        <VerticalStackLayout Spacing="10" Padding="0,0,0,10">
            <Label Text="Hire a coach to request one-to-one sessions. Needs an active membership." Style="{StaticResource Muted}" IsVisible="{OnIdiom Phone=False, Default=True}" />
            <c:Banner Message="{Binding ErrorMessage}" />
        </VerticalStackLayout>

        <ScrollView Grid.Row="1"><c:CardGrid Columns="{OnIdiom Phone=1, Default=4}" Padding="0,0,0,16" BindableLayout.ItemsSource="{Binding Cards}">
            <BindableLayout.EmptyView><Label Text="No coaches are in the gym right now. This list updates by itself." Style="{StaticResource Muted}" /></BindableLayout.EmptyView>
            <BindableLayout.ItemTemplate>
                <DataTemplate x:DataType="svc:CoachCard">
                    <Border Style="{StaticResource Panel}">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding Closed}" Value="True"><Setter Property="Opacity" Value="0.55" /></DataTrigger>
                        </Border.Triggers>
                        <VerticalStackLayout Spacing="12">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                <c:Avatar Letters="{Binding Letters}" Url="{Binding PhotoUrl}" Diameter="{OnIdiom Phone=56, Default=72}"
                                          SemanticProperties.Description="{Binding Name, StringFormat='Profile photo of {0}'}" />
                                <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                    <Label Text="{Binding Name}" Style="{StaticResource Heading}" />
                                    <Label Text="{Binding Coach.Specialty}" FontFamily="BarlowMedium" />
                                    <Label Text="Not taking new members right now." Style="{StaticResource Caption}" IsVisible="{Binding Closed}" />
                                    <Label Text="Your coach" Style="{StaticResource Caption}" IsVisible="{Binding Hired}" />
                                    <Label Text="Not in the gym right now." Style="{StaticResource Caption}" IsVisible="{Binding InGym, Converter={StaticResource Not}}" />
                                </VerticalStackLayout>
                            </Grid>
                            <Label Text="{Binding Coach.Bio}" Style="{StaticResource Muted}" FontSize="{OnIdiom Phone=15, Default=16}" />
                            <VerticalStackLayout Spacing="2">
                                <Label Text="On the floor" Style="{StaticResource Caption}" FontFamily="BarlowSemiBold" />
                                <Label Text="{Binding ShiftsText}" Style="{StaticResource Caption}" />
                            </VerticalStackLayout>
                            <Label Text="{Binding RateText}" FontFamily="BarlowSemiBold" />
                            <FlexLayout Wrap="Wrap">
                                <Button Text="Hire" Style="{StaticResource SmallOutlineButton}" Margin="0,0,8,8"
                                        IsVisible="{Binding Hired, Converter={StaticResource Not}}" IsEnabled="{Binding Closed, Converter={StaticResource Not}}" Clicked="OnHire" />
                                <Button Text="Message" Style="{StaticResource FilterChip}" Margin="0,0,8,8" IsVisible="{Binding Hired}" Clicked="OnMessage" />
                                <Button Text="End hire" Style="{StaticResource FilterChip}" Margin="0,0,8,8" IsVisible="{Binding Hired}" Clicked="OnEndHire" />
                            </FlexLayout>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </BindableLayout.ItemTemplate>
        </c:CardGrid></ScrollView>
    </Grid>
</v:BasePage>
