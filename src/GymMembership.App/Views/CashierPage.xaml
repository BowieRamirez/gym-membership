<?xml version="1.0" encoding="utf-8" ?>
<v:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
            xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
            xmlns:v="clr-namespace:GymMembership.App.Views"
            xmlns:c="clr-namespace:GymMembership.App.Controls"
            xmlns:vm="clr-namespace:GymMembership.Core.ViewModels;assembly=GymMembership.Core"
            xmlns:svc="clr-namespace:GymMembership.Core.Services;assembly=GymMembership.Core"
            xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
            x:Class="GymMembership.App.Views.CashierPage" x:DataType="vm:CashierViewModel" Title="Cashier">

    <v:BasePage.Resources>
        <toolkit:IntToBoolConverter x:Key="Any" />
        <!-- owner, 2026-11-16: the search results are a table (as the app's other lists), 10 to a page; the contact column tells
             two people with the same name apart; Choose is the row's one action -->
        <DataTemplate x:Key="HitRow" x:DataType="svc:MemberHit">
            <VerticalStackLayout>
                <Grid Style="{StaticResource TableRow}" ColumnDefinitions="1.2*,1.1*,1.6*,150,110" ColumnSpacing="12">
                    <Grid.Triggers>
                        <DataTrigger TargetType="Grid" Binding="{Binding IsChosen}" Value="True">
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}" />
                        </DataTrigger>
                    </Grid.Triggers>
                    <Label Text="{Binding Username}" FontFamily="BarlowSemiBold" VerticalOptions="Center" LineBreakMode="TailTruncation" />
                    <Label Grid.Column="1" Text="{Binding DeskStatusText}" Style="{StaticResource Muted}" VerticalOptions="Center" LineBreakMode="TailTruncation" />
                    <Label Grid.Column="2" Text="{Binding ContactText}" Style="{StaticResource Muted}" VerticalOptions="Center" LineBreakMode="TailTruncation" />
                    <c:StatusChip Grid.Column="3" Status="{Binding PlanStatus}" VerticalOptions="Center" />
                    <Button Grid.Column="4" Text="Choose" Style="{StaticResource SmallOutlineButton}" Clicked="OnPickMember" HorizontalOptions="End" VerticalOptions="Center"
                            SemanticProperties.Description="{Binding Username, StringFormat='Choose {0}'}">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding IsChosen}" Value="True">
                                <Setter Property="Text" Value="✓ Chosen" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                </Grid>
                <BoxView Style="{StaticResource Hairline}" />
            </VerticalStackLayout>
        </DataTemplate>
        <!-- narrow windows: the same facts stacked -->
        <DataTemplate x:Key="HitCard" x:DataType="svc:MemberHit">
            <VerticalStackLayout>
                <Grid Padding="14,10" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <Grid.Triggers>
                        <DataTrigger TargetType="Grid" Binding="{Binding IsChosen}" Value="True">
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}" />
                        </DataTrigger>
                    </Grid.Triggers>
                    <VerticalStackLayout Spacing="2">
                        <Label Text="{Binding Username}" FontFamily="BarlowSemiBold" />
                        <Label Text="{Binding DeskStatusText}" Style="{StaticResource Caption}" />
                        <Label Text="{Binding ContactText}" Style="{StaticResource Caption}" />
                    </VerticalStackLayout>
                    <Button Grid.Column="1" Text="Choose" Style="{StaticResource SmallOutlineButton}" Clicked="OnPickMember" VerticalOptions="Center"
                            SemanticProperties.Description="{Binding Username, StringFormat='Choose {0}'}">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding IsChosen}" Value="True">
                                <Setter Property="Text" Value="✓ Chosen" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                </Grid>
                <BoxView Style="{StaticResource Hairline}" />
            </VerticalStackLayout>
        </DataTemplate>
    </v:BasePage.Resources>

    <ScrollView MaximumWidthRequest="{StaticResource PageWidth}">
        <VerticalStackLayout Padding="{OnIdiom Phone='20,16,20,24', Default='16,12,16,20'}" Spacing="14">
            <Label Text="Payments taken here count as verified at once and get a receipt number for the paper receipt." Style="{StaticResource Muted}" />
            <c:Banner Message="{Binding ErrorMessage}" />
            <c:Banner Kind="notice" Message="{Binding Notice}" />

            <c:SideLayout SideFirst="False">
                <!-- main: the drawer and sale; order stays beside both on wide windows -->
                <VerticalStackLayout Spacing="12">
            <!-- F2 (0050): the cashier's own drawer, before the sale. No shift: count the float and start one (outlined, ink in light and yellow in dark as the Check-in PIN step: it's the next step). -->
            <Border Style="{StaticResource Panel}" Stroke="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource Signal}}" StrokeThickness="2" IsVisible="{Binding NeedsShift}">
                <VerticalStackLayout Spacing="10">
                    <c:CardTitle Text="Start your shift" />
                    <Label Text="Count the cash in the drawer before your first sale. Cash you take and pay back is added to this shift." Style="{StaticResource Caption}" />
                    <FlexLayout Wrap="Wrap" AlignItems="End">
                        <VerticalStackLayout Spacing="4" Margin="0,0,12,8">
                            <Label Text="Float you counted (₱)" Style="{StaticResource Caption}" />
                            <Border Style="{StaticResource Field}" WidthRequest="170"><Entry Text="{Binding StartFloat}" Keyboard="Numeric" AutomationId="ShiftFloat" ReturnCommand="{Binding StartShiftCommand}" SemanticProperties.Description="Float you counted, in pesos" /></Border>
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="4" Margin="0,0,12,8" WidthRequest="360" IsVisible="{Binding StartNeedsNote}">
                            <Label Text="{Binding FloatNoteLabel}" Style="{StaticResource Caption}" />
                            <Border Style="{StaticResource Field}"><Entry Text="{Binding StartNote}" ReturnCommand="{Binding StartShiftCommand}" Placeholder="For example: short float from the safe" SemanticProperties.Description="Why the float is different" /></Border>
                        </VerticalStackLayout>
                        <Button Text="Start shift" Margin="0,0,0,8" Command="{Binding StartShiftCommand}" AutomationId="StartShift" />
                    </FlexLayout>
                </VerticalStackLayout>
            </Border>

            <!-- shift open: the figures in a row, expected last and largest; End shift opens the count in place -->
            <Border Style="{StaticResource Panel}" IsVisible="{Binding HasShift}">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="14">
                        <c:CardTitle Text="Your drawer" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="{Binding ShiftSince}" Style="{StaticResource Caption}" VerticalOptions="Center" />
                        <Button Grid.Column="2" Text="End shift" Style="{StaticResource SmallOutlineButton}" Command="{Binding BeginCloseCommand}" AutomationId="EndShift"
                                IsVisible="{Binding IsClosing, Converter={StaticResource Not}}" />
                    </Grid>
                    <FlexLayout Wrap="Wrap" AlignItems="End">
                        <VerticalStackLayout Margin="0,0,34,6">
                            <Label Text="Float" Style="{StaticResource Caption}" />
                            <Label Text="{Binding Shift.OpeningFloat, StringFormat='₱{0:N2}', FallbackValue=''}" FontFamily="BarlowMedium" FontSize="20" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Margin="0,0,34,6">
                            <Label Text="Cash taken" Style="{StaticResource Caption}" />
                            <Label Text="{Binding Shift.CashIn, StringFormat='₱{0:N2}', FallbackValue=''}" FontFamily="BarlowMedium" FontSize="20" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Margin="0,0,34,6">
                            <Label Text="Paid back" Style="{StaticResource Caption}" />
                            <Label Text="{Binding Shift.CashOut, StringFormat='₱{0:N2}', FallbackValue=''}" FontFamily="BarlowMedium" FontSize="20" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Margin="0,0,0,6">
                            <Label Text="Expected in the drawer" Style="{StaticResource Caption}" />
                            <Label Text="{Binding Shift.Expected, StringFormat='₱{0:N2}', FallbackValue=''}" Style="{StaticResource KpiValue}" />
                        </VerticalStackLayout>
                    </FlexLayout>

                    <VerticalStackLayout Spacing="10" IsVisible="{Binding IsClosing}">
                        <BoxView Style="{StaticResource Hairline}" />
                        <FlexLayout Wrap="Wrap" AlignItems="End">
                            <VerticalStackLayout Spacing="4" Margin="0,0,14,0">
                                <Label Text="Cash you counted (₱)" Style="{StaticResource Caption}" />
                                <Border Style="{StaticResource Field}" WidthRequest="170">
                                    <Entry Text="{Binding CountedText}" Keyboard="Numeric" AutomationId="ShiftCounted" ReturnCommand="{Binding EndShiftCommand}" SemanticProperties.Description="Cash you counted, in pesos">
                                        <Entry.Behaviors><c:NumericOnlyBehavior /></Entry.Behaviors>
                                    </Entry>
                                </Border>
                            </VerticalStackLayout>
                            <!-- matches in green, over or short in red; the words say which, so colour is never the only signal -->
                            <Label Text="{Binding CountText}" FontFamily="BarlowSemiBold" FontSize="18" MinimumHeightRequest="44" VerticalTextAlignment="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource GoodLight}, Dark={StaticResource GoodDark}}">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding CloseNeedsNote}" Value="True">
                                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource BadLight}, Dark={StaticResource BadDark}}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </FlexLayout>
                        <VerticalStackLayout Spacing="6" IsVisible="{Binding CloseNeedsNote}">
                            <Label Text="Why does it differ? (needed when the count differs)" Style="{StaticResource Caption}" />
                            <FlexLayout Wrap="Wrap">
                                <Button Text="Wrong change given" Style="{StaticResource FilterChip}" Margin="0,0,8,8" Command="{Binding PickCloseReasonCommand}" CommandParameter="wrong_change">
                                    <Button.Triggers><DataTrigger TargetType="Button" Binding="{Binding CloseReason}" Value="wrong_change"><Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource ChosenLight}, Dark={StaticResource Signal}}" /><Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnChosenLight}, Dark={StaticResource Black}}" /><Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource ChosenLight}, Dark={StaticResource Signal}}" /></DataTrigger></Button.Triggers>
                                </Button>
                                <Button Text="Sale not recorded" Style="{StaticResource FilterChip}" Margin="0,0,8,8" Command="{Binding PickCloseReasonCommand}" CommandParameter="unrecorded_sale">
                                    <Button.Triggers><DataTrigger TargetType="Button" Binding="{Binding CloseReason}" Value="unrecorded_sale"><Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource ChosenLight}, Dark={StaticResource Signal}}" /><Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnChosenLight}, Dark={StaticResource Black}}" /><Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource ChosenLight}, Dark={StaticResource Signal}}" /></DataTrigger></Button.Triggers>
                                </Button>
                                <Button Text="Counting mistake" Style="{StaticResource FilterChip}" Margin="0,0,8,8" Command="{Binding PickCloseReasonCommand}" CommandParameter="counting_mistake">
                                    <Button.Triggers><DataTrigger TargetType="Button" Binding="{Binding CloseReason}" Value="counting_mistake"><Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource ChosenLight}, Dark={StaticResource Signal}}" /><Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnChosenLight}, Dark={StaticResource Black}}" /><Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource ChosenLight}, Dark={StaticResource Signal}}" /></DataTrigger></Button.Triggers>
                                </Button>
                                <Button Text="Float was wrong" Style="{StaticResource FilterChip}" Margin="0,0,8,8" Command="{Binding PickCloseReasonCommand}" CommandParameter="float_wrong">
                                    <Button.Triggers><DataTrigger TargetType="Button" Binding="{Binding CloseReason}" Value="float_wrong"><Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource ChosenLight}, Dark={StaticResource Signal}}" /><Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnChosenLight}, Dark={StaticResource Black}}" /><Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource ChosenLight}, Dark={StaticResource Signal}}" /></DataTrigger></Button.Triggers>
                                </Button>
                                <Button Text="Other" Style="{StaticResource FilterChip}" Margin="0,0,8,8" Command="{Binding PickCloseReasonCommand}" CommandParameter="other">
                                    <Button.Triggers><DataTrigger TargetType="Button" Binding="{Binding CloseReason}" Value="other"><Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource ChosenLight}, Dark={StaticResource Signal}}" /><Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnChosenLight}, Dark={StaticResource Black}}" /><Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource ChosenLight}, Dark={StaticResource Signal}}" /></DataTrigger></Button.Triggers>
                                </Button>
                            </FlexLayout>
                            <VerticalStackLayout Spacing="4" WidthRequest="360" HorizontalOptions="Start">
                                <Label Text="Note (required for Other)" Style="{StaticResource Caption}" />
                                <Border Style="{StaticResource Field}"><Entry Text="{Binding CloseNote}" ReturnCommand="{Binding EndShiftCommand}" Placeholder="For example: gave change twice" SemanticProperties.Description="Why the count differs" /></Border>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                        <HorizontalStackLayout Spacing="10">
                            <Button Text="End shift" Command="{Binding EndShiftCommand}" AutomationId="ConfirmEndShift" />
                            <Button Text="Keep shift open" Style="{StaticResource OutlineButton}" Command="{Binding KeepShiftCommand}" />
                        </HorizontalStackLayout>
                        <Label Text="After you end it, the shift can't be changed. Admin and System admin see it under Revenue." Style="{StaticResource Caption}" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

                    <Label Text="What are they paying for?" Style="{StaticResource SectionTitle}" Margin="0" />
                                <!-- 9.7: the app's chips (were icon pills); the chosen one is yellow and says "selected" to a screen reader -->
                                <FlexLayout Wrap="Wrap">
                                    <Button Text="Membership" Style="{StaticResource FilterChip}" Margin="0,0,8,8" Command="{Binding PickKindCommand}" CommandParameter="Membership">
                                        <Button.Triggers><DataTrigger TargetType="Button" Binding="{Binding Kind}" Value="Membership"><Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource ChosenLight}, Dark={StaticResource Signal}}" /><Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnChosenLight}, Dark={StaticResource Black}}" /><Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource ChosenLight}, Dark={StaticResource Signal}}" /><Setter Property="SemanticProperties.Description" Value="Membership, selected" /></DataTrigger></Button.Triggers>
                                    </Button>
                                    <Button Text="Renewal" Style="{StaticResource FilterChip}" Margin="0,0,8,8" Command="{Binding PickKindCommand}" CommandParameter="Renewal">
                                        <Button.Triggers><DataTrigger TargetType="Button" Binding="{Binding Kind}" Value="Renewal"><Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource ChosenLight}, Dark={StaticResource Signal}}" /><Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnChosenLight}, Dark={StaticResource Black}}" /><Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource ChosenLight}, Dark={StaticResource Signal}}" /><Setter Property="SemanticProperties.Description" Value="Renewal, selected" /></DataTrigger></Button.Triggers>
                                    </Button>
                                    <Button Text="Amenity booking" Style="{StaticResource FilterChip}" Margin="0,0,8,8" Command="{Binding PickKindCommand}" CommandParameter="Amenity booking">
                                        <Button.Triggers><DataTrigger TargetType="Button" Binding="{Binding Kind}" Value="Amenity booking"><Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource ChosenLight}, Dark={StaticResource Signal}}" /><Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnChosenLight}, Dark={StaticResource Black}}" /><Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource ChosenLight}, Dark={StaticResource Signal}}" /><Setter Property="SemanticProperties.Description" Value="Amenity booking, selected" /></DataTrigger></Button.Triggers>
                                    </Button>
                                    <Button Text="Coach session" Style="{StaticResource FilterChip}" Margin="0,0,8,8" Command="{Binding PickKindCommand}" CommandParameter="Coach session">
                                        <Button.Triggers><DataTrigger TargetType="Button" Binding="{Binding Kind}" Value="Coach session"><Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource ChosenLight}, Dark={StaticResource Signal}}" /><Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnChosenLight}, Dark={StaticResource Black}}" /><Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource ChosenLight}, Dark={StaticResource Signal}}" /><Setter Property="SemanticProperties.Description" Value="Coach session, selected" /></DataTrigger></Button.Triggers>
                                    </Button>
                                    <Button Text="Day pass" Style="{StaticResource FilterChip}" Margin="0,0,8,8" Command="{Binding PickKindCommand}" CommandParameter="Day pass">
                                        <Button.Triggers><DataTrigger TargetType="Button" Binding="{Binding Kind}" Value="Day pass"><Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource ChosenLight}, Dark={StaticResource Signal}}" /><Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnChosenLight}, Dark={StaticResource Black}}" /><Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource ChosenLight}, Dark={StaticResource Signal}}" /><Setter Property="SemanticProperties.Description" Value="Day pass, selected" /></DataTrigger></Button.Triggers>
                                    </Button>
                                </FlexLayout>

                                <!-- owner, 2026-11-23: bookings take money, so they moved here from Amenity status -->
                    <ContentView IsVisible="{Binding IsAmenityBooking}">
                    <Border Style="{StaticResource Panel}" BindingContext="{Binding Booking}">
                        <VerticalStackLayout Spacing="14" x:DataType="vm:DeskBookingViewModel">
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Spacing="2">
                                    <c:CardTitle Text="Book an amenity" />
                                    <Label Text="Same slots and rules as the app. The full price is paid now: in cash into your drawer, or online through Xendit for a walk-in." Style="{StaticResource Caption}" />
                                </VerticalStackLayout>
                            </Grid>
                            <c:Banner Message="{Binding ErrorMessage}" />
                            <c:Banner Kind="notice" Message="{Binding Notice}" />

                            <!-- 1. who -->
                            <!-- owner, 2026-11-25: member or walk-in, one at a time -->
                            <HorizontalStackLayout Spacing="8">
                                <c:ChoiceChip Text="Member" IsChosen="{Binding IsWalkIn, Converter={StaticResource Not}}" Command="{Binding StartMemberCommand}" AutomationId="DeskBookMember" />
                                <c:ChoiceChip Text="Walk-in" IsChosen="{Binding IsWalkIn}" Command="{Binding StartWalkInCommand}" AutomationId="DeskBookWalkIn" />
                            </HorizontalStackLayout>
                            <VerticalStackLayout Spacing="4" IsVisible="{Binding IsWalkIn, Converter={StaticResource Not}}">
                                <VerticalStackLayout Spacing="4" WidthRequest="300" HorizontalOptions="Start">
                                    <Label Text="Customer" Style="{StaticResource Caption}" />
                                    <Border Style="{StaticResource Field}"><Entry Text="{Binding Search}" Placeholder="Name, email or phone" ReturnCommand="{Binding PickTopSuggestionCommand}" SemanticProperties.Description="Search members by name, email or phone" AutomationId="DeskBookSearch" /></Border>
                                </VerticalStackLayout>
                                <Border Style="{StaticResource TablePanel}" IsVisible="{Binding HasSuggestions}" MaximumWidthRequest="480" HorizontalOptions="Start" AutomationId="DeskBookSuggestions">
                                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Suggestions}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="svc:MemberHit">
                                                <VerticalStackLayout>
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Padding="12,8" SemanticProperties.Description="{Binding Username, StringFormat='Choose {0}'}">
                                                        <Grid.GestureRecognizers>
                                                            <TapGestureRecognizer Tapped="OnPickCustomer" />
                                                        </Grid.GestureRecognizers>
                                                        <VerticalStackLayout Spacing="1" VerticalOptions="Center">
                                                            <Label Text="{Binding Username}" FontFamily="BarlowSemiBold" LineBreakMode="TailTruncation" />
                                                            <Label Text="{Binding ContactText}" Style="{StaticResource Caption}" LineBreakMode="TailTruncation" />
                                                        </VerticalStackLayout>
                                                        <c:StatusChip Grid.Column="1" Status="{Binding PlanStatus}" VerticalOptions="Center" />
                                                    </Grid>
                                                    <BoxView Style="{StaticResource Hairline}" />
                                                </VerticalStackLayout>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>
                                </Border>
                            </VerticalStackLayout>
                            <Label Text="No member found. Check the spelling, or try their email or phone. No account? Choose Walk-in." Style="{StaticResource Muted}" IsVisible="{Binding NoMatch}" />
                            <!-- 0091 (owner): someone with no account is booked by name; they photograph the receipt shown after booking -->
                            <VerticalStackLayout Spacing="4" IsVisible="{Binding IsWalkIn}" WidthRequest="300" HorizontalOptions="Start">
                                <Label Text="Walk-in's name" Style="{StaticResource Caption}" />
                                <Border Style="{StaticResource Field}"><Entry Text="{Binding WalkInName}" MaxLength="100" Placeholder="Full name" SemanticProperties.Description="Walk-in's name" AutomationId="DeskBookWalkInName" /></Border>
                                <Label Text="No account needed. They get a receipt number to photograph." Style="{StaticResource Caption}" />
                            </VerticalStackLayout>
                            <Label Text="{Binding Member.Username, StringFormat='Booking for {0}'}" FontFamily="BarlowSemiBold" IsVisible="{Binding Member, Converter={StaticResource IsNotNull}}" />

                            <!-- 2. what and when: only times the grid can take are offered -->
                            <FlexLayout Wrap="Wrap" AlignItems="End">
                                <VerticalStackLayout Spacing="4" Margin="0,0,12,8" WidthRequest="200">
                                    <Label Text="Amenity" Style="{StaticResource Caption}" />
                                    <Border Style="{StaticResource Field}"><Picker ItemsSource="{Binding Amenities}" ItemDisplayBinding="{Binding Name, x:DataType=svc:GridAmenity}" SelectedItem="{Binding Amenity}" SemanticProperties.Description="Amenity" AutomationId="DeskBookAmenity" /></Border>
                                </VerticalStackLayout>
                                <VerticalStackLayout Spacing="4" Margin="0,0,12,8">
                                    <Label Text="Day" Style="{StaticResource Caption}" />
                                    <Border Style="{StaticResource Field}"><DatePicker Date="{Binding Day}" SemanticProperties.Description="Day" /></Border>
                                </VerticalStackLayout>
                                <VerticalStackLayout Spacing="4" Margin="0,0,12,8" WidthRequest="150">
                                    <Label Text="Starts" Style="{StaticResource Caption}" />
                                    <Border Style="{StaticResource Field}"><Picker ItemsSource="{Binding Starts}" ItemDisplayBinding="{Binding Label, x:DataType=vm:DeskBookingViewModel+SlotOption}" SelectedItem="{Binding Start}" SemanticProperties.Description="Start time" AutomationId="DeskBookStart" /></Border>
                                </VerticalStackLayout>
                                <VerticalStackLayout Spacing="4" Margin="0,0,12,8" WidthRequest="130">
                                    <Label Text="How long" Style="{StaticResource Caption}" />
                                    <Border Style="{StaticResource Field}"><Picker ItemsSource="{Binding Lengths}" ItemDisplayBinding="{Binding Text, x:DataType=vm:PickChip}" SelectedItem="{Binding Length}" SemanticProperties.Description="How long" AutomationId="DeskBookMinutes" /></Border>
                                </VerticalStackLayout>
                                <Button Text="Book and take cash" Style="{StaticResource SmallButton}" Margin="0,0,12,8" Command="{Binding BookCommand}" AutomationId="DeskBook" />
                                <!-- 0092 (owner): a walk-in may pay online through Xendit instead -->
                                <Button Text="Pay online (Xendit)" Style="{StaticResource SmallOutlineButton}" Margin="0,0,0,8" Command="{Binding PayOnlineCommand}"
                                        IsVisible="{Binding IsWalkIn}" AutomationId="DeskBookOnline" />
                            </FlexLayout>

                            <!-- waiting for Xendit: the checkout is open on this PC; the slot is theirs once Check payment says paid -->
                            <Border Style="{StaticResource Panel}" IsVisible="{Binding IsWaiting}" MaximumWidthRequest="640" HorizontalOptions="Start" AutomationId="DeskBookWaiting">
                                <VerticalStackLayout Spacing="8">
                                    <Label Text="{Binding Waiting.WalkInName, StringFormat='Waiting for {0} to pay online'}" FontFamily="BarlowSemiBold" />
                                    <Label Text="{Binding Waiting.TotalPrice, StringFormat='₱{0:N2} through Xendit (GCash, Maya or a bank app via QR Ph). The checkout closes in 30 minutes.'}" Style="{StaticResource Caption}" />
                                    <HorizontalStackLayout Spacing="8">
                                        <Button Text="Check payment" Style="{StaticResource SmallButton}" Command="{Binding CheckPaymentCommand}" AutomationId="DeskBookCheck" />
                                        <Button Text="Open checkout again" Style="{StaticResource SmallOutlineButton}" Command="{Binding OpenCheckoutCommand}" />
                                        <Button Text="Cancel" Style="{StaticResource SmallOutlineButton}" Command="{Binding StopWaitingCommand}" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                            </Border>

                            <!-- 3. the receipt: a walk-in photographs it; a member also has it in their Front desk chat -->
                            <Border Style="{StaticResource Panel}" IsVisible="{Binding Receipt, Converter={StaticResource IsNotNull}}" MaximumWidthRequest="480" HorizontalOptions="Start" AutomationId="DeskBookReceipt">
                                <VerticalStackLayout Spacing="6">
                                    <Label Text="Booked and paid" Style="{StaticResource Caption}" />
                                    <Label Text="{Binding Receipt.ReceiptNo, StringFormat='Receipt {0}'}" FontFamily="BarlowSemiBold" FontSize="24" />
                                    <Label Text="{Binding Receipt.Customer}" FontFamily="BarlowSemiBold" />
                                    <Label Text="{Binding Receipt.Amenity}" />
                                    <Label Text="{Binding Receipt.When}" />
                                    <Label Text="{Binding Receipt.Paid, StringFormat='Paid {0}'}" />
                                    <Label Text="{Binding Receipt.Note}" Style="{StaticResource Muted}" Margin="0,4,0,0" />
                                </VerticalStackLayout>
                            </Border>
                        </VerticalStackLayout>
                    </Border>
                    </ContentView>
                    <Border Style="{StaticResource Panel}" IsVisible="{Binding IsCoachSession}">
                        <ContentView BindingContext="{Binding CoachBooking}">
                        <VerticalStackLayout x:DataType="vm:DeskCoachBookingViewModel">
                        <VerticalStackLayout Spacing="12">
                            <VerticalStackLayout Spacing="2">
                                <c:CardTitle Text="Book a coach for a member" />
                                <Label Text="One-on-one, 1 or 2 hours inside the coach's shift. Free with a coach-included package or coach access; otherwise the add-on is paid in cash or online." Style="{StaticResource Caption}" />
                            </VerticalStackLayout>
                            <c:Banner Message="{Binding ErrorMessage}" />
                            <c:Banner Kind="notice" Message="{Binding Notice}" />
                            <VerticalStackLayout Spacing="4" WidthRequest="300" HorizontalOptions="Start">
                                <Label Text="Member" Style="{StaticResource Caption}" />
                                <Border Style="{StaticResource Field}"><Entry Text="{Binding CoachCustomerSearch}" Placeholder="Name, email or phone" /></Border>
                            </VerticalStackLayout>
                            <Border Style="{StaticResource TablePanel}" IsVisible="{Binding CoachCustomerHits.Count, Converter={StaticResource Any}}" MaximumWidthRequest="480" HorizontalOptions="Start">
                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding CoachCustomerHits}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="svc:MemberHit">
                                            <VerticalStackLayout>
                                                <Grid ColumnDefinitions="*,Auto" Padding="12,8">
                                                    <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnPickCoachCustomer" /></Grid.GestureRecognizers>
                                                    <Label Text="{Binding Username}" FontFamily="BarlowSemiBold" />
                                                    <c:StatusChip Grid.Column="1" Status="{Binding PlanStatus}" />
                                                </Grid>
                                                <BoxView Style="{StaticResource Hairline}" />
                                            </VerticalStackLayout>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </Border>
                            <Label Text="{Binding CoachCustomer.Username, StringFormat='Booking for {0}'}" FontFamily="BarlowSemiBold" IsVisible="{Binding CoachCustomer, Converter={StaticResource IsNotNull}}" />
                            <FlexLayout Wrap="Wrap" AlignItems="End">
                                <VerticalStackLayout Spacing="4" Margin="0,0,12,8">
                                    <Label Text="Day" Style="{StaticResource Caption}" />
                                    <Border Style="{StaticResource Field}"><DatePicker Date="{Binding CoachBookDay}" MinimumDate="{x:Static x:DateTime.Today}" /></Border>
                                </VerticalStackLayout>
                                <VerticalStackLayout Spacing="4" Margin="0,0,12,8">
                                    <Label Text="Length" Style="{StaticResource Caption}" />
                                    <HorizontalStackLayout Spacing="6">
                                        <Button Text="1 hour" Style="{StaticResource FilterChip}" Command="{Binding SetDeskCoachHoursCommand}" CommandParameter="1" />
                                        <Button Text="2 hours" Style="{StaticResource FilterChip}" Command="{Binding SetDeskCoachHoursCommand}" CommandParameter="2" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                                <VerticalStackLayout Spacing="4" Margin="0,0,12,8" WidthRequest="200">
                                    <Label Text="Coach" Style="{StaticResource Caption}" />
                                    <Border Style="{StaticResource Field}"><Picker ItemsSource="{Binding DeskFreeCoaches}" ItemDisplayBinding="{Binding FullName}" SelectedItem="{Binding SelectedDeskCoach}" Title="Coach" /></Border>
                                </VerticalStackLayout>
                                <VerticalStackLayout Spacing="4" Margin="0,0,12,8" WidthRequest="180">
                                    <Label Text="Hour" Style="{StaticResource Caption}" />
                                    <Border Style="{StaticResource Field}"><Picker ItemsSource="{Binding DeskCoachHours}" ItemDisplayBinding="{Binding Label}" SelectedItem="{Binding SelectedDeskCoachHour}" Title="Hour" /></Border>
                                </VerticalStackLayout>
                                <VerticalStackLayout Spacing="4" Margin="0,0,12,8">
                                    <Label Text="Method" Style="{StaticResource Caption}" />
                                    <HorizontalStackLayout Spacing="6">
                                        <Button Text="Cash" Style="{StaticResource FilterChip}" Command="{Binding PickDeskCoachMethodCommand}" CommandParameter="Cash" />
                                        <Button Text="Online" Style="{StaticResource FilterChip}" Command="{Binding PickDeskCoachMethodCommand}" CommandParameter="Online" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                                <VerticalStackLayout Spacing="4" Margin="0,0,12,8" WidthRequest="160">
                                    <Label Text="Discount code" Style="{StaticResource Caption}" />
                                    <Border Style="{StaticResource Field}"><Entry Text="{Binding DeskCoachCode}" Placeholder="Optional" /></Border>
                                </VerticalStackLayout>
                            </FlexLayout>
                            <Button Text="Book coach session" Style="{StaticResource SmallButton}" HorizontalOptions="Start" Command="{Binding DeskBookCoachCommand}" />
                        </VerticalStackLayout>
                        </VerticalStackLayout>
                        </ContentView>
                    </Border>

                                <!-- cashier plan Y3: a Day pass needs no account; a name is optional, or find the member below -->
                                <VerticalStackLayout Spacing="10" IsVisible="{Binding IsWalkIn}">
                                    <VerticalStackLayout Spacing="6" IsVisible="{Binding HasMultipleDayPassOptions}">
                                        <Label Text="Day pass option" Style="{StaticResource Caption}" />
                                        <FlexLayout Wrap="Wrap" BindableLayout.ItemsSource="{Binding DayPassOptions}">
                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate x:DataType="vm:ItemOption">
                                                    <Button Text="{Binding Name}" Style="{StaticResource FilterChip}" Margin="0,0,8,8" Clicked="OnPickDayPassOption">
                                                        <Button.Triggers>
                                                            <DataTrigger TargetType="Button" Binding="{Binding IsPicked}" Value="True">
                                                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource ChosenLight}, Dark={StaticResource Signal}}" />
                                                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnChosenLight}, Dark={StaticResource Black}}" />
                                                                <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource ChosenLight}, Dark={StaticResource Signal}}" />
                                                            </DataTrigger>
                                                        </Button.Triggers>
                                                    </Button>
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </FlexLayout>
                                    </VerticalStackLayout>
                                    <FlexLayout Wrap="Wrap" AlignItems="End" IsVisible="{Binding DayPassWithCoach}">
                                        <VerticalStackLayout Spacing="4" Margin="0,0,12,8" WidthRequest="220">
                                            <Label Text="Coach (1 hour today)" Style="{StaticResource Caption}" />
                                            <Border Style="{StaticResource Field}"><Picker ItemsSource="{Binding DayPassCoaches}" ItemDisplayBinding="{Binding FullName}" SelectedItem="{Binding SelectedDayPassCoach}" Title="{Binding DayPassCoachTitle}" /></Border>
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Spacing="4" Margin="0,0,12,8" WidthRequest="190">
                                            <Label Text="Hour" Style="{StaticResource Caption}" />
                                            <Border Style="{StaticResource Field}"><Picker ItemsSource="{Binding DayPassHours}" ItemDisplayBinding="{Binding Label}" SelectedItem="{Binding SelectedDayPassHour}" Title="Hour" /></Border>
                                        </VerticalStackLayout>
                                    </FlexLayout>
                                    <VerticalStackLayout Spacing="4" WidthRequest="300" HorizontalOptions="Start">
                                        <Label Text="Name (optional)" Style="{StaticResource Caption}" />
                                        <Border Style="{StaticResource Field}"><Entry Text="{Binding WalkInName}" MaxLength="100" Placeholder="Leave blank to keep it anonymous" SemanticProperties.Description="Day pass name, optional" /></Border>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>

                                <VerticalStackLayout Spacing="12" IsVisible="{Binding ShowsOrder}">
                                    <!-- owner, 2026-11-25: Membership is for someone new: their details here, a package below, then Record payment (or
                                         GCash / QR Ph) makes the account and takes the payment in one go -->
                                    <Border Style="{StaticResource Panel}" IsVisible="{Binding ShowsRegisterForm}" MaximumWidthRequest="640" HorizontalOptions="Start">
                                        <VerticalStackLayout Spacing="10">
                                            <c:CardTitle Text="New member" />
                                            <Label Text="Fill in their details, choose a package below, then record the payment: the account is made with it. They get a temporary password to change the first time they sign in. Already have an account? Use Renewal." Style="{StaticResource Caption}" LineBreakMode="WordWrap" />
                                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12" RowDefinitions="Auto,Auto" RowSpacing="10">
                                                <VerticalStackLayout Spacing="4"><Label Text="First name" Style="{StaticResource Caption}" /><Border Style="{StaticResource Field}"><Entry Text="{Binding NewFirstName}" SemanticProperties.Description="First name" /></Border></VerticalStackLayout>
                                                <VerticalStackLayout Grid.Column="1" Spacing="4"><Label Text="Last name" Style="{StaticResource Caption}" /><Border Style="{StaticResource Field}"><Entry Text="{Binding NewLastName}" SemanticProperties.Description="Last name" /></Border></VerticalStackLayout>
                                                <VerticalStackLayout Grid.Row="1" Spacing="4"><Label Text="Email" Style="{StaticResource Caption}" /><Border Style="{StaticResource Field}"><Entry Text="{Binding NewEmail}" Keyboard="Email" SemanticProperties.Description="Email" /></Border></VerticalStackLayout>
                                                <VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="4"><Label Text="Phone (optional)" Style="{StaticResource Caption}" /><Border Style="{StaticResource Field}"><Entry Text="{Binding NewPhone}" Keyboard="Telephone" SemanticProperties.Description="Phone" /></Border></VerticalStackLayout>
                                            </Grid>
                                        </VerticalStackLayout>
                                    </Border>
                                    <VerticalStackLayout Spacing="12" IsVisible="{Binding ShowsSearch}">
                                    <!-- D1 (2026-11-20): typing 2+ letters shows up to 8 suggestions under the box; Enter picks the top one -->
                                    <VerticalStackLayout Spacing="4">
                                        <FlexLayout Wrap="Wrap" AlignItems="End">
                                            <VerticalStackLayout Spacing="4" Margin="0,0,12,8" WidthRequest="300">
                                                <Label Text="Customer" Style="{StaticResource Caption}" />
                                                <Border Style="{StaticResource Field}"><Entry Text="{Binding Search}" Placeholder="Name, email or phone" ReturnCommand="{Binding PickTopSuggestionCommand}" SemanticProperties.Description="Search members by name, email or phone" AutomationId="CashierSearch" /></Border>
                                            </VerticalStackLayout>
                                        </FlexLayout>
                                        <Border Style="{StaticResource TablePanel}" IsVisible="{Binding ShowSuggestions}" MaximumWidthRequest="480" HorizontalOptions="Start" AutomationId="CashierSuggestions">
                                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Suggestions}">
                                                <BindableLayout.ItemTemplate>
                                                    <DataTemplate x:DataType="svc:MemberHit">
                                                        <VerticalStackLayout>
                                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Padding="12,8" SemanticProperties.Description="{Binding Username, StringFormat='Choose {0}'}">
                                                                <Grid.GestureRecognizers>
                                                                    <TapGestureRecognizer Tapped="OnPickCashierSuggestion" />
                                                                </Grid.GestureRecognizers>
                                                                <VerticalStackLayout Spacing="1" VerticalOptions="Center">
                                                                    <Label Text="{Binding Username}" FontFamily="BarlowSemiBold" LineBreakMode="TailTruncation" />
                                                                    <Label Text="{Binding ContactText}" Style="{StaticResource Caption}" LineBreakMode="TailTruncation" />
                                                                </VerticalStackLayout>
                                                                <c:StatusChip Grid.Column="1" Status="{Binding PlanStatus}" VerticalOptions="Center" />
                                                            </Grid>
                                                            <BoxView Style="{StaticResource Hairline}" />
                                                        </VerticalStackLayout>
                                                    </DataTemplate>
                                                </BindableLayout.ItemTemplate>
                                            </VerticalStackLayout>
                                        </Border>
                                    </VerticalStackLayout>
                                    <Label Text="No member found. Check the spelling, or try their email or phone. New here? Register them under Membership." Style="{StaticResource Muted}" IsVisible="{Binding ShowNoMatch}" />
                                    <Label Text="{Binding HiddenHint}" Style="{StaticResource Muted}" IsVisible="{Binding HasHiddenHint}" AutomationId="CashierHiddenHint" />
                                    <Border Style="{StaticResource TablePanel}" IsVisible="{Binding ShowHits}">
                                        <VerticalStackLayout>
                                            <VerticalStackLayout x:Name="HitHead" IsVisible="{OnIdiom Phone=False, Default=True}">
                                                <Grid Style="{StaticResource TableHead}" ColumnDefinitions="1.2*,1.1*,1.6*,150,110" ColumnSpacing="12">
                                                    <Label Text="Member" Style="{StaticResource Caption}" />
                                                    <Label Grid.Column="1" Text="Plan" Style="{StaticResource Caption}" />
                                                    <Label Grid.Column="2" Text="Phone and email" Style="{StaticResource Caption}" />
                                                    <Label Grid.Column="3" Text="Status" Style="{StaticResource Caption}" />
                                                </Grid>
                                                <BoxView Style="{StaticResource Hairline}" />
                                            </VerticalStackLayout>
                                            <c:TableBody Items="{Binding Hits}" Header="{x:Reference HitHead}" WideFrom="760"
                                                         RowTemplate="{StaticResource HitRow}" CardTemplate="{StaticResource HitCard}" />
                                        </VerticalStackLayout>
                                    </Border>
                                    </VerticalStackLayout>
                                    <Label Text="{Binding Member.Username, StringFormat='Chosen: {0}'}" FontFamily="BarlowSemiBold" IsVisible="{Binding Member, Converter={StaticResource IsNotNull}}" />

                                    <Label Text="Choose one" Style="{StaticResource SectionTitle}" Margin="0" IsVisible="{Binding NeedsMember}" />
                                    <FlexLayout Wrap="Wrap" BindableLayout.ItemsSource="{Binding Options}" IsVisible="{Binding NeedsMember}">
                                        <BindableLayout.EmptyView>
                                            <Label Text="{Binding ItemsEmptyText}" Style="{StaticResource Muted}" />
                                        </BindableLayout.EmptyView>
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ItemOption">
                                                <Border Style="{StaticResource Panel}" Padding="14,12" WidthRequest="{OnIdiom Phone=156, Default=200}" Margin="0,0,12,12"
                                                        SemanticProperties.Description="{Binding Name}" SemanticProperties.Hint="{Binding PriceText}">
                                                    <Border.Triggers>
                                                        <!-- picked: an outline (ink in light, yellow in dark) on the same card, not a darker hole (as the coach calendar, 9.6) -->
                                                        <DataTrigger TargetType="Border" Binding="{Binding IsPicked}" Value="True">
                                                            <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource Signal}}" />
                                                            <Setter Property="StrokeThickness" Value="2" />
                                                        </DataTrigger>
                                                    </Border.Triggers>
                                                    <Border.GestureRecognizers>
                                                        <TapGestureRecognizer Tapped="OnPickItem" />
                                                    </Border.GestureRecognizers>
                                                    <VerticalStackLayout Spacing="4">
                                                        <Label Text="{Binding Name}" FontFamily="BarlowSemiBold" LineBreakMode="WordWrap" />
                                                        <Label Text="{Binding PriceText}" Style="{StaticResource Heading}" />
                                                        <Label Text="Selected" Style="{StaticResource Caption}" IsVisible="{Binding IsPicked}" />
                                                    </VerticalStackLayout>
                                                </Border>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </FlexLayout>
                                </VerticalStackLayout>

                </VerticalStackLayout>
                <!-- side: the order, always in view while choosing (D5: customer header at the top) -->
                <Border Style="{StaticResource SidePanel}">
                                <VerticalStackLayout Spacing="12">
                                <VerticalStackLayout Spacing="6" IsVisible="{Binding ShowsOrder, Converter={StaticResource Not}}">
                                    <c:CardTitle Text="Paid in the booking" />
                                    <Label Text="Bookings are paid with the buttons in the form: cash goes into your drawer, online goes through Xendit." Style="{StaticResource Caption}" LineBreakMode="WordWrap" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Spacing="12" IsVisible="{Binding ShowsOrder}">
                                    <VerticalStackLayout Spacing="4" IsVisible="{Binding HasChosenMember}">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <Label Text="{Binding Member.Username}" FontFamily="BarlowBold" FontSize="22" LineBreakMode="WordWrap" VerticalOptions="Center" />
                                            <Button Grid.Column="1" Text="Change" Style="{StaticResource SmallOutlineButton}" Command="{Binding ChangeCustomerCommand}" VerticalOptions="Start" AutomationId="CashierChangeCustomer" />
                                        </Grid>
                                        <HorizontalStackLayout Spacing="8">
                                            <c:StatusChip Status="{Binding Member.PlanStatus}" VerticalOptions="Center" />
                                            <Label Text="{Binding OrderWhoStatus}" Style="{StaticResource Caption}" VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                        <Label Text="{Binding OrderWhoContact}" Style="{StaticResource Caption}" IsVisible="{Binding OrderWhoContact, Converter={StaticResource HasText}}" LineBreakMode="TailTruncation" />
                                    </VerticalStackLayout>
                                    <Label Text="Choose a customer" Style="{StaticResource Heading}" IsVisible="{Binding ShowChooseCustomerEmpty}" />
                                    <Label Text="{Binding OrderWho}" FontFamily="BarlowSemiBold" FontSize="18" IsVisible="{Binding IsWalkIn}" />
                                    <Label Text="{Binding OrderIneligibleText}" Style="{StaticResource Caption}" TextColor="{AppThemeBinding Light={StaticResource BadLight}, Dark={StaticResource BadDark}}" IsVisible="{Binding HasOrderIneligible}" LineBreakMode="WordWrap" />
                                    <BoxView Style="{StaticResource Hairline}" />
                                    <c:CardTitle Text="Order" />
                                    <Label Text="{Binding OrderWhat}" Style="{StaticResource Muted}" />
                                    <Label Text="{Binding OrderHow}" Style="{StaticResource Caption}" />

                                    <Label Text="Paid with" Style="{StaticResource Caption}" />
                                    <FlexLayout Wrap="Wrap">
                                        <Button Text="Cash" Style="{StaticResource FilterChip}" Margin="0,0,8,8" Command="{Binding PickMethodCommand}" CommandParameter="Cash">
                                            <Button.Triggers><DataTrigger TargetType="Button" Binding="{Binding Method}" Value="Cash"><Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource ChosenLight}, Dark={StaticResource Signal}}" /><Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnChosenLight}, Dark={StaticResource Black}}" /><Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource ChosenLight}, Dark={StaticResource Signal}}" /><Setter Property="SemanticProperties.Description" Value="Cash, selected" /></DataTrigger></Button.Triggers>
                                        </Button>
                                        <Button Text="GCash / QR Ph" Style="{StaticResource FilterChip}" Margin="0,0,8,8" Command="{Binding PickMethodCommand}" CommandParameter="GCash / QR Ph"
                                                SemanticProperties.Hint="Paid on Xendit's checkout: GCash, Maya or any bank app by QR Ph">
                                            <Button.Triggers><DataTrigger TargetType="Button" Binding="{Binding Method}" Value="GCash / QR Ph"><Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource ChosenLight}, Dark={StaticResource Signal}}" /><Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnChosenLight}, Dark={StaticResource Black}}" /><Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource ChosenLight}, Dark={StaticResource Signal}}" /><Setter Property="SemanticProperties.Description" Value="GCash / QR Ph, selected" /></DataTrigger></Button.Triggers>
                                        </Button>
                                    </FlexLayout>

                                    <VerticalStackLayout Spacing="4" WidthRequest="260" HorizontalOptions="Start" IsVisible="{Binding CanUseCode}">
                                        <Label Text="Discount code (optional)" Style="{StaticResource Caption}" />
                                        <Border Style="{StaticResource Field}"><Entry Text="{Binding DiscountCode}" Unfocused="OnCodeUnfocused" SemanticProperties.Description="Discount code" /></Border>
                                        <Label Text="{Binding CodeCheckText}" Style="{StaticResource Caption}" LineBreakMode="WordWrap" IsVisible="{Binding HasCodeCheck}" AutomationId="CashierCodeFeedback">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding CodeWorks}" Value="True">
                                                    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource GoodLight}, Dark={StaticResource GoodDark}}" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Label" Binding="{Binding CodeWorks}" Value="False">
                                                    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource BadLight}, Dark={StaticResource BadDark}}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="Total" Style="{StaticResource Caption}" />
                                        <Label Text="{Binding TotalText}" Style="{StaticResource Numeral}" />
                                        <Label Text="{Binding TotalNote}" Style="{StaticResource Caption}" IsVisible="{Binding TotalNote, Converter={StaticResource HasText}}" />
                                    </VerticalStackLayout>

                                    <Button Text="Complete payment" Command="{Binding RecordCommand}" MinimumHeightRequest="56" FontSize="18" IsVisible="{Binding IsWaiting, Converter={StaticResource Not}}" />
                                    <Label Text="Start your shift to take cash. GCash / QR Ph doesn't need one." FontFamily="BarlowMedium" FontSize="13" IsVisible="{Binding CashNeedsShift}" />
                                    <!-- cashier plan Y6: Xendit's checkout is open on this PC; the receipt comes when Xendit confirms -->
                                    <VerticalStackLayout Spacing="8" IsVisible="{Binding IsWaiting}">
                                        <Label Text="{Binding Waiting.Amount, StringFormat='Waiting for ₱{0:N2} on Xendit'}" FontFamily="BarlowSemiBold" />
                                        <Label Text="The customer scans the QR Ph code on Xendit's page with GCash, Maya or their bank app." Style="{StaticResource Caption}" />
                                        <Button Text="Check payment" Command="{Binding CheckPaymentCommand}" MinimumHeightRequest="56" FontSize="18" AutomationId="CashierCheckPayment" />
                                        <FlexLayout Wrap="Wrap">
                                            <Button Text="Open checkout again" Style="{StaticResource SmallOutlineButton}" Margin="0,0,8,8" Command="{Binding OpenCheckoutCommand}" />
                                            <Button Text="Customer left" Style="{StaticResource SmallOutlineButton}" Margin="0,0,8,8" Command="{Binding StopWaitingCommand}" />
                                        </FlexLayout>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                                </VerticalStackLayout>
                            </Border>
            </c:SideLayout>

        </VerticalStackLayout>
    </ScrollView>
</v:BasePage>
