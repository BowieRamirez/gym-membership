<?xml version="1.0" encoding="utf-8" ?>
<v:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
            xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
            xmlns:v="clr-namespace:GymMembership.App.Views"
            xmlns:c="clr-namespace:GymMembership.App.Controls"
            xmlns:vm="clr-namespace:GymMembership.Core.ViewModels;assembly=GymMembership.Core"
            x:Class="GymMembership.App.Views.CashierPage" x:DataType="vm:CashierViewModel" Title="Cashier">

    <ScrollView MaximumWidthRequest="{StaticResource PageWidth}">
        <VerticalStackLayout Padding="{OnIdiom Phone='20,16,20,24', Default='16,12,16,20'}" Spacing="14">
            <Label Text="Payments taken here count as verified at once and get a receipt number for the paper receipt." Style="{StaticResource Muted}" />
            <c:Banner Message="{Binding ErrorMessage}" />
            <c:Banner Kind="notice" Message="{Binding Notice}" />

            <!-- F2 (0050): the cashier's own drawer, before the sale. No shift: count the float and start one (outlined, ink in light and yellow in dark as the Check-in PIN step: it's the next step). -->
            <Border Style="{StaticResource Panel}" Stroke="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource Signal}}" StrokeThickness="2" IsVisible="{Binding NeedsShift}">
                <VerticalStackLayout Spacing="10">
                    <c:CardTitle Text="Start your shift" />
                    <Label Text="Count the cash in the drawer before your first sale. Cash you take and pay back is added to this shift." Style="{StaticResource Caption}" />
                    <FlexLayout Wrap="Wrap" AlignItems="End">
                        <VerticalStackLayout Spacing="4" Margin="0,0,12,8">
                            <Label Text="Float you counted (₱)" Style="{StaticResource Caption}" />
                            <Border Style="{StaticResource Field}" WidthRequest="170"><Entry Text="{Binding StartFloat}" Keyboard="Numeric" AutomationId="ShiftFloat" ReturnCommand="{Binding StartShiftCommand}" SemanticProperties.Description="Float you counted, in pesos" /></Border>
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="4" Margin="0,0,12,8" WidthRequest="360" IsVisible="{Binding StartNeedsNote}">
                            <Label Text="{Binding FloatNoteLabel}" Style="{StaticResource Caption}" />
                            <Border Style="{StaticResource Field}"><Entry Text="{Binding StartNote}" ReturnCommand="{Binding StartShiftCommand}" Placeholder="For example: short float from the safe" SemanticProperties.Description="Why the float is different" /></Border>
                        </VerticalStackLayout>
                        <Button Text="Start shift" Margin="0,0,0,8" Command="{Binding StartShiftCommand}" AutomationId="StartShift" />
                    </FlexLayout>
                </VerticalStackLayout>
            </Border>

            <!-- shift open: the figures in a row, expected last and largest; End shift opens the count in place -->
            <Border Style="{StaticResource Panel}" IsVisible="{Binding HasShift}">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="14">
                        <c:CardTitle Text="Your drawer" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="{Binding ShiftSince}" Style="{StaticResource Caption}" VerticalOptions="Center" />
                        <Button Grid.Column="2" Text="End shift" Style="{StaticResource SmallOutlineButton}" Command="{Binding BeginCloseCommand}" AutomationId="EndShift"
                                IsVisible="{Binding IsClosing, Converter={StaticResource Not}}" />
                    </Grid>
                    <FlexLayout Wrap="Wrap" AlignItems="End">
                        <VerticalStackLayout Margin="0,0,34,6">
                            <Label Text="Float" Style="{StaticResource Caption}" />
                            <Label Text="{Binding Shift.OpeningFloat, StringFormat='₱{0:N2}', FallbackValue=''}" FontFamily="BarlowMedium" FontSize="20" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Margin="0,0,34,6">
                            <Label Text="Cash taken" Style="{StaticResource Caption}" />
                            <Label Text="{Binding Shift.CashIn, StringFormat='₱{0:N2}', FallbackValue=''}" FontFamily="BarlowMedium" FontSize="20" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Margin="0,0,34,6">
                            <Label Text="Paid back" Style="{StaticResource Caption}" />
                            <Label Text="{Binding Shift.CashOut, StringFormat='₱{0:N2}', FallbackValue=''}" FontFamily="BarlowMedium" FontSize="20" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Margin="0,0,0,6">
                            <Label Text="Expected in the drawer" Style="{StaticResource Caption}" />
                            <Label Text="{Binding Shift.Expected, StringFormat='₱{0:N2}', FallbackValue=''}" Style="{StaticResource KpiValue}" />
                        </VerticalStackLayout>
                    </FlexLayout>

                    <VerticalStackLayout Spacing="10" IsVisible="{Binding IsClosing}">
                        <BoxView Style="{StaticResource Hairline}" />
                        <FlexLayout Wrap="Wrap" AlignItems="End">
                            <VerticalStackLayout Spacing="4" Margin="0,0,14,0">
                                <Label Text="Cash you counted (₱)" Style="{StaticResource Caption}" />
                                <Border Style="{StaticResource Field}" WidthRequest="170"><Entry Text="{Binding CountedText}" Keyboard="Numeric" AutomationId="ShiftCounted" ReturnCommand="{Binding EndShiftCommand}" SemanticProperties.Description="Cash you counted, in pesos" /></Border>
                            </VerticalStackLayout>
                            <!-- matches in green, over or short in red; the words say which, so colour is never the only signal -->
                            <Label Text="{Binding CountText}" FontFamily="BarlowSemiBold" FontSize="18" MinimumHeightRequest="44" VerticalTextAlignment="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource GoodLight}, Dark={StaticResource GoodDark}}">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding CloseNeedsNote}" Value="True">
                                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource BadLight}, Dark={StaticResource BadDark}}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </FlexLayout>
                        <VerticalStackLayout Spacing="4" WidthRequest="360" HorizontalOptions="Start" IsVisible="{Binding CloseNeedsNote}">
                            <Label Text="What happened? (needed when the count differs)" Style="{StaticResource Caption}" />
                            <Border Style="{StaticResource Field}"><Entry Text="{Binding CloseNote}" ReturnCommand="{Binding EndShiftCommand}" Placeholder="For example: gave change twice" SemanticProperties.Description="Why the count differs" /></Border>
                        </VerticalStackLayout>
                        <HorizontalStackLayout Spacing="10">
                            <Button Text="End shift" Command="{Binding EndShiftCommand}" AutomationId="ConfirmEndShift" />
                            <Button Text="Keep shift open" Style="{StaticResource OutlineButton}" Command="{Binding KeepShiftCommand}" />
                        </HorizontalStackLayout>
                        <Label Text="After you end it, the shift can't be changed. Admin and System admin see it under Revenue." Style="{StaticResource Caption}" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <c:SideLayout SideFirst="False" StackedSideWidth="{OnIdiom Phone=10000, Default=600}">
                <!-- main: what they pay for, who, which item; then today's cash -->
                <VerticalStackLayout Spacing="12">
                    <Label Text="What are they paying for?" Style="{StaticResource SectionTitle}" Margin="0" />
                                <!-- 9.7: the app's chips (were icon pills); the chosen one is yellow and says "selected" to a screen reader -->
                                <FlexLayout Wrap="Wrap">
                                    <Button Text="Membership" Style="{StaticResource FilterChip}" Margin="0,0,8,8" Command="{Binding PickKindCommand}" CommandParameter="Membership">
                                        <Button.Triggers><DataTrigger TargetType="Button" Binding="{Binding Kind}" Value="Membership"><Setter Property="BackgroundColor" Value="{StaticResource Signal}" /><Setter Property="TextColor" Value="{StaticResource Black}" /><Setter Property="BorderColor" Value="{StaticResource Signal}" /><Setter Property="SemanticProperties.Description" Value="Membership, selected" /></DataTrigger></Button.Triggers>
                                    </Button>
                                    <Button Text="Renewal" Style="{StaticResource FilterChip}" Margin="0,0,8,8" Command="{Binding PickKindCommand}" CommandParameter="Renewal">
                                        <Button.Triggers><DataTrigger TargetType="Button" Binding="{Binding Kind}" Value="Renewal"><Setter Property="BackgroundColor" Value="{StaticResource Signal}" /><Setter Property="TextColor" Value="{StaticResource Black}" /><Setter Property="BorderColor" Value="{StaticResource Signal}" /><Setter Property="SemanticProperties.Description" Value="Renewal, selected" /></DataTrigger></Button.Triggers>
                                    </Button>
                                    <Button Text="Amenity" Style="{StaticResource FilterChip}" Margin="0,0,8,8" Command="{Binding PickKindCommand}" CommandParameter="Amenity">
                                        <Button.Triggers><DataTrigger TargetType="Button" Binding="{Binding Kind}" Value="Amenity"><Setter Property="BackgroundColor" Value="{StaticResource Signal}" /><Setter Property="TextColor" Value="{StaticResource Black}" /><Setter Property="BorderColor" Value="{StaticResource Signal}" /><Setter Property="SemanticProperties.Description" Value="Amenity, selected" /></DataTrigger></Button.Triggers>
                                    </Button>
                                    <Button Text="Walk-in" Style="{StaticResource FilterChip}" Margin="0,0,8,8" Command="{Binding PickKindCommand}" CommandParameter="Walk-in">
                                        <Button.Triggers><DataTrigger TargetType="Button" Binding="{Binding Kind}" Value="Walk-in"><Setter Property="BackgroundColor" Value="{StaticResource Signal}" /><Setter Property="TextColor" Value="{StaticResource Black}" /><Setter Property="BorderColor" Value="{StaticResource Signal}" /><Setter Property="SemanticProperties.Description" Value="Walk-in, selected" /></DataTrigger></Button.Triggers>
                                    </Button>
                                </FlexLayout>

                                <!-- walk-ins have no member: just a name -->
                                <VerticalStackLayout Spacing="4" WidthRequest="300" HorizontalOptions="Start" IsVisible="{Binding IsWalkIn}">
                                    <Label Text="Name" Style="{StaticResource Caption}" />
                                    <Border Style="{StaticResource Field}"><Entry Text="{Binding WalkInName}" SemanticProperties.Description="Walk-in name" /></Border>
                                </VerticalStackLayout>

                                <VerticalStackLayout Spacing="12" IsVisible="{Binding NeedsMember}">
                                    <FlexLayout Wrap="Wrap" AlignItems="End">
                                        <VerticalStackLayout Spacing="4" Margin="0,0,12,8" WidthRequest="240">
                                            <Label Text="Find the member" Style="{StaticResource Caption}" />
                                            <Border Style="{StaticResource Field}"><Entry Text="{Binding Search}" Placeholder="Start of their name" ReturnCommand="{Binding FindCommand}" SemanticProperties.Description="Search members" /></Border>
                                        </VerticalStackLayout>
                                        <Button Text="Find" Style="{StaticResource SmallOutlineButton}" Margin="0,0,12,8" Command="{Binding FindCommand}" />
                                        <VerticalStackLayout Spacing="4" Margin="0,0,12,8" WidthRequest="260">
                                            <Label Text="Member" Style="{StaticResource Caption}" />
                                            <Border Style="{StaticResource Field}"><Picker ItemsSource="{Binding Hits}" ItemDisplayBinding="{Binding Username}" SelectedItem="{Binding Member}" Title="Choose after Find" SemanticProperties.Description="Member" /></Border>
                                        </VerticalStackLayout>
                                    </FlexLayout>

                                    <Label Text="Choose one" Style="{StaticResource SectionTitle}" Margin="0" />
                                    <FlexLayout Wrap="Wrap" BindableLayout.ItemsSource="{Binding Options}">
                                        <BindableLayout.EmptyView>
                                            <Label Text="{Binding ItemsEmptyText}" Style="{StaticResource Muted}" />
                                        </BindableLayout.EmptyView>
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ItemOption">
                                                <Border Style="{StaticResource Panel}" Padding="14,12" WidthRequest="{OnIdiom Phone=156, Default=200}" Margin="0,0,12,12"
                                                        SemanticProperties.Description="{Binding Name}" SemanticProperties.Hint="{Binding PriceText}">
                                                    <Border.Triggers>
                                                        <!-- picked: an outline (ink in light, yellow in dark) on the same card, not a darker hole (as the coach calendar, 9.6) -->
                                                        <DataTrigger TargetType="Border" Binding="{Binding IsPicked}" Value="True">
                                                            <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource Signal}}" />
                                                            <Setter Property="StrokeThickness" Value="2" />
                                                        </DataTrigger>
                                                    </Border.Triggers>
                                                    <Border.GestureRecognizers>
                                                        <TapGestureRecognizer Tapped="OnPickItem" />
                                                    </Border.GestureRecognizers>
                                                    <VerticalStackLayout Spacing="4">
                                                        <Label Text="{Binding Name}" FontFamily="BarlowSemiBold" LineBreakMode="WordWrap" />
                                                        <Label Text="{Binding PriceText}" Style="{StaticResource Heading}" />
                                                        <Label Text="Selected" Style="{StaticResource Caption}" IsVisible="{Binding IsPicked}" />
                                                    </VerticalStackLayout>
                                                </Border>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </FlexLayout>
                                </VerticalStackLayout>

                </VerticalStackLayout>
                <!-- side: the order, always in view while choosing -->
                <Border Style="{StaticResource SidePanel}">
                                <VerticalStackLayout Spacing="12">
                                    <c:CardTitle Text="Order" />
                                    <Label Text="{Binding OrderWho}" FontFamily="BarlowSemiBold" />
                                    <Label Text="{Binding OrderWhat}" Style="{StaticResource Muted}" />
                                    <Label Text="{Binding OrderHow}" Style="{StaticResource Caption}" />

                                    <Label Text="Paid with" Style="{StaticResource Caption}" />
                                    <FlexLayout Wrap="Wrap">
                                        <Button Text="Cash" Style="{StaticResource FilterChip}" Margin="0,0,8,8" Command="{Binding PickMethodCommand}" CommandParameter="Cash">
                                            <Button.Triggers><DataTrigger TargetType="Button" Binding="{Binding Method}" Value="Cash"><Setter Property="BackgroundColor" Value="{StaticResource Signal}" /><Setter Property="TextColor" Value="{StaticResource Black}" /><Setter Property="BorderColor" Value="{StaticResource Signal}" /><Setter Property="SemanticProperties.Description" Value="Cash, selected" /></DataTrigger></Button.Triggers>
                                        </Button>
                                        <Button Text="GCash" Style="{StaticResource FilterChip}" Margin="0,0,8,8" Command="{Binding PickMethodCommand}" CommandParameter="GCash">
                                            <Button.Triggers><DataTrigger TargetType="Button" Binding="{Binding Method}" Value="GCash"><Setter Property="BackgroundColor" Value="{StaticResource Signal}" /><Setter Property="TextColor" Value="{StaticResource Black}" /><Setter Property="BorderColor" Value="{StaticResource Signal}" /><Setter Property="SemanticProperties.Description" Value="GCash, selected" /></DataTrigger></Button.Triggers>
                                        </Button>
                                        <Button Text="Bank transfer" Style="{StaticResource FilterChip}" Margin="0,0,8,8" Command="{Binding PickMethodCommand}" CommandParameter="Bank transfer">
                                            <Button.Triggers><DataTrigger TargetType="Button" Binding="{Binding Method}" Value="Bank transfer"><Setter Property="BackgroundColor" Value="{StaticResource Signal}" /><Setter Property="TextColor" Value="{StaticResource Black}" /><Setter Property="BorderColor" Value="{StaticResource Signal}" /><Setter Property="SemanticProperties.Description" Value="Bank transfer, selected" /></DataTrigger></Button.Triggers>
                                        </Button>
                                    </FlexLayout>

                                    <VerticalStackLayout Spacing="4" WidthRequest="260" HorizontalOptions="Start" IsVisible="{Binding NeedsReference}">
                                        <Label Text="Reference number" Style="{StaticResource Caption}" />
                                        <Border Style="{StaticResource Field}"><Entry Text="{Binding ReferenceNo}" SemanticProperties.Description="Reference number" /></Border>
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Spacing="4" WidthRequest="260" HorizontalOptions="Start" IsVisible="{Binding NeedsMember}">
                                        <Label Text="Discount code (optional)" Style="{StaticResource Caption}" />
                                        <Border Style="{StaticResource Field}"><Entry Text="{Binding DiscountCode}" SemanticProperties.Description="Discount code" /></Border>
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="Total" Style="{StaticResource Caption}" />
                                        <Label Text="{Binding TotalText}" Style="{StaticResource Numeral}" />
                                        <Label Text="{Binding TotalNote}" Style="{StaticResource Caption}" IsVisible="{Binding TotalNote, Converter={StaticResource HasText}}" />
                                    </VerticalStackLayout>

                                    <Button Text="Complete payment" Command="{Binding RecordCommand}" MinimumHeightRequest="56" FontSize="18" />
                                    <Label Text="Start your shift above to take cash. GCash and bank transfers don't need one." FontFamily="BarlowMedium" FontSize="13" IsVisible="{Binding CashNeedsShift}" />
                                </VerticalStackLayout>
                            </Border>
            </c:SideLayout>

        </VerticalStackLayout>
    </ScrollView>
</v:BasePage>
