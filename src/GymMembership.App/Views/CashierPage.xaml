<?xml version="1.0" encoding="utf-8" ?>
<v:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
            xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
            xmlns:v="clr-namespace:GymMembership.App.Views"
            xmlns:c="clr-namespace:GymMembership.App.Controls"
            xmlns:vm="clr-namespace:GymMembership.Core.ViewModels;assembly=GymMembership.Core"
            xmlns:svc="clr-namespace:GymMembership.Core.Services;assembly=GymMembership.Core"
            x:Class="GymMembership.App.Views.CashierPage" x:DataType="vm:CashierViewModel" Title="Cashier">

    <ScrollView MaximumWidthRequest="{StaticResource PageWidth}">
        <VerticalStackLayout Padding="{OnIdiom Phone='20,16,20,24', Default='16,12,16,20'}" Spacing="14">
            <Label Text="Payments taken here count as verified at once and get a receipt number for the paper receipt." Style="{StaticResource Muted}" />
            <c:Banner Message="{Binding ErrorMessage}" />
            <c:Banner Kind="notice" Message="{Binding Notice}" />

            <c:SideLayout SideFirst="False" StackedSideWidth="{OnIdiom Phone=10000, Default=600}">
                <!-- main: what they pay for, who, which item; then today's cash -->
                <VerticalStackLayout Spacing="12">
                    <Label Text="What are they paying for?" Style="{StaticResource SectionTitle}" Margin="0" />
                                <!-- 9.7: the app's chips (were icon pills); the chosen one is yellow and says "selected" to a screen reader -->
                                <FlexLayout Wrap="Wrap">
                                    <Button Text="Membership" Style="{StaticResource FilterChip}" Margin="0,0,8,8" Command="{Binding PickKindCommand}" CommandParameter="Membership">
                                        <Button.Triggers><DataTrigger TargetType="Button" Binding="{Binding Kind}" Value="Membership"><Setter Property="Style" Value="{StaticResource FilterChipOn}" /><Setter Property="SemanticProperties.Description" Value="Membership, selected" /></DataTrigger></Button.Triggers>
                                    </Button>
                                    <Button Text="Renewal" Style="{StaticResource FilterChip}" Margin="0,0,8,8" Command="{Binding PickKindCommand}" CommandParameter="Renewal">
                                        <Button.Triggers><DataTrigger TargetType="Button" Binding="{Binding Kind}" Value="Renewal"><Setter Property="Style" Value="{StaticResource FilterChipOn}" /><Setter Property="SemanticProperties.Description" Value="Renewal, selected" /></DataTrigger></Button.Triggers>
                                    </Button>
                                    <Button Text="Amenity" Style="{StaticResource FilterChip}" Margin="0,0,8,8" Command="{Binding PickKindCommand}" CommandParameter="Amenity">
                                        <Button.Triggers><DataTrigger TargetType="Button" Binding="{Binding Kind}" Value="Amenity"><Setter Property="Style" Value="{StaticResource FilterChipOn}" /><Setter Property="SemanticProperties.Description" Value="Amenity, selected" /></DataTrigger></Button.Triggers>
                                    </Button>
                                    <Button Text="Walk-in" Style="{StaticResource FilterChip}" Margin="0,0,8,8" Command="{Binding PickKindCommand}" CommandParameter="Walk-in">
                                        <Button.Triggers><DataTrigger TargetType="Button" Binding="{Binding Kind}" Value="Walk-in"><Setter Property="Style" Value="{StaticResource FilterChipOn}" /><Setter Property="SemanticProperties.Description" Value="Walk-in, selected" /></DataTrigger></Button.Triggers>
                                    </Button>
                                </FlexLayout>

                                <!-- walk-ins have no member: just a name -->
                                <VerticalStackLayout Spacing="4" WidthRequest="300" HorizontalOptions="Start" IsVisible="{Binding IsWalkIn}">
                                    <Label Text="Name" Style="{StaticResource Caption}" />
                                    <Border Style="{StaticResource Field}"><Entry Text="{Binding WalkInName}" SemanticProperties.Description="Walk-in name" /></Border>
                                </VerticalStackLayout>

                                <VerticalStackLayout Spacing="12" IsVisible="{Binding NeedsMember}">
                                    <FlexLayout Wrap="Wrap" AlignItems="End">
                                        <VerticalStackLayout Spacing="4" Margin="0,0,12,8" WidthRequest="240">
                                            <Label Text="Find the member" Style="{StaticResource Caption}" />
                                            <Border Style="{StaticResource Field}"><Entry Text="{Binding Search}" Placeholder="Start of their name" ReturnCommand="{Binding FindCommand}" SemanticProperties.Description="Search members" /></Border>
                                        </VerticalStackLayout>
                                        <Button Text="Find" Style="{StaticResource SmallOutlineButton}" Margin="0,0,12,8" Command="{Binding FindCommand}" />
                                        <VerticalStackLayout Spacing="4" Margin="0,0,12,8" WidthRequest="260">
                                            <Label Text="Member" Style="{StaticResource Caption}" />
                                            <Border Style="{StaticResource Field}"><Picker ItemsSource="{Binding Hits}" ItemDisplayBinding="{Binding Username}" SelectedItem="{Binding Member}" Title="Choose after Find" SemanticProperties.Description="Member" /></Border>
                                        </VerticalStackLayout>
                                    </FlexLayout>

                                    <Label Text="Choose one" Style="{StaticResource SectionTitle}" Margin="0" />
                                    <FlexLayout Wrap="Wrap" BindableLayout.ItemsSource="{Binding Options}">
                                        <BindableLayout.EmptyView>
                                            <Label Text="{Binding ItemsEmptyText}" Style="{StaticResource Muted}" />
                                        </BindableLayout.EmptyView>
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ItemOption">
                                                <Border Style="{StaticResource Panel}" Padding="14,12" WidthRequest="{OnIdiom Phone=156, Default=200}" Margin="0,0,12,12"
                                                        SemanticProperties.Description="{Binding Name}" SemanticProperties.Hint="{Binding PriceText}">
                                                    <Border.Triggers>
                                                        <!-- picked: an outline (ink in light, yellow in dark) on the same card, not a darker hole (as the coach calendar, 9.6) -->
                                                        <DataTrigger TargetType="Border" Binding="{Binding IsPicked}" Value="True">
                                                            <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource Signal}}" />
                                                            <Setter Property="StrokeThickness" Value="2" />
                                                        </DataTrigger>
                                                    </Border.Triggers>
                                                    <Border.GestureRecognizers>
                                                        <TapGestureRecognizer Tapped="OnPickItem" />
                                                    </Border.GestureRecognizers>
                                                    <VerticalStackLayout Spacing="4">
                                                        <Label Text="{Binding Name}" FontFamily="BarlowSemiBold" LineBreakMode="WordWrap" />
                                                        <Label Text="{Binding PriceText}" Style="{StaticResource Heading}" />
                                                        <Label Text="Selected" Style="{StaticResource Caption}" IsVisible="{Binding IsPicked}" />
                                                    </VerticalStackLayout>
                                                </Border>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </FlexLayout>
                                </VerticalStackLayout>

                </VerticalStackLayout>
                <!-- side: the order, always in view while choosing -->
                <Border Style="{StaticResource SidePanel}">
                                <VerticalStackLayout Spacing="12">
                                    <c:CardTitle Text="Order" />
                                    <Label Text="{Binding OrderWho}" FontFamily="BarlowSemiBold" />
                                    <Label Text="{Binding OrderWhat}" Style="{StaticResource Muted}" />
                                    <Label Text="{Binding OrderHow}" Style="{StaticResource Caption}" />

                                    <Label Text="Paid with" Style="{StaticResource Caption}" />
                                    <FlexLayout Wrap="Wrap">
                                        <Button Text="Cash" Style="{StaticResource FilterChip}" Margin="0,0,8,8" Command="{Binding PickMethodCommand}" CommandParameter="Cash">
                                            <Button.Triggers><DataTrigger TargetType="Button" Binding="{Binding Method}" Value="Cash"><Setter Property="Style" Value="{StaticResource FilterChipOn}" /><Setter Property="SemanticProperties.Description" Value="Cash, selected" /></DataTrigger></Button.Triggers>
                                        </Button>
                                        <Button Text="GCash" Style="{StaticResource FilterChip}" Margin="0,0,8,8" Command="{Binding PickMethodCommand}" CommandParameter="GCash">
                                            <Button.Triggers><DataTrigger TargetType="Button" Binding="{Binding Method}" Value="GCash"><Setter Property="Style" Value="{StaticResource FilterChipOn}" /><Setter Property="SemanticProperties.Description" Value="GCash, selected" /></DataTrigger></Button.Triggers>
                                        </Button>
                                        <Button Text="Bank transfer" Style="{StaticResource FilterChip}" Margin="0,0,8,8" Command="{Binding PickMethodCommand}" CommandParameter="Bank transfer">
                                            <Button.Triggers><DataTrigger TargetType="Button" Binding="{Binding Method}" Value="Bank transfer"><Setter Property="Style" Value="{StaticResource FilterChipOn}" /><Setter Property="SemanticProperties.Description" Value="Bank transfer, selected" /></DataTrigger></Button.Triggers>
                                        </Button>
                                    </FlexLayout>

                                    <VerticalStackLayout Spacing="4" WidthRequest="260" HorizontalOptions="Start" IsVisible="{Binding NeedsReference}">
                                        <Label Text="Reference number" Style="{StaticResource Caption}" />
                                        <Border Style="{StaticResource Field}"><Entry Text="{Binding ReferenceNo}" SemanticProperties.Description="Reference number" /></Border>
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Spacing="4" WidthRequest="260" HorizontalOptions="Start" IsVisible="{Binding NeedsMember}">
                                        <Label Text="Discount code (optional)" Style="{StaticResource Caption}" />
                                        <Border Style="{StaticResource Field}"><Entry Text="{Binding DiscountCode}" SemanticProperties.Description="Discount code" /></Border>
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="Total" Style="{StaticResource Caption}" />
                                        <Label Text="{Binding TotalText}" Style="{StaticResource Numeral}" />
                                        <Label Text="{Binding TotalNote}" Style="{StaticResource Caption}" IsVisible="{Binding TotalNote, Converter={StaticResource HasText}}" />
                                    </VerticalStackLayout>

                                    <Button Text="Complete payment" Command="{Binding RecordCommand}" MinimumHeightRequest="56" FontSize="18" />
                                </VerticalStackLayout>
                            </Border>
            </c:SideLayout>

            <!-- today's cash in one panel, under the order so a stacked window keeps the order right after the choices (9.7: was a title,
                 a panel with a long rule and a second panel for the rows, all between the choices and the order) -->
            <Border Style="{StaticResource Panel}">
                <VerticalStackLayout Spacing="8">
                    <c:CardTitle Text="Net cash today" />
                    <Label Text="{Binding CashTotal}" Style="{StaticResource KpiValue}" />
                    <Label Text="Cash taken minus cash refunds paid back today. It should match the drawer." Style="{StaticResource Caption}" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding CashToday}">
                        <BindableLayout.EmptyView><Label Text="No cash taken or paid back yet today." Style="{StaticResource Muted}" Margin="0,4,0,0" /></BindableLayout.EmptyView>
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="svc:CashRow">
                                <VerticalStackLayout>
                                    <BoxView Style="{StaticResource Hairline}" />
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Padding="0,10">
                                        <Label VerticalOptions="Center">
                                            <Label.Text>
                                                <MultiBinding StringFormat="{}{0}  ({1})"><Binding Path="Kind" /><Binding Path="Payments" /></MultiBinding>
                                            </Label.Text>
                                        </Label>
                                        <Label Grid.Column="1" Text="{Binding Total, StringFormat='₱{0:N2}'}" FontFamily="BarlowSemiBold" VerticalOptions="Center" />
                                    </Grid>
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</v:BasePage>
