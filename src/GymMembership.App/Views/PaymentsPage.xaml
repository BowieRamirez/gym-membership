<?xml version="1.0" encoding="utf-8" ?>
<!-- Owner fixes 2026-11-19 Q8: the member's own payments, moved here from My membership. Newest first, 10 a page, filtered by what was
     bought (a Day pass is a package, so it is under Membership). Same table and card patterns as the list it replaces. -->
<v:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
            xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
            xmlns:v="clr-namespace:GymMembership.App.Views"
            xmlns:c="clr-namespace:GymMembership.App.Controls"
            xmlns:vm="clr-namespace:GymMembership.Core.ViewModels;assembly=GymMembership.Core"
            xmlns:svc="clr-namespace:GymMembership.Core.Services;assembly=GymMembership.Core"
            x:Class="GymMembership.App.Views.PaymentsPage" x:DataType="vm:MyPaymentsViewModel" Title="Payments">

    <v:BasePage.Resources>
        <!-- Windows: one row a payment -->
        <DataTemplate x:Key="PaymentRow" x:DataType="svc:PaymentItem">
            <VerticalStackLayout>
                <Grid Style="{StaticResource TableRow}" ColumnDefinitions="*,110,100,*,130,170,120,200">
                    <Label Text="{Binding What}" FontFamily="BarlowMedium" VerticalOptions="Center" />
                    <c:StatusChip Grid.Column="1" Status="{Binding StatusText}" VerticalOptions="Center" />
                    <Label Grid.Column="2" Text="{Binding MethodText}" VerticalOptions="Center" />
                    <Label Grid.Column="3" Text="{Binding Detail}" VerticalOptions="Center" />
                    <Label Grid.Column="4" Text="{Binding PaymentCode}" Style="{StaticResource Muted}" VerticalOptions="Center" />
                    <Label Grid.Column="5" Text="{Binding CreatedAt, Converter={StaticResource LocalDate}, ConverterParameter='d MMM yyyy, h:mm tt'}" VerticalOptions="Center" />
                    <Label Grid.Column="6" Text="{Binding Amount, StringFormat='₱{0:N2}'}" FontFamily="BarlowSemiBold" HorizontalOptions="End" VerticalOptions="Center" />
                    <HorizontalStackLayout Grid.Column="7" Spacing="6" VerticalOptions="Center" HorizontalOptions="End">
                        <Button Text="Pay again" Style="{StaticResource SmallOutlineButton}" IsVisible="{Binding CanPayAgain}" Clicked="OnPayAgain" />
                        <Button Text="Cancel payment" Style="{StaticResource SmallOutlineButton}" IsVisible="{Binding CanCancel}" Clicked="OnCancelPayment" />
                    </HorizontalStackLayout>
                </Grid>
                <BoxView Style="{StaticResource Hairline}" />
            </VerticalStackLayout>
        </DataTemplate>
        <!-- phone and narrow windows: what and how much; then the status, the day and how it was paid; the code and the receipt or reason under -->
        <DataTemplate x:Key="PaymentCard" x:DataType="svc:PaymentItem">
            <VerticalStackLayout>
                <VerticalStackLayout Spacing="4" Padding="14,12">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <Label Text="{Binding What}" FontFamily="BarlowSemiBold" />
                        <Label Grid.Column="1" Text="{Binding Amount, StringFormat='₱{0:N2}'}" FontFamily="BarlowSemiBold" />
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <c:StatusChip Status="{Binding StatusText}" VerticalOptions="Center" />
                        <Label Grid.Column="1" Style="{StaticResource Caption}" VerticalOptions="Center">
                            <Label.Text>
                                <MultiBinding StringFormat="{}{0}  ·  {1}">
                                    <Binding Path="CreatedAt" Converter="{StaticResource LocalDate}" ConverterParameter="d MMM yyyy" />
                                    <Binding Path="MethodText" />
                                </MultiBinding>
                            </Label.Text>
                        </Label>
                    </Grid>
                    <Label Text="{Binding PaymentCode, StringFormat='Payment code {0}'}" Style="{StaticResource Caption}" />
                    <Label Text="{Binding Detail}" Style="{StaticResource Caption}" IsVisible="{Binding Detail, Converter={StaticResource HasText}}" />
                    <HorizontalStackLayout Spacing="8" Margin="0,6,0,0" IsVisible="{Binding CanPayAgain}">
                        <Button Text="Pay again" Style="{StaticResource FilterChip}" Clicked="OnPayAgain" />
                    </HorizontalStackLayout>
                    <HorizontalStackLayout Spacing="8" Margin="0,6,0,0" IsVisible="{Binding CanCancel}">
                        <Button Text="Cancel payment" Style="{StaticResource FilterChip}" Clicked="OnCancelPayment" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
                <BoxView Style="{StaticResource Hairline}" />
            </VerticalStackLayout>
        </DataTemplate>
    </v:BasePage.Resources>

    <ScrollView MaximumWidthRequest="{StaticResource PageWidth}">
        <VerticalStackLayout Padding="{OnIdiom Phone='16,12,16,24', Default='16,12,16,20'}" Spacing="12">
            <Label Text="Everything you've paid for or started paying, newest first. Only you see this." Style="{OnIdiom Phone={StaticResource Caption}, Default={StaticResource Muted}}" />
            <c:Banner Message="{Binding ErrorMessage}" />
            <c:Banner Kind="notice" Message="{Binding Notice}" />

            <!-- D6 (2026-11-20): Pay again popup with optional discount code, then straight to Xendit checkout -->
            <Border Style="{StaticResource Panel}" IsVisible="{Binding IsPayingAgain}" MaximumWidthRequest="480" HorizontalOptions="{OnIdiom Phone=Fill, Default=Start}" AutomationId="PayAgainPanel">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <VerticalStackLayout Spacing="2">
                            <c:CardTitle Text="{Binding PayAgainTitle}" />
                            <Label Text="{Binding PayAgainPriceText}" Style="{StaticResource Heading}" />
                        </VerticalStackLayout>
                        <Button Grid.Column="1" Text="Cancel" Style="{StaticResource SmallOutlineButton}" Command="{Binding ClosePayAgainCommand}" VerticalOptions="Start" />
                    </Grid>
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Discount code (optional)" Style="{StaticResource Caption}" />
                        <Border Style="{StaticResource Field}"><Entry Text="{Binding PayAgainCode}" Unfocused="OnPayAgainCodeUnfocused" Placeholder="Enter code" SemanticProperties.Description="Discount code" AutomationId="PayAgainCode" /></Border>
                        <Label Text="{Binding PayAgainCodeText}" Style="{StaticResource Caption}" LineBreakMode="WordWrap" IsVisible="{Binding HasPayAgainCodeCheck}">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding PayAgainCodeWorks}" Value="True">
                                    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource GoodLight}, Dark={StaticResource GoodDark}}" />
                                </DataTrigger>
                                <DataTrigger TargetType="Label" Binding="{Binding PayAgainCodeWorks}" Value="False">
                                    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource BadLight}, Dark={StaticResource BadDark}}" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </VerticalStackLayout>
                    <Button Text="Pay online" Command="{Binding ConfirmPayAgainCommand}" MinimumHeightRequest="48" AutomationId="PayAgainConfirm" />
                </VerticalStackLayout>
            </Border>

            <!-- what was bought + how it was paid; the chosen chip is filled, as on the other member pages -->
            <FlexLayout Wrap="Wrap" AlignItems="Center">
                <Button Text="All" Style="{StaticResource FilterChip}" Margin="0,0,8,8" Command="{Binding SetKindCommand}" CommandParameter="All">
                    <Button.Triggers><DataTrigger TargetType="Button" Binding="{Binding Kind}" Value="All"><Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource ChosenLight}, Dark={StaticResource Signal}}" /><Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnChosenLight}, Dark={StaticResource Black}}" /><Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource ChosenLight}, Dark={StaticResource Signal}}" /></DataTrigger></Button.Triggers>
                </Button>
                <Button Text="Membership" Style="{StaticResource FilterChip}" Margin="0,0,8,8" Command="{Binding SetKindCommand}" CommandParameter="Membership">
                    <Button.Triggers><DataTrigger TargetType="Button" Binding="{Binding Kind}" Value="Membership"><Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource ChosenLight}, Dark={StaticResource Signal}}" /><Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnChosenLight}, Dark={StaticResource Black}}" /><Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource ChosenLight}, Dark={StaticResource Signal}}" /></DataTrigger></Button.Triggers>
                </Button>
                <Button Text="Amenity" Style="{StaticResource FilterChip}" Margin="0,0,8,8" Command="{Binding SetKindCommand}" CommandParameter="Amenity">
                    <Button.Triggers><DataTrigger TargetType="Button" Binding="{Binding Kind}" Value="Amenity"><Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource ChosenLight}, Dark={StaticResource Signal}}" /><Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnChosenLight}, Dark={StaticResource Black}}" /><Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource ChosenLight}, Dark={StaticResource Signal}}" /></DataTrigger></Button.Triggers>
                </Button>
                <Border Style="{StaticResource Field}" Margin="0,0,0,8">
                    <Picker ItemsSource="{Binding PaidWiths}" SelectedIndex="{Binding PaidWithIndex}" WidthRequest="130"
                            SemanticProperties.Description="Filter by how it was paid" AutomationId="PaymentsPaidWithFilter" />
                </Border>
            </FlexLayout>

            <Border Style="{StaticResource TablePanel}">
                <VerticalStackLayout>
                    <VerticalStackLayout x:Name="PaymentsHead" IsVisible="{OnIdiom Phone=False, Default=True}">
                        <Grid Style="{StaticResource TableHead}" ColumnDefinitions="*,110,100,*,130,170,120,200">
                            <Label Text="Item" Style="{StaticResource Caption}" />
                            <Label Grid.Column="1" Text="Status" Style="{StaticResource Caption}" />
                            <Label Grid.Column="2" Text="Paid with" Style="{StaticResource Caption}" />
                            <Label Grid.Column="3" Text="Details" Style="{StaticResource Caption}" />
                            <Label Grid.Column="4" Text="Payment code" Style="{StaticResource Caption}" />
                            <Label Grid.Column="5" Text="Date" Style="{StaticResource Caption}" />
                            <Label Grid.Column="6" Text="Amount" Style="{StaticResource Caption}" HorizontalOptions="End" />
                        </Grid>
                        <BoxView Style="{StaticResource Hairline}" />
                    </VerticalStackLayout>
                    <c:TableBody Items="{Binding Rows}" Header="{x:Reference PaymentsHead}" WideFrom="1000"
                                 RowTemplate="{StaticResource PaymentRow}" CardTemplate="{StaticResource PaymentCard}">
                        <c:TableBody.Empty><Label Text="{Binding EmptyText, Source={RelativeSource AncestorType={x:Type vm:MyPaymentsViewModel}}}" Style="{StaticResource Muted}" Margin="14" /></c:TableBody.Empty>
                    </c:TableBody>
                </VerticalStackLayout>
            </Border>

            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                <Button Text="Previous" Command="{Binding PreviousCommand}" Style="{StaticResource SmallOutlineButton}" />
                <Label Grid.Column="1" Text="{Binding PageText}" Style="{StaticResource Caption}" HorizontalOptions="Center" VerticalOptions="Center" />
                <Button Grid.Column="2" Text="Next" Command="{Binding NextCommand}" Style="{StaticResource SmallOutlineButton}" />
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</v:BasePage>
