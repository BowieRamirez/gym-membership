<?xml version="1.0" encoding="utf-8" ?>
<v:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
            xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
            xmlns:v="clr-namespace:GymMembership.App.Views"
            xmlns:c="clr-namespace:GymMembership.App.Controls"
            xmlns:vm="clr-namespace:GymMembership.Core.ViewModels;assembly=GymMembership.Core"
            xmlns:svc="clr-namespace:GymMembership.Core.Services;assembly=GymMembership.Core"
            x:Class="GymMembership.App.Views.RequestsPage" x:DataType="vm:RequestsViewModel" Title="Time requests">

    <v:BasePage.Resources>
        <!-- desktop: one table row per request, its buttons at the end -->
        <DataTemplate x:Key="RequestRow" x:DataType="svc:RequestRow">
            <VerticalStackLayout>
                <Grid Style="{StaticResource TableRow}" ColumnDefinitions="*,190,150,130,*,110,340">
                    <Label Text="{Binding With}" FontFamily="BarlowMedium" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="{Binding Request.RequestedStart, Converter={StaticResource LocalDate}, ConverterParameter='ddd d MMM, h:mm tt'}" VerticalOptions="Center" />
                    <Label Grid.Column="2" Text="{Binding Kind}" Style="{StaticResource Muted}" VerticalOptions="Center" />
                    <Label Grid.Column="3" Text="{Binding Amenity}" Style="{StaticResource Muted}" VerticalOptions="Center" />
                    <VerticalStackLayout Grid.Column="4" Spacing="2" VerticalOptions="Center">
                        <Label Text="{Binding Request.Message}" Style="{StaticResource Muted}" LineBreakMode="TailTruncation" />
                        <Label Text="{Binding ProposalText, StringFormat='Proposed: {0}'}" IsVisible="{Binding HasProposal}" />
                    </VerticalStackLayout>
                    <c:StatusChip Grid.Column="5" Status="{Binding Request.Status}" VerticalOptions="Center" />
                    <HorizontalStackLayout Grid.Column="6" Spacing="6" VerticalOptions="Center" HorizontalOptions="End">
                        <Button Text="Approve" Style="{StaticResource SmallButton}" IsVisible="{Binding CanRespond}" Clicked="OnApprove" />
                        <Button Text="Accept" Style="{StaticResource SmallButton}" IsVisible="{Binding CanAccept}" Clicked="OnAccept" />
                        <Button Text="Propose another time" Style="{StaticResource SmallOutlineButton}" IsVisible="{Binding CanPropose}" Clicked="OnPropose" />
                        <Button Text="Ask for another time" Style="{StaticResource SmallOutlineButton}" IsVisible="{Binding CanAccept}" Clicked="OnAnother" />
                        <Button Text="Decline" Style="{StaticResource SmallOutlineButton}" IsVisible="{Binding CanDecline}" Clicked="OnDecline" />
                        <Button Text="Cancel request" Style="{StaticResource SmallOutlineButton}" IsVisible="{Binding CanCancel}" Clicked="OnCancel" />
                    </HorizontalStackLayout>
                </Grid>
                <BoxView Style="{StaticResource Hairline}" />
            </VerticalStackLayout>
        </DataTemplate>
        <!-- phone and narrow windows: who and the status; when and what kind; the amenity, message and proposal only when there are any; actions as chips -->
        <DataTemplate x:Key="RequestCard" x:DataType="svc:RequestRow">
            <VerticalStackLayout>
                <VerticalStackLayout Spacing="4" Padding="14,12">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <Label Text="{Binding With}" FontFamily="BarlowSemiBold" VerticalOptions="Center" />
                        <c:StatusChip Grid.Column="1" Status="{Binding Request.Status}" VerticalOptions="Center" />
                    </Grid>
                    <Label Style="{StaticResource Caption}">
                        <Label.Text>
                            <MultiBinding StringFormat="{}{0}  ·  {1}">
                                <Binding Path="Request.RequestedStart" Converter="{StaticResource LocalDate}" ConverterParameter="ddd d MMM, h:mm tt" />
                                <Binding Path="Kind" />
                            </MultiBinding>
                        </Label.Text>
                    </Label>
                    <Label Text="{Binding Amenity, StringFormat='At {0}'}" Style="{StaticResource Caption}" IsVisible="{Binding Amenity, Converter={StaticResource HasText}}" />
                    <Label Text="{Binding Request.Message}" Style="{StaticResource Muted}" FontSize="15" IsVisible="{Binding Request.Message, Converter={StaticResource HasText}}" />
                    <Label Text="{Binding ProposalText, StringFormat='Proposed: {0}'}" FontFamily="BarlowMedium" IsVisible="{Binding HasProposal}" />
                    <FlexLayout Wrap="Wrap" Margin="0,4,0,0">
                        <Button Text="Approve" Style="{StaticResource FilterChipOn}" Margin="0,0,8,8" IsVisible="{Binding CanRespond}" Clicked="OnApprove" />
                        <Button Text="Accept" Style="{StaticResource FilterChipOn}" Margin="0,0,8,8" IsVisible="{Binding CanAccept}" Clicked="OnAccept" />
                        <Button Text="Propose another time" Style="{StaticResource FilterChip}" Margin="0,0,8,8" IsVisible="{Binding CanPropose}" Clicked="OnPropose" />
                        <Button Text="Ask for another time" Style="{StaticResource FilterChip}" Margin="0,0,8,8" IsVisible="{Binding CanAccept}" Clicked="OnAnother" />
                        <Button Text="Decline" Style="{StaticResource FilterChip}" Margin="0,0,8,8" IsVisible="{Binding CanDecline}" Clicked="OnDecline" />
                        <Button Text="Cancel request" Style="{StaticResource FilterChip}" Margin="0,0,8,8" IsVisible="{Binding CanCancel}" Clicked="OnCancel" />
                    </FlexLayout>
                </VerticalStackLayout>
                <BoxView Style="{StaticResource Hairline}" />
            </VerticalStackLayout>
        </DataTemplate>
    </v:BasePage.Resources>

    <ScrollView MaximumWidthRequest="{StaticResource PageWidth}">
        <VerticalStackLayout Padding="{OnIdiom Phone='16,12,16,24', Default='16,12,16,20'}" Spacing="12">
            <c:Banner Message="{Binding ErrorMessage}" />
            <c:Banner Kind="notice" Message="{Binding Notice}" />

            <!-- the requests first, then the form (which can be a long dead form while a session is booked); stacked, the form stops at a readable width -->
            <c:SideLayout SideFirst="False" StackedSideWidth="640">
                <!-- main: the requests waiting for a reply -->
                <VerticalStackLayout Spacing="10">
                    <!-- Windows only: the list and Sessions say the same on a phone -->
                    <c:CardGrid Columns="2" MinColumnWidth="180" IsVisible="{OnIdiom Phone=False, Default=True}">
                        <Border Style="{StaticResource Panel}">
                            <VerticalStackLayout Spacing="8">
                                <c:CardTitle Text="Waiting for a reply" />
                                <Label Text="{Binding WaitingText}" Style="{StaticResource KpiValue}" />
                            </VerticalStackLayout>
                        </Border>
                        <Border Style="{StaticResource Panel}">
                            <VerticalStackLayout Spacing="8">
                                <c:CardTitle Text="Next session" />
                                <Label Text="{Binding NextSessionText}" Style="{StaticResource KpiValue}" />
                            </VerticalStackLayout>
                        </Border>
                    </c:CardGrid>
                    <HorizontalStackLayout Spacing="12">
                        <Label Text="Open requests" Style="{StaticResource SectionTitle}" Margin="0" VerticalOptions="Center" />
                        <Button Text="Refresh requests" Style="{StaticResource SmallOutlineButton}" VerticalOptions="Center"
                                Command="{Binding LoadCommand}" IsVisible="{Binding UseWindowsRequestForm}" AutomationId="RefreshSessionRequests" />
                    </HorizontalStackLayout>
                    <Border Style="{StaticResource TablePanel}">
                        <VerticalStackLayout>
                            <VerticalStackLayout x:Name="RequestsHead" IsVisible="{OnIdiom Phone=False, Default=True}">
                                <Grid Style="{StaticResource TableHead}" ColumnDefinitions="*,190,150,130,*,110,340">
                                    <Label Text="With" Style="{StaticResource Caption}" />
                                    <Label Grid.Column="1" Text="When" Style="{StaticResource Caption}" />
                                    <Label Grid.Column="2" Text="Type" Style="{StaticResource Caption}" />
                                    <Label Grid.Column="3" Text="Amenity" Style="{StaticResource Caption}" />
                                    <Label Grid.Column="4" Text="Message" Style="{StaticResource Caption}" />
                                    <Label Grid.Column="5" Text="Status" Style="{StaticResource Caption}" />
                                </Grid>
                                <BoxView Style="{StaticResource Hairline}" />
                            </VerticalStackLayout>
                            <c:TableBody BindableLayout.ItemsSource="{Binding Requests}" Header="{x:Reference RequestsHead}" WideFrom="1300"
                                         RowTemplate="{StaticResource RequestRow}" CardTemplate="{StaticResource RequestCard}"
                                         BindableLayout.ItemTemplate="{OnIdiom Phone={StaticResource RequestCard}, Default={StaticResource RequestRow}}">
                                <BindableLayout.EmptyView><Label Text="Nothing pending." Style="{StaticResource Muted}" Margin="14" /></BindableLayout.EmptyView>
                            </c:TableBody>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- side: answering a request, the request form, or why there is no form -->
                <VerticalStackLayout Spacing="12">
                    <Border Style="{StaticResource SidePanel}" IsVisible="{Binding IsResponding}">
                                    <VerticalStackLayout Spacing="10">
                                        <c:CardTitle Text="{Binding ResponseTitle}" />
                                        <FlexLayout Wrap="Wrap" AlignItems="End" IsVisible="{Binding ResponseNeedsTime}">
                                            <VerticalStackLayout Spacing="4" Margin="0,0,12,8">
                                                <Label Text="Date" Style="{StaticResource Caption}" />
                                                <Border Style="{StaticResource Field}"><DatePicker Date="{Binding ResponseDate}" MinimumDate="{x:Static x:DateTime.Today}" /></Border>
                                            </VerticalStackLayout>
                                            <VerticalStackLayout Spacing="4" Margin="0,0,12,8">
                                                <Label Text="Start" Style="{StaticResource Caption}" />
                                                <Border Style="{StaticResource Field}"><TimePicker Time="{Binding ResponseTime}" /></Border>
                                            </VerticalStackLayout>
                                            <VerticalStackLayout Spacing="4" Margin="0,0,12,8">
                                                <Label Text="Minutes" Style="{StaticResource Caption}" />
                                                <Border Style="{StaticResource Field}"><Picker ItemsSource="{Binding Durations}" SelectedItem="{Binding ResponseDuration}" WidthRequest="90" /></Border>
                                            </VerticalStackLayout>
                                            <VerticalStackLayout Spacing="4" Margin="0,0,0,8">
                                                <Label Text="Amenity" Style="{StaticResource Caption}" />
                                                <Border Style="{StaticResource Field}">
                                                    <Picker ItemsSource="{Binding AmenityChoices}" ItemDisplayBinding="{Binding Name}" SelectedItem="{Binding ResponseAmenity}" WidthRequest="180"
                                                            SemanticProperties.Description="Amenity for the session" />
                                                </Border>
                                            </VerticalStackLayout>
                                        </FlexLayout>
                                        <Border Style="{StaticResource Field}"><Entry Text="{Binding ResponseReason}" Placeholder="{Binding ResponseReasonHint}" /></Border>
                                        <HorizontalStackLayout Spacing="8">
                                            <Button Text="{Binding ResponseSubmitText}" Style="{StaticResource SmallButton}" Command="{Binding SubmitResponseCommand}" />
                                            <Button Text="Close" Style="{StaticResource SmallOutlineButton}" Command="{Binding CloseResponseCommand}" />
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>
                                </Border>

                    <!-- Compose -->
                                <Border Style="{StaticResource SidePanel}" IsVisible="{Binding CanCompose}">
                                    <VerticalStackLayout Spacing="12">
                                        <c:CardTitle Text="{Binding ComposeTitle}" />
                                        <VerticalStackLayout Spacing="4" IsVisible="{Binding ShowMemberPicker}">
                                            <Label Text="Member" Style="{StaticResource Caption}" />
                                            <Border Style="{StaticResource Field}">
                                                <Picker ItemsSource="{Binding Members}" ItemDisplayBinding="{Binding Name}" SelectedItem="{Binding SelectedMember}"
                                                        Title="Choose a member" AutomationId="RequestMemberPicker" SemanticProperties.Description="Member to invite" />
                                            </Border>
                                            <Label Text="{Binding MemberPickerHint}" Style="{StaticResource Caption}" />
                                        </VerticalStackLayout>

                                        <VerticalStackLayout Spacing="4" IsVisible="{Binding IsCoach, Converter={StaticResource Not}}">
                                            <Label Text="Coach" Style="{StaticResource Caption}" />
                                            <Border Style="{StaticResource Field}">
                                                <Picker ItemsSource="{Binding Coaches}" ItemDisplayBinding="{Binding Name}" SelectedItem="{Binding SelectedCoach}"
                                                        SemanticProperties.Description="Coach" />
                                            </Border>
                                        </VerticalStackLayout>

                                        <FlexLayout Wrap="Wrap" AlignItems="End">
                                            <VerticalStackLayout Spacing="4" Margin="0,0,16,8">
                                                <Label Text="Date" Style="{StaticResource Caption}" />
                                                <Border Style="{StaticResource Field}"><DatePicker Date="{Binding Date}" MinimumDate="{x:Static x:DateTime.Today}" /></Border>
                                            </VerticalStackLayout>
                                            <VerticalStackLayout Spacing="4" Margin="0,0,16,8">
                                                <Label Text="Start time" Style="{StaticResource Caption}" />
                                                <Border Style="{StaticResource Field}"><TimePicker Time="{Binding Time}" /></Border>
                                            </VerticalStackLayout>
                                            <VerticalStackLayout Spacing="4" Margin="0,0,0,8">
                                                <Label Text="Minutes" Style="{StaticResource Caption}" />
                                                <Border Style="{StaticResource Field}">
                                                    <Picker ItemsSource="{Binding Durations}" SelectedItem="{Binding DurationMinutes}" WidthRequest="90" />
                                                </Border>
                                            </VerticalStackLayout>
                                            <!-- members: a session can use an amenity; it then follows the booking grid and gym hours -->
                                            <VerticalStackLayout Spacing="4" Margin="0,0,0,8" IsVisible="{Binding IsCoach, Converter={StaticResource Not}}">
                                                <Label Text="Amenity" Style="{StaticResource Caption}" />
                                                <Border Style="{StaticResource Field}">
                                                    <Picker ItemsSource="{Binding AmenityChoices}" ItemDisplayBinding="{Binding Name}" SelectedItem="{Binding SelectedAmenity}" WidthRequest="180"
                                                            SemanticProperties.Description="Amenity for the session" />
                                                </Border>
                                            </VerticalStackLayout>
                                        </FlexLayout>

                                        <VerticalStackLayout Spacing="4" IsVisible="{Binding IsCoach, Converter={StaticResource Not}}">
                                            <Label Text="Message (optional)" Style="{StaticResource Caption}" />
                                            <Border Style="{StaticResource Field}"><Entry Text="{Binding Message}" /></Border>
                                        </VerticalStackLayout>

                                        <Label Text="You already have a session booked with this coach. Request another after it ends, or change it in Sessions."
                                               Style="{StaticResource Muted}" IsVisible="{Binding ShowActiveSession}" AutomationId="ActiveSessionRequestHint" />
                                        <Label Text="Your request to this coach is still waiting. Cancel it in the list to send a different one."
                                               Style="{StaticResource Muted}" IsVisible="{Binding ShowPendingRequest}" AutomationId="PendingSessionRequestHint" />
                                        <Button Text="{Binding SubmitText}" Style="{StaticResource SmallButton}" HorizontalOptions="Start"
                                                Command="{Binding SubmitCommand}" AutomationId="SubmitSessionRequest" />
                                    </VerticalStackLayout>
                                </Border>
                    <Label Text="Hire a coach first, then you can request sessions here." Style="{StaticResource Muted}"
                           IsVisible="{Binding CanCompose, Converter={StaticResource Not}}" />
                </VerticalStackLayout>
            </c:SideLayout>
        </VerticalStackLayout>
    </ScrollView>
</v:BasePage>
