<?xml version="1.0" encoding="utf-8" ?>
<v:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
            xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
            xmlns:v="clr-namespace:GymMembership.App.Views"
            xmlns:c="clr-namespace:GymMembership.App.Controls"
            xmlns:vm="clr-namespace:GymMembership.Core.ViewModels;assembly=GymMembership.Core"
            xmlns:svc="clr-namespace:GymMembership.Core.Services;assembly=GymMembership.Core"
            x:Class="GymMembership.App.Views.SessionsPage" x:DataType="vm:SessionsViewModel" Title="Sessions">

    <v:BasePage.Resources>
        <!-- desktop: one table row per session, its buttons at the end -->
        <DataTemplate x:Key="SessionRow" x:DataType="svc:SessionRow">
            <VerticalStackLayout>
                <Grid Style="{StaticResource TableRow}" ColumnDefinitions="*,*,230,120,120,470">
                    <Label Text="{Binding Session.Title}" FontFamily="BarlowMedium" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="{Binding With}" VerticalOptions="Center" />
                    <Label Grid.Column="2" VerticalOptions="Center">
                        <Label.Text>
                            <MultiBinding StringFormat="{}{0} to {1}">
                                <Binding Path="Session.ScheduledStart" Converter="{StaticResource LocalDate}" ConverterParameter="ddd d MMM, h:mm tt" />
                                <Binding Path="Session.ScheduledEnd" Converter="{StaticResource LocalDate}" ConverterParameter="h:mm tt" />
                            </MultiBinding>
                        </Label.Text>
                    </Label>
                    <Label Grid.Column="3" Text="{Binding Amenity}" Style="{StaticResource Muted}" VerticalOptions="Center" />
                    <c:StatusChip Grid.Column="4" Status="{Binding Session.Status}" VerticalOptions="Center" />
                    <HorizontalStackLayout Grid.Column="5" Spacing="6" VerticalOptions="Center" HorizontalOptions="End">
                        <Button Text="Add 30 minutes" Style="{StaticResource SmallOutlineButton}" IsVisible="{Binding CanExtend}" Clicked="OnExtend"
                                SemanticProperties.Hint="Extends this session and its amenity booking by 30 minutes" />
                        <Button Text="Mark complete" Style="{StaticResource SmallOutlineButton}" IsVisible="{Binding CanManage}" Clicked="OnComplete" />
                        <Button Text="No-show" Style="{StaticResource SmallOutlineButton}" IsVisible="{Binding CanManage}" Clicked="OnNoShow" />
                        <Button Text="Reschedule" Style="{StaticResource SmallOutlineButton}" IsVisible="{Binding CanChange}" Clicked="OnStartReschedule" />
                        <Button Text="Cancel session" Style="{StaticResource SmallOutlineButton}" IsVisible="{Binding CanChange}" Clicked="OnCancel" />
                    </HorizontalStackLayout>
                </Grid>
                <BoxView Style="{StaticResource Hairline}" />
            </VerticalStackLayout>
        </DataTemplate>
        <!-- phone and narrow windows: two lines (title and status; when and with whom), the amenity only when there is one, actions as chips -->
        <DataTemplate x:Key="SessionCard" x:DataType="svc:SessionRow">
            <VerticalStackLayout>
                <VerticalStackLayout Spacing="4" Padding="14,12">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <Label Text="{Binding Session.Title}" FontFamily="BarlowSemiBold" VerticalOptions="Center" />
                        <c:StatusChip Grid.Column="1" Status="{Binding Session.Status}" VerticalOptions="Center" />
                    </Grid>
                    <Label Style="{StaticResource Caption}">
                        <Label.Text>
                            <MultiBinding StringFormat="{}{0} to {1}  ·  {2}">
                                <Binding Path="Session.ScheduledStart" Converter="{StaticResource LocalDate}" ConverterParameter="ddd d MMM, h:mm tt" />
                                <Binding Path="Session.ScheduledEnd" Converter="{StaticResource LocalDate}" ConverterParameter="h:mm tt" />
                                <Binding Path="With" />
                            </MultiBinding>
                        </Label.Text>
                    </Label>
                    <Label Text="{Binding Amenity, StringFormat='At {0}'}" Style="{StaticResource Caption}" IsVisible="{Binding Amenity, Converter={StaticResource HasText}}" />
                    <FlexLayout Wrap="Wrap" Margin="0,4,0,0">
                        <Button Text="Add 30 minutes" Style="{StaticResource FilterChip}" Margin="0,0,8,8" IsVisible="{Binding CanExtend}" Clicked="OnExtend"
                                SemanticProperties.Hint="Extends this session and its amenity booking by 30 minutes" />
                        <Button Text="Mark complete" Style="{StaticResource FilterChip}" Margin="0,0,8,8" IsVisible="{Binding CanManage}" Clicked="OnComplete" />
                        <Button Text="No-show" Style="{StaticResource FilterChip}" Margin="0,0,8,8" IsVisible="{Binding CanManage}" Clicked="OnNoShow" />
                        <Button Text="Reschedule" Style="{StaticResource FilterChip}" Margin="0,0,8,8" IsVisible="{Binding CanChange}" Clicked="OnStartReschedule" />
                        <Button Text="Cancel session" Style="{StaticResource FilterChip}" Margin="0,0,8,8" IsVisible="{Binding CanChange}" Clicked="OnCancel" />
                    </FlexLayout>
                </VerticalStackLayout>
                <BoxView Style="{StaticResource Hairline}" />
            </VerticalStackLayout>
        </DataTemplate>
    </v:BasePage.Resources>

    <ScrollView MaximumWidthRequest="{StaticResource PageWidth}">
        <VerticalStackLayout Padding="{OnIdiom Phone='16,12,16,24', Default='16,12,16,20'}" Spacing="12">
            <c:Banner Message="{Binding ErrorMessage}" />
            <c:Banner Kind="notice" Message="{Binding Notice}" />

            <c:SideLayout StackedSideWidth="600">
                <VerticalStackLayout Spacing="4">
                <!-- status filter chips; they wrap onto a second line on a narrow phone; the yellow one is in use -->
                <FlexLayout Wrap="Wrap">
                        <Button Text="All" Style="{StaticResource FilterChip}" Margin="0,0,8,8" Command="{Binding SetFilterCommand}" CommandParameter="All">
                            <Button.Triggers><DataTrigger TargetType="Button" Binding="{Binding Filter}" Value="All"><Setter Property="Style" Value="{StaticResource FilterChipOn}" /></DataTrigger></Button.Triggers>
                        </Button>
                        <Button Text="Scheduled" Style="{StaticResource FilterChip}" Margin="0,0,8,8" Command="{Binding SetFilterCommand}" CommandParameter="Scheduled">
                            <Button.Triggers><DataTrigger TargetType="Button" Binding="{Binding Filter}" Value="Scheduled"><Setter Property="Style" Value="{StaticResource FilterChipOn}" /></DataTrigger></Button.Triggers>
                        </Button>
                        <Button Text="Completed" Style="{StaticResource FilterChip}" Margin="0,0,8,8" Command="{Binding SetFilterCommand}" CommandParameter="Completed">
                            <Button.Triggers><DataTrigger TargetType="Button" Binding="{Binding Filter}" Value="Completed"><Setter Property="Style" Value="{StaticResource FilterChipOn}" /></DataTrigger></Button.Triggers>
                        </Button>
                        <Button Text="Cancelled or no-show" Style="{StaticResource FilterChip}" Margin="0,0,8,8" Command="{Binding SetFilterCommand}" CommandParameter="Cancelled">
                            <Button.Triggers><DataTrigger TargetType="Button" Binding="{Binding Filter}" Value="Cancelled"><Setter Property="Style" Value="{StaticResource FilterChipOn}" /></DataTrigger></Button.Triggers>
                        </Button>
                </FlexLayout>
                <Border Style="{StaticResource TablePanel}">
                    <VerticalStackLayout>
                        <VerticalStackLayout x:Name="SessionsHead" IsVisible="{OnIdiom Phone=False, Default=True}">
                            <Grid Style="{StaticResource TableHead}" ColumnDefinitions="*,*,230,120,120,470">
                                <Label Text="Session" Style="{StaticResource Caption}" />
                                <Label Grid.Column="1" Text="With" Style="{StaticResource Caption}" />
                                <Label Grid.Column="2" Text="When" Style="{StaticResource Caption}" />
                                <Label Grid.Column="3" Text="Amenity" Style="{StaticResource Caption}" />
                                <Label Grid.Column="4" Text="Status" Style="{StaticResource Caption}" />
                            </Grid>
                            <BoxView Style="{StaticResource Hairline}" />
                        </VerticalStackLayout>
                        <!-- a table from 1300 px of table width; narrower, the phone cards -->
                        <c:TableBody BindableLayout.ItemsSource="{Binding Sessions}" Header="{x:Reference SessionsHead}" WideFrom="1300"
                                     RowTemplate="{StaticResource SessionRow}" CardTemplate="{StaticResource SessionCard}"
                                     BindableLayout.ItemTemplate="{OnIdiom Phone={StaticResource SessionCard}, Default={StaticResource SessionRow}}">
                            <BindableLayout.EmptyView><Label Text="{Binding EmptyText, Source={RelativeSource AncestorType={x:Type vm:SessionsViewModel}}}" Style="{StaticResource Muted}" Margin="14" /></BindableLayout.EmptyView>
                        </c:TableBody>
                    </VerticalStackLayout>
                </Border>
                </VerticalStackLayout>

                <!-- the side panel only while a session is being moved; otherwise the list takes the full width. The coach photo
                     prompt lives on My coach profile only (9.6: here it sat above the sessions that needed action). -->
                <VerticalStackLayout Spacing="12" IsVisible="{Binding Rescheduling, Converter={StaticResource IsNotNull}}">
                    <Border Style="{StaticResource SidePanel}">
                        <VerticalStackLayout Spacing="12">
                                <c:CardTitle Text="{Binding Rescheduling.Session.Title, StringFormat='Move “{0}” to a new time'}" />
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="New date" Style="{StaticResource Caption}" />
                                        <Border Style="{StaticResource Field}"><DatePicker Date="{Binding Date}" MinimumDate="{x:Static x:DateTime.Today}" /></Border>
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                                        <Label Text="New start time" Style="{StaticResource Caption}" />
                                        <Border Style="{StaticResource Field}"><TimePicker Time="{Binding Time}" /></Border>
                                    </VerticalStackLayout>
                                </Grid>
                                <Label Text="The session keeps its length. The other person has to approve the new time before it moves." Style="{StaticResource Caption}" />
                                <FlexLayout Wrap="Wrap">
                                    <Button Text="Send new time" Style="{StaticResource SmallButton}" Margin="0,0,8,8" Command="{Binding SendRescheduleCommand}" />
                                    <Button Text="Keep current time" Style="{StaticResource SmallOutlineButton}" Margin="0,0,8,8" Command="{Binding StopRescheduleCommand}" />
                                </FlexLayout>
                            </VerticalStackLayout>
                    </Border>

                </VerticalStackLayout>
            </c:SideLayout>
        </VerticalStackLayout>
    </ScrollView>
</v:BasePage>
