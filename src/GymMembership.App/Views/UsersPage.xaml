<?xml version="1.0" encoding="utf-8" ?>
<v:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
            xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
            xmlns:v="clr-namespace:GymMembership.App.Views"
            xmlns:c="clr-namespace:GymMembership.App.Controls"
            xmlns:vm="clr-namespace:GymMembership.Core.ViewModels;assembly=GymMembership.Core"
            xmlns:svc="clr-namespace:GymMembership.Core.Services;assembly=GymMembership.Core"
            x:Class="GymMembership.App.Views.UsersPage" x:DataType="vm:UsersViewModel" Title="Users and roles">

    <v:BasePage.Resources>
        <!-- one account: name, role, status, then the actions menu (role, password, name, deactivate, delete) -->
        <DataTemplate x:Key="AccountRow" x:DataType="svc:UserRow">
            <VerticalStackLayout>
                <Grid Style="{StaticResource TableRow}" ColumnDefinitions="*,*,110,100">
                    <VerticalStackLayout VerticalOptions="Center">
                        <Label Text="{Binding Username}" FontFamily="BarlowSemiBold" />
                        <Label Text="Last name missing" Style="{StaticResource Caption}" IsVisible="{Binding NameIncomplete}" />
                    </VerticalStackLayout>
                    <Label Grid.Column="1" Text="{Binding RoleText}" Style="{StaticResource Muted}" VerticalOptions="Center" />
                    <c:StatusChip Grid.Column="2" Status="{Binding ActiveStatus}" VerticalOptions="Center" />
                    <Button Grid.Column="3" Text="Actions" Style="{StaticResource SmallOutlineButton}" HorizontalOptions="End" VerticalOptions="Center"
                            Clicked="OnAccountActions" AutomationId="UserAccountActions"
                            SemanticProperties.Description="{Binding Username, StringFormat='Actions for {0}'}" SemanticProperties.Hint="Role, password and account actions" />
                </Grid>
                <BoxView Style="{StaticResource Hairline}" />
            </VerticalStackLayout>
        </DataTemplate>
        <DataTemplate x:Key="AccountCard" x:DataType="svc:UserRow">
            <VerticalStackLayout>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Padding="14,10">
                    <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                        <Label Text="{Binding Username}" FontFamily="BarlowSemiBold" />
                        <Label Text="Last name missing" Style="{StaticResource Caption}" IsVisible="{Binding NameIncomplete}" />
                        <Label Text="{Binding RoleText}" Style="{StaticResource Caption}" />
                        <c:StatusChip Status="{Binding ActiveStatus}" />
                    </VerticalStackLayout>
                    <Button Grid.Column="1" Text="Actions" Style="{StaticResource SmallOutlineButton}" VerticalOptions="Center"
                            Clicked="OnAccountActions" AutomationId="UserAccountActions"
                            SemanticProperties.Description="{Binding Username, StringFormat='Actions for {0}'}" SemanticProperties.Hint="Role, password and account actions" />
                </Grid>
                <BoxView Style="{StaticResource Hairline}" />
            </VerticalStackLayout>
        </DataTemplate>
    </v:BasePage.Resources>

    <ScrollView MaximumWidthRequest="{StaticResource PageWidth}">
        <VerticalStackLayout Padding="{OnIdiom Phone='20,16,20,24', Default='16,12,16,20'}" Spacing="14">
            <Label Text="Share the email and temporary password with the person so they can sign in." Style="{StaticResource Muted}" />
            <c:Banner Message="{Binding ErrorMessage}" />
            <c:Banner Kind="notice" Message="{Binding Notice}" />

            <Border Style="{StaticResource Panel}" IsVisible="{Binding Resetting, Converter={StaticResource IsNotNull}}">
                <VerticalStackLayout Spacing="10">
                    <c:CardTitle Text="{Binding Resetting.Username, StringFormat='Reset password for {0}'}" />
                    <Label Text="Set a new temporary password of 8 to 64 characters, with a letter and a number, and share it with them. The old one stops working." Style="{StaticResource Caption}" />
                    <Border Style="{StaticResource Field}" WidthRequest="240" HorizontalOptions="Start">
                        <Grid ColumnDefinitions="*,Auto"><Entry x:Name="ResetPasswordBox" Text="{Binding ResetPassword}" IsPassword="True" SemanticProperties.Description="New temporary password" /><c:EyeButton Grid.Column="1" Entry="{x:Reference ResetPasswordBox}" /></Grid>
                    </Border>
                    <HorizontalStackLayout Spacing="8">
                        <Button Text="Set password" Style="{StaticResource SmallButton}" Command="{Binding ConfirmResetCommand}" />
                        <Button Text="Cancel" Style="{StaticResource SmallOutlineButton}" Command="{Binding StopResetCommand}" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Panel}" IsVisible="{Binding Correcting, Converter={StaticResource IsNotNull}}">
                <VerticalStackLayout Spacing="10">
                    <c:CardTitle Text="{Binding Correcting.Username, StringFormat='Correct the name of {0}'}" />
                    <Label Text="Names are locked after sign-up. Use this only to fix a mistake. The old name, the new name and your reason go in the audit log." Style="{StaticResource Caption}" />
                    <FlexLayout Wrap="Wrap" AlignItems="End">
                        <VerticalStackLayout Spacing="4" Margin="0,0,12,8" WidthRequest="180">
                            <Label Text="First name" Style="{StaticResource Caption}" />
                            <Border Style="{StaticResource Field}"><Entry Text="{Binding CorrectFirstName}" MaxLength="{x:Static svc:AccountRules.MaxName}" SemanticProperties.Description="Corrected first name" AutomationId="CorrectFirstName" /></Border>
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="4" Margin="0,0,12,8" WidthRequest="180">
                            <Label Text="Last name" Style="{StaticResource Caption}" />
                            <Border Style="{StaticResource Field}"><Entry Text="{Binding CorrectLastName}" MaxLength="{x:Static svc:AccountRules.MaxName}" SemanticProperties.Description="Corrected last name" AutomationId="CorrectLastName" /></Border>
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="4" Margin="0,0,12,8" WidthRequest="372">
                            <Label Text="Reason" Style="{StaticResource Caption}" />
                            <Border Style="{StaticResource Field}"><Entry Text="{Binding CorrectReason}" MaxLength="500" ReturnCommand="{Binding ConfirmCorrectNameCommand}" SemanticProperties.Description="Reason for the correction" AutomationId="CorrectReason" /></Border>
                        </VerticalStackLayout>
                    </FlexLayout>
                    <HorizontalStackLayout Spacing="8">
                        <Button Text="Correct name" Style="{StaticResource SmallButton}" Command="{Binding ConfirmCorrectNameCommand}" AutomationId="ConfirmCorrectName" />
                        <Button Text="Cancel" Style="{StaticResource SmallOutlineButton}" Command="{Binding StopCorrectNameCommand}" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Panel}">
                <VerticalStackLayout Spacing="12">
                    <c:CardTitle Text="{Binding AddTitle}" />
                    <Label Text="The temporary password needs 8 to 64 characters, with a letter and a number." Style="{StaticResource Caption}" />
                    <FlexLayout Wrap="Wrap" AlignItems="End">
                        <VerticalStackLayout Spacing="4" Margin="0,0,12,8" WidthRequest="180">
                            <Label Text="First name" Style="{StaticResource Caption}" />
                            <Border Style="{StaticResource Field}"><Entry Text="{Binding NewFirstName}" SemanticProperties.Description="First name" /></Border>
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="4" Margin="0,0,12,8" WidthRequest="180">
                            <Label Text="Last name" Style="{StaticResource Caption}" />
                            <Border Style="{StaticResource Field}"><Entry Text="{Binding NewLastName}" SemanticProperties.Description="Last name" /></Border>
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="4" Margin="0,0,12,8" WidthRequest="240">
                            <Label Text="Email" Style="{StaticResource Caption}" />
                            <Border Style="{StaticResource Field}"><Entry Text="{Binding NewEmail}" Keyboard="Email" SemanticProperties.Description="Email" /></Border>
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="4" Margin="0,0,12,8" WidthRequest="180">
                            <Label Text="Temporary password" Style="{StaticResource Caption}" />
                            <Border Style="{StaticResource Field}"><Grid ColumnDefinitions="*,Auto"><Entry x:Name="NewPasswordBox" Text="{Binding NewPassword}" IsPassword="True" SemanticProperties.Description="Temporary password" /><c:EyeButton Grid.Column="1" Entry="{x:Reference NewPasswordBox}" /></Grid></Border>
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="4" Margin="0,0,12,8" WidthRequest="130">
                            <Label Text="Role" Style="{StaticResource Caption}" />
                            <Border Style="{StaticResource Field}"><Picker ItemsSource="{Binding Roles}" SelectedItem="{Binding NewRole}" SemanticProperties.Description="Role" /></Border>
                        </VerticalStackLayout>
                        <Button Text="Add user" Style="{StaticResource SmallButton}" Margin="0,0,0,8" Command="{Binding AddUserCommand}" />
                    </FlexLayout>
                </VerticalStackLayout>
            </Border>

            <!-- 9.8: the accounts as a table (hairline rows in one panel, a header), each row's menu a labelled "Actions" button (was a "⋮"
                 glyph); the menu itself is unchanged (owner, D28). AutomationId stays: scripts/Test-WindowsArchive.ps1 uses it. -->
            <!-- item 3 (0059): accounts with no last name, for a System admin to correct with Actions > Correct name; shown only when there are some -->
            <Grid ColumnDefinitions="*,Auto">
                <Label Text="Active accounts" Style="{StaticResource SectionTitle}" VerticalOptions="Center" />
                <Button Grid.Column="1" Text="{Binding IncompleteText}" Style="{StaticResource FilterChip}" Command="{Binding ToggleIncompleteCommand}"
                        IsVisible="{Binding HasIncomplete}" AutomationId="NameIncompleteFilter" VerticalOptions="Center"
                        SemanticProperties.Hint="Shows only the accounts with no last name, or every account again">
                    <Button.Triggers><DataTrigger TargetType="Button" Binding="{Binding OnlyIncomplete}" Value="True"><Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource ChosenLight}, Dark={StaticResource Signal}}" /><Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnChosenLight}, Dark={StaticResource Black}}" /><Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource ChosenLight}, Dark={StaticResource Signal}}" /></DataTrigger></Button.Triggers>
                </Button>
            </Grid>
            <Border Style="{StaticResource TablePanel}">
                <VerticalStackLayout>
                    <VerticalStackLayout x:Name="AccountHead">
                        <Grid Style="{StaticResource TableHead}" ColumnDefinitions="*,*,110,100">
                            <Label Text="Name" Style="{StaticResource Caption}" />
                            <Label Grid.Column="1" Text="Role" Style="{StaticResource Caption}" />
                            <Label Grid.Column="2" Text="Status" Style="{StaticResource Caption}" />
                        </Grid>
                        <BoxView Style="{StaticResource Hairline}" />
                    </VerticalStackLayout>
                    <c:TableBody BindableLayout.ItemsSource="{Binding Users}" Header="{x:Reference AccountHead}" WideFrom="700"
                                 RowTemplate="{StaticResource AccountRow}" CardTemplate="{StaticResource AccountCard}"
                                 BindableLayout.ItemTemplate="{OnIdiom Phone={StaticResource AccountCard}, Default={StaticResource AccountRow}}">
                        <BindableLayout.EmptyView><Label Text="No active accounts." Style="{StaticResource Muted}" Margin="14" /></BindableLayout.EmptyView>
                    </c:TableBody>
                </VerticalStackLayout>
            </Border>

            <Label Text="Deactivated accounts" Style="{StaticResource SectionTitle}" />
            <Label Text="Switched off, not deleted. Reactivate someone to let them sign in again." Style="{StaticResource Caption}" />
            <Border Style="{StaticResource TablePanel}">
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Deactivated}" BindableLayout.ItemTemplate="{StaticResource AccountRow}">
                    <BindableLayout.EmptyView><Label Text="No deactivated accounts." Style="{StaticResource Muted}" Margin="14" /></BindableLayout.EmptyView>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</v:BasePage>
