<?xml version="1.0" encoding="utf-8" ?>
<v:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
            xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
            xmlns:v="clr-namespace:GymMembership.App.Views"
            xmlns:c="clr-namespace:GymMembership.App.Controls"
            xmlns:vm="clr-namespace:GymMembership.Core.ViewModels;assembly=GymMembership.Core"
            xmlns:svc="clr-namespace:GymMembership.Core.Services;assembly=GymMembership.Core"
            xmlns:zxing="clr-namespace:ZXing.Net.Maui.Controls;assembly=ZXing.Net.MAUI.Controls"
            x:Class="GymMembership.App.Views.MyMembershipPage" x:DataType="vm:MyMembershipViewModel" Title="My membership">

    <v:BasePage.Resources>
        <!-- desktop: one table row per paid term -->
        <DataTemplate x:Key="TermRow" x:DataType="svc:TermCard">
            <VerticalStackLayout>
                <Grid Style="{StaticResource TableRow}" ColumnDefinitions="160,*,110,130,210">
                    <Label Text="{Binding Term.PackageName}" FontFamily="BarlowMedium" VerticalOptions="Center" />
                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                        <Label Text="{Binding ShortDates}" />
                        <Label Text="{Binding RefundText}" Style="{StaticResource Caption}" />
                        <Label Text="{Binding Refund.DecisionReason}" Style="{StaticResource Caption}" IsVisible="{Binding Refund.DecisionReason, Converter={StaticResource IsNotNull}}" />
                    </VerticalStackLayout>
                    <c:StatusChip Grid.Column="2" Status="{Binding State}" VerticalOptions="Center" />
                    <Label Grid.Column="3" Text="{Binding Term.AmountPaid, StringFormat='₱{0:N2}'}" FontFamily="BarlowSemiBold" HorizontalOptions="End" VerticalOptions="Center" />
                    <Button Grid.Column="4" Text="Cancel &amp; request refund" Style="{StaticResource SmallOutlineButton}" VerticalOptions="Center" HorizontalOptions="End"
                            IsVisible="{Binding CanRequestRefund}" Clicked="OnRequestRefund" />
                </Grid>
                <BoxView Style="{StaticResource Hairline}" />
            </VerticalStackLayout>
        </DataTemplate>
        <!-- phone and narrow windows: two lines (name and status; days and price), a note only when a refund or cancellation exists.
             The refund dialog explains the outcome, so the row doesn't. -->
        <DataTemplate x:Key="TermCard" x:DataType="svc:TermCard">
            <VerticalStackLayout>
                <VerticalStackLayout Spacing="4" Padding="14,12">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <Label Text="{Binding Term.PackageName}" FontFamily="BarlowSemiBold" VerticalOptions="Center" />
                        <c:StatusChip Grid.Column="1" Status="{Binding State}" VerticalOptions="Center" />
                    </Grid>
                    <Label Style="{StaticResource Caption}">
                        <Label.Text>
                            <MultiBinding StringFormat="{}{0}  ·  ₱{1:N2}">
                                <Binding Path="ShortDates" />
                                <Binding Path="Term.AmountPaid" />
                            </MultiBinding>
                        </Label.Text>
                    </Label>
                    <Label Text="{Binding RefundNote}" Style="{StaticResource Caption}" IsVisible="{Binding RefundNote, Converter={StaticResource IsNotNull}}" />
                    <Label Text="{Binding Refund.DecisionReason}" Style="{StaticResource Caption}" IsVisible="{Binding Refund.DecisionReason, Converter={StaticResource IsNotNull}}" />
                    <Button Text="Cancel &amp; request refund" Style="{StaticResource FilterChip}" HorizontalOptions="Start" Margin="0,6,0,0"
                            IsVisible="{Binding CanRequestRefund}" Clicked="OnRequestRefund" />
                </VerticalStackLayout>
                <BoxView Style="{StaticResource Hairline}" />
            </VerticalStackLayout>
        </DataTemplate>

        <DataTemplate x:Key="PaymentRow" x:DataType="svc:PaymentItem">
            <VerticalStackLayout>
                <Grid Style="{StaticResource TableRow}" ColumnDefinitions="*,110,*,130,170,120,240">
                    <Label Text="{Binding What}" FontFamily="BarlowMedium" VerticalOptions="Center" />
                    <c:StatusChip Grid.Column="1" Status="{Binding Status}" VerticalOptions="Center" />
                    <Label Grid.Column="2" Text="{Binding Detail}" VerticalOptions="Center" />
                    <Label Grid.Column="3" Text="{Binding PaymentCode}" Style="{StaticResource Muted}" VerticalOptions="Center" />
                    <Label Grid.Column="4" Text="{Binding CreatedAt, Converter={StaticResource LocalDate}, ConverterParameter='d MMM yyyy, h:mm tt'}" VerticalOptions="Center" />
                    <Label Grid.Column="5" Text="{Binding Amount, StringFormat='₱{0:N2}'}" FontFamily="BarlowSemiBold" HorizontalOptions="End" VerticalOptions="Center" />
                    <HorizontalStackLayout Grid.Column="6" Spacing="6" VerticalOptions="Center" HorizontalOptions="End">
                        <Button Text="Pay again" Style="{StaticResource SmallOutlineButton}" IsVisible="{Binding CanPayAgain}" Clicked="OnPayAgain" />
                        <Button Text="Cancel payment" Style="{StaticResource SmallOutlineButton}" IsVisible="{Binding CanCancel}" Clicked="OnCancelPayment" />
                    </HorizontalStackLayout>
                </Grid>
                <BoxView Style="{StaticResource Hairline}" />
            </VerticalStackLayout>
        </DataTemplate>
        <!-- phone and narrow windows: what and how much; then the status, the day and the payment code; the receipt or reason only when there is one -->
        <DataTemplate x:Key="PaymentCard" x:DataType="svc:PaymentItem">
            <VerticalStackLayout>
                <VerticalStackLayout Spacing="4" Padding="14,12">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <Label Text="{Binding What}" FontFamily="BarlowSemiBold" />
                        <Label Grid.Column="1" Text="{Binding Amount, StringFormat='₱{0:N2}'}" FontFamily="BarlowSemiBold" />
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <c:StatusChip Status="{Binding Status}" VerticalOptions="Center" />
                        <Label Grid.Column="1" Style="{StaticResource Caption}" VerticalOptions="Center">
                            <Label.Text>
                                <MultiBinding StringFormat="{}{0}  ·  {1}">
                                    <Binding Path="CreatedAt" Converter="{StaticResource LocalDate}" ConverterParameter="d MMM yyyy" />
                                    <Binding Path="PaymentCode" />
                                </MultiBinding>
                            </Label.Text>
                        </Label>
                    </Grid>
                    <Label Text="{Binding Detail}" Style="{StaticResource Caption}" IsVisible="{Binding Detail, Converter={StaticResource HasText}}" />
                    <HorizontalStackLayout Spacing="8" Margin="0,6,0,0" IsVisible="{Binding CanPayAgain}">
                        <Button Text="Pay again" Style="{StaticResource FilterChip}" Clicked="OnPayAgain" />
                    </HorizontalStackLayout>
                    <HorizontalStackLayout Spacing="8" Margin="0,6,0,0" IsVisible="{Binding CanCancel}">
                        <Button Text="Cancel payment" Style="{StaticResource FilterChip}" Clicked="OnCancelPayment" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
                <BoxView Style="{StaticResource Hairline}" />
            </VerticalStackLayout>
        </DataTemplate>
    </v:BasePage.Resources>

    <ScrollView MaximumWidthRequest="{StaticResource PageWidth}">
        <VerticalStackLayout Padding="{OnIdiom Phone='16,12,16,24', Default='16,12,16,20'}" Spacing="12">
            <c:UpdatedBar x:Name="UpdatedLine" />   <!-- F4: when it last loaded, with Refresh; it also reloads by itself on a change -->
            <c:Banner Message="{Binding ErrorMessage}" />
            <c:Banner Kind="notice" Message="{Binding Notice}" />

            <!-- The one memorable moment: days left, the highlight card with a pill bar that runs out; then two plain number cards (Windows).
                 Above the main/side split so it comes first on phones too. Phones (Phase 9, Android mockup): the highlight alone, with
                 the end date and the one action inside it; pending payments show in Pay now and the payments list. -->
            <Grid ColumnDefinitions="{OnIdiom Phone='*', Default='*,*,*'}" ColumnSpacing="12" RowSpacing="12">
                <Border Style="{StaticResource HeroPanel}" Padding="{OnIdiom Phone='18,16', Default='18,14'}">
                    <VerticalStackLayout Spacing="{OnIdiom Phone=4, Default=8}">
                        <c:CardTitle Text="{Binding HeroCaption}" TextColor="{AppThemeBinding Light={StaticResource OnAccentLight}, Dark={StaticResource Black}}" />
                        <!-- the days, end date and lane only while a term runs; otherwise the sentence above and the action say it all -->
                        <Label Text="{Binding HeroNumber}" Style="{StaticResource Numeral}" FontSize="{OnIdiom Phone=56, Default=60}" TextColor="{AppThemeBinding Light={StaticResource OnAccentLight}, Dark={StaticResource Black}}"
                               SemanticProperties.Description="Days left on your membership" IsVisible="{Binding HasActiveTerm}" />
                        <ContentView IsVisible="{OnIdiom Phone=True, Default=False}">
                            <ContentView.Triggers><DataTrigger TargetType="ContentView" Binding="{Binding HasActiveTerm}" Value="False"><Setter Property="IsVisible" Value="False" /></DataTrigger></ContentView.Triggers>
                            <Label Text="{Binding TermEndsText, StringFormat='Ends {0}'}" Style="{StaticResource Caption}" TextColor="{AppThemeBinding Light={StaticResource OnAccentLight}, Dark={StaticResource Black}}" Margin="0,0,0,6" />
                        </ContentView>
                        <c:LaneView IsVisible="{Binding HasActiveTerm}" Fraction="{Binding LaneFraction}" HeightRequest="26" DashColor="{AppThemeBinding Light={StaticResource LaneDashLight}, Dark={StaticResource Black}}" TrackColor="{AppThemeBinding Light={StaticResource LaneTrackLight}, Dark=#D6C700}" />
                        <!-- phones: the one action sits on the highlight card, so a yellow card and a yellow button never stack -->
                        <ContentView IsVisible="{OnIdiom Phone=True, Default=False}">
                            <ContentView.Triggers><DataTrigger TargetType="ContentView" Binding="{Binding PayNow, Converter={StaticResource IsNotNull}}" Value="True"><Setter Property="IsVisible" Value="False" /></DataTrigger></ContentView.Triggers>
                            <Button Text="Choose a package / extend" Style="{StaticResource HeroSmallButton}" Clicked="OnChoosePackage" Margin="0,10,0,0" />
                        </ContentView>
                        <!-- Windows: with nothing running and nothing to pay, the card offers the way in (it was an empty yellow block) -->
                        <ContentView IsVisible="{OnIdiom Phone=False, Default=True}">
                            <ContentView.Triggers><DataTrigger TargetType="ContentView" Binding="{Binding CanStart}" Value="False"><Setter Property="IsVisible" Value="False" /></DataTrigger></ContentView.Triggers>
                            <Button Text="Choose a package" Style="{StaticResource HeroSmallButton}" Clicked="OnChoosePackage" Margin="0,10,0,0" HorizontalOptions="Start" />
                        </ContentView>
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Panel}" IsVisible="{OnIdiom Phone=False, Default=True}">
                    <VerticalStackLayout Spacing="8">
                        <c:CardTitle Text="Current term ends" />
                        <Label Text="{Binding TermEndsText}" Style="{OnIdiom Phone={StaticResource KpiValue}, Default={StaticResource Numeral}}" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Panel}" IsVisible="{OnIdiom Phone=False, Default=True}">
                    <VerticalStackLayout Spacing="8">
                        <c:CardTitle Text="Payments waiting" />
                        <Label Text="{Binding PaymentsWaitingText}" Style="{OnIdiom Phone={StaticResource KpiValue}, Default={StaticResource Numeral}}" />
                        <Label Text="To pay or to be verified" Style="{StaticResource Caption}" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <!-- stacked above the tables, the pay panel and the QR row stop at a readable width -->
            <c:SideLayout StackedSideWidth="600">
                <!-- main: paid terms, payments -->
                <VerticalStackLayout Spacing="12">

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <Label Text="Your paid terms" Style="{StaticResource SectionTitle}" Margin="0" VerticalOptions="Center" />
                        <Button Grid.Column="1" Text="Choose a package / extend" Style="{StaticResource SmallButton}" VerticalOptions="Center" Clicked="OnChoosePackage" IsVisible="{OnIdiom Phone=False, Default=True}">
                            <!-- while a payment waits, paying it is the next step: this one goes quiet -->
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding PayNow, Converter={StaticResource IsNotNull}}" Value="True"><Setter Property="Style" Value="{StaticResource SmallOutlineButton}" /></DataTrigger>
                                <DataTrigger TargetType="Button" Binding="{Binding CanStart}" Value="True"><Setter Property="Style" Value="{StaticResource SmallOutlineButton}" /></DataTrigger>
                            </Button.Triggers>
                        </Button>
                    </Grid>
                    <Border Style="{StaticResource TablePanel}">
                        <VerticalStackLayout>
                            <VerticalStackLayout x:Name="TermsHead" IsVisible="{OnIdiom Phone=False, Default=True}">
                                <Grid Style="{StaticResource TableHead}" ColumnDefinitions="160,*,110,130,210">
                                    <Label Text="Package" Style="{StaticResource Caption}" />
                                    <Label Grid.Column="1" Text="Dates (Manila)" Style="{StaticResource Caption}" />
                                    <Label Grid.Column="2" Text="Status" Style="{StaticResource Caption}" />
                                    <Label Grid.Column="3" Text="Actually paid" Style="{StaticResource Caption}" HorizontalOptions="End" />
                                </Grid>
                                <BoxView Style="{StaticResource Hairline}" />
                            </VerticalStackLayout>
                            <c:TableBody BindableLayout.ItemsSource="{Binding Terms}" Header="{x:Reference TermsHead}" WideFrom="900"
                                         RowTemplate="{StaticResource TermRow}" CardTemplate="{StaticResource TermCard}"
                                         BindableLayout.ItemTemplate="{OnIdiom Phone={StaticResource TermCard}, Default={StaticResource TermRow}}">
                                <BindableLayout.EmptyView>
                                    <Label Text="No paid terms yet. Choose a package, pay and wait for verification." Style="{StaticResource Muted}" Margin="14" />
                                </BindableLayout.EmptyView>
                            </c:TableBody>
                        </VerticalStackLayout>
                    </Border>
                    <!-- the rule under the table it explains, as in the approved mockup; on phones folded behind a link so the screen isn't a wall of text -->
                    <Button Text="How paid terms work" Style="{StaticResource LinkButton}" HorizontalOptions="Start" Margin="-4,-8,0,-8" Clicked="OnToggleTermsRule"
                            IsVisible="{OnIdiom Phone=True, Default=False}" />
                    <Label x:Name="TermsRule" Text="Extensions start after your last paid term. No upgrades or unused-time credits. Other paid terms keep their dates if one is cancelled, so a gap may remain."
                           Style="{StaticResource Caption}" IsVisible="{OnIdiom Phone=False, Default=True}" />

                    <Label Text="Payments" Style="{StaticResource SectionTitle}" Margin="{OnIdiom Phone=0, Default='0,10,0,0'}" />
                    <!-- status filter chips; they wrap onto a second line on a narrow phone; the yellow one is in use -->
                    <FlexLayout Wrap="Wrap">
                            <Button Text="All" Style="{StaticResource FilterChip}" Margin="0,0,8,8" Command="{Binding SetFilterCommand}" CommandParameter="All">
                                <Button.Triggers><DataTrigger TargetType="Button" Binding="{Binding Filter}" Value="All"><Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource ChosenLight}, Dark={StaticResource Signal}}" /><Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnChosenLight}, Dark={StaticResource Black}}" /><Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource ChosenLight}, Dark={StaticResource Signal}}" /></DataTrigger></Button.Triggers>
                            </Button>
                            <Button Text="Verified" Style="{StaticResource FilterChip}" Margin="0,0,8,8" Command="{Binding SetFilterCommand}" CommandParameter="Verified">
                                <Button.Triggers><DataTrigger TargetType="Button" Binding="{Binding Filter}" Value="Verified"><Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource ChosenLight}, Dark={StaticResource Signal}}" /><Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnChosenLight}, Dark={StaticResource Black}}" /><Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource ChosenLight}, Dark={StaticResource Signal}}" /></DataTrigger></Button.Triggers>
                            </Button>
                            <Button Text="Pending" Style="{StaticResource FilterChip}" Margin="0,0,8,8" Command="{Binding SetFilterCommand}" CommandParameter="Pending">
                                <Button.Triggers><DataTrigger TargetType="Button" Binding="{Binding Filter}" Value="Pending"><Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource ChosenLight}, Dark={StaticResource Signal}}" /><Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnChosenLight}, Dark={StaticResource Black}}" /><Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource ChosenLight}, Dark={StaticResource Signal}}" /></DataTrigger></Button.Triggers>
                            </Button>
                            <Button Text="Expired or rejected" Style="{StaticResource FilterChip}" Margin="0,0,8,8" Command="{Binding SetFilterCommand}" CommandParameter="Expired">
                                <Button.Triggers><DataTrigger TargetType="Button" Binding="{Binding Filter}" Value="Expired"><Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource ChosenLight}, Dark={StaticResource Signal}}" /><Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnChosenLight}, Dark={StaticResource Black}}" /><Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource ChosenLight}, Dark={StaticResource Signal}}" /></DataTrigger></Button.Triggers>
                            </Button>
                    </FlexLayout>
                    <Border Style="{StaticResource TablePanel}">
                        <VerticalStackLayout>
                            <VerticalStackLayout x:Name="PaymentsHead" IsVisible="{OnIdiom Phone=False, Default=True}">
                                <Grid Style="{StaticResource TableHead}" ColumnDefinitions="*,110,*,130,170,120,240">
                                    <Label Text="Item" Style="{StaticResource Caption}" />
                                    <Label Grid.Column="1" Text="Status" Style="{StaticResource Caption}" />
                                    <Label Grid.Column="2" Text="Details" Style="{StaticResource Caption}" />
                                    <Label Grid.Column="3" Text="Payment code" Style="{StaticResource Caption}" />
                                    <Label Grid.Column="4" Text="Date" Style="{StaticResource Caption}" />
                                    <Label Grid.Column="5" Text="Amount" Style="{StaticResource Caption}" HorizontalOptions="End" />
                                </Grid>
                                <BoxView Style="{StaticResource Hairline}" />
                            </VerticalStackLayout>
                            <c:TableBody BindableLayout.ItemsSource="{Binding Payments}" Header="{x:Reference PaymentsHead}" WideFrom="1000"
                                         RowTemplate="{StaticResource PaymentRow}" CardTemplate="{StaticResource PaymentCard}"
                                         BindableLayout.ItemTemplate="{OnIdiom Phone={StaticResource PaymentCard}, Default={StaticResource PaymentRow}}">
                                <BindableLayout.EmptyView><Label Text="{Binding PaymentsEmptyText, Source={RelativeSource AncestorType={x:Type vm:MyMembershipViewModel}}}" Style="{StaticResource Muted}" Margin="14" /></BindableLayout.EmptyView>
                            </c:TableBody>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- side: what to pay now (if anything), then the member QR -->
                <VerticalStackLayout Spacing="12">
                    <!-- Pay by QR: the code is what the front desk matches your transfer against, so it is the biggest thing here -->
                    <Border Style="{StaticResource SidePanel}" IsVisible="{Binding PayNow, Converter={StaticResource IsNotNull}}">
                        <VerticalStackLayout Spacing="12">
                            <c:CardTitle Text="{Binding PayNow.Amount, StringFormat='Pay ₱{0:N2} by QR'}" />
                            <Image Source="{Binding QrUrl}" IsVisible="{Binding HasQr}" WidthRequest="168" HeightRequest="168" HorizontalOptions="Center"
                                   SemanticProperties.Description="The gym's payment QR code" />
                            <Label Text="{Binding AccountName, StringFormat='Pay to {0}'}" IsVisible="{Binding AccountName, Converter={StaticResource IsNotNull}}" />
                            <Label Text="Ask the gym for its QR if none shows here." Style="{StaticResource Caption}" IsVisible="{Binding HasQr, Converter={StaticResource Not}}" />
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Type this code in the payment message" Style="{StaticResource Caption}" />
                                <Label Text="{Binding PayNow.PaymentCode}" Style="{StaticResource Numeral}" SemanticProperties.Description="Payment code" />
                            </VerticalStackLayout>
                            <Label Text="{Binding PayNow.ExpiresAt, Converter={StaticResource LocalDate}, ConverterParameter='ddd d MMM, h:mm tt', StringFormat='Pay before {0}, or this payment expires.'}"
                                   Style="{StaticResource Caption}" IsVisible="{Binding PayNow.ExpiresAt, Converter={StaticResource IsNotNull}}" />
                            <Label Text="After you pay, enter the reference number from your receipt and send a screenshot of it." Style="{StaticResource Muted}" />
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Reference number" Style="{StaticResource Caption}" />
                                <Border Style="{StaticResource Field}"><Entry Text="{Binding ReferenceNo}" SemanticProperties.Description="Reference number from your receipt" /></Border>
                            </VerticalStackLayout>
                            <Button Text="Choose screenshot and send" Style="{StaticResource SmallButton}" Command="{Binding SendProofCommand}" />
                            <!-- membership payments only: a booking is cancelled on Book an amenity (F12), which also releases its time -->
                            <Button Text="Cancel this payment" Style="{StaticResource SmallOutlineButton}" Clicked="OnCancelPayment" IsVisible="{Binding PayNow.CanCancel}" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- F6 (0049): a one-use pass for the front desk, good for 5 minutes and renewed by the 20-second refresh before it runs out;
                         kept apart from the gym's pay-by-QR panel. Always dark on white so any scanner reads it. -->
                    <!-- A one-line row whose Show button opens the code in place, so the code never fills the first screen
                         (owner, 2026-11-07: folded on Windows too, where nobody scans it from a PC) -->
                    <Border Style="{StaticResource SidePanel}" IsVisible="{Binding HasCode}">
                        <VerticalStackLayout Spacing="10">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                    <c:CardTitle Text="Your member QR" />
                                    <Label Text="Show it at the front desk when you arrive. It works once, so a screenshot won't." Style="{StaticResource Caption}" />
                                </VerticalStackLayout>
                                <Button x:Name="QrToggle" Grid.Column="1" Text="Show" Style="{StaticResource FilterChip}" VerticalOptions="Center" Clicked="OnToggleQr"
                                        SemanticProperties.Hint="Shows or hides your member QR code" />
                            </Grid>
                            <VerticalStackLayout x:Name="QrBody" Spacing="10" IsVisible="False">
                                <!-- the generator ignores its own size on Windows, so the white frame sets it and the code fills the frame -->
                                <Border BackgroundColor="White" StrokeThickness="0" Padding="8" WidthRequest="{OnIdiom Phone=240, Default=180}" HeightRequest="{OnIdiom Phone=240, Default=180}" HorizontalOptions="Center"
                                        AutomationId="MemberQr" SemanticProperties.Description="Your member QR code">
                                    <zxing:BarcodeGeneratorView Format="QrCode" Value="{Binding MyCode}" HorizontalOptions="Fill" VerticalOptions="Fill"
                                                                ForegroundColor="Black" BackgroundColor="White" />
                                </Border>
                                <Label Text="{Binding PassLeftText}" FontFamily="BarlowSemiBold" HorizontalOptions="Center" AutomationId="PassLeft" />
                                <Label Text="It identifies you at the front desk; it is not for paying." Style="{StaticResource Caption}" HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </c:SideLayout>
        </VerticalStackLayout>
    </ScrollView>
</v:BasePage>
