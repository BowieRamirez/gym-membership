<?xml version="1.0" encoding="utf-8" ?>
<v:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
            xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
            xmlns:v="clr-namespace:GymMembership.App.Views"
            xmlns:c="clr-namespace:GymMembership.App.Controls"
            xmlns:vm="clr-namespace:GymMembership.Core.ViewModels;assembly=GymMembership.Core"
            xmlns:svc="clr-namespace:GymMembership.Core.Services;assembly=GymMembership.Core"
            x:Class="GymMembership.App.Views.MyMembershipPage" x:DataType="vm:MyMembershipViewModel" Title="My membership">

    <ScrollView MaximumWidthRequest="920">
        <VerticalStackLayout Padding="{OnIdiom Phone='16,12,16,24', Default='20,16,20,24'}" Spacing="14">

            <c:Banner Message="{Binding ErrorMessage}" />
            <c:Banner Kind="notice" Message="{Binding Notice}" />

            <!-- The one memorable moment: days left, shown as a lane that runs out -->
            <Border Style="{StaticResource Panel}" Padding="{OnIdiom Phone='16,16', Default='24,22'}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="{Binding HeroNumber}" Style="{StaticResource Numeral}" FontSize="84"
                           SemanticProperties.Description="Days left on your membership" />
                    <c:LaneView Fraction="{Binding LaneFraction}" Thickness="6" HeightRequest="14"
                                DashColor="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}"
                                TrackColor="{AppThemeBinding Light={StaticResource LineLight}, Dark={StaticResource LineDark}}" />
                    <Label Text="{Binding HeroCaption}" />
                </VerticalStackLayout>
            </Border>

            <!-- Pay by QR: the code is what the front desk matches your transfer against, so it is the biggest thing here -->
            <Border Style="{StaticResource Panel}" Padding="{OnIdiom Phone='16,16', Default='24,22'}" IsVisible="{Binding PayNow, Converter={StaticResource IsNotNull}}">
                <VerticalStackLayout Spacing="14">
                    <Label Text="{Binding PayNow.Amount, StringFormat='Pay ₱{0:N2} by QR'}" Style="{StaticResource Heading}" />
                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="20">
                        <Image Source="{Binding QrUrl}" IsVisible="{Binding HasQr}" WidthRequest="168" HeightRequest="168" VerticalOptions="Start"
                               Grid.ColumnSpan="{OnIdiom Phone=2, Default=1}" HorizontalOptions="{OnIdiom Phone=Center, Default=Start}"
                               SemanticProperties.Description="The gym's payment QR code" />
                        <VerticalStackLayout Grid.Row="{OnIdiom Phone=1, Default=0}" Grid.Column="{OnIdiom Phone=0, Default=1}" Grid.ColumnSpan="{OnIdiom Phone=2, Default=1}"
                                             Margin="{OnIdiom Phone='0,14,0,0', Default=0}" Spacing="10">
                            <Label Text="{Binding AccountName, StringFormat='Pay to {0}'}" IsVisible="{Binding AccountName, Converter={StaticResource IsNotNull}}" />
                            <Label Text="Ask the gym for its QR if none shows here." Style="{StaticResource Caption}" IsVisible="{Binding HasQr, Converter={StaticResource Not}}" />
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Type this code in the payment message" Style="{StaticResource Caption}" />
                                <Label Text="{Binding PayNow.PaymentCode}" Style="{StaticResource Numeral}" SemanticProperties.Description="Payment code" />
                            </VerticalStackLayout>
                            <Label Text="{Binding PayNow.ExpiresAt, Converter={StaticResource LocalDate}, ConverterParameter='ddd d MMM, h:mm tt', StringFormat='Pay before {0}, or this payment expires.'}"
                                   Style="{StaticResource Caption}" IsVisible="{Binding PayNow.ExpiresAt, Converter={StaticResource IsNotNull}}" />
                        </VerticalStackLayout>
                    </Grid>

                    <Label Text="After you pay, enter the reference number from your receipt and send a screenshot of it." Style="{StaticResource Muted}" />
                    <VerticalStackLayout Spacing="10">
                        <VerticalStackLayout Spacing="4" HorizontalOptions="{OnIdiom Phone=Fill, Default=Start}" WidthRequest="{OnIdiom Phone=-1, Default=240}">
                            <Label Text="Reference number" Style="{StaticResource Caption}" />
                            <Border Style="{StaticResource Field}"><Entry Text="{Binding ReferenceNo}" SemanticProperties.Description="Reference number from your receipt" /></Border>
                        </VerticalStackLayout>
                        <Button Text="Choose screenshot and send" Style="{StaticResource SmallButton}" HorizontalOptions="{OnIdiom Phone=Fill, Default=Start}" Command="{Binding SendProofCommand}" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Label Text="Your memberships" Style="{StaticResource Heading}" Margin="0,8,0,0" />
            <VerticalStackLayout Spacing="4" HorizontalOptions="{OnIdiom Phone=Fill, Default=Start}" WidthRequest="{OnIdiom Phone=-1, Default=260}">
                <Label Text="Discount code for renewing (optional)" Style="{StaticResource Caption}" />
                <Border Style="{StaticResource Field}"><Entry Text="{Binding DiscountCode}" SemanticProperties.Description="Discount code" /></Border>
            </VerticalStackLayout>
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Memberships}" Spacing="10">
                <BindableLayout.EmptyView>
                    <Label Text="You don't have a membership yet. Open Packages to start one." Style="{StaticResource Muted}" />
                </BindableLayout.EmptyView>
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="svc:MembershipRow">
                        <Border Style="{StaticResource Panel}">
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12">
                                <VerticalStackLayout Spacing="6">
                                    <Label Text="{Binding PackageName}" Style="{StaticResource Heading}" />
                                    <c:StatusChip Status="{Binding Status}" />
                                    <Label Text="{Binding EndsAt, Converter={StaticResource LocalDate}, ConverterParameter='d MMM yyyy', StringFormat='Ends {0}'}"
                                           Style="{StaticResource Caption}" IsVisible="{Binding EndsAt, Converter={StaticResource IsNotNull}}" />
                                </VerticalStackLayout>
                                <Button Text="Renew" Style="{StaticResource CardButton}" VerticalOptions="Start"
                                        IsVisible="{Binding CanRenew}"
                                        Clicked="OnRenew" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <Label Text="Payments" Style="{StaticResource Heading}" Margin="0,8,0,0" />
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Payments}" Spacing="10">
                <BindableLayout.EmptyView>
                    <Label Text="No payments yet." Style="{StaticResource Muted}" />
                </BindableLayout.EmptyView>
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="svc:PaymentItem">
                        <Border Style="{StaticResource Panel}">
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12">
                                <VerticalStackLayout Spacing="6">
                                    <Label Text="{Binding What}" Style="{StaticResource Heading}" />
                                    <c:StatusChip Status="{Binding Status}" />
                                    <Label Text="{Binding Detail}" IsVisible="{Binding Detail, Converter={StaticResource IsNotNull}}" />
                                    <Label Style="{StaticResource Caption}">
                                        <Label.Text>
                                            <MultiBinding StringFormat="{}{0} · {1}">
                                                <Binding Path="PaymentCode" />
                                                <Binding Path="CreatedAt" Converter="{StaticResource LocalDate}" ConverterParameter="d MMM yyyy, h:mm tt" />
                                            </MultiBinding>
                                        </Label.Text>
                                    </Label>
                                </VerticalStackLayout>
                                <VerticalStackLayout Style="{StaticResource CardActions}" Spacing="6">
                                    <Label Text="{Binding Amount, StringFormat='₱{0:N2}'}" Style="{StaticResource Heading}" HorizontalOptions="{OnIdiom Phone=Start, Default=End}" />
                                    <Button Text="Pay again" Style="{StaticResource SmallOutlineButton}" IsVisible="{Binding CanPayAgain}"
                                            Clicked="OnPayAgain" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</v:BasePage>
