<?xml version="1.0" encoding="utf-8" ?>
<v:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
            xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
            xmlns:v="clr-namespace:GymMembership.App.Views"
            xmlns:c="clr-namespace:GymMembership.App.Controls"
            xmlns:vm="clr-namespace:GymMembership.Core.ViewModels;assembly=GymMembership.Core"
            xmlns:svc="clr-namespace:GymMembership.Core.Services;assembly=GymMembership.Core"
            xmlns:zxing="clr-namespace:ZXing.Net.Maui.Controls;assembly=ZXing.Net.MAUI.Controls"
            x:Class="GymMembership.App.Views.MyMembershipPage" x:DataType="vm:MyMembershipViewModel" Title="My membership">

    <ScrollView MaximumWidthRequest="{StaticResource PageWidth}">
        <VerticalStackLayout Padding="{OnIdiom Phone='16,12,16,24', Default='20,16,20,24'}" Spacing="14">

            <c:Banner Message="{Binding ErrorMessage}" />
            <c:Banner Kind="notice" Message="{Binding Notice}" />

            <!-- D12: the member's permanent ID code, kept apart from the gym's pay-by-QR panel below. Always dark on white so any scanner reads it. -->
            <c:CardGrid Columns="{OnIdiom Phone=1, Default=2}">
            <!-- The one memorable moment: days left, a lime card with a pill bar that runs out -->
            <Border Style="{StaticResource HeroPanel}" Padding="{OnIdiom Phone='16,16', Default='22,20'}">
                <VerticalStackLayout Spacing="12">
                    <c:CardTitle Icon="clock" Text="{Binding HeroCaption}" TextColor="{StaticResource Black}" />
                    <Label Text="{Binding HeroNumber}" Style="{StaticResource Numeral}" FontSize="84" TextColor="{StaticResource Black}"
                           SemanticProperties.Description="Days left on your membership" />
                    <c:LaneView Fraction="{Binding LaneFraction}" HeightRequest="34" DashColor="{StaticResource Black}" TrackColor="#5A6159" />
                </VerticalStackLayout>
            </Border>
            <Border Style="{StaticResource Panel}" Padding="18" IsVisible="{Binding HasCode}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="18">
                    <!-- the generator ignores its own size on Windows, so the white frame sets it and the code fills the frame -->
                    <Border BackgroundColor="White" StrokeThickness="0" Padding="8" WidthRequest="166" HeightRequest="166" VerticalOptions="Center"
                            AutomationId="MemberQr" SemanticProperties.Description="Your member QR code">
                        <zxing:BarcodeGeneratorView Format="QrCode" Value="{Binding MyCode}" HorizontalOptions="Fill" VerticalOptions="Fill"
                                                    ForegroundColor="Black" BackgroundColor="White" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                        <c:CardTitle Icon="scan-line" Text="Your member QR" />
                        <Label Text="Show this at the front desk when you arrive. It only identifies you; it is not for paying." Style="{StaticResource Muted}" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            </c:CardGrid>

            <!-- Pay by QR: the code is what the front desk matches your transfer against, so it is the biggest thing here -->
            <Border Style="{StaticResource Panel}" Padding="{OnIdiom Phone='16,16', Default='24,22'}" IsVisible="{Binding PayNow, Converter={StaticResource IsNotNull}}">
                <VerticalStackLayout Spacing="14">
                    <c:CardTitle Icon="banknote" Text="{Binding PayNow.Amount, StringFormat='Pay ₱{0:N2} by QR'}" />
                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="20">
                        <Image Source="{Binding QrUrl}" IsVisible="{Binding HasQr}" WidthRequest="168" HeightRequest="168" VerticalOptions="Start"
                               Grid.ColumnSpan="{OnIdiom Phone=2, Default=1}" HorizontalOptions="{OnIdiom Phone=Center, Default=Start}"
                               SemanticProperties.Description="The gym's payment QR code" />
                        <VerticalStackLayout Grid.Row="{OnIdiom Phone=1, Default=0}" Grid.Column="{OnIdiom Phone=0, Default=1}" Grid.ColumnSpan="{OnIdiom Phone=2, Default=1}"
                                             Margin="{OnIdiom Phone='0,14,0,0', Default=0}" Spacing="10">
                            <Label Text="{Binding AccountName, StringFormat='Pay to {0}'}" IsVisible="{Binding AccountName, Converter={StaticResource IsNotNull}}" />
                            <Label Text="Ask the gym for its QR if none shows here." Style="{StaticResource Caption}" IsVisible="{Binding HasQr, Converter={StaticResource Not}}" />
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Type this code in the payment message" Style="{StaticResource Caption}" />
                                <Label Text="{Binding PayNow.PaymentCode}" Style="{StaticResource Numeral}" SemanticProperties.Description="Payment code" />
                            </VerticalStackLayout>
                            <Label Text="{Binding PayNow.ExpiresAt, Converter={StaticResource LocalDate}, ConverterParameter='ddd d MMM, h:mm tt', StringFormat='Pay before {0}, or this payment expires.'}"
                                   Style="{StaticResource Caption}" IsVisible="{Binding PayNow.ExpiresAt, Converter={StaticResource IsNotNull}}" />
                        </VerticalStackLayout>
                    </Grid>

                    <Label Text="After you pay, enter the reference number from your receipt and send a screenshot of it." Style="{StaticResource Muted}" />
                    <VerticalStackLayout Spacing="10">
                        <VerticalStackLayout Spacing="4" HorizontalOptions="{OnIdiom Phone=Fill, Default=Start}" WidthRequest="{OnIdiom Phone=-1, Default=240}">
                            <Label Text="Reference number" Style="{StaticResource Caption}" />
                            <Border Style="{StaticResource Field}"><Entry Text="{Binding ReferenceNo}" SemanticProperties.Description="Reference number from your receipt" /></Border>
                        </VerticalStackLayout>
                        <Button Text="Choose screenshot and send" Style="{StaticResource SmallButton}" HorizontalOptions="{OnIdiom Phone=Fill, Default=Start}" Command="{Binding SendProofCommand}" />
                        <Button Text="Cancel this payment" Style="{StaticResource SmallOutlineButton}" HorizontalOptions="{OnIdiom Phone=Fill, Default=Start}" Clicked="OnCancelPayment" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Label Text="Your paid terms" Style="{StaticResource SectionTitle}" />
            <Label Text="Extensions start after your last paid term. No upgrades or unused-time credits. Other paid terms keep their dates if one is cancelled, so a gap may remain." Style="{StaticResource Muted}" />
            <Button Text="Choose a package / extend" Style="{StaticResource SmallButton}" HorizontalOptions="Start" Clicked="OnChoosePackage" />
            <c:CardGrid Columns="{OnIdiom Phone=1, Default=2}" BindableLayout.ItemsSource="{Binding Terms}">
                <BindableLayout.EmptyView>
                    <Label Text="No paid terms yet. Choose a package, pay and wait for verification." Style="{StaticResource Muted}" />
                </BindableLayout.EmptyView>
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="svc:TermCard">
                        <Border Style="{StaticResource Panel}">
                            <VerticalStackLayout Spacing="8">
                                <c:CardTitle Icon="id-card" Text="{Binding Term.PackageName}" />
                                <c:StatusChip Status="{Binding State}" />
                                <Label Text="{Binding Dates}" Style="{StaticResource Caption}" />
                                <Label Text="{Binding Term.AmountPaid, StringFormat='Actually paid: ₱{0:N2}'}" />
                                <Label Text="{Binding RefundText}" Style="{StaticResource Muted}" />
                                <Label Text="{Binding Refund.DecisionReason}" IsVisible="{Binding Refund.DecisionReason, Converter={StaticResource IsNotNull}}" />
                                <Button Text="Cancel &amp; request refund" Style="{StaticResource SmallOutlineButton}" HorizontalOptions="Start"
                                        IsVisible="{Binding CanRequestRefund}" Clicked="OnRequestRefund" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </c:CardGrid>

            <!-- payments: white rows inside one card -->
            <Label Text="Payments" Style="{StaticResource SectionTitle}" />
            <Border Style="{StaticResource Panel}" Padding="12">
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Payments}" Spacing="8">
                <BindableLayout.EmptyView>
                    <Label Text="No payments yet." Style="{StaticResource Muted}" />
                </BindableLayout.EmptyView>
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="svc:PaymentItem">
                        <Border Style="{StaticResource Row}">
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12">
                                <VerticalStackLayout Spacing="6">
                                    <Label Text="{Binding What}" Style="{StaticResource Heading}" />
                                    <c:StatusChip Status="{Binding Status}" />
                                    <Label Text="{Binding Detail}" IsVisible="{Binding Detail, Converter={StaticResource IsNotNull}}" />
                                    <Label Style="{StaticResource Caption}">
                                        <Label.Text>
                                            <MultiBinding StringFormat="{}{0} · {1}">
                                                <Binding Path="PaymentCode" />
                                                <Binding Path="CreatedAt" Converter="{StaticResource LocalDate}" ConverterParameter="d MMM yyyy, h:mm tt" />
                                            </MultiBinding>
                                        </Label.Text>
                                    </Label>
                                </VerticalStackLayout>
                                <VerticalStackLayout Style="{StaticResource CardActions}" Spacing="6">
                                    <Label Text="{Binding Amount, StringFormat='₱{0:N2}'}" Style="{StaticResource Heading}" HorizontalOptions="{OnIdiom Phone=Start, Default=End}" />
                                    <Button Text="Pay again" Style="{StaticResource SmallOutlineButton}" IsVisible="{Binding CanPayAgain}"
                                            Clicked="OnPayAgain" />
                                    <Button Text="Cancel payment" Style="{StaticResource SmallOutlineButton}" IsVisible="{Binding CanCancel}"
                                            Clicked="OnCancelPayment" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</v:BasePage>
