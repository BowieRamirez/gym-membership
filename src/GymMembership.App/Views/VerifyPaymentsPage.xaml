<?xml version="1.0" encoding="utf-8" ?>
<v:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
            xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
            xmlns:v="clr-namespace:GymMembership.App.Views"
            xmlns:c="clr-namespace:GymMembership.App.Controls"
            xmlns:vm="clr-namespace:GymMembership.Core.ViewModels;assembly=GymMembership.Core"
            xmlns:svc="clr-namespace:GymMembership.Core.Services;assembly=GymMembership.Core"
            x:Class="GymMembership.App.Views.VerifyPaymentsPage" x:DataType="vm:VerifyPaymentsViewModel" Title="Payments to verify">

    <v:BasePage.Resources>
        <!-- wide: one row per payment, its actions at the end -->
        <DataTemplate x:Key="QueueRow" x:DataType="svc:PaymentRow">
            <VerticalStackLayout>
                <Grid Style="{StaticResource TableRow}" ColumnDefinitions="*,*,110,170,120,110,320">
                    <Label Text="{Binding Payer}" FontFamily="BarlowMedium" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="{Binding Item}" VerticalOptions="Center" />
                    <Label Grid.Column="2" Text="{Binding Payment.PaymentCode}" FontFamily="BarlowSemiBold" VerticalOptions="Center" />
                    <Label Grid.Column="3" Text="{Binding Payment.ReferenceNo}" Style="{StaticResource Muted}" VerticalOptions="Center" IsVisible="{Binding HasProof}" />
                    <Label Grid.Column="3" Text="No proof yet" Style="{StaticResource Muted}" VerticalOptions="Center" IsVisible="{Binding HasProof, Converter={StaticResource Not}}" />
                    <Label Grid.Column="4" Text="{Binding Payment.CreatedAt, Converter={StaticResource LocalDate}, ConverterParameter='d MMM, h:mm tt'}" Style="{StaticResource Muted}" VerticalOptions="Center" />
                    <Label Grid.Column="5" Text="{Binding Payment.Amount, StringFormat='₱{0:N2}'}" FontFamily="BarlowSemiBold" HorizontalOptions="End" VerticalOptions="Center" />
                    <HorizontalStackLayout Grid.Column="6" Spacing="6" HorizontalOptions="End" VerticalOptions="Center">
                        <Button Text="View screenshot" Style="{StaticResource SmallOutlineButton}" IsVisible="{Binding HasProof}" Clicked="OnViewProof" />
                        <Button Text="Verify" Style="{StaticResource SmallOutlineButton}" Clicked="OnApprove" />
                        <Button Text="Reject" Style="{StaticResource SmallOutlineButton}" Clicked="OnReject" />
                    </HorizontalStackLayout>
                </Grid>
                <BoxView Style="{StaticResource Hairline}" />
            </VerticalStackLayout>
        </DataTemplate>
        <!-- narrow and phones: who and how much; package and code; reference and when; the actions as chips -->
        <DataTemplate x:Key="QueueCard" x:DataType="svc:PaymentRow">
            <VerticalStackLayout>
                <VerticalStackLayout Spacing="4" Padding="14,12">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <Label Text="{Binding Payer}" FontFamily="BarlowSemiBold" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="{Binding Payment.Amount, StringFormat='₱{0:N2}'}" FontFamily="BarlowSemiBold" VerticalOptions="Center" />
                    </Grid>
                    <Label Style="{StaticResource Caption}">
                        <Label.Text>
                            <MultiBinding StringFormat="{}{0}  ·  {1}">
                                <Binding Path="Item" />
                                <Binding Path="Payment.PaymentCode" />
                            </MultiBinding>
                        </Label.Text>
                    </Label>
                    <Label Style="{StaticResource Caption}" IsVisible="{Binding HasProof}">
                        <Label.Text>
                            <MultiBinding StringFormat="{}Reference {0}  ·  {1}">
                                <Binding Path="Payment.ReferenceNo" />
                                <Binding Path="Payment.CreatedAt" Converter="{StaticResource LocalDate}" ConverterParameter="d MMM, h:mm tt" />
                            </MultiBinding>
                        </Label.Text>
                    </Label>
                    <Label Text="Waiting for the member to pay and send proof" Style="{StaticResource Caption}" IsVisible="{Binding HasProof, Converter={StaticResource Not}}" />
                    <FlexLayout Wrap="Wrap" Margin="0,4,0,0">
                        <Button Text="View screenshot" Style="{StaticResource FilterChip}" Margin="0,0,8,8" IsVisible="{Binding HasProof}" Clicked="OnViewProof" />
                        <Button Text="Verify" Style="{StaticResource FilterChip}" Margin="0,0,8,8" Clicked="OnApprove" />
                        <Button Text="Reject" Style="{StaticResource FilterChip}" Margin="0,0,8,8" Clicked="OnReject" />
                    </FlexLayout>
                </VerticalStackLayout>
                <BoxView Style="{StaticResource Hairline}" />
            </VerticalStackLayout>
        </DataTemplate>
    </v:BasePage.Resources>

    <Grid RowDefinitions="Auto,*" Padding="{OnIdiom Phone='20,16,20,0', Default='16,12,16,0'}" MaximumWidthRequest="{StaticResource PageWidth}">
        <VerticalStackLayout Spacing="10" Padding="0,0,0,10">
            <Label Text="Oldest first. Match the code and amount in the gym's e-wallet; Verify turns the membership on and issues a receipt number." Style="{StaticResource Muted}" />
            <c:Banner Message="{Binding ErrorMessage}" />
            <c:Banner Kind="notice" Message="{Binding Notice}" />

            <!-- the screenshot the member sent -->
            <Border Style="{StaticResource Panel}" IsVisible="{Binding Viewing, Converter={StaticResource IsNotNull}}">
                <VerticalStackLayout Spacing="10">
                    <c:CardTitle Text="{Binding Viewing.Payer, StringFormat='Screenshot from {0}'}" />
                    <Image Source="{Binding ProofUrl}" MaximumHeightRequest="360" Aspect="AspectFit" HorizontalOptions="Start"
                           IsVisible="{Binding ProofUrl, Converter={StaticResource IsNotNull}}" SemanticProperties.Description="Payment screenshot" />
                    <Label Text="No screenshot to show." Style="{StaticResource Caption}" IsVisible="{Binding ProofUrl, Converter={StaticResource IsNull}}" />
                    <Button Text="Close" Style="{StaticResource SmallOutlineButton}" HorizontalOptions="Start" Command="{Binding CloseProofCommand}" />
                </VerticalStackLayout>
            </Border>

            <!-- a rejection is final, so it needs a reason the member will read -->
            <Border Style="{StaticResource Panel}" IsVisible="{Binding Rejecting, Converter={StaticResource IsNotNull}}">
                <VerticalStackLayout Spacing="10">
                    <c:CardTitle Text="{Binding Rejecting.Payer, StringFormat='Reject {0}’s payment'}" />
                    <Label Text="Say why, so they know what to fix. They can pay again with a new payment." Style="{StaticResource Caption}" />
                    <Border Style="{StaticResource Field}" WidthRequest="360" HorizontalOptions="Start">
                        <Entry Text="{Binding RejectReason}" Placeholder="Amount does not match" SemanticProperties.Description="Reason for rejecting" />
                    </Border>
                    <HorizontalStackLayout Spacing="8">
                        <Button Text="Reject payment" Style="{StaticResource SmallButton}" Command="{Binding ConfirmRejectCommand}" />
                        <Button Text="Keep it pending" Style="{StaticResource SmallOutlineButton}" Command="{Binding KeepPendingCommand}" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>

        <!-- 9.7: the queue is a table (as on Home), stacked rows on narrow windows and phones; the actions are outline, one set per row -->
        <ScrollView Grid.Row="1">
            <Border Style="{StaticResource TablePanel}" Margin="0,0,0,16" VerticalOptions="Start">
                <VerticalStackLayout>
                    <VerticalStackLayout x:Name="QueueHead" IsVisible="{OnIdiom Phone=False, Default=True}">
                        <Grid Style="{StaticResource TableHead}" ColumnDefinitions="*,*,110,170,120,110,320">
                            <Label Text="Payer" Style="{StaticResource Caption}" />
                            <Label Grid.Column="1" Text="Package" Style="{StaticResource Caption}" />
                            <Label Grid.Column="2" Text="Code" Style="{StaticResource Caption}" />
                            <Label Grid.Column="3" Text="Reference" Style="{StaticResource Caption}" />
                            <Label Grid.Column="4" Text="Sent" Style="{StaticResource Caption}" />
                            <Label Grid.Column="5" Text="Amount" Style="{StaticResource Caption}" HorizontalOptions="End" />
                        </Grid>
                        <BoxView Style="{StaticResource Hairline}" />
                    </VerticalStackLayout>
                    <c:TableBody BindableLayout.ItemsSource="{Binding Pending}" Header="{x:Reference QueueHead}" WideFrom="1100"
                                 RowTemplate="{StaticResource QueueRow}" CardTemplate="{StaticResource QueueCard}"
                                 BindableLayout.ItemTemplate="{OnIdiom Phone={StaticResource QueueCard}, Default={StaticResource QueueRow}}">
                        <BindableLayout.EmptyView><Label Text="No payments are waiting. Members' e-wallet payments show up here." Style="{StaticResource Muted}" Margin="14" /></BindableLayout.EmptyView>
                    </c:TableBody>
                </VerticalStackLayout>
            </Border>
        </ScrollView>
    </Grid>
</v:BasePage>
