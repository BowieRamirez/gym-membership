<?xml version="1.0" encoding="utf-8" ?>
<v:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
            xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
            xmlns:v="clr-namespace:GymMembership.App.Views"
            xmlns:c="clr-namespace:GymMembership.App.Controls"
            xmlns:vm="clr-namespace:GymMembership.Core.ViewModels;assembly=GymMembership.Core"
            xmlns:svc="clr-namespace:GymMembership.Core.Services;assembly=GymMembership.Core"
            x:Class="GymMembership.App.Views.VerifyPaymentsPage" x:DataType="vm:VerifyPaymentsViewModel" Title="Payments to verify">

    <Grid RowDefinitions="Auto,*" Padding="{OnIdiom Phone='20,16,20,0', Default='16,12,16,0'}" MaximumWidthRequest="{StaticResource PageWidth}">
        <VerticalStackLayout Spacing="10" Padding="0,0,0,10">
            <Label Text="Oldest first. Find the transfer in the gym's e-wallet by its payment code and amount, then verify or reject. Verifying switches the membership on and gives a receipt number." Style="{StaticResource Muted}" />
            <c:Banner Message="{Binding ErrorMessage}" />
            <c:Banner Kind="notice" Message="{Binding Notice}" />

            <!-- the screenshot the member sent -->
            <Border Style="{StaticResource Panel}" IsVisible="{Binding Viewing, Converter={StaticResource IsNotNull}}">
                <VerticalStackLayout Spacing="10">
                    <c:CardTitle Icon="receipt" Text="{Binding Viewing.Payer, StringFormat='Screenshot from {0}'}" />
                    <Image Source="{Binding ProofUrl}" MaximumHeightRequest="360" Aspect="AspectFit" HorizontalOptions="Start"
                           IsVisible="{Binding ProofUrl, Converter={StaticResource IsNotNull}}" SemanticProperties.Description="Payment screenshot" />
                    <Label Text="No screenshot to show." Style="{StaticResource Caption}" IsVisible="{Binding ProofUrl, Converter={StaticResource IsNull}}" />
                    <Button Text="Close" Style="{StaticResource SmallOutlineButton}" HorizontalOptions="Start" Command="{Binding CloseProofCommand}" />
                </VerticalStackLayout>
            </Border>

            <!-- a rejection is final, so it needs a reason the member will read -->
            <Border Style="{StaticResource Panel}" IsVisible="{Binding Rejecting, Converter={StaticResource IsNotNull}}">
                <VerticalStackLayout Spacing="10">
                    <c:CardTitle Icon="ban" Text="{Binding Rejecting.Payer, StringFormat='Reject {0}’s payment'}" />
                    <Label Text="Say why, so they know what to fix. They can pay again with a new payment." Style="{StaticResource Caption}" />
                    <Border Style="{StaticResource Field}" WidthRequest="360" HorizontalOptions="Start">
                        <Entry Text="{Binding RejectReason}" Placeholder="Amount does not match" SemanticProperties.Description="Reason for rejecting" />
                    </Border>
                    <HorizontalStackLayout Spacing="8">
                        <Button Text="Reject payment" Style="{StaticResource SmallButton}" Command="{Binding ConfirmRejectCommand}" />
                        <Button Text="Keep it pending" Style="{StaticResource SmallOutlineButton}" Command="{Binding KeepPendingCommand}" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>

        <ScrollView Grid.Row="1"><c:CardGrid Columns="{OnIdiom Phone=1, Default=4}" Padding="0,0,0,16" BindableLayout.ItemsSource="{Binding Pending}">
            <BindableLayout.EmptyView><Label Text="No payments are waiting." Style="{StaticResource Muted}" /></BindableLayout.EmptyView>
            <BindableLayout.ItemTemplate>
                <DataTemplate x:DataType="svc:PaymentRow">
                    <Border Style="{StaticResource Panel}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                            <VerticalStackLayout Spacing="4">
                                <c:CardTitle Icon="badge-check" Text="{Binding Payer}" />
                                <Label Text="{Binding Item}" />
                                <Label Text="{Binding Payment.PaymentCode}" FontFamily="BarlowSemiBold" />
                                <Label Text="{Binding Payment.ReferenceNo, StringFormat='Reference {0}'}" Style="{StaticResource Caption}" IsVisible="{Binding HasProof}" />
                                <Label Text="{Binding Payment.CreatedAt, Converter={StaticResource LocalDate}, ConverterParameter='d MMM, h:mm tt'}" Style="{StaticResource Caption}" />
                                <Label Style="{StaticResource Caption}" Text="Waiting for the member to pay and send proof" IsVisible="{Binding HasProof, Converter={StaticResource Not}}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="8" HorizontalOptions="End">
                                <Label Text="{Binding Payment.Amount, StringFormat='₱{0:N2}'}" Style="{StaticResource Numeral}" HorizontalOptions="End" />
                                <Button Text="View screenshot" Style="{StaticResource SmallOutlineButton}" IsVisible="{Binding HasProof}"
                                        Clicked="OnViewProof" />
                                <HorizontalStackLayout Spacing="8">
                                    <Button Text="Verify" Style="{StaticResource SmallButton}"
                                            Clicked="OnApprove" />
                                    <Button Text="Reject" Style="{StaticResource SmallOutlineButton}"
                                            Clicked="OnReject" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </BindableLayout.ItemTemplate>
        </c:CardGrid></ScrollView>
    </Grid>
</v:BasePage>
