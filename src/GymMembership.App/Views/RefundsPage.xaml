<?xml version="1.0" encoding="utf-8" ?>
<v:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
            xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
            xmlns:v="clr-namespace:GymMembership.App.Views"
            xmlns:c="clr-namespace:GymMembership.App.Controls"
            xmlns:vm="clr-namespace:GymMembership.Core.ViewModels;assembly=GymMembership.Core"
            xmlns:svc="clr-namespace:GymMembership.Core.Services;assembly=GymMembership.Core"
            x:Class="GymMembership.App.Views.RefundsPage" x:DataType="vm:RefundsViewModel" Title="Refunds &amp; voids">
    <!-- D30: Cancellations &amp; refunds and Void a payment are one page with the switch; the void half is VoidPaymentsPage's content (BasePage.HostPart) -->
    <Grid RowDefinitions="Auto,*" MaximumWidthRequest="{StaticResource PageWidth}">
    <c:PartSwitch x:Name="Switch" First="Cancellations &amp; refunds" Second="Void a payment" Margin="16,12,16,0" />
    <ContentView x:Name="Part" Grid.Row="1" IsVisible="{Binding ShowSecond, Source={x:Reference Switch}, x:DataType=c:PartSwitch}" />
    <ScrollView Grid.Row="1" Padding="16,12" IsVisible="{Binding ShowSecond, Source={x:Reference Switch}, x:DataType=c:PartSwitch, Converter={StaticResource Not}}"><VerticalStackLayout>
        
            <VerticalStackLayout Spacing="10" Padding="0,0,0,16">
                <!-- 9.8: no heading repeating the page title; the rules in two sentences (were five) -->
                <Label Text="An unused term is owed a full refund; a used one needs your review (guidance, not legal advice), and approving cancels only that term. Amenity bookings are refunded when cancelled 1 hour or more before, or when the front desk approves a claim. The app sends no money: return it yourself, then record the repayment." Style="{StaticResource Muted}" MaximumWidthRequest="760" HorizontalOptions="Start" />
                <c:Banner Message="{Binding ErrorMessage}" />
                <c:Banner Kind="notice" Message="{Binding Notice}" />
            </VerticalStackLayout>
        
        <c:CardGrid Columns="{OnIdiom Phone=1, Default=4}" BindableLayout.ItemsSource="{Binding Requests}"><BindableLayout.EmptyView><Label Text="No cancellation or refund requests." Style="{StaticResource Muted}" /></BindableLayout.EmptyView>
        <BindableLayout.ItemTemplate>
            <DataTemplate x:DataType="svc:RefundCard">
                <Border Style="{StaticResource Panel}">
                    <VerticalStackLayout Spacing="8">
                        <c:CardTitle Text="{Binding Member}" />
                        <Label Text="{Binding PackageName}" />
                        <Label Text="{Binding Dates}" Style="{StaticResource Caption}" />
                        <VerticalStackLayout Spacing="0">
                            <Label Text="{Binding AmountLabel}" Style="{StaticResource Caption}" />
                            <Label Text="{Binding Request.Amount, StringFormat='₱{0:N2}'}" Style="{StaticResource PriceNumeral}" />
                        </VerticalStackLayout>
                        <Label Text="{Binding Request.Reason, StringFormat='Member reason: {0}'}" />
                        <Label Text="{Binding ReviewText}" FontFamily="BarlowSemiBold" IsVisible="{Binding ReviewText, Converter={StaticResource HasText}}" />
                        <Label Text="{Binding LaterTermsWarning}" Style="{StaticResource Caption}" IsVisible="{Binding LaterTermsWarning, Converter={StaticResource HasText}}" />
                        <Label Text="{Binding State}" Style="{StaticResource Muted}" />
                        <Label Text="{Binding Request.DecisionReason}" IsVisible="{Binding Request.DecisionReason, Converter={StaticResource IsNotNull}}" />
                        <VerticalStackLayout Spacing="8" IsVisible="{Binding CanDecide}">
                            <!-- outline per card (9.8): a queue of requests is not one page-wide main action -->
                            <Button Text="Approve cancellation / refund" Style="{StaticResource SmallOutlineButton}" HorizontalOptions="{OnIdiom Phone=Fill, Default=Start}" Clicked="OnApprove" />
                            <Button Text="Reject request" Style="{StaticResource SmallOutlineButton}" HorizontalOptions="{OnIdiom Phone=Fill, Default=Start}" Clicked="OnReject" />
                        </VerticalStackLayout>
                        <Button Text="Record money repaid" Style="{StaticResource SmallOutlineButton}" HorizontalOptions="{OnIdiom Phone=Fill, Default=Start}" IsVisible="{Binding CanRepay}" Clicked="OnPaid" />
                    </VerticalStackLayout>
                </Border>
            </DataTemplate>
        </BindableLayout.ItemTemplate>
    </c:CardGrid></VerticalStackLayout></ScrollView>
    </Grid>
</v:BasePage>
