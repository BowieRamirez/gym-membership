<?xml version="1.0" encoding="utf-8" ?>
<v:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
            xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
            xmlns:v="clr-namespace:GymMembership.App.Views"
            xmlns:c="clr-namespace:GymMembership.App.Controls"
            xmlns:vm="clr-namespace:GymMembership.Core.ViewModels;assembly=GymMembership.Core"
            xmlns:m="clr-namespace:GymMembership.Core.Models;assembly=GymMembership.Core"
            x:Class="GymMembership.App.Views.PayrollPage" x:DataType="vm:PayrollViewModel" Title="Payroll">

    <v:BasePage.Resources>
        <!-- Wide table row (Period tab) -->
        <DataTemplate x:Key="PayrollRowTemplate" x:DataType="vm:PayrollRowItem">
            <VerticalStackLayout>
                <Grid Style="{StaticResource TableRow}" ColumnDefinitions="*,140,115,110,110,120,84" ColumnSpacing="12">
                    <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnRowTapped" /></Grid.GestureRecognizers>
                    <Grid.Triggers>
                        <DataTrigger TargetType="Grid" Binding="{Binding IsSelected}" Value="True">
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}" />
                        </DataTrigger>
                    </Grid.Triggers>

                    <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                        <Label Text="{Binding FullName}" FontFamily="BarlowSemiBold" VerticalOptions="Center" LineBreakMode="TailTruncation">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding NoSalary}" Value="True">
                                    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                        <c:StatusChip Status="{Binding RoleLabel}" VerticalOptions="Center" />
                    </HorizontalStackLayout>

                    <Label Grid.Column="1" Text="{Binding HoursText}" Style="{StaticResource Muted}" VerticalOptions="Center" LineBreakMode="TailTruncation" />

                    <!-- Salary or warning chip -->
                    <Label Grid.Column="2" Text="{Binding SalaryText}" HorizontalOptions="End" VerticalOptions="Center" LineBreakMode="NoWrap"
                           IsVisible="{Binding NoSalary, Converter={StaticResource Not}}" />
                    <c:StatusChip Grid.Column="2" Status="No salary set" HorizontalOptions="End" VerticalOptions="Center"
                                  IsVisible="{Binding NoSalary}" />

                    <Label Grid.Column="3" Text="{Binding BonusesText}" HorizontalOptions="End" VerticalOptions="Center" LineBreakMode="NoWrap"
                           IsVisible="{Binding NoSalary, Converter={StaticResource Not}}" />
                    <Label Grid.Column="4" Text="{Binding DeductionsText}" HorizontalOptions="End" VerticalOptions="Center" LineBreakMode="NoWrap"
                           IsVisible="{Binding NoSalary, Converter={StaticResource Not}}" />
                    <Label Grid.Column="5" Text="{Binding NetText}" FontFamily="BarlowSemiBold" HorizontalOptions="End" VerticalOptions="Center" LineBreakMode="NoWrap"
                           IsVisible="{Binding NoSalary, Converter={StaticResource Not}}" />

                    <Button Grid.Column="6" Text="Lines" Style="{StaticResource SmallOutlineButton}" HorizontalOptions="End" VerticalOptions="Center"
                            Clicked="OnOpenDrawerClicked" SemanticProperties.Description="{Binding FullName, StringFormat='Open payroll lines for {0}'}" />
                </Grid>
                <BoxView Style="{StaticResource Hairline}" />
            </VerticalStackLayout>
        </DataTemplate>

        <!-- Narrow card (Period tab) -->
        <DataTemplate x:Key="PayrollCardTemplate" x:DataType="vm:PayrollRowItem">
            <VerticalStackLayout>
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="4" Padding="14,12">
                    <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnRowTapped" /></Grid.GestureRecognizers>
                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                        <Label Text="{Binding FullName}" FontFamily="BarlowSemiBold" VerticalOptions="Center" />
                        <c:StatusChip Status="{Binding RoleLabel}" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <Label Grid.Column="1" Text="{Binding NetText}" FontFamily="BarlowBold" VerticalOptions="Center"
                           IsVisible="{Binding NoSalary, Converter={StaticResource Not}}" />
                    <c:StatusChip Grid.Column="1" Status="No salary set" VerticalOptions="Center" IsVisible="{Binding NoSalary}" />

                    <Label Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding HoursText}" Style="{StaticResource Muted}" />

                    <HorizontalStackLayout Grid.Row="2" Spacing="12" IsVisible="{Binding NoSalary, Converter={StaticResource Not}}">
                        <Label Text="{Binding SalaryText, StringFormat='Salary {0}'}" Style="{StaticResource Caption}" />
                        <Label Text="{Binding BonusesText, StringFormat='Bonus {0}'}" Style="{StaticResource Caption}" />
                        <Label Text="{Binding DeductionsText, StringFormat='Ded. {0}'}" Style="{StaticResource Caption}" />
                    </HorizontalStackLayout>
                    <Button Grid.Row="2" Grid.Column="1" Text="Lines" Style="{StaticResource SmallOutlineButton}" Clicked="OnOpenDrawerClicked" />
                </Grid>
                <BoxView Style="{StaticResource Hairline}" />
            </VerticalStackLayout>
        </DataTemplate>

        <!-- Wide table row (Salaries tab) -->
        <DataTemplate x:Key="SalaryRowTemplate" x:DataType="vm:StaffSalaryItem">
            <VerticalStackLayout>
                <Grid Style="{StaticResource TableRow}" ColumnDefinitions="1.1*,140,1.1*,230" ColumnSpacing="14">
                    <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                        <Label Text="{Binding FullName}" FontFamily="BarlowSemiBold" VerticalOptions="Center" LineBreakMode="TailTruncation" />
                        <c:StatusChip Status="{Binding RoleLabel}" VerticalOptions="Center" />
                    </HorizontalStackLayout>

                    <Label Grid.Column="1" Text="{Binding AmountText}" FontFamily="BarlowSemiBold" HorizontalOptions="End" VerticalOptions="Center" LineBreakMode="NoWrap"
                           IsVisible="{Binding NoSalary, Converter={StaticResource Not}}" />
                    <c:StatusChip Grid.Column="1" Status="No salary set" HorizontalOptions="End" VerticalOptions="Center" IsVisible="{Binding NoSalary}" />

                    <Label Grid.Column="2" Text="{Binding UpdatedText}" Style="{StaticResource Muted}" VerticalOptions="Center" LineBreakMode="TailTruncation" />

                    <Button Grid.Column="3" Text="Set salary" Style="{StaticResource SmallOutlineButton}" HorizontalOptions="End" VerticalOptions="Center"
                            Command="{Binding BeginEditCommand}" IsVisible="{Binding IsNotEditing}" />

                    <VerticalStackLayout Grid.Column="3" Spacing="4" IsVisible="{Binding IsEditing}" VerticalOptions="Center">
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                            <Border Style="{StaticResource Field}" Padding="8,4">
                                <Entry Text="{Binding AmountInput}" Keyboard="Numeric" Placeholder="₱0.00" SemanticProperties.Description="Salary per period">
                                    <Entry.Behaviors><c:NumericOnlyBehavior /></Entry.Behaviors>
                                </Entry>
                            </Border>
                            <Button Grid.Column="1" Text="Save" Style="{StaticResource SmallButton}" Command="{Binding SaveCommand}" />
                            <Button Grid.Column="2" Text="Cancel" Style="{StaticResource SmallOutlineButton}" Command="{Binding CancelEditCommand}" />
                        </Grid>
                        <Label Text="{Binding ErrorText}" Style="{StaticResource FieldError}" IsVisible="{Binding ErrorText, Converter={StaticResource IsNotNull}}" />
                    </VerticalStackLayout>
                </Grid>
                <BoxView Style="{StaticResource Hairline}" />
            </VerticalStackLayout>
        </DataTemplate>

        <!-- Narrow card (Salaries tab) -->
        <DataTemplate x:Key="SalaryCardTemplate" x:DataType="vm:StaffSalaryItem">
            <VerticalStackLayout>
                <VerticalStackLayout Padding="14,12" Spacing="6">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                            <Label Text="{Binding FullName}" FontFamily="BarlowSemiBold" VerticalOptions="Center" />
                            <c:StatusChip Status="{Binding RoleLabel}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <Label Grid.Column="1" Text="{Binding AmountText}" FontFamily="BarlowSemiBold" VerticalOptions="Center"
                               IsVisible="{Binding NoSalary, Converter={StaticResource Not}}" />
                        <c:StatusChip Grid.Column="1" Status="No salary set" VerticalOptions="Center" IsVisible="{Binding NoSalary}" />
                    </Grid>
                    <Label Text="{Binding UpdatedText, StringFormat='Updated {0}'}" Style="{StaticResource Caption}" />
                    <Button Text="Set salary" Style="{StaticResource SmallOutlineButton}" HorizontalOptions="Start"
                            Command="{Binding BeginEditCommand}" IsVisible="{Binding IsNotEditing}" />
                    <VerticalStackLayout Spacing="4" IsVisible="{Binding IsEditing}">
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                            <Border Style="{StaticResource Field}" Padding="8,4">
                                <Entry Text="{Binding AmountInput}" Keyboard="Numeric" Placeholder="₱0.00">
                                    <Entry.Behaviors><c:NumericOnlyBehavior /></Entry.Behaviors>
                                </Entry>
                            </Border>
                            <Button Grid.Column="1" Text="Save" Style="{StaticResource SmallButton}" Command="{Binding SaveCommand}" />
                            <Button Grid.Column="2" Text="Cancel" Style="{StaticResource SmallOutlineButton}" Command="{Binding CancelEditCommand}" />
                        </Grid>
                        <Label Text="{Binding ErrorText}" Style="{StaticResource FieldError}" IsVisible="{Binding ErrorText, Converter={StaticResource IsNotNull}}" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
                <BoxView Style="{StaticResource Hairline}" />
            </VerticalStackLayout>
        </DataTemplate>
    </v:BasePage.Resources>

    <Grid>
        <Grid RowDefinitions="Auto,*">
            <!-- Segment tabs (Pay period | Salaries) -->
            <Border Style="{StaticResource SegmentTrack}" Margin="24,14,24,0" HorizontalOptions="Start">
                <HorizontalStackLayout Spacing="2">
                    <Button Text="Pay period" Command="{Binding OpenPeriodTabCommand}" Style="{StaticResource Segment}" AutomationId="PayrollPeriodTab">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding IsPeriodTab}" Value="True">
                                <Setter Property="FontFamily" Value="BarlowSemiBold" />
                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource SurfaceDark}}" />
                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource InkDark}}" />
                            </DataTrigger>
                            <DataTrigger TargetType="Button" Binding="{Binding IsPeriodTab}" Value="False">
                                <Setter Property="FontFamily" Value="BarlowMedium" />
                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LineLight}, Dark={StaticResource PageDark}}" />
                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                    <Button Text="Salaries" Command="{Binding OpenSalariesTabCommand}" Style="{StaticResource Segment}" AutomationId="PayrollSalariesTab">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding IsSalariesTab}" Value="True">
                                <Setter Property="FontFamily" Value="BarlowSemiBold" />
                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource SurfaceDark}}" />
                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource InkDark}}" />
                            </DataTrigger>
                            <DataTrigger TargetType="Button" Binding="{Binding IsSalariesTab}" Value="False">
                                <Setter Property="FontFamily" Value="BarlowMedium" />
                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LineLight}, Dark={StaticResource PageDark}}" />
                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                </HorizontalStackLayout>
            </Border>

            <ScrollView Grid.Row="1">
                <VerticalStackLayout Padding="24,16,24,32" Spacing="16">
                    <c:Banner Kind="notice" Message="{Binding Notice}" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNull}}">
                        <c:Banner Message="{Binding ErrorMessage}" />
                        <Button Grid.Column="1" Text="Try again" Style="{StaticResource SmallOutlineButton}" VerticalOptions="Center" Command="{Binding LoadCommand}" />
                    </Grid>
                    <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" HorizontalOptions="Start" />

                    <!-- PAY PERIOD TAB -->
                    <VerticalStackLayout Spacing="14" IsVisible="{Binding IsPeriodTab}">
                        <Border Style="{StaticResource Panel}">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <VerticalStackLayout Spacing="6" VerticalOptions="Center">
                                    <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                                        <Button Text="‹" Style="{StaticResource SmallOutlineButton}" Command="{Binding PrevPeriodCommand}" WidthRequest="36" AutomationId="PrevPeriod" SemanticProperties.Description="Previous pay period" />
                                        <Label Text="{Binding PeriodLabel}" Style="{StaticResource Heading}" VerticalOptions="Center" />
                                        <Button Text="›" Style="{StaticResource SmallOutlineButton}" Command="{Binding NextPeriodCommand}" WidthRequest="36" AutomationId="NextPeriod" SemanticProperties.Description="Next pay period" />
                                        <c:StatusChip Status="{Binding StatusText}" VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                        <Label Text="{Binding SummaryText}" Style="{StaticResource Muted}" VerticalOptions="Center" />
                                        <Button Text="Set salaries" Style="{StaticResource LinkButton}" Command="{Binding OpenSalariesTabCommand}"
                                                IsVisible="{Binding HasNoSalary}" VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Column="1" HorizontalOptions="End" VerticalOptions="Center" Spacing="2">
                                    <Label Text="Total net pay" Style="{StaticResource Caption}" HorizontalOptions="End" />
                                    <Label Text="{Binding TotalNetText}" Style="{StaticResource Numeral}" FontFamily="BarlowBold" FontSize="28" HorizontalOptions="End" AutomationId="TotalNet" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource TablePanel}">
                            <VerticalStackLayout>
                                <VerticalStackLayout x:Name="PeriodHead">
                                    <Grid Style="{StaticResource TableHead}" ColumnDefinitions="*,140,115,110,110,120,84" ColumnSpacing="12">
                                        <Label Text="Staff member" Style="{StaticResource Caption}" />
                                        <Label Grid.Column="1" Text="Hours (ref.)" Style="{StaticResource Caption}" />
                                        <Label Grid.Column="2" Text="Salary" Style="{StaticResource Caption}" HorizontalOptions="End" />
                                        <Label Grid.Column="3" Text="Bonuses" Style="{StaticResource Caption}" HorizontalOptions="End" />
                                        <Label Grid.Column="4" Text="Deductions" Style="{StaticResource Caption}" HorizontalOptions="End" />
                                        <Label Grid.Column="5" Text="Net pay" Style="{StaticResource Caption}" HorizontalOptions="End" />
                                    </Grid>
                                    <BoxView Style="{StaticResource Hairline}" />
                                </VerticalStackLayout>
                                <c:TableBody Items="{Binding Rows}" Header="{x:Reference PeriodHead}" WideFrom="900"
                                             RowTemplate="{StaticResource PayrollRowTemplate}" CardTemplate="{StaticResource PayrollCardTemplate}">
                                    <c:TableBody.Empty>
                                        <Label Text="No front desk or coach accounts yet. Add them in Users and roles." Style="{StaticResource Muted}" Margin="14" />
                                    </c:TableBody.Empty>
                                </c:TableBody>
                            </VerticalStackLayout>
                        </Border>

                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Button Text="Export PDF" Style="{StaticResource SmallOutlineButton}" Command="{Binding ExportPdfCommand}" AutomationId="ExportPayrollPdf" />
                            <Button Grid.Column="2" Text="Mark as paid" Style="{StaticResource SmallButton}" Command="{Binding MarkPaidCommand}"
                                    IsVisible="{Binding IsDraft}" IsEnabled="{Binding CanMarkPaid}" AutomationId="MarkPayrollPaid" />
                        </Grid>
                    </VerticalStackLayout>

                    <!-- SALARIES TAB -->
                    <VerticalStackLayout Spacing="14" IsVisible="{Binding IsSalariesTab}">
                        <Label Text="Fixed salary per half-month pay period (1st–15th and 16th–end). Draft periods update immediately when a salary changes; paid periods stay locked."
                               Style="{StaticResource Muted}" />

                        <!-- Role-level fixed salaries -->
                        <Border Style="{StaticResource Panel}">
                            <VerticalStackLayout Spacing="10">
                                <Label Text="Set fixed salary by role" Style="{StaticResource SectionTitle}" />
                                <Label Text="Applies to every active account in that role (and any new ones added later)." Style="{StaticResource Caption}" />
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                                    <VerticalStackLayout Spacing="6">
                                        <HorizontalStackLayout Spacing="8">
                                            <c:StatusChip Status="Front desk" />
                                            <Label Text="{Binding EmployeeRoleSalaryStatus}" Style="{StaticResource Caption}" VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <Border Style="{StaticResource Field}" Padding="10,4">
                                                <Entry Text="{Binding EmployeeRoleSalaryInput}" Keyboard="Numeric" Placeholder="₱0.00" AutomationId="EmployeeRoleSalary" SemanticProperties.Description="Front desk fixed salary">
                                                    <Entry.Behaviors><c:NumericOnlyBehavior /></Entry.Behaviors>
                                                </Entry>
                                            </Border>
                                            <Button Grid.Column="1" Text="Apply to all" Style="{StaticResource SmallButton}" Command="{Binding SaveEmployeeRoleSalaryCommand}" AutomationId="SaveEmployeeRoleSalary" />
                                        </Grid>
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Grid.Column="1" Spacing="6">
                                        <HorizontalStackLayout Spacing="8">
                                            <c:StatusChip Status="Coach" />
                                            <Label Text="{Binding CoachRoleSalaryStatus}" Style="{StaticResource Caption}" VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <Border Style="{StaticResource Field}" Padding="10,4">
                                                <Entry Text="{Binding CoachRoleSalaryInput}" Keyboard="Numeric" Placeholder="₱0.00" AutomationId="CoachRoleSalary" SemanticProperties.Description="Coach fixed salary">
                                                    <Entry.Behaviors><c:NumericOnlyBehavior /></Entry.Behaviors>
                                                </Entry>
                                            </Border>
                                            <Button Grid.Column="1" Text="Apply to all" Style="{StaticResource SmallButton}" Command="{Binding SaveCoachRoleSalaryCommand}" AutomationId="SaveCoachRoleSalary" />
                                        </Grid>
                                    </VerticalStackLayout>
                                </Grid>
                                <Label Text="{Binding RoleSalaryError}" Style="{StaticResource FieldError}" IsVisible="{Binding RoleSalaryError, Converter={StaticResource IsNotNull}}" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Style="{StaticResource TablePanel}">
                            <VerticalStackLayout>
                                <VerticalStackLayout x:Name="SalariesHead">
                                    <Grid Style="{StaticResource TableHead}" ColumnDefinitions="1.1*,140,1.1*,230" ColumnSpacing="14">
                                        <Label Text="Staff member" Style="{StaticResource Caption}" />
                                        <Label Grid.Column="1" Text="Salary per period" Style="{StaticResource Caption}" HorizontalOptions="End" />
                                        <Label Grid.Column="2" Text="Last changed" Style="{StaticResource Caption}" />
                                    </Grid>
                                    <BoxView Style="{StaticResource Hairline}" />
                                </VerticalStackLayout>
                                <c:TableBody Items="{Binding StaffSalaries}" Header="{x:Reference SalariesHead}" WideFrom="900"
                                             RowTemplate="{StaticResource SalaryRowTemplate}" CardTemplate="{StaticResource SalaryCardTemplate}">
                                    <c:TableBody.Empty>
                                        <Label Text="No front desk or coach accounts yet. Add them in Users and roles." Style="{StaticResource Muted}" Margin="14" />
                                    </c:TableBody.Empty>
                                </c:TableBody>
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>
        </Grid>

        <!-- Side drawer: person's lines for the period -->
        <BoxView Color="Black" Opacity="{AppThemeBinding Light=0.28, Dark=0.55}" IsVisible="{Binding IsDrawerOpen}">
            <BoxView.GestureRecognizers><TapGestureRecognizer Command="{Binding CloseDrawerCommand}" /></BoxView.GestureRecognizers>
        </BoxView>
        <Border IsVisible="{Binding IsDrawerOpen}" HorizontalOptions="{OnIdiom Phone=Fill, Default=End}" WidthRequest="{OnIdiom Phone=-1, Default=460}"
                StrokeThickness="0" Padding="0"
                BackgroundColor="{AppThemeBinding Light={StaticResource CardLight}, Dark={StaticResource CardDark}}">
            <Border.Shadow><Shadow Brush="Black" Offset="-12,0" Radius="30" Opacity="0.3" /></Border.Shadow>
            <Grid RowDefinitions="Auto,Auto,*">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Padding="22,18,22,12">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="{Binding SelectedRow.FullName}" Style="{StaticResource Heading}" SemanticProperties.HeadingLevel="Level2" />
                        <Label Style="{StaticResource Caption}">
                            <Label.Text>
                                <MultiBinding StringFormat="{}{0} · {1}">
                                    <Binding Path="SelectedRow.RoleLabel" />
                                    <Binding Path="SelectedRow.HoursText" />
                                </MultiBinding>
                            </Label.Text>
                        </Label>
                    </VerticalStackLayout>
                    <Button Grid.Column="1" Text="Close" Style="{StaticResource SmallOutlineButton}" VerticalOptions="Start" Command="{Binding CloseDrawerCommand}" />
                </Grid>
                <BoxView Grid.Row="1" Style="{StaticResource Hairline}" />

                <ScrollView Grid.Row="2">
                    <VerticalStackLayout Padding="22,16" Spacing="14">
                        <Border Style="{StaticResource Panel}" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="Salary per period" Style="{StaticResource Caption}" />
                                    <Label Text="From Salaries · change it there" Style="{StaticResource Caption}" IsVisible="{Binding IsDraft}" />
                                </VerticalStackLayout>
                                <Label Grid.Column="1" Text="{Binding SelectedRow.SalaryText}" FontFamily="BarlowSemiBold" VerticalOptions="Center" />
                            </Grid>
                        </Border>

                        <Label Text="Adjustments" Style="{StaticResource SectionTitle}" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding DrawerLines}" Spacing="8">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:PayrollLineItem">
                                    <Border Style="{StaticResource Panel}" Padding="12,10">
                                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                                            <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                                <Label Text="{Binding KindLabel}" FontFamily="BarlowSemiBold" />
                                                <Label Text="{Binding Note}" Style="{StaticResource Caption}" IsVisible="{Binding Note, Converter={StaticResource IsNotNull}}" />
                                            </VerticalStackLayout>
                                            <Label Grid.Column="1" Text="{Binding AmountText}" FontFamily="BarlowSemiBold" VerticalOptions="Center" />
                                            <Button Grid.Column="2" Text="Remove" Style="{StaticResource LinkButton}" Clicked="OnRemoveLineClicked"
                                                    IsVisible="{Binding CanRemove}" VerticalOptions="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                            <BindableLayout.EmptyView>
                                <Label Text="No bonus or deduction lines yet." Style="{StaticResource Muted}" />
                            </BindableLayout.EmptyView>
                        </VerticalStackLayout>

                        <!-- Add bonus / deduction (Draft only) -->
                        <VerticalStackLayout Spacing="10" IsVisible="{Binding IsDraft}" Margin="0,6,0,0">
                            <BoxView Style="{StaticResource Hairline}" />
                            <Label Text="Add line" Style="{StaticResource SectionTitle}" />
                            <HorizontalStackLayout Spacing="8">
                                <Button Text="Bonus" Style="{StaticResource SmallOutlineButton}" Command="{Binding SetLineKindCommand}" CommandParameter="bonus">
                                    <Button.Triggers>
                                        <DataTrigger TargetType="Button" Binding="{Binding IsBonusKind}" Value="True">
                                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource SurfaceDark}}" />
                                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource InkDark}}" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Button" Binding="{Binding IsBonusKind}" Value="False">
                                            <Setter Property="BackgroundColor" Value="Transparent" />
                                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}" />
                                        </DataTrigger>
                                    </Button.Triggers>
                                </Button>
                                <Button Text="Deduction" Style="{StaticResource SmallOutlineButton}" Command="{Binding SetLineKindCommand}" CommandParameter="deduction">
                                    <Button.Triggers>
                                        <DataTrigger TargetType="Button" Binding="{Binding IsDeductionKind}" Value="True">
                                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource SurfaceDark}}" />
                                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource InkDark}}" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Button" Binding="{Binding IsDeductionKind}" Value="False">
                                            <Setter Property="BackgroundColor" Value="Transparent" />
                                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}" />
                                        </DataTrigger>
                                    </Button.Triggers>
                                </Button>
                            </HorizontalStackLayout>

                            <VerticalStackLayout Spacing="4">
                                <Label Text="Amount (₱)" Style="{StaticResource Caption}" />
                                <Border Style="{StaticResource Field}">
                                    <Entry Text="{Binding LineAmountText}" Keyboard="Numeric" Placeholder="0.00">
                                        <Entry.Behaviors><c:NumericOnlyBehavior /></Entry.Behaviors>
                                    </Entry>
                                </Border>
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="4">
                                <Label Text="Note (required)" Style="{StaticResource Caption}" />
                                <Border Style="{StaticResource Field}">
                                    <Entry Text="{Binding LineNote}" MaxLength="200" Placeholder="e.g. Holiday cover, Cash short shift #20" />
                                </Border>
                            </VerticalStackLayout>

                            <Label Text="{Binding LineError}" Style="{StaticResource FieldError}" IsVisible="{Binding LineError, Converter={StaticResource IsNotNull}}" />
                            <Button Text="Add line" Style="{StaticResource SmallButton}" Command="{Binding AddLineCommand}" HorizontalOptions="Start" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </ScrollView>
            </Grid>
        </Border>
    </Grid>
</v:BasePage>
