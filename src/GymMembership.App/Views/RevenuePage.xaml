<?xml version="1.0" encoding="utf-8" ?>
<v:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
            xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
            xmlns:v="clr-namespace:GymMembership.App.Views"
            xmlns:c="clr-namespace:GymMembership.App.Controls"
            xmlns:vm="clr-namespace:GymMembership.Core.ViewModels;assembly=GymMembership.Core"
            xmlns:m="clr-namespace:GymMembership.Core.Models;assembly=GymMembership.Core"
            x:Class="GymMembership.App.Views.RevenuePage" x:DataType="vm:RevenueViewModel" Title="Revenue">

    <ScrollView MaximumWidthRequest="720">
        <VerticalStackLayout Padding="20,16,20,24" Spacing="14">
            <Label Text="Net receipts: verified payments minus approved refunds, grouped by Manila day, item and payment method. A refund counts on the day it was approved, and is shown against the method the member paid with. The cash drawer on the Cashier page drops only when the repayment is recorded. Payment counts count receipts, not refunds. Voids are excluded." Style="{StaticResource Muted}" />
            <c:Banner Message="{Binding ErrorMessage}" />

            <FlexLayout Wrap="Wrap" AlignItems="End">
                <VerticalStackLayout Spacing="4" Margin="0,0,16,8">
                    <Label Text="From" Style="{StaticResource Caption}" />
                    <Border Style="{StaticResource Field}"><DatePicker Date="{Binding From}" /></Border>
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="4" Margin="0,0,16,8">
                    <Label Text="To" Style="{StaticResource Caption}" />
                    <Border Style="{StaticResource Field}"><DatePicker Date="{Binding To}" /></Border>
                </VerticalStackLayout>
                <Button Text="Show revenue" Style="{StaticResource SmallButton}" Margin="0,0,0,8" Command="{Binding LoadCommand}" />
            </FlexLayout>

            <Border Style="{StaticResource Panel}" Padding="24,20">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Net in this period" Style="{StaticResource Caption}" />
                    <Label Text="{Binding TotalText}" Style="{StaticResource Numeral}" />
                </VerticalStackLayout>
            </Border>

            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Rows}" Spacing="8">
                <BindableLayout.EmptyView><Label Text="No receipts or approved refunds in this period." Style="{StaticResource Muted}" /></BindableLayout.EmptyView>
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="m:RevenueRow">
                        <Border Style="{StaticResource Panel}" Padding="16,12">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="{Binding Day, StringFormat='{0:ddd d MMM}'}" />
                                    <Label Style="{StaticResource Caption}">
                                        <Label.Text>
                                            <MultiBinding StringFormat="{}{0} · {1} · {2} payment(s)">
                                                <Binding Path="Kind" /><Binding Path="Method" /><Binding Path="Payments" />
                                            </MultiBinding>
                                        </Label.Text>
                                    </Label>
                                </VerticalStackLayout>
                                <Label Grid.Column="1" Text="{Binding Total, StringFormat='₱{0:N2}'}" Style="{StaticResource Heading}" VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</v:BasePage>
