<?xml version="1.0" encoding="utf-8" ?>
<v:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
            xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
            xmlns:v="clr-namespace:GymMembership.App.Views"
            xmlns:c="clr-namespace:GymMembership.App.Controls"
            xmlns:vm="clr-namespace:GymMembership.Core.ViewModels;assembly=GymMembership.Core"
            xmlns:m="clr-namespace:GymMembership.Core.Models;assembly=GymMembership.Core"
            x:Class="GymMembership.App.Views.ShiftsPage" x:Name="ShiftsRoot" x:DataType="vm:ShiftsViewModel" Title="My shifts">

    <v:BasePage.Resources>
        <DataTemplate x:Key="ShiftRow" x:DataType="m:ShiftPost">
            <VerticalStackLayout>
                <Grid ColumnDefinitions="1.3*,1.4*,1.4*,Auto" ColumnSpacing="12" Padding="14,10">
                    <Label Text="{Binding Start, Converter={StaticResource LocalDate}, ConverterParameter='dddd d MMM'}" FontFamily="BarlowSemiBold" VerticalOptions="Center" LineBreakMode="TailTruncation" />
                    <Label Grid.Column="1" VerticalOptions="Center">
                        <Label.Text>
                            <MultiBinding StringFormat="{}{0} to {1}">
                                <Binding Path="Start" Converter="{StaticResource LocalDate}" ConverterParameter="h:mm tt" />
                                <Binding Path="End" Converter="{StaticResource LocalDate}" ConverterParameter="h:mm tt" />
                            </MultiBinding>
                        </Label.Text>
                    </Label>
                    <Label Grid.Column="2" Text="{Binding Note, TargetNullValue='—'}" Style="{StaticResource Muted}" VerticalOptions="Center" LineBreakMode="TailTruncation" />
                    <c:StatusChip Grid.Column="3" Status="{Binding Status}" VerticalOptions="Center" />
                </Grid>
                <BoxView Style="{StaticResource Hairline}" />
            </VerticalStackLayout>
        </DataTemplate>
        <DataTemplate x:Key="ShiftCard" x:DataType="m:ShiftPost">
            <VerticalStackLayout Spacing="6" Padding="14,12">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <Label Text="{Binding Start, Converter={StaticResource LocalDate}, ConverterParameter='dddd d MMM'}" FontFamily="BarlowSemiBold" VerticalOptions="Center" />
                    <c:StatusChip Grid.Column="1" Status="{Binding Status}" VerticalOptions="Center" />
                </Grid>
                <Label Style="{StaticResource Caption}">
                    <Label.Text>
                        <MultiBinding StringFormat="{}{0} to {1}">
                            <Binding Path="Start" Converter="{StaticResource LocalDate}" ConverterParameter="h:mm tt" />
                            <Binding Path="End" Converter="{StaticResource LocalDate}" ConverterParameter="h:mm tt" />
                        </MultiBinding>
                    </Label.Text>
                </Label>
                <Label Text="{Binding Note}" Style="{StaticResource Muted}" IsVisible="{Binding Note, Converter={StaticResource HasText}}" />
                <BoxView Style="{StaticResource Hairline}" Margin="0,4,0,0" />
            </VerticalStackLayout>
        </DataTemplate>
    </v:BasePage.Resources>

    <ScrollView MaximumWidthRequest="{StaticResource PageWidth}">
        <VerticalStackLayout Padding="{OnIdiom Phone='16,12,16,24', Default='16,12,16,20'}" Spacing="14">
            <!-- Fix 3 (0151, S2): the gym sets coaches' shifts on its Scheduling page; coaches see them here -->
            <Label Text="The gym sets your shifts. Members can book you during them. Ask the admin if a shift needs to change." Style="{StaticResource Muted}" />
            <c:Banner Message="{Binding ErrorMessage}" />
            <c:Banner Kind="notice" Message="{Binding Notice}" />
            <c:CoachCalendarView BindingContext="{Binding Calendar}" ShowAmenities="False" IsVisible="{Binding ., Converter={StaticResource IsNotNull}}">
                <c:CoachCalendarView.MainFooter>
                    <VerticalStackLayout Spacing="10" BindingContext="{Binding Source={x:Reference ShiftsRoot}, Path=BindingContext}" x:DataType="vm:ShiftsViewModel">
                        <Label Text="Upcoming shifts" Style="{StaticResource SectionTitle}" Margin="0" />
                        <Border Style="{StaticResource TablePanel}">
                            <VerticalStackLayout>
                                <VerticalStackLayout x:Name="ShiftsHead" IsVisible="{OnIdiom Phone=False, Default=True}">
                                    <Grid Style="{StaticResource TableHead}" ColumnDefinitions="1.3*,1.4*,1.4*,Auto" ColumnSpacing="12">
                                        <Label Text="Date" Style="{StaticResource Caption}" />
                                        <Label Grid.Column="1" Text="Hours" Style="{StaticResource Caption}" />
                                        <Label Grid.Column="2" Text="Note" Style="{StaticResource Caption}" />
                                        <Label Grid.Column="3" Text="Status" Style="{StaticResource Caption}" />
                                    </Grid>
                                    <BoxView Style="{StaticResource Hairline}" />
                                </VerticalStackLayout>
                                <c:TableBody Items="{Binding Shifts}" Header="{x:Reference ShiftsHead}" WideFrom="620"
                                             RowTemplate="{StaticResource ShiftRow}" CardTemplate="{StaticResource ShiftCard}">
                                    <c:TableBody.Empty><Label Text="No shifts yet. The admin adds them on the Scheduling page." Style="{StaticResource Muted}" Margin="14" /></c:TableBody.Empty>
                                </c:TableBody>
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </c:CoachCalendarView.MainFooter>
            </c:CoachCalendarView>
        </VerticalStackLayout>
    </ScrollView>
</v:BasePage>
