<?xml version="1.0" encoding="utf-8" ?>
<v:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
            xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
            xmlns:v="clr-namespace:GymMembership.App.Views"
            xmlns:c="clr-namespace:GymMembership.App.Controls"
            xmlns:vm="clr-namespace:GymMembership.Core.ViewModels;assembly=GymMembership.Core"
            xmlns:m="clr-namespace:GymMembership.Core.Models;assembly=GymMembership.Core"
            x:Class="GymMembership.App.Views.ShiftsPage" x:DataType="vm:ShiftsViewModel" Title="My shifts">

    <ScrollView MaximumWidthRequest="{StaticResource PageWidth}">
        <VerticalStackLayout Padding="{OnIdiom Phone='16,12,16,24', Default='16,12,16,20'}" Spacing="14">
            <Label Text="Post when you are on the gym floor. Your trainees are notified and members can see it on the Coaches page." Style="{StaticResource Muted}" />
            <c:Banner Message="{Binding ErrorMessage}" />
            <c:Banner Kind="notice" Message="{Binding Notice}" />
            <c:SideLayout>
                <!-- main: upcoming shifts -->
                <VerticalStackLayout Spacing="10">
                    <Label Text="Upcoming shifts" Style="{StaticResource SectionTitle}" Margin="0" />
                                <c:CardGrid Columns="{OnIdiom Phone=1, Default=3}" BindableLayout.ItemsSource="{Binding Shifts}">
                                    <BindableLayout.EmptyView><Label Text="No shifts posted yet." Style="{StaticResource Muted}" /></BindableLayout.EmptyView>
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="m:ShiftPost">
                                            <Border Style="{StaticResource Panel}">
                                                <VerticalStackLayout Spacing="8">
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                                        <VerticalStackLayout Spacing="2">
                                                            <Label Style="{StaticResource Heading}">
                                                                <Label.Text>
                                                                    <MultiBinding StringFormat="{}{0} to {1}">
                                                                        <Binding Path="Start" Converter="{StaticResource LocalDate}" ConverterParameter="dddd d MMM, h:mm tt" />
                                                                        <Binding Path="End" Converter="{StaticResource LocalDate}" ConverterParameter="h:mm tt" />
                                                                    </MultiBinding>
                                                                </Label.Text>
                                                            </Label>
                                                            <Label Text="{Binding Note}" Style="{StaticResource Muted}" IsVisible="{Binding Note, Converter={StaticResource HasText}}" />
                                                        </VerticalStackLayout>
                                                        <c:StatusChip Grid.Column="1" Status="{Binding Status}" VerticalOptions="Start" />
                                                    </Grid>
                                                    <Button Text="Cancel shift" Style="{StaticResource SmallOutlineButton}" HorizontalOptions="Start"
                                                            Clicked="OnCancel">
                                                        <Button.Triggers>
                                                            <DataTrigger TargetType="Button" Binding="{Binding Status}" Value="cancelled"><Setter Property="IsVisible" Value="False" /></DataTrigger>
                                                        </Button.Triggers>
                                                    </Button>
                                                </VerticalStackLayout>
                                            </Border>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </c:CardGrid>
                </VerticalStackLayout>
                <!-- side: hiring on or off, then post a shift -->
                <VerticalStackLayout Spacing="12">
                    <Button Text="{Binding HiringButtonText}" Style="{StaticResource SmallOutlineButton}" HorizontalOptions="Start"
                                        Command="{Binding ToggleHiringCommand}"
                                        SemanticProperties.Hint="Pausing keeps you listed but members cannot hire you until you resume" />

                                <Border Style="{StaticResource SidePanel}">
                                    <VerticalStackLayout Spacing="12">
                                        <c:CardTitle Icon="calendar-clock" Text="Post a shift" />
                                        <FlexLayout Wrap="Wrap" AlignItems="End">
                                            <VerticalStackLayout Spacing="4" Margin="0,0,16,8">
                                                <Label Text="Date" Style="{StaticResource Caption}" />
                                                <Border Style="{StaticResource Field}"><DatePicker Date="{Binding Date}" MinimumDate="{x:Static x:DateTime.Today}" /></Border>
                                            </VerticalStackLayout>
                                            <VerticalStackLayout Spacing="4" Margin="0,0,16,8">
                                                <Label Text="Starts" Style="{StaticResource Caption}" />
                                                <Border Style="{StaticResource Field}"><TimePicker Time="{Binding Time}" /></Border>
                                            </VerticalStackLayout>
                                            <VerticalStackLayout Spacing="4" Margin="0,0,0,8">
                                                <Label Text="Hours" Style="{StaticResource Caption}" />
                                                <Border Style="{StaticResource Field}">
                                                    <Picker ItemsSource="{Binding HoursOptions}" SelectedItem="{Binding Hours}" WidthRequest="90" />
                                                </Border>
                                            </VerticalStackLayout>
                                        </FlexLayout>
                                        <VerticalStackLayout Spacing="4">
                                            <Label Text="Note (optional)" Style="{StaticResource Caption}" />
                                            <Border Style="{StaticResource Field}"><Entry Text="{Binding Note}" Placeholder="What you will be running" /></Border>
                                        </VerticalStackLayout>
                                        <Button Text="Post shift" Style="{StaticResource SmallButton}" HorizontalOptions="Start" Command="{Binding PostCommand}" />
                                    </VerticalStackLayout>
                                </Border>
                </VerticalStackLayout>
            </c:SideLayout>
        </VerticalStackLayout>
    </ScrollView>
</v:BasePage>
