<?xml version="1.0" encoding="utf-8" ?>
<v:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
            xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
            xmlns:v="clr-namespace:GymMembership.App.Views"
            xmlns:c="clr-namespace:GymMembership.App.Controls"
            xmlns:svc="clr-namespace:GymMembership.Core.Services;assembly=GymMembership.Core"
            xmlns:vm="clr-namespace:GymMembership.Core.ViewModels;assembly=GymMembership.Core"
            x:Class="GymMembership.App.Views.RegisterPage" x:DataType="vm:RegisterViewModel"
            Title="Create an account">

    <ScrollView>
        <VerticalStackLayout Padding="{OnIdiom Phone='24,48,24,24', Default='64,40'}" Spacing="18" MaximumWidthRequest="480"
                             VerticalOptions="{OnIdiom Phone=Start, Default=Center}" HorizontalOptions="Fill">
            <c:LaneView DashColor="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}"
                        TrackColor="{AppThemeBinding Light={StaticResource LineLight}, Dark={StaticResource LineDark}}" />

            <VerticalStackLayout Spacing="6">
                <Label Text="Create an account" Style="{StaticResource Display}" SemanticProperties.HeadingLevel="Level1" />
                <Label Text="You can look around right away. Pick a package and get your payment verified to unlock amenities, coaches, messages and sessions." Style="{StaticResource Muted}" />
            </VerticalStackLayout>

            <c:Banner Message="{Binding ErrorMessage}" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <VerticalStackLayout Spacing="6">
                    <Label Text="First name" Style="{StaticResource Caption}" />
                    <Border Style="{StaticResource Field}"><Entry Text="{Binding FirstName}" TextChanged="OnNameChanged" MaxLength="{x:Static svc:AccountRules.MaxName}" ReturnType="Next" SemanticProperties.Description="First name" /></Border>
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1" Spacing="6">
                    <Label Text="Last name" Style="{StaticResource Caption}" />
                    <Border Style="{StaticResource Field}"><Entry Text="{Binding LastName}" TextChanged="OnNameChanged" MaxLength="{x:Static svc:AccountRules.MaxName}" ReturnType="Next" SemanticProperties.Description="Last name" /></Border>
                </VerticalStackLayout>
            </Grid>
            <VerticalStackLayout Spacing="6">
                <Label Text="Email" Style="{StaticResource Caption}" />
                <Border Style="{StaticResource Field}"><Entry Text="{Binding Email}" MaxLength="{x:Static svc:AccountRules.MaxEmail}" Keyboard="Email" ReturnType="Next" SemanticProperties.Description="Email address" /></Border>
            </VerticalStackLayout>
            <VerticalStackLayout Spacing="6">
                <Label Text="Password (6 to 64 characters)" Style="{StaticResource Caption}" />
                <Border Style="{StaticResource Field}"><Grid ColumnDefinitions="*,Auto"><Entry x:Name="PasswordBox" Text="{Binding Password}" MaxLength="{x:Static svc:AccountRules.MaxPassword}" IsPassword="True" ReturnType="Next" SemanticProperties.Description="Password" /><c:EyeButton Grid.Column="1" Entry="{x:Reference PasswordBox}" /></Grid></Border>
            </VerticalStackLayout>
            <VerticalStackLayout Spacing="6">
                <Label Text="Repeat password" Style="{StaticResource Caption}" />
                <Border Style="{StaticResource Field}">
                    <Grid ColumnDefinitions="*,Auto"><Entry x:Name="ConfirmPasswordBox" Text="{Binding ConfirmPassword}" MaxLength="{x:Static svc:AccountRules.MaxPassword}" IsPassword="True" ReturnType="Done" ReturnCommand="{Binding RegisterCommand}" SemanticProperties.Description="Repeat password" /><c:EyeButton Grid.Column="1" Entry="{x:Reference ConfirmPasswordBox}" /></Grid>
                </Border>
            </VerticalStackLayout>

            <Button Text="Create account" Margin="0,6,0,0" Command="{Binding RegisterCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}" />
            <Button Text="I already have an account" Style="{StaticResource OutlineButton}" Command="{Binding BackToSignInCommand}" />
        </VerticalStackLayout>
    </ScrollView>
</v:BasePage>
