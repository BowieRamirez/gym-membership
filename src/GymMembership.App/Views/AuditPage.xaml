<?xml version="1.0" encoding="utf-8" ?>
<v:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
            xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
            xmlns:v="clr-namespace:GymMembership.App.Views"
            xmlns:c="clr-namespace:GymMembership.App.Controls"
            xmlns:vm="clr-namespace:GymMembership.Core.ViewModels;assembly=GymMembership.Core"
            xmlns:m="clr-namespace:GymMembership.Core.Models;assembly=GymMembership.Core"
            x:Class="GymMembership.App.Views.AuditPage" x:DataType="vm:AuditViewModel" Title="Logs &amp; Archive">

    <v:BasePage.Resources>
        <!-- wide: one row per entry, the columns of the owner's table (items 5 and 14) -->
        <DataTemplate x:Key="AuditRowTemplate" x:DataType="m:AuditRecord">
            <VerticalStackLayout>
                <Grid Style="{StaticResource TableRow}" ColumnDefinitions="134,*,100,112,96,*,104,*,1.4*">
                    <Label Text="{Binding WhenText}" Style="{StaticResource Muted}" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="{Binding ActorName}" VerticalOptions="Center" />
                    <Label Grid.Column="2" Text="{Binding RoleText}" Style="{StaticResource Muted}" VerticalOptions="Center" />
                    <Label Grid.Column="3" Text="{Binding IpAddress}" Style="{StaticResource Muted}" VerticalOptions="Center" LineBreakMode="TailTruncation" />
                    <Label Grid.Column="4" Text="{Binding AreaText}" Style="{StaticResource Muted}" VerticalOptions="Center" />
                    <Label Grid.Column="5" Text="{Binding ActionText}" FontFamily="BarlowSemiBold" VerticalOptions="Center" />
                    <Label Grid.Column="6" Text="{Binding ObjectTypeText}" Style="{StaticResource Muted}" VerticalOptions="Center" />
                    <Label Grid.Column="7" Text="{Binding ObjectText}" VerticalOptions="Center" LineBreakMode="TailTruncation" />
                    <Label Grid.Column="8" Text="{Binding DetailsText}" Style="{StaticResource Muted}" VerticalOptions="Center" MaxLines="2" LineBreakMode="TailTruncation"
                           ToolTipProperties.Text="{Binding DetailsText}" />
                </Grid>
                <BoxView Style="{StaticResource Hairline}" />
            </VerticalStackLayout>
        </DataTemplate>
        <!-- narrow and phones: the same facts stacked -->
        <DataTemplate x:Key="AuditCardTemplate" x:DataType="m:AuditRecord">
            <VerticalStackLayout>
                <VerticalStackLayout Padding="14,10" Spacing="2">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <Label Text="{Binding ActionText}" FontFamily="BarlowSemiBold" />
                        <Label Grid.Column="1" Text="{Binding WhenText}" Style="{StaticResource Caption}" />
                    </Grid>
                    <Label Style="{StaticResource Muted}">
                        <Label.Text>
                            <MultiBinding StringFormat="{}{0}, {1}  {2}">
                                <Binding Path="ActorName" /><Binding Path="RoleText" /><Binding Path="IpAddress" />
                            </MultiBinding>
                        </Label.Text>
                    </Label>
                    <Label Style="{StaticResource Caption}">
                        <Label.Text>
                            <MultiBinding StringFormat="{}{0}: {1}">
                                <Binding Path="ObjectTypeText" /><Binding Path="ObjectText" />
                            </MultiBinding>
                        </Label.Text>
                    </Label>
                    <Label Text="{Binding DetailsText}" Style="{StaticResource Caption}" />
                </VerticalStackLayout>
                <BoxView Style="{StaticResource Hairline}" />
            </VerticalStackLayout>
        </DataTemplate>
    </v:BasePage.Resources>

    <Grid RowDefinitions="Auto,*">
        <HorizontalStackLayout Padding="20,12,20,0" Spacing="10" MaximumWidthRequest="{StaticResource PageWidth}">
            <Button Text="Audit log" Command="{Binding OpenLogsCommand}" Style="{StaticResource SmallOutlineButton}" AutomationId="OpenLogs" />
            <Button Text="Archive" Command="{Binding OpenArchiveCommand}" IsVisible="{Binding HasArchive}" Style="{StaticResource SmallOutlineButton}" AutomationId="OpenArchive" />
        </HorizontalStackLayout>
        <Grid Grid.Row="1" IsVisible="{Binding ShowArchive}">
            <c:ArchivePanel BindingContext="{Binding Archive}" />
        </Grid>

        <ScrollView Grid.Row="1" IsVisible="{Binding ShowLogs}">
            <!-- full width, left edge in line with the Audit log and Archive buttons: nine columns need the room -->
            <VerticalStackLayout Padding="{OnIdiom Phone='16,12,16,24', Default='20,12,20,20'}" Spacing="12">
                <Label Text="Sensitive actions, newest first, 10 to a page. Entries can't be edited. IP addresses are kept for 90 days." Style="{StaticResource Muted}" />
                <c:Banner Message="{Binding ErrorMessage}" />
                <c:Banner Kind="notice" Message="{Binding Notice}" />

                <!-- filters (D7), then export of everything they match -->
                <Border Style="{StaticResource Panel}">
                    <VerticalStackLayout Spacing="10">
                        <FlexLayout Wrap="Wrap" AlignItems="End">
                            <VerticalStackLayout WidthRequest="220" Margin="0,0,12,8" Spacing="4">
                                <Label Text="User" Style="{StaticResource Caption}" />
                                <Border Style="{StaticResource Field}"><Entry Text="{Binding User}" Placeholder="Part of a name" ReturnCommand="{Binding ApplyCommand}" AutomationId="AuditUser" /></Border>
                            </VerticalStackLayout>
                            <VerticalStackLayout WidthRequest="190" Margin="0,0,12,8" Spacing="4">
                                <Label Text="Action type" Style="{StaticResource Caption}" />
                                <Picker SemanticProperties.Description="Action type" ItemsSource="{Binding Areas}" SelectedIndex="{Binding AreaIndex}" AutomationId="AuditArea" />
                            </VerticalStackLayout>
                            <VerticalStackLayout WidthRequest="190" Margin="0,0,12,8" Spacing="4">
                                <Label Text="Object type" Style="{StaticResource Caption}" />
                                <Picker SemanticProperties.Description="Object type" ItemsSource="{Binding ObjectTypes}" SelectedIndex="{Binding ObjectIndex}" AutomationId="AuditObject" />
                            </VerticalStackLayout>
                            <HorizontalStackLayout Margin="0,0,12,14" Spacing="8">
                                <Switch IsToggled="{Binding UseDates}" AutomationId="AuditUseDates" />
                                <Label Text="Dates (Manila)" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                            <VerticalStackLayout Margin="0,0,12,8" Spacing="4" IsVisible="{Binding UseDates}"><Label Text="From" Style="{StaticResource Caption}" /><DatePicker Date="{Binding From}" /></VerticalStackLayout>
                            <VerticalStackLayout Margin="0,0,12,8" Spacing="4" IsVisible="{Binding UseDates}"><Label Text="Through" Style="{StaticResource Caption}" /><DatePicker Date="{Binding To}" /></VerticalStackLayout>
                        </FlexLayout>
                        <FlexLayout Wrap="Wrap">
                            <Button Text="Apply filters" Command="{Binding ApplyCommand}" Style="{StaticResource SmallButton}" Margin="0,0,8,0" AutomationId="AuditApply" />
                            <Button Text="Clear filters" Command="{Binding ClearFiltersCommand}" Style="{StaticResource SmallOutlineButton}" Margin="0,0,8,0" AutomationId="AuditClear" />
                            <Button Text="Export CSV" Command="{Binding ExportCommand}" Style="{StaticResource SmallOutlineButton}" AutomationId="AuditExport"
                                    ToolTipProperties.Text="Every entry the filters match, not just this page" />
                        </FlexLayout>
                    </VerticalStackLayout>
                </Border>

                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
                <Border Style="{StaticResource TablePanel}">
                    <VerticalStackLayout>
                        <VerticalStackLayout x:Name="AuditHead" IsVisible="{OnIdiom Phone=False, Default=True}">
                            <Grid Style="{StaticResource TableHead}" ColumnDefinitions="134,*,100,112,96,*,104,*,1.4*">
                                <Label Text="Date and time" Style="{StaticResource Caption}" />
                                <Label Grid.Column="1" Text="User" Style="{StaticResource Caption}" />
                                <Label Grid.Column="2" Text="Role" Style="{StaticResource Caption}" />
                                <Label Grid.Column="3" Text="IP address" Style="{StaticResource Caption}" />
                                <Label Grid.Column="4" Text="Action type" Style="{StaticResource Caption}" />
                                <Label Grid.Column="5" Text="Action" Style="{StaticResource Caption}" />
                                <Label Grid.Column="6" Text="Object type" Style="{StaticResource Caption}" />
                                <Label Grid.Column="7" Text="Object" Style="{StaticResource Caption}" />
                                <Label Grid.Column="8" Text="Change details" Style="{StaticResource Caption}" />
                            </Grid>
                            <BoxView Style="{StaticResource Hairline}" />
                        </VerticalStackLayout>
                        <c:TableBody BindableLayout.ItemsSource="{Binding Entries}" Header="{x:Reference AuditHead}" WideFrom="1150"
                                     RowTemplate="{StaticResource AuditRowTemplate}" CardTemplate="{StaticResource AuditCardTemplate}"
                                     BindableLayout.ItemTemplate="{OnIdiom Phone={StaticResource AuditCardTemplate}, Default={StaticResource AuditRowTemplate}}" />
                        <Label Text="No entries match these filters." Style="{StaticResource Muted}" Margin="14" IsVisible="{Binding IsEmpty}" AutomationId="AuditEmpty" />
                    </VerticalStackLayout>
                </Border>

                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                    <Label Text="{Binding PageText}" Style="{StaticResource Muted}" VerticalOptions="Center" AutomationId="AuditPage" />
                    <Button Grid.Column="1" Text="Previous" Command="{Binding PreviousCommand}" Style="{StaticResource SmallOutlineButton}" AutomationId="AuditPrevious" />
                    <Button Grid.Column="2" Text="Next" Command="{Binding NextCommand}" Style="{StaticResource SmallOutlineButton}" AutomationId="AuditNext" />
                </Grid>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</v:BasePage>
