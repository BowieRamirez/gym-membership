<?xml version="1.0" encoding="utf-8" ?>
<v:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
            xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
            xmlns:v="clr-namespace:GymMembership.App.Views"
            xmlns:c="clr-namespace:GymMembership.App.Controls"
            xmlns:vm="clr-namespace:GymMembership.Core.ViewModels;assembly=GymMembership.Core"
            xmlns:svc="clr-namespace:GymMembership.Core.Services;assembly=GymMembership.Core"
            xmlns:m="clr-namespace:GymMembership.Core.Models;assembly=GymMembership.Core"
            x:Class="GymMembership.App.Views.MessagesPage" x:DataType="vm:MessengerViewModel" Title="Messages">

    <!-- Desktop: the list (360 wide) beside the chat. Phone: one at a time, the list first (the code-behind sets the columns). -->
    <Grid x:Name="Root" ColumnDefinitions="360,*" RowDefinitions="Auto,*">

        <c:Banner Grid.ColumnSpan="2" Message="{Binding ErrorMessage}" Margin="16,12,16,0" />

        <!-- ===== conversations ===== -->
        <!-- the conversation list sits in a card beside the chat -->
        <Border Grid.Row="1" Style="{StaticResource Panel}" Padding="0" Margin="12,12,0,12" IsVisible="{Binding ShowList}">
        <Grid x:Name="ListPane" RowDefinitions="Auto,Auto,Auto,Auto,*" RowSpacing="10" Padding="14,12">
            <Border Style="{StaticResource Field}">
                <Entry Text="{Binding SearchText}" Placeholder="Search people and messages" ClearButtonVisibility="WhileEditing" SemanticProperties.Description="Search" />
            </Border>

            <!-- a member's two conversations, as chips (the yellow one is open) -->
            <HorizontalStackLayout Grid.Row="1" Spacing="8" IsVisible="{Binding HasTabs}">
                <Button Text="{Binding CoachTabText}" Style="{StaticResource FilterChip}" Command="{Binding ShowTabCommand}" CommandParameter="coach">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding Tab}" Value="coach">
                            <Setter Property="Style" Value="{StaticResource FilterChipOn}" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
                <Button Text="{Binding StaffTabText}" Style="{StaticResource FilterChip}" Command="{Binding ShowTabCommand}" CommandParameter="support">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding Tab}" Value="support">
                            <Setter Property="Style" Value="{StaticResource FilterChipOn}" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
            </HorizontalStackLayout>

            <!-- front desk: which members' conversations -->
            <HorizontalStackLayout Grid.Row="2" Spacing="8" IsVisible="{Binding HasFilters}">
                <Button Text="Open" Style="{StaticResource FilterChip}" Command="{Binding ShowFilterCommand}" CommandParameter="open">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding Filter}" Value="open">
                            <Setter Property="Style" Value="{StaticResource FilterChipOn}" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
                <Button Text="Mine" Style="{StaticResource FilterChip}" Command="{Binding ShowFilterCommand}" CommandParameter="mine">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding Filter}" Value="mine">
                            <Setter Property="Style" Value="{StaticResource FilterChipOn}" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
                <Button Text="Closed" Style="{StaticResource FilterChip}" Command="{Binding ShowFilterCommand}" CommandParameter="closed">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding Filter}" Value="closed">
                            <Setter Property="Style" Value="{StaticResource FilterChipOn}" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
            </HorizontalStackLayout>

            <!-- what the search found inside messages (names are matched in the list below) -->
            <ScrollView Grid.Row="3" MaximumHeightRequest="240" IsVisible="{Binding HasHits}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="In messages" Style="{StaticResource Caption}" />
                    <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Hits}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="m:ChatSearchHit">
                                <Border Style="{StaticResource Row}" Padding="12,10">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnOpenHit" />
                                    </Border.GestureRecognizers>
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="{Binding WithName}" FontFamily="BarlowSemiBold" />
                                        <Label Text="{Binding Snippet}" Style="{StaticResource Muted}" LineBreakMode="TailTruncation" MaxLines="2" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>

            <CollectionView Grid.Row="4" ItemsSource="{Binding Threads}">
                <CollectionView.EmptyView>
                    <Label Text="{Binding EmptyListText}" Style="{StaticResource Muted}" Margin="0,8" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:ThreadItem">
                        <c:ThreadRowView Margin="0,0,0,8">
                            <c:ThreadRowView.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnOpen" />
                            </c:ThreadRowView.GestureRecognizers>
                        </c:ThreadRowView>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
        </Border>

        <!-- ===== the open conversation ===== -->
        <Grid x:Name="ChatPane" Grid.Row="1" Grid.Column="1" IsVisible="{Binding ShowChat}">
            <Label Text="Choose a conversation to read and reply." Style="{StaticResource Muted}" Margin="20,24"
                   IsVisible="{Binding HasChat, Converter={StaticResource Not}}" />

            <Grid RowDefinitions="Auto,Auto,*,Auto" IsVisible="{Binding HasChat}">
                <!-- who you are talking to, and for staff: take, release, close -->
                <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="12" Padding="16,12">
                    <!-- phones: a back arrow, as in any Android app bar, not a "Back" pill -->
                    <Grid WidthRequest="44" HeightRequest="44" IsVisible="{Binding IsCompact}" VerticalOptions="Center">
                        <Button BackgroundColor="Transparent" BorderWidth="0" Padding="0" Command="{Binding BackCommand}" SemanticProperties.Description="Back to conversations" />
                        <c:IconView Icon="chevron-left" Ghost="True" Size="24" HorizontalOptions="Center" VerticalOptions="Center" InputTransparent="True" />
                    </Grid>
                    <c:Avatar Grid.Column="1" Letters="{Binding Selected.Letters}" Url="{Binding Selected.AvatarUrl}" Diameter="40" VerticalOptions="Center" />
                    <VerticalStackLayout Grid.Column="2" VerticalOptions="Center">
                        <Label Text="{Binding Selected.Thread.WithName}" Style="{StaticResource Heading}" LineBreakMode="TailTruncation" />
                        <Label Text="{Binding Selected.Subtitle}" Style="{StaticResource Caption}" IsVisible="{Binding Selected.Subtitle, Converter={StaticResource HasText}}" />
                        <Label Text="{Binding StatusLine}" Style="{StaticResource Caption}" IsVisible="{Binding StatusLine, Converter={StaticResource HasText}}"
                               SemanticProperties.Description="{Binding StatusLine}" />
                    </VerticalStackLayout>
                    <HorizontalStackLayout Grid.Column="3" Spacing="8" VerticalOptions="Center">
                        <Button Text="Take" Style="{StaticResource SmallButton}" Command="{Binding TakeCommand}" IsVisible="{Binding CanTake}" />
                        <Button Text="Release" Style="{StaticResource SmallOutlineButton}" Command="{Binding ReleaseCommand}" IsVisible="{Binding CanRelease}" />
                        <Button Text="Close chat" Style="{StaticResource SmallOutlineButton}" Command="{Binding CloseChatCommand}" IsVisible="{Binding CanClose}" />
                        <Button Text="Reopen" Style="{StaticResource SmallOutlineButton}" Command="{Binding ReopenCommand}" IsVisible="{Binding CanReopen}" />
                    </HorizontalStackLayout>
                </Grid>

                <Button Grid.Row="1" Text="Load earlier messages" Style="{StaticResource SmallOutlineButton}" Command="{Binding LoadEarlierCommand}"
                        IsVisible="{Binding HasMore}" HorizontalOptions="Center" Margin="0,0,0,10" />

                <!-- Your messages sit right on the highlight colour; theirs sit left on a panel -->
                <CollectionView Grid.Row="2" ItemsSource="{Binding Bubbles}" ItemsUpdatingScrollMode="KeepLastItemInView" Margin="16,0">
                    <CollectionView.EmptyView>
                        <Label Text="No messages yet. Say hello below." Style="{StaticResource Muted}" />
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="svc:ChatBubble">
                            <!-- the grid fills the row; the bubble inside it sits left or right (a list row ignores its own alignment on Windows) -->
                            <Grid>
                                <Border Style="{StaticResource Panel}" Padding="14,10" Margin="0,0,0,8" MaximumWidthRequest="460"
                                        HorizontalOptions="Start" StrokeShape="RoundRectangle 14,14,14,4">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding Mine}" Value="True">
                                            <Setter Property="HorizontalOptions" Value="End" />
                                            <Setter Property="StrokeShape" Value="RoundRectangle 14,14,4,14" />
                                            <!-- the highlight flip (D23): black in light, yellow in dark (was a near-white block in dark until the 9.6 polish) -->
                                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource Signal}}" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <VerticalStackLayout Spacing="3">
                                        <!-- front desk only, for staff: which of them wrote it -->
                                        <Label Text="{Binding Line.SenderName}" Style="{StaticResource Caption}" FontFamily="BarlowSemiBold"
                                               IsVisible="{Binding Line.SenderName, Converter={StaticResource HasText}}" />
                                        <!-- a photo, when the message has one: a fixed crop with rounded corners; if no link could be made, say so instead of leaving a gap -->
                                        <Border IsVisible="{Binding ShowPhoto}" StrokeThickness="0" StrokeShape="RoundRectangle 10" HorizontalOptions="Start">
                                            <Image Source="{Binding PhotoUrl}" Aspect="AspectFill" WidthRequest="240" HeightRequest="170" SemanticProperties.Description="Photo in this message" />
                                        </Border>
                                        <Label Text="Photo unavailable" Style="{StaticResource Caption}" IsVisible="{Binding PhotoMissing}">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding Mine}" Value="True">
                                                    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PageDark}}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                        <Label Text="{Binding Line.Body}" IsVisible="{Binding HasText}">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding Mine}" Value="True">
                                                    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PageDark}}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                        <!-- time, and under what you sent: Sent, Delivered or Read -->
                                        <Label Text="{Binding Line.SentAt, Converter={StaticResource LocalDate}, ConverterParameter='ddd d MMM, h:mm tt'}"
                                               Style="{StaticResource Caption}" FontSize="12" HorizontalOptions="End">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding Mine}" Value="True">
                                                    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PageDark}}" />
                                                    <Setter Property="Opacity" Value="0.75" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                        <Label Text="{Binding Status}" Style="{StaticResource Caption}" FontSize="12" HorizontalOptions="End"
                                               IsVisible="{Binding Mine}" TextColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PageDark}}" Opacity="0.75" />
                                    </VerticalStackLayout>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- the message box stays at the bottom -->
                <Grid Grid.Row="3" RowDefinitions="Auto,Auto" RowSpacing="8" Padding="16,10,16,14" IsVisible="{Binding CanSend}">
                    <!-- a photo that is chosen and waiting to be sent -->
                    <Border Style="{StaticResource Panel}" Padding="12,8" IsVisible="{Binding HasPhoto}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <Label Text="{Binding PhotoName, StringFormat='Photo ready to send: {0}'}" VerticalOptions="Center" LineBreakMode="MiddleTruncation" />
                            <Button Grid.Column="1" Text="Remove" Style="{StaticResource SmallOutlineButton}" Command="{Binding RemovePhotoCommand}" />
                        </Grid>
                    </Border>
                    <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                        <Button Text="Photo" Style="{StaticResource SmallOutlineButton}" Command="{Binding AttachCommand}" VerticalOptions="Center" />
                        <Border Grid.Column="1" Style="{StaticResource Field}">
                            <Entry Text="{Binding Draft}" Placeholder="Write a message" MaxLength="2000" ReturnCommand="{Binding SendCommand}" SemanticProperties.Description="Message" />
                        </Border>
                        <Button Grid.Column="2" Text="Send" Command="{Binding SendCommand}" />
                    </Grid>
                </Grid>
                <Label Grid.Row="3" Text="You can read this conversation, but you can't send new messages in it right now." Style="{StaticResource Muted}"
                       Padding="16,10,16,14" IsVisible="{Binding ReadOnly}" />
            </Grid>
        </Grid>
    </Grid>
</v:BasePage>
