<?xml version="1.0" encoding="utf-8" ?>
<v:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
            xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
            xmlns:v="clr-namespace:GymMembership.App.Views"
            xmlns:c="clr-namespace:GymMembership.App.Controls"
            xmlns:svc="clr-namespace:GymMembership.Core.Services;assembly=GymMembership.Core"
            xmlns:vm="clr-namespace:GymMembership.Core.ViewModels;assembly=GymMembership.Core"
            x:Class="GymMembership.App.Views.SettingsPage" x:DataType="vm:SettingsViewModel" Title="Settings">

    <ScrollView MaximumWidthRequest="{StaticResource PageWidth}">
        <VerticalStackLayout Padding="{OnIdiom Phone='16,12,16,24', Default='16,12,16,20'}" Spacing="12">
            <c:Banner Message="{Binding ErrorMessage}" />
            <c:Banner Kind="notice" Message="{Binding Notice}" />

            <!-- who is signed in: a plain panel (Phase 9: yellow is kept for actions and the one key figure, not a profile).
                 Saved values, not what is being typed below. -->
            <Border Style="{StaticResource Panel}" Padding="{OnIdiom Phone='16,16', Default='20,18'}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="18">
                    <c:Avatar Letters="{Binding Letters}" Url="{Binding AvatarUrl}" Diameter="{OnIdiom Phone=64, Default=88}" VerticalOptions="Center" />
                    <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                        <Label Text="{Binding SavedName}" Style="{StaticResource PageTitle}" />
                        <Label Text="{Binding SavedEmail}" />
                        <Label Text="Email confirmed" Style="{StaticResource Caption}" IsVisible="{Binding EmailConfirmed}" />
                        <Label Text="Email not confirmed yet" Style="{StaticResource Caption}" IsVisible="{Binding EmailConfirmed, Converter={StaticResource Not}}" />
                        <Button Text="Change picture" Style="{StaticResource SmallOutlineButton}"
                                Command="{Binding ChangePhotoCommand}" HorizontalOptions="Start" Margin="0,6,0,0" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <c:SideLayout SideFirst="False" StackedSideWidth="600">
                <!-- main: name and email in one panel, side by side when there is room -->
                <Border Style="{StaticResource Panel}" Padding="0">
                    <c:CardGrid Columns="{OnIdiom Phone=1, Default=2}" MinColumnWidth="340" Spacing="0">
                        <VerticalStackLayout Spacing="14" Padding="18">
                            <c:CardTitle Text="Your name" />
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="First name" Style="{StaticResource Caption}" />
                                    <Label Text="{Binding FirstName}" FontFamily="BarlowSemiBold" AutomationId="SettingsFirstName" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Spacing="4" IsVisible="{Binding LastName, Converter={StaticResource HasText}}">
                                    <Label Text="Last name" Style="{StaticResource Caption}" />
                                    <Label Text="{Binding LastName}" FontFamily="BarlowSemiBold" AutomationId="SettingsLastName" />
                                </VerticalStackLayout>
                            </Grid>
                            <Label Text="Names can't be changed after sign-up. If yours is wrong, ask the gym to correct it." Style="{StaticResource Caption}" />
                        </VerticalStackLayout>

                        <!-- Email: send a code to the address, then type it. A new address becomes the sign-in email. -->
                        <VerticalStackLayout Spacing="14" Padding="18">
                            <c:CardTitle Text="Sign-in email" />
                            <Label Text="Not confirmed yet. Send a code to this address to confirm it." Style="{StaticResource Caption}" IsVisible="{Binding EmailConfirmed, Converter={StaticResource Not}}" />
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Email address" Style="{StaticResource Caption}" />
                                <Border Style="{StaticResource Field}"><Entry Text="{Binding EmailAddress}" Keyboard="Email" MaxLength="{x:Static svc:AccountRules.MaxEmail}" SemanticProperties.Description="Sign-in email" /></Border>
                            </VerticalStackLayout>
                            <Button Text="Send code" Style="{StaticResource SmallOutlineButton}" Command="{Binding SendEmailCodeCommand}" HorizontalOptions="Start" />
                            <VerticalStackLayout Spacing="12" IsVisible="{Binding CodeSent}">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="Code from the email" Style="{StaticResource Caption}" />
                                    <Border Style="{StaticResource Field}"><Entry Text="{Binding EmailCode}" Keyboard="Numeric" MaxLength="6" ReturnCommand="{Binding ConfirmEmailCommand}" SemanticProperties.Description="6-digit code" /></Border>
                                </VerticalStackLayout>
                                <Button Text="Confirm email" Style="{StaticResource SmallOutlineButton}" Command="{Binding ConfirmEmailCommand}" HorizontalOptions="Start" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </c:CardGrid>
                </Border>

                <!-- side: the two short settings; stacked on a narrower window they stop at a readable width (StackedSideWidth).
                     Their buttons are outline: Settings has no single main action, and three yellow buttons shouted in dark (Phase 9 critique) -->
                <VerticalStackLayout Spacing="12">
                    <Border Style="{StaticResource SidePanel}">
                        <VerticalStackLayout Spacing="10">
                            <c:CardTitle Text="Theme" />
                            <!-- three short choices: the field is as wide as the longest, not the panel (9.6 polish) -->
                            <Border Style="{StaticResource Field}" WidthRequest="240" HorizontalOptions="Start">
                                <Picker ItemsSource="{Binding ThemeNames}" SelectedIndex="{Binding ThemeIndex}" SemanticProperties.Description="Theme" />
                            </Border>
                            <Button Text="Save theme" Style="{StaticResource SmallOutlineButton}" Command="{Binding SaveCommand}" HorizontalOptions="Start" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- F8 (mockup docs/mockups/desk-pin.html): members only; typed twice because a typo only shows up at the desk -->
                    <Border Style="{StaticResource SidePanel}" IsVisible="{Binding IsMember}">
                        <VerticalStackLayout Spacing="12">
                            <VerticalStackLayout Spacing="2">
                                <c:CardTitle Text="Desk PIN" />
                                <Label Text="4 digits you type at the front desk if you check in without your phone." Style="{StaticResource Caption}" />
                            </VerticalStackLayout>
                            <FlexLayout Wrap="Wrap">
                                <VerticalStackLayout Spacing="4" Margin="0,0,12,8">
                                    <Label Text="New PIN" Style="{StaticResource Caption}" />
                                    <Border Style="{StaticResource Field}" WidthRequest="132">
                                        <Grid ColumnDefinitions="*,Auto"><Entry x:Name="DeskPinBox" Text="{Binding DeskPin}" IsPassword="True" Keyboard="Numeric" MaxLength="4" AutomationId="NewDeskPin" SemanticProperties.Description="New desk PIN, 4 digits" /><c:EyeButton Grid.Column="1" Entry="{x:Reference DeskPinBox}" /></Grid>
                                    </Border>
                                </VerticalStackLayout>
                                <VerticalStackLayout Spacing="4" Margin="0,0,12,8">
                                    <Label Text="Type it again" Style="{StaticResource Caption}" />
                                    <Border Style="{StaticResource Field}" WidthRequest="132">
                                        <Grid ColumnDefinitions="*,Auto"><Entry x:Name="DeskPinAgainBox" Text="{Binding DeskPinAgain}" IsPassword="True" Keyboard="Numeric" MaxLength="4" ReturnCommand="{Binding SaveDeskPinCommand}"
                                               AutomationId="RepeatDeskPin" SemanticProperties.Description="Repeat the desk PIN" /><c:EyeButton Grid.Column="1" Entry="{x:Reference DeskPinAgainBox}" /></Grid>
                                    </Border>
                                </VerticalStackLayout>
                            </FlexLayout>
                            <Button Text="Save PIN" Style="{StaticResource SmallOutlineButton}" Command="{Binding SaveDeskPinCommand}" HorizontalOptions="Start" AutomationId="SaveDeskPin" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Style="{StaticResource SidePanel}">
                        <VerticalStackLayout Spacing="12">
                            <c:CardTitle Text="Change password" />
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Current password" Style="{StaticResource Caption}" />
                                <Border Style="{StaticResource Field}"><Grid ColumnDefinitions="*,Auto"><Entry x:Name="CurrentPasswordBox" Text="{Binding CurrentPassword}" IsPassword="True" SemanticProperties.Description="Current password" /><c:EyeButton Grid.Column="1" Entry="{x:Reference CurrentPasswordBox}" /></Grid></Border>
                            </VerticalStackLayout>
                            <VerticalStackLayout Spacing="4">
                                <Label Text="New password (8 to 64 characters, a letter and a number)" Style="{StaticResource Caption}" />
                                <Border Style="{StaticResource Field}"><Grid ColumnDefinitions="*,Auto"><Entry x:Name="NewPasswordBox" Text="{Binding NewPassword}" IsPassword="True" SemanticProperties.Description="New password" /><c:EyeButton Grid.Column="1" Entry="{x:Reference NewPasswordBox}" /></Grid></Border>
                            </VerticalStackLayout>
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Repeat new password" Style="{StaticResource Caption}" />
                                <Border Style="{StaticResource Field}"><Grid ColumnDefinitions="*,Auto"><Entry x:Name="ConfirmPasswordBox" Text="{Binding ConfirmPassword}" IsPassword="True" ReturnCommand="{Binding ChangePasswordCommand}" SemanticProperties.Description="Repeat new password" /><c:EyeButton Grid.Column="1" Entry="{x:Reference ConfirmPasswordBox}" /></Grid></Border>
                            </VerticalStackLayout>
                            <Button Text="Change password" Style="{StaticResource SmallOutlineButton}" Command="{Binding ChangePasswordCommand}" HorizontalOptions="Start" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </c:SideLayout>

        </VerticalStackLayout>
    </ScrollView>
</v:BasePage>
