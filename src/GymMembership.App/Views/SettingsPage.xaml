<?xml version="1.0" encoding="utf-8" ?>
<v:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
            xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
            xmlns:v="clr-namespace:GymMembership.App.Views"
            xmlns:c="clr-namespace:GymMembership.App.Controls"
            xmlns:vm="clr-namespace:GymMembership.Core.ViewModels;assembly=GymMembership.Core"
            x:Class="GymMembership.App.Views.SettingsPage" x:DataType="vm:SettingsViewModel" Title="Settings">

    <ScrollView MaximumWidthRequest="520">
        <VerticalStackLayout Padding="20,16,20,24" Spacing="16">
            <c:Banner Message="{Binding ErrorMessage}" />
            <c:Banner Kind="notice" Message="{Binding Notice}" />

            <VerticalStackLayout Spacing="6">
                <Label Text="Theme" Style="{StaticResource Caption}" />
                <Border Style="{StaticResource Field}">
                    <Picker ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}" SemanticProperties.Description="Theme" />
                </Border>
                <Label Text="System follows your device. Light and dark stay fixed." Style="{StaticResource Caption}" />
            </VerticalStackLayout>

            <Button Text="Save theme" Command="{Binding SaveCommand}" HorizontalOptions="Start" />

            <c:LaneView Margin="0,12"
                        DashColor="{AppThemeBinding Light={StaticResource LineLight}, Dark={StaticResource LineDark}}"
                        TrackColor="{AppThemeBinding Light={StaticResource LineLight}, Dark={StaticResource LineDark}}" />

            <Label Text="Change password" Style="{StaticResource Heading}" />
            <VerticalStackLayout Spacing="4">
                <Label Text="Current password" Style="{StaticResource Caption}" />
                <Border Style="{StaticResource Field}"><Entry Text="{Binding CurrentPassword}" IsPassword="True" SemanticProperties.Description="Current password" /></Border>
            </VerticalStackLayout>
            <VerticalStackLayout Spacing="4">
                <Label Text="New password (at least 6 characters)" Style="{StaticResource Caption}" />
                <Border Style="{StaticResource Field}"><Entry Text="{Binding NewPassword}" IsPassword="True" SemanticProperties.Description="New password" /></Border>
            </VerticalStackLayout>
            <VerticalStackLayout Spacing="4">
                <Label Text="Repeat new password" Style="{StaticResource Caption}" />
                <Border Style="{StaticResource Field}"><Entry Text="{Binding ConfirmPassword}" IsPassword="True" ReturnCommand="{Binding ChangePasswordCommand}" SemanticProperties.Description="Repeat new password" /></Border>
            </VerticalStackLayout>
            <Button Text="Change password" Command="{Binding ChangePasswordCommand}" HorizontalOptions="Start" />

            <c:LaneView Margin="0,12"
                        DashColor="{AppThemeBinding Light={StaticResource LineLight}, Dark={StaticResource LineDark}}"
                        TrackColor="{AppThemeBinding Light={StaticResource LineLight}, Dark={StaticResource LineDark}}" />

            <Button Text="Sign out" Style="{StaticResource OutlineButton}" Command="{Binding SignOutCommand}" HorizontalOptions="Start" />
        </VerticalStackLayout>
    </ScrollView>
</v:BasePage>
