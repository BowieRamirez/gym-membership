<?xml version="1.0" encoding="utf-8" ?>
<v:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
            xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
            xmlns:v="clr-namespace:GymMembership.App.Views"
            xmlns:c="clr-namespace:GymMembership.App.Controls"
            xmlns:svc="clr-namespace:GymMembership.Core.Services;assembly=GymMembership.Core"
            xmlns:vm="clr-namespace:GymMembership.Core.ViewModels;assembly=GymMembership.Core"
            x:Class="GymMembership.App.Views.SettingsPage" x:DataType="vm:SettingsViewModel" Title="Settings">

    <ScrollView MaximumWidthRequest="{StaticResource PageWidth}">
        <VerticalStackLayout Padding="{OnIdiom Phone='16,12,16,24', Default='16,12,16,20'}" Spacing="12">
            <c:Banner Message="{Binding ErrorMessage}" />
            <c:Banner Kind="notice" Message="{Binding Notice}" />

            <!-- who is signed in: the one lime card on the page. Saved values, not what is being typed below. -->
            <Border Style="{StaticResource HeroPanel}" Padding="{OnIdiom Phone='16,16', Default='20,18'}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="18">
                    <c:Avatar Letters="{Binding Letters}" Url="{Binding AvatarUrl}" Diameter="{OnIdiom Phone=64, Default=88}" VerticalOptions="Center" />
                    <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                        <Label Text="{Binding SavedName}" Style="{StaticResource PageTitle}" TextColor="{StaticResource Black}" />
                        <Label Text="{Binding SavedEmail}" TextColor="{StaticResource Black}" />
                        <Label Text="Email confirmed" Style="{StaticResource Caption}" TextColor="{StaticResource Black}" IsVisible="{Binding EmailConfirmed}" />
                        <Label Text="Email not confirmed yet" Style="{StaticResource Caption}" TextColor="{StaticResource Black}" IsVisible="{Binding EmailConfirmed, Converter={StaticResource Not}}" />
                        <Button Text="Change picture" Style="{StaticResource InkSmallButton}"
                                Command="{Binding ChangePhotoCommand}" HorizontalOptions="Start" Margin="0,6,0,0" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <c:SideLayout SideFirst="False">
                <!-- main: name and email in one panel, side by side when there is room -->
                <Border Style="{StaticResource Panel}" Padding="0">
                    <c:CardGrid Columns="{OnIdiom Phone=1, Default=2}" MinColumnWidth="340" Spacing="0">
                        <VerticalStackLayout Spacing="14" Padding="18">
                            <c:CardTitle Icon="id-card" Text="Your name" />
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="First name" Style="{StaticResource Caption}" />
                                    <Border Style="{StaticResource Field}"><Entry Text="{Binding FirstName}" TextChanged="OnNameChanged" MaxLength="{x:Static svc:AccountRules.MaxName}" SemanticProperties.Description="First name" /></Border>
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Spacing="4">
                                    <Label Text="Last name" Style="{StaticResource Caption}" />
                                    <Border Style="{StaticResource Field}"><Entry Text="{Binding LastName}" TextChanged="OnNameChanged" MaxLength="{x:Static svc:AccountRules.MaxName}" ReturnCommand="{Binding SaveNameCommand}" SemanticProperties.Description="Last name" /></Border>
                                </VerticalStackLayout>
                            </Grid>
                            <Button Text="Save name" Command="{Binding SaveNameCommand}" HorizontalOptions="Start" />
                        </VerticalStackLayout>

                        <!-- Email: send a code to the address, then type it. A new address becomes the sign-in email. -->
                        <VerticalStackLayout Spacing="14" Padding="18">
                            <c:CardTitle Icon="message-square" Text="Sign-in email" />
                            <Label Text="Not confirmed yet. Send a code to this address to confirm it." Style="{StaticResource Caption}" IsVisible="{Binding EmailConfirmed, Converter={StaticResource Not}}" />
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Email address" Style="{StaticResource Caption}" />
                                <Border Style="{StaticResource Field}"><Entry Text="{Binding EmailAddress}" Keyboard="Email" MaxLength="{x:Static svc:AccountRules.MaxEmail}" SemanticProperties.Description="Sign-in email" /></Border>
                                <Label Text="Changing it also changes the email you sign in with." Style="{StaticResource Caption}" />
                            </VerticalStackLayout>
                            <Button Text="Send code" Command="{Binding SendEmailCodeCommand}" HorizontalOptions="Start" />
                            <VerticalStackLayout Spacing="12" IsVisible="{Binding CodeSent}">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="Code from the email" Style="{StaticResource Caption}" />
                                    <Border Style="{StaticResource Field}"><Entry Text="{Binding EmailCode}" Keyboard="Numeric" MaxLength="6" ReturnCommand="{Binding ConfirmEmailCommand}" SemanticProperties.Description="6-digit code" /></Border>
                                </VerticalStackLayout>
                                <Button Text="Confirm email" Command="{Binding ConfirmEmailCommand}" HorizontalOptions="Start" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </c:CardGrid>
                </Border>

                <!-- side: the two short settings -->
                <VerticalStackLayout Spacing="12">
                    <Border Style="{StaticResource SidePanel}">
                        <VerticalStackLayout Spacing="10">
                            <c:CardTitle Icon="settings" Text="Theme" />
                            <Border Style="{StaticResource Field}">
                                <Picker ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}" SemanticProperties.Description="Theme" />
                            </Border>
                            <Label Text="System follows your device. Light and dark stay fixed." Style="{StaticResource Caption}" />
                            <Button Text="Save theme" Style="{StaticResource SmallButton}" Command="{Binding SaveCommand}" HorizontalOptions="Start" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Style="{StaticResource SidePanel}">
                        <VerticalStackLayout Spacing="12">
                            <c:CardTitle Icon="eye" Text="Change password" />
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Current password" Style="{StaticResource Caption}" />
                                <Border Style="{StaticResource Field}"><Grid ColumnDefinitions="*,Auto"><Entry x:Name="CurrentPasswordBox" Text="{Binding CurrentPassword}" IsPassword="True" SemanticProperties.Description="Current password" /><c:EyeButton Grid.Column="1" Entry="{x:Reference CurrentPasswordBox}" /></Grid></Border>
                            </VerticalStackLayout>
                            <VerticalStackLayout Spacing="4">
                                <Label Text="New password (at least 6 characters)" Style="{StaticResource Caption}" />
                                <Border Style="{StaticResource Field}"><Grid ColumnDefinitions="*,Auto"><Entry x:Name="NewPasswordBox" Text="{Binding NewPassword}" IsPassword="True" SemanticProperties.Description="New password" /><c:EyeButton Grid.Column="1" Entry="{x:Reference NewPasswordBox}" /></Grid></Border>
                            </VerticalStackLayout>
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Repeat new password" Style="{StaticResource Caption}" />
                                <Border Style="{StaticResource Field}"><Grid ColumnDefinitions="*,Auto"><Entry x:Name="ConfirmPasswordBox" Text="{Binding ConfirmPassword}" IsPassword="True" ReturnCommand="{Binding ChangePasswordCommand}" SemanticProperties.Description="Repeat new password" /><c:EyeButton Grid.Column="1" Entry="{x:Reference ConfirmPasswordBox}" /></Grid></Border>
                            </VerticalStackLayout>
                            <Button Text="Change password" Command="{Binding ChangePasswordCommand}" HorizontalOptions="Start" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </c:SideLayout>

            <Button Text="Sign out" IsVisible="{OnPlatform WinUI=False, Default=True}" Style="{StaticResource OutlineButton}" Command="{Binding SignOutCommand}" HorizontalOptions="Start" />
        </VerticalStackLayout>
    </ScrollView>
</v:BasePage>
