<?xml version="1.0" encoding="utf-8" ?>
<v:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
            xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
            xmlns:v="clr-namespace:GymMembership.App.Views"
            xmlns:c="clr-namespace:GymMembership.App.Controls"
            xmlns:vm="clr-namespace:GymMembership.Core.ViewModels;assembly=GymMembership.Core"
            xmlns:svc="clr-namespace:GymMembership.Core.Services;assembly=GymMembership.Core"
            x:Class="GymMembership.App.Views.AmenityStatusPage" x:DataType="vm:AmenityStatusViewModel" Title="Amenity status">

    <ScrollView MaximumWidthRequest="{StaticResource PageWidth}">
        <VerticalStackLayout Padding="{OnIdiom Phone='16,12,16,24', Default='16,12,16,20'}" Spacing="12">
            <Label Text="Members who follow an amenity are alerted when it becomes available or unavailable." Style="{StaticResource Muted}" />
            <c:Banner Message="{Binding ErrorMessage}" />
            <c:Banner Kind="notice" Message="{Binding Notice}" />

            <!-- G13 (approved mockup docs/mockups/amenity-down-payment.html): today's bookings with a balance still to pay at the desk -->
            <VerticalStackLayout Spacing="8" IsVisible="{Binding HasBalances}">
                <Label Text="Today's bookings with a balance" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource Panel}">
                    <VerticalStackLayout Spacing="8">
                        <VerticalStackLayout Spacing="0" BindableLayout.ItemsSource="{Binding Balances}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="svc:BalanceRow">
                                    <VerticalStackLayout>
                                        <Grid ColumnDefinitions="140,*,*,120,Auto" ColumnSpacing="12" Padding="0,8">
                                            <Label Text="{Binding When}" VerticalOptions="Center" />
                                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                                <Label Text="{Binding Member}" FontFamily="BarlowSemiBold" />
                                                <Label Text="{Binding Amenity}" Style="{StaticResource Caption}" />
                                            </VerticalStackLayout>
                                            <VerticalStackLayout Grid.Column="2" VerticalOptions="Center">
                                                <Label Text="{Binding CoachText}" />
                                                <Label Text="{Binding PaidText}" Style="{StaticResource Caption}" />
                                            </VerticalStackLayout>
                                            <Label Grid.Column="3" Text="{Binding BalanceText}" FontFamily="BarlowSemiBold" VerticalOptions="Center" HorizontalOptions="End" />
                                            <HorizontalStackLayout Grid.Column="4" Spacing="8" VerticalOptions="Center">
                                                <Button Text="Take in cash" Style="{StaticResource SmallButton}" Clicked="OnTakeCash" AutomationId="TakeBalanceCash"
                                                        SemanticProperties.Description="{Binding Member, StringFormat='Take the balance of {0} in cash'}" />
                                                <Button Text="GCash" Style="{StaticResource SmallOutlineButton}" Clicked="OnTakeGcash"
                                                        SemanticProperties.Description="{Binding Member, StringFormat='Take the balance of {0} by GCash'}" />
                                            </HorizontalStackLayout>
                                        </Grid>
                                        <BoxView Style="{StaticResource Hairline}" />
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="4" WidthRequest="260" HorizontalOptions="Start">
                            <Label Text="GCash reference (for GCash only)" Style="{StaticResource Caption}" />
                            <Border Style="{StaticResource Field}"><Entry Text="{Binding BalanceReference}" SemanticProperties.Description="GCash reference for the balance" /></Border>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <!-- the editor for the amenity you chose -->
            <Border Style="{StaticResource Panel}" IsVisible="{Binding IsEditing}" MaximumWidthRequest="{OnIdiom Phone=10000, Default=640}" HorizontalOptions="{OnIdiom Phone=Fill, Default=Start}">
                <VerticalStackLayout Spacing="10">
                    <c:CardTitle Text="{Binding Editing.Amenity.Name, StringFormat='Change {0}'}" />
                    <Border Style="{StaticResource Field}">
                        <Picker ItemsSource="{Binding Choices}" ItemDisplayBinding="{Binding Label}" SelectedItem="{Binding Choice}" SemanticProperties.Description="Status" />
                    </Border>

                    <VerticalStackLayout Spacing="10" IsVisible="{Binding ShowDetail}">
                        <Label Text="Reason (shown to members)" Style="{StaticResource Caption}" />
                        <Border Style="{StaticResource Field}">
                            <Entry Text="{Binding Reason}" MaxLength="200" Placeholder="For example maintenance, cleaning, closed" SemanticProperties.Description="Reason" />
                        </Border>
                        <FlexLayout Wrap="Wrap">
                            <!-- quick reasons: the app's chips (9.7) -->
                            <Button Text="Maintenance" Style="{StaticResource FilterChip}" Margin="0,0,8,8" Clicked="OnMaintenance" />
                            <Button Text="Cleaning" Style="{StaticResource FilterChip}" Margin="0,0,8,8" Clicked="OnCleaning" />
                            <Button Text="Closed" Style="{StaticResource FilterChip}" Margin="0,0,8,8" Clicked="OnClosed" />
                        </FlexLayout>
                        <HorizontalStackLayout Spacing="10">
                            <Switch IsToggled="{Binding HasBackAt}" SemanticProperties.Description="I know when it will be back" />
                            <Label Text="I know when it will be back" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Spacing="10" IsVisible="{Binding HasBackAt}">
                            <Border Style="{StaticResource Field}"><DatePicker Date="{Binding BackDate}" SemanticProperties.Description="Return date" /></Border>
                            <Border Style="{StaticResource Field}"><TimePicker Time="{Binding BackTime}" SemanticProperties.Description="Return time" /></Border>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>

                    <HorizontalStackLayout Spacing="10">
                        <Button Text="Save status" Command="{Binding SaveCommand}" />
                        <Button Text="Cancel" Style="{StaticResource OutlineButton}" Command="{Binding CancelCommand}" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <c:CardGrid Columns="{OnIdiom Phone=1, Default=4}" BindableLayout.ItemsSource="{Binding Cards}">
                <BindableLayout.EmptyView><Label Text="No amenities are listed yet." Style="{StaticResource Muted}" /></BindableLayout.EmptyView>
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="svc:AmenityCard">
                        <c:AmenityCardView ActionText="Change status" ActionClicked="OnChange" />
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </c:CardGrid>
        </VerticalStackLayout>
    </ScrollView>
</v:BasePage>
