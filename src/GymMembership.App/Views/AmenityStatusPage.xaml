<?xml version="1.0" encoding="utf-8" ?>
<v:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
            xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
            xmlns:v="clr-namespace:GymMembership.App.Views"
            xmlns:c="clr-namespace:GymMembership.App.Controls"
            xmlns:vm="clr-namespace:GymMembership.Core.ViewModels;assembly=GymMembership.Core"
            xmlns:svc="clr-namespace:GymMembership.Core.Services;assembly=GymMembership.Core"
            x:Class="GymMembership.App.Views.AmenityStatusPage" x:DataType="vm:AmenityStatusViewModel" Title="Amenity status">

    <ScrollView MaximumWidthRequest="{StaticResource PageWidth}">
        <!-- owner, 2026-11-17: the desk's Booked card sits on the right (staff pages are Windows only) -->
        <Grid ColumnDefinitions="*,380" ColumnSpacing="20" Padding="{OnIdiom Phone='16,12,16,24', Default='16,12,16,20'}">
        <VerticalStackLayout Spacing="12">
            <Label Text="Members who follow an amenity are alerted when it becomes available or unavailable." Style="{StaticResource Muted}" />
            <c:Banner Message="{Binding ErrorMessage}" />
            <c:Banner Kind="notice" Message="{Binding Notice}" />


            <!-- G13 (approved mockup docs/mockups/amenity-down-payment.html): today's bookings with a balance still to pay at the desk -->
            <VerticalStackLayout Spacing="8" IsVisible="{Binding HasBalances}">
                <Label Text="Today's bookings with a balance" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource Panel}">
                    <VerticalStackLayout Spacing="8">
                        <VerticalStackLayout Spacing="0" BindableLayout.ItemsSource="{Binding Balances}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="svc:BalanceRow">
                                    <VerticalStackLayout>
                                        <Grid ColumnDefinitions="140,*,*,120,Auto" ColumnSpacing="12" Padding="0,8">
                                            <Label Text="{Binding When}" VerticalOptions="Center" />
                                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                                <Label Text="{Binding Member}" FontFamily="BarlowSemiBold" />
                                                <Label Text="{Binding Amenity}" Style="{StaticResource Caption}" />
                                            </VerticalStackLayout>
                                            <VerticalStackLayout Grid.Column="2" VerticalOptions="Center">
                                                <Label Text="{Binding CoachText}" />
                                                <Label Text="{Binding PaidText}" Style="{StaticResource Caption}" />
                                            </VerticalStackLayout>
                                            <Label Grid.Column="3" Text="{Binding BalanceText}" FontFamily="BarlowSemiBold" VerticalOptions="Center" HorizontalOptions="End" />
                                            <HorizontalStackLayout Grid.Column="4" Spacing="8" VerticalOptions="Center">
                                                <Button Text="Take in cash" Style="{StaticResource SmallButton}" Clicked="OnTakeCash" AutomationId="TakeBalanceCash"
                                                        SemanticProperties.Description="{Binding Member, StringFormat='Take the balance of {0} in cash'}" />
                                                <Button Text="GCash" Style="{StaticResource SmallOutlineButton}" Clicked="OnTakeGcash"
                                                        SemanticProperties.Description="{Binding Member, StringFormat='Take the balance of {0} by GCash'}" />
                                            </HorizontalStackLayout>
                                        </Grid>
                                        <BoxView Style="{StaticResource Hairline}" />
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="4" WidthRequest="260" HorizontalOptions="Start">
                            <Label Text="GCash reference (for GCash only)" Style="{StaticResource Caption}" />
                            <Border Style="{StaticResource Field}"><Entry Text="{Binding BalanceReference}" SemanticProperties.Description="GCash reference for the balance" /></Border>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <!-- F13 booking refund claims ("I didn't use it"), moved here from Payments to verify (cashier plan Y7): what the member said
                 beside what the desk checks; decided with a reason the member reads -->
            <VerticalStackLayout Spacing="8" IsVisible="{Binding HasClaims}">
                <Label Text="Booking refund claims" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource Panel}" IsVisible="{Binding IsDeciding}">
                    <VerticalStackLayout Spacing="10">
                        <c:CardTitle Text="{Binding DecideTitle}" />
                        <Label Text="Say what you checked, for example the check-ins that day or the amenity's log. The member reads this." Style="{StaticResource Caption}" />
                        <Border Style="{StaticResource Field}" WidthRequest="420" HorizontalOptions="Start">
                            <Entry Text="{Binding DecideReason}" Placeholder="No check-in that day; pool closed for cleaning" SemanticProperties.Description="Reason for the decision" />
                        </Border>
                        <HorizontalStackLayout Spacing="8">
                            <Button Text="{Binding DecideText}" Style="{StaticResource SmallButton}" Command="{Binding ConfirmDecisionCommand}" />
                            <Button Text="Back" Style="{StaticResource SmallOutlineButton}" Command="{Binding KeepClaimCommand}" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>
                <Border Style="{StaticResource Panel}">
                    <VerticalStackLayout Spacing="0" BindableLayout.ItemsSource="{Binding Claims}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="svc:ClaimRow">
                                <VerticalStackLayout>
                                    <Grid ColumnDefinitions="*,1.4*,1.2*,Auto" ColumnSpacing="12" Padding="0,8">
                                        <VerticalStackLayout VerticalOptions="Center">
                                            <Label Text="{Binding Member}" FontFamily="BarlowSemiBold" />
                                            <Label Text="{Binding Amenity, StringFormat='{0} booking'}" Style="{StaticResource Caption}" />
                                            <Label Text="{Binding When}" Style="{StaticResource Caption}" />
                                        </VerticalStackLayout>
                                        <Label Grid.Column="1" Text="{Binding Claim.Reason, StringFormat='“{0}”'}" LineBreakMode="WordWrap" VerticalOptions="Center" />
                                        <VerticalStackLayout Grid.Column="2" VerticalOptions="Center">
                                            <Label Text="{Binding CheckIns, StringFormat='Check-ins that day: {0}'}" Style="{StaticResource Caption}" />
                                            <Label Text="{Binding AmenityNow, StringFormat='Amenity now: {0}'}" Style="{StaticResource Caption}" />
                                        </VerticalStackLayout>
                                        <HorizontalStackLayout Grid.Column="3" Spacing="8" VerticalOptions="Center">
                                            <Label Text="{Binding Price}" FontFamily="BarlowSemiBold" VerticalOptions="Center" />
                                            <Button Text="Approve" Style="{StaticResource SmallOutlineButton}" Clicked="OnApproveClaim" />
                                            <Button Text="Decline" Style="{StaticResource SmallOutlineButton}" Clicked="OnDeclineClaim" />
                                        </HorizontalStackLayout>
                                    </Grid>
                                    <BoxView Style="{StaticResource Hairline}" />
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <!-- the editor for the amenity you chose -->
            <Border Style="{StaticResource Panel}" IsVisible="{Binding IsEditing}" MaximumWidthRequest="{OnIdiom Phone=10000, Default=640}" HorizontalOptions="{OnIdiom Phone=Fill, Default=Start}">
                <VerticalStackLayout Spacing="10">
                    <c:CardTitle Text="{Binding Editing.Amenity.Name, StringFormat='Change {0}'}" />
                    <Border Style="{StaticResource Field}">
                        <Picker ItemsSource="{Binding Choices}" ItemDisplayBinding="{Binding Label}" SelectedItem="{Binding Choice}" SemanticProperties.Description="Status" />
                    </Border>

                    <VerticalStackLayout Spacing="10" IsVisible="{Binding ShowDetail}">
                        <Label Text="Reason (shown to members)" Style="{StaticResource Caption}" />
                        <Border Style="{StaticResource Field}">
                            <Entry Text="{Binding Reason}" MaxLength="200" Placeholder="For example maintenance, cleaning, closed" SemanticProperties.Description="Reason" />
                        </Border>
                        <FlexLayout Wrap="Wrap">
                            <!-- quick reasons: the app's chips (9.7) -->
                            <Button Text="Maintenance" Style="{StaticResource FilterChip}" Margin="0,0,8,8" Clicked="OnMaintenance" />
                            <Button Text="Cleaning" Style="{StaticResource FilterChip}" Margin="0,0,8,8" Clicked="OnCleaning" />
                            <Button Text="Closed" Style="{StaticResource FilterChip}" Margin="0,0,8,8" Clicked="OnClosed" />
                        </FlexLayout>
                        <HorizontalStackLayout Spacing="10">
                            <Switch IsToggled="{Binding HasBackAt}" SemanticProperties.Description="I know when it will be back" />
                            <Label Text="I know when it will be back" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Spacing="10" IsVisible="{Binding HasBackAt}">
                            <Border Style="{StaticResource Field}"><DatePicker Date="{Binding BackDate}" SemanticProperties.Description="Return date" /></Border>
                            <Border Style="{StaticResource Field}"><TimePicker Time="{Binding BackTime}" SemanticProperties.Description="Return time" /></Border>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>

                    <HorizontalStackLayout Spacing="10">
                        <Button Text="Save status" Command="{Binding SaveCommand}" />
                        <Button Text="Cancel" Style="{StaticResource OutlineButton}" Command="{Binding CancelCommand}" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <c:CardGrid Columns="{OnIdiom Phone=1, Default=3}" BindableLayout.ItemsSource="{Binding Cards}">
                <BindableLayout.EmptyView><Label Text="No amenities are listed yet." Style="{StaticResource Muted}" /></BindableLayout.EmptyView>
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="svc:AmenityCard">
                        <c:AmenityCardView ActionText="Change status" ActionClicked="OnChange" />
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </c:CardGrid>
        </VerticalStackLayout>

        <!-- who booked: confirmed bookings not yet ended, soonest first; View shows the details and prints the receipt -->
        <VerticalStackLayout Grid.Column="1" Spacing="8">
            <Label Text="Booked" Style="{StaticResource SectionTitle}" />
            <Border Style="{StaticResource Panel}" IsVisible="{Binding IsViewing}" AutomationId="BookedDetails">
                <VerticalStackLayout Spacing="6">
                    <c:CardTitle Text="{Binding Viewing.Who}" />
                    <Label Text="{Binding Viewing.Amenity}" FontFamily="BarlowSemiBold" />
                    <Label Text="{Binding Viewing.When}" />
                    <Label Text="{Binding Viewing.Coach, StringFormat='Coach: {0}'}" IsVisible="{Binding Viewing.Coach, Converter={StaticResource IsNotNull}}" />
                    <Label Text="{Binding Viewing.PaidText}" />
                    <Label Text="{Binding Viewing.MethodText}" Style="{StaticResource Caption}" />
                    <Label Text="{Binding Viewing.ReceiptText, StringFormat='Receipt {0}'}" FontFamily="BarlowSemiBold" />
                    <Label Text="{Binding Viewing.Booking.Id, StringFormat='Booking no. {0}'}" Style="{StaticResource Caption}" />
                    <Label Text="{Binding Viewing.RefundText}" FontFamily="BarlowSemiBold" IsVisible="{Binding Viewing.RefundText, Converter={StaticResource HasText}}" AutomationId="BookingRefundState" />
                    <Label Text="{Binding Viewing.RefundRule}" Style="{StaticResource Caption}" IsVisible="{Binding Viewing.CanRequestRefund}" />
                    <VerticalStackLayout Spacing="8" Margin="0,6,0,0" IsVisible="{Binding IsAskingRefund}">
                        <Label Text="Why is this being refunded? The System admin reads this." Style="{StaticResource Caption}" />
                        <Border Style="{StaticResource Field}"><Entry Text="{Binding RefundReason}" MaxLength="900" Placeholder="Customer can't come" SemanticProperties.Description="Reason for the refund" AutomationId="BookingRefundReason" /></Border>
                        <HorizontalStackLayout Spacing="8">
                            <Button Text="Send request" Style="{StaticResource SmallButton}" Command="{Binding SendRefundCommand}" AutomationId="SendBookingRefund" />
                            <Button Text="Back" Style="{StaticResource SmallOutlineButton}" Command="{Binding KeepRefundCommand}" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                    <FlexLayout Wrap="Wrap" Margin="0,6,0,0" IsVisible="{Binding IsAskingRefund, Converter={StaticResource Not}}">
                        <Button Text="Print receipt" Style="{StaticResource SmallButton}" Margin="0,0,8,8" Command="{Binding PrintReceiptCommand}" AutomationId="PrintBookingReceipt" />
                        <Button Text="{Binding Viewing.RefundButton}" Style="{StaticResource SmallOutlineButton}" Margin="0,0,8,8" Command="{Binding AskRefundCommand}" IsVisible="{Binding Viewing.CanRequestRefund}" AutomationId="RequestBookingRefund" />
                        <Button Text="Close" Style="{StaticResource SmallOutlineButton}" Margin="0,0,8,8" Command="{Binding CloseViewCommand}" />
                    </FlexLayout>
                </VerticalStackLayout>
            </Border>
            <Border Style="{StaticResource Panel}">
                <VerticalStackLayout Spacing="0" BindableLayout.ItemsSource="{Binding Booked}">
                    <BindableLayout.EmptyView><Label Text="No upcoming bookings." Style="{StaticResource Muted}" /></BindableLayout.EmptyView>
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="svc:BookedRow">
                            <VerticalStackLayout>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Padding="0,8">
                                    <VerticalStackLayout VerticalOptions="Center">
                                        <Label Text="{Binding Who}" FontFamily="BarlowSemiBold" LineBreakMode="TailTruncation" />
                                        <Label Text="{Binding Amenity}" Style="{StaticResource Caption}" />
                                        <Label Text="{Binding When}" Style="{StaticResource Caption}" />
                                    </VerticalStackLayout>
                                    <Button Grid.Column="1" Text="View" Style="{StaticResource FilterChip}" VerticalOptions="Center" Clicked="OnViewBooked"
                                            SemanticProperties.Description="{Binding Who, StringFormat='View the booking of {0}'}" />
                                </Grid>
                                <BoxView Style="{StaticResource Hairline}" />
                            </VerticalStackLayout>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
        </Grid>
    </ScrollView>
</v:BasePage>
