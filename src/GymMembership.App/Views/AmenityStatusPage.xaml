<?xml version="1.0" encoding="utf-8" ?>
<v:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
            xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
            xmlns:v="clr-namespace:GymMembership.App.Views"
            xmlns:c="clr-namespace:GymMembership.App.Controls"
            xmlns:vm="clr-namespace:GymMembership.Core.ViewModels;assembly=GymMembership.Core"
            xmlns:svc="clr-namespace:GymMembership.Core.Services;assembly=GymMembership.Core"
            xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
            x:Class="GymMembership.App.Views.AmenityStatusPage" x:DataType="vm:AmenityStatusViewModel" Title="Amenity status">

    <v:BasePage.Resources>
        <toolkit:IntToBoolConverter x:Key="Any" />
    </v:BasePage.Resources>

    <ScrollView MaximumWidthRequest="{StaticResource PageWidth}">
        <!-- owner, 2026-11-17: the desk's Booked card sits on the right (staff pages are Windows only) -->
        <Grid ColumnDefinitions="*,380" ColumnSpacing="20" Padding="{OnIdiom Phone='16,12,16,24', Default='16,12,16,20'}">
        <VerticalStackLayout Spacing="12">
            <Label Text="Members who follow an amenity are alerted when it becomes available or unavailable." Style="{StaticResource Muted}" />
            <c:Banner Message="{Binding ErrorMessage}" />
            <c:Banner Kind="notice" Message="{Binding Notice}" />

            <!-- plan 2026-11-17 Z1, Z2: the desk books a slot for a customer standing at the counter and takes the full price in cash.
                 Find a member, or book a walk-in by name (0091: no account), then amenity, day, time and length; then the receipt -->
            <HorizontalStackLayout Spacing="10">
                <Button Text="Book for a customer" Style="{StaticResource SmallButton}" Command="{Binding ToggleBookingCommand}"
                        IsVisible="{Binding HasBooking}" AutomationId="DeskBookOpen" />
                <Button Text="Book a coach for a customer" Style="{StaticResource SmallOutlineButton}" Command="{Binding ToggleCoachBookingCommand}"
                        IsVisible="{Binding HasCoachBooking}" />
            </HorizontalStackLayout>
            <Border Style="{StaticResource Panel}" IsVisible="{Binding IsBookingCoach}">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Spacing="2">
                            <c:CardTitle Text="Book a coach for a customer" />
                            <Label Text="Included in VIP packages, or paid add-on (cash or online) for other packages." Style="{StaticResource Caption}" />
                        </VerticalStackLayout>
                        <Button Grid.Column="1" Text="Close" Style="{StaticResource SmallOutlineButton}" Command="{Binding ToggleCoachBookingCommand}" />
                    </Grid>
                    <VerticalStackLayout Spacing="4" WidthRequest="300" HorizontalOptions="Start">
                        <Label Text="Member" Style="{StaticResource Caption}" />
                        <Border Style="{StaticResource Field}"><Entry Text="{Binding CoachCustomerSearch}" Placeholder="Name, email or phone" /></Border>
                    </VerticalStackLayout>
                    <Border Style="{StaticResource TablePanel}" IsVisible="{Binding CoachCustomerHits.Count, Converter={StaticResource Any}}" MaximumWidthRequest="480" HorizontalOptions="Start">
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding CoachCustomerHits}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="svc:MemberHit">
                                    <VerticalStackLayout>
                                        <Grid ColumnDefinitions="*,Auto" Padding="12,8">
                                            <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnPickCoachCustomer" /></Grid.GestureRecognizers>
                                            <Label Text="{Binding Username}" FontFamily="BarlowSemiBold" />
                                            <c:StatusChip Grid.Column="1" Status="{Binding PlanStatus}" />
                                        </Grid>
                                        <BoxView Style="{StaticResource Hairline}" />
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </Border>
                    <Label Text="{Binding CoachCustomer.Username, StringFormat='Booking for {0}'}" FontFamily="BarlowSemiBold" IsVisible="{Binding CoachCustomer, Converter={StaticResource IsNotNull}}" />
                    <FlexLayout Wrap="Wrap" AlignItems="End">
                        <VerticalStackLayout Spacing="4" Margin="0,0,12,8">
                            <Label Text="Day" Style="{StaticResource Caption}" />
                            <Border Style="{StaticResource Field}"><DatePicker Date="{Binding CoachBookDay}" MinimumDate="{x:Static x:DateTime.Today}" /></Border>
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="4" Margin="0,0,12,8">
                            <Label Text="Length" Style="{StaticResource Caption}" />
                            <HorizontalStackLayout Spacing="6">
                                <Button Text="1 hour" Style="{StaticResource FilterChip}" Command="{Binding SetDeskCoachHoursCommand}" CommandParameter="1" />
                                <Button Text="2 hours" Style="{StaticResource FilterChip}" Command="{Binding SetDeskCoachHoursCommand}" CommandParameter="2" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="4" Margin="0,0,12,8" WidthRequest="200">
                            <Label Text="Coach" Style="{StaticResource Caption}" />
                            <Border Style="{StaticResource Field}"><Picker ItemsSource="{Binding DeskFreeCoaches}" ItemDisplayBinding="{Binding FullName}" SelectedItem="{Binding SelectedDeskCoach}" Title="Coach" /></Border>
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="4" Margin="0,0,12,8" WidthRequest="180">
                            <Label Text="Hour" Style="{StaticResource Caption}" />
                            <Border Style="{StaticResource Field}"><Picker ItemsSource="{Binding DeskCoachHours}" ItemDisplayBinding="{Binding Label}" SelectedItem="{Binding SelectedDeskCoachHour}" Title="Hour" /></Border>
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="4" Margin="0,0,12,8">
                            <Label Text="Method" Style="{StaticResource Caption}" />
                            <HorizontalStackLayout Spacing="6">
                                <Button Text="Cash" Style="{StaticResource FilterChip}" Command="{Binding PickDeskCoachMethodCommand}" CommandParameter="Cash" />
                                <Button Text="Online" Style="{StaticResource FilterChip}" Command="{Binding PickDeskCoachMethodCommand}" CommandParameter="Online" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="4" Margin="0,0,12,8" WidthRequest="160">
                            <Label Text="Discount code" Style="{StaticResource Caption}" />
                            <Border Style="{StaticResource Field}"><Entry Text="{Binding DeskCoachCode}" Placeholder="Optional" /></Border>
                        </VerticalStackLayout>
                    </FlexLayout>
                    <Button Text="Book coach session" Style="{StaticResource SmallButton}" HorizontalOptions="Start" Command="{Binding DeskBookCoachCommand}" />
                </VerticalStackLayout>
            </Border>
            <ContentView IsVisible="{Binding IsBooking}">
            <Border Style="{StaticResource Panel}" BindingContext="{Binding Booking}">
                <VerticalStackLayout Spacing="14" x:DataType="vm:DeskBookingViewModel">
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Spacing="2">
                            <c:CardTitle Text="Book for a customer" />
                            <Label Text="Same slots and rules as the app. The full price is paid now: in cash into your drawer, or online through Xendit for a walk-in." Style="{StaticResource Caption}" />
                        </VerticalStackLayout>
                        <Button Grid.Column="1" Text="Close" Style="{StaticResource SmallOutlineButton}" VerticalOptions="Start" Clicked="OnCloseBooking" />
                    </Grid>
                    <c:Banner Message="{Binding ErrorMessage}" />
                    <c:Banner Kind="notice" Message="{Binding Notice}" />

                    <!-- 1. who -->
                    <VerticalStackLayout Spacing="4">
                        <FlexLayout Wrap="Wrap" AlignItems="End">
                            <VerticalStackLayout Spacing="4" Margin="0,0,12,8" WidthRequest="300">
                                <Label Text="Customer" Style="{StaticResource Caption}" />
                                <Border Style="{StaticResource Field}"><Entry Text="{Binding Search}" Placeholder="Name, email or phone" ReturnCommand="{Binding PickTopSuggestionCommand}" SemanticProperties.Description="Search members by name, email or phone" AutomationId="DeskBookSearch" /></Border>
                            </VerticalStackLayout>
                            <Button Text="Book for a walk-in" Style="{StaticResource SmallOutlineButton}" Margin="0,0,12,8" Command="{Binding StartWalkInCommand}" AutomationId="DeskBookWalkIn" />
                        </FlexLayout>
                        <Border Style="{StaticResource TablePanel}" IsVisible="{Binding HasSuggestions}" MaximumWidthRequest="480" HorizontalOptions="Start" AutomationId="DeskBookSuggestions">
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Suggestions}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="svc:MemberHit">
                                        <VerticalStackLayout>
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Padding="12,8" SemanticProperties.Description="{Binding Username, StringFormat='Choose {0}'}">
                                                <Grid.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="OnPickCustomer" />
                                                </Grid.GestureRecognizers>
                                                <VerticalStackLayout Spacing="1" VerticalOptions="Center">
                                                    <Label Text="{Binding Username}" FontFamily="BarlowSemiBold" LineBreakMode="TailTruncation" />
                                                    <Label Text="{Binding ContactText}" Style="{StaticResource Caption}" LineBreakMode="TailTruncation" />
                                                </VerticalStackLayout>
                                                <c:StatusChip Grid.Column="1" Status="{Binding PlanStatus}" VerticalOptions="Center" />
                                            </Grid>
                                            <BoxView Style="{StaticResource Hairline}" />
                                        </VerticalStackLayout>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                    <Label Text="No member found. Check the spelling, or try their email or phone. No account? Book for a walk-in." Style="{StaticResource Muted}" IsVisible="{Binding NoMatch}" />
                    <!-- 0091 (owner): someone with no account is booked by name; they photograph the receipt shown after booking -->
                    <VerticalStackLayout Spacing="4" IsVisible="{Binding IsWalkIn}" WidthRequest="300" HorizontalOptions="Start">
                        <Label Text="Walk-in's name" Style="{StaticResource Caption}" />
                        <Border Style="{StaticResource Field}"><Entry Text="{Binding WalkInName}" MaxLength="100" Placeholder="Full name" SemanticProperties.Description="Walk-in's name" AutomationId="DeskBookWalkInName" /></Border>
                        <Label Text="No account needed. They get a receipt number to photograph." Style="{StaticResource Caption}" />
                    </VerticalStackLayout>
                    <Label Text="{Binding Member.Username, StringFormat='Booking for {0}'}" FontFamily="BarlowSemiBold" IsVisible="{Binding Member, Converter={StaticResource IsNotNull}}" />

                    <!-- 2. what and when: only times the grid can take are offered -->
                    <FlexLayout Wrap="Wrap" AlignItems="End">
                        <VerticalStackLayout Spacing="4" Margin="0,0,12,8" WidthRequest="200">
                            <Label Text="Amenity" Style="{StaticResource Caption}" />
                            <Border Style="{StaticResource Field}"><Picker ItemsSource="{Binding Amenities}" ItemDisplayBinding="{Binding Name, x:DataType=svc:GridAmenity}" SelectedItem="{Binding Amenity}" SemanticProperties.Description="Amenity" AutomationId="DeskBookAmenity" /></Border>
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="4" Margin="0,0,12,8">
                            <Label Text="Day" Style="{StaticResource Caption}" />
                            <Border Style="{StaticResource Field}"><DatePicker Date="{Binding Day}" SemanticProperties.Description="Day" /></Border>
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="4" Margin="0,0,12,8" WidthRequest="150">
                            <Label Text="Starts" Style="{StaticResource Caption}" />
                            <Border Style="{StaticResource Field}"><Picker ItemsSource="{Binding Starts}" ItemDisplayBinding="{Binding Label, x:DataType=vm:DeskBookingViewModel+SlotOption}" SelectedItem="{Binding Start}" SemanticProperties.Description="Start time" AutomationId="DeskBookStart" /></Border>
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="4" Margin="0,0,12,8" WidthRequest="130">
                            <Label Text="How long" Style="{StaticResource Caption}" />
                            <Border Style="{StaticResource Field}"><Picker ItemsSource="{Binding Lengths}" ItemDisplayBinding="{Binding Text, x:DataType=vm:PickChip}" SelectedItem="{Binding Length}" SemanticProperties.Description="How long" AutomationId="DeskBookMinutes" /></Border>
                        </VerticalStackLayout>
                        <Button Text="Book and take cash" Style="{StaticResource SmallButton}" Margin="0,0,12,8" Command="{Binding BookCommand}" AutomationId="DeskBook" />
                        <!-- 0092 (owner): a walk-in may pay online through Xendit instead -->
                        <Button Text="Pay online (Xendit)" Style="{StaticResource SmallOutlineButton}" Margin="0,0,0,8" Command="{Binding PayOnlineCommand}"
                                IsVisible="{Binding IsWalkIn}" AutomationId="DeskBookOnline" />
                    </FlexLayout>

                    <!-- waiting for Xendit: the checkout is open on this PC; the slot is theirs once Check payment says paid -->
                    <Border Style="{StaticResource Panel}" IsVisible="{Binding IsWaiting}" MaximumWidthRequest="640" HorizontalOptions="Start" AutomationId="DeskBookWaiting">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="{Binding Waiting.WalkInName, StringFormat='Waiting for {0} to pay online'}" FontFamily="BarlowSemiBold" />
                            <Label Text="{Binding Waiting.TotalPrice, StringFormat='₱{0:N2} through Xendit (GCash, Maya or a bank app via QR Ph). The checkout closes in 30 minutes.'}" Style="{StaticResource Caption}" />
                            <HorizontalStackLayout Spacing="8">
                                <Button Text="Check payment" Style="{StaticResource SmallButton}" Command="{Binding CheckPaymentCommand}" AutomationId="DeskBookCheck" />
                                <Button Text="Open checkout again" Style="{StaticResource SmallOutlineButton}" Command="{Binding OpenCheckoutCommand}" />
                                <Button Text="Cancel" Style="{StaticResource SmallOutlineButton}" Command="{Binding StopWaitingCommand}" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <!-- 3. the receipt: a walk-in photographs it; a member also has it in their Front desk chat -->
                    <Border Style="{StaticResource Panel}" IsVisible="{Binding Receipt, Converter={StaticResource IsNotNull}}" MaximumWidthRequest="480" HorizontalOptions="Start" AutomationId="DeskBookReceipt">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Booked and paid" Style="{StaticResource Caption}" />
                            <Label Text="{Binding Receipt.ReceiptNo, StringFormat='Receipt {0}'}" FontFamily="BarlowSemiBold" FontSize="24" />
                            <Label Text="{Binding Receipt.Customer}" FontFamily="BarlowSemiBold" />
                            <Label Text="{Binding Receipt.Amenity}" />
                            <Label Text="{Binding Receipt.When}" />
                            <Label Text="{Binding Receipt.Paid, StringFormat='Paid {0}'}" />
                            <Label Text="{Binding Receipt.Note}" Style="{StaticResource Muted}" Margin="0,4,0,0" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </Border>
            </ContentView>

            <!-- G13 (approved mockup docs/mockups/amenity-down-payment.html): today's bookings with a balance still to pay at the desk -->
            <VerticalStackLayout Spacing="8" IsVisible="{Binding HasBalances}">
                <Label Text="Today's bookings with a balance" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource Panel}">
                    <VerticalStackLayout Spacing="8">
                        <VerticalStackLayout Spacing="0" BindableLayout.ItemsSource="{Binding Balances}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="svc:BalanceRow">
                                    <VerticalStackLayout>
                                        <Grid ColumnDefinitions="140,*,*,120,Auto" ColumnSpacing="12" Padding="0,8">
                                            <Label Text="{Binding When}" VerticalOptions="Center" />
                                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                                <Label Text="{Binding Member}" FontFamily="BarlowSemiBold" />
                                                <Label Text="{Binding Amenity}" Style="{StaticResource Caption}" />
                                            </VerticalStackLayout>
                                            <VerticalStackLayout Grid.Column="2" VerticalOptions="Center">
                                                <Label Text="{Binding CoachText}" />
                                                <Label Text="{Binding PaidText}" Style="{StaticResource Caption}" />
                                            </VerticalStackLayout>
                                            <Label Grid.Column="3" Text="{Binding BalanceText}" FontFamily="BarlowSemiBold" VerticalOptions="Center" HorizontalOptions="End" />
                                            <HorizontalStackLayout Grid.Column="4" Spacing="8" VerticalOptions="Center">
                                                <Button Text="Take in cash" Style="{StaticResource SmallButton}" Clicked="OnTakeCash" AutomationId="TakeBalanceCash"
                                                        SemanticProperties.Description="{Binding Member, StringFormat='Take the balance of {0} in cash'}" />
                                                <Button Text="GCash" Style="{StaticResource SmallOutlineButton}" Clicked="OnTakeGcash"
                                                        SemanticProperties.Description="{Binding Member, StringFormat='Take the balance of {0} by GCash'}" />
                                            </HorizontalStackLayout>
                                        </Grid>
                                        <BoxView Style="{StaticResource Hairline}" />
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="4" WidthRequest="260" HorizontalOptions="Start">
                            <Label Text="GCash reference (for GCash only)" Style="{StaticResource Caption}" />
                            <Border Style="{StaticResource Field}"><Entry Text="{Binding BalanceReference}" SemanticProperties.Description="GCash reference for the balance" /></Border>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <!-- F13 booking refund claims ("I didn't use it"), moved here from Payments to verify (cashier plan Y7): what the member said
                 beside what the desk checks; decided with a reason the member reads -->
            <VerticalStackLayout Spacing="8" IsVisible="{Binding HasClaims}">
                <Label Text="Booking refund claims" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource Panel}" IsVisible="{Binding IsDeciding}">
                    <VerticalStackLayout Spacing="10">
                        <c:CardTitle Text="{Binding DecideTitle}" />
                        <Label Text="Say what you checked, for example the check-ins that day or the amenity's log. The member reads this." Style="{StaticResource Caption}" />
                        <Border Style="{StaticResource Field}" WidthRequest="420" HorizontalOptions="Start">
                            <Entry Text="{Binding DecideReason}" Placeholder="No check-in that day; pool closed for cleaning" SemanticProperties.Description="Reason for the decision" />
                        </Border>
                        <HorizontalStackLayout Spacing="8">
                            <Button Text="{Binding DecideText}" Style="{StaticResource SmallButton}" Command="{Binding ConfirmDecisionCommand}" />
                            <Button Text="Back" Style="{StaticResource SmallOutlineButton}" Command="{Binding KeepClaimCommand}" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>
                <Border Style="{StaticResource Panel}">
                    <VerticalStackLayout Spacing="0" BindableLayout.ItemsSource="{Binding Claims}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="svc:ClaimRow">
                                <VerticalStackLayout>
                                    <Grid ColumnDefinitions="*,1.4*,1.2*,Auto" ColumnSpacing="12" Padding="0,8">
                                        <VerticalStackLayout VerticalOptions="Center">
                                            <Label Text="{Binding Member}" FontFamily="BarlowSemiBold" />
                                            <Label Text="{Binding Amenity, StringFormat='{0} booking'}" Style="{StaticResource Caption}" />
                                            <Label Text="{Binding When}" Style="{StaticResource Caption}" />
                                        </VerticalStackLayout>
                                        <Label Grid.Column="1" Text="{Binding Claim.Reason, StringFormat='“{0}”'}" LineBreakMode="WordWrap" VerticalOptions="Center" />
                                        <VerticalStackLayout Grid.Column="2" VerticalOptions="Center">
                                            <Label Text="{Binding CheckIns, StringFormat='Check-ins that day: {0}'}" Style="{StaticResource Caption}" />
                                            <Label Text="{Binding AmenityNow, StringFormat='Amenity now: {0}'}" Style="{StaticResource Caption}" />
                                        </VerticalStackLayout>
                                        <HorizontalStackLayout Grid.Column="3" Spacing="8" VerticalOptions="Center">
                                            <Label Text="{Binding Price}" FontFamily="BarlowSemiBold" VerticalOptions="Center" />
                                            <Button Text="Approve" Style="{StaticResource SmallOutlineButton}" Clicked="OnApproveClaim" />
                                            <Button Text="Decline" Style="{StaticResource SmallOutlineButton}" Clicked="OnDeclineClaim" />
                                        </HorizontalStackLayout>
                                    </Grid>
                                    <BoxView Style="{StaticResource Hairline}" />
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <!-- the editor for the amenity you chose -->
            <Border Style="{StaticResource Panel}" IsVisible="{Binding IsEditing}" MaximumWidthRequest="{OnIdiom Phone=10000, Default=640}" HorizontalOptions="{OnIdiom Phone=Fill, Default=Start}">
                <VerticalStackLayout Spacing="10">
                    <c:CardTitle Text="{Binding Editing.Amenity.Name, StringFormat='Change {0}'}" />
                    <Border Style="{StaticResource Field}">
                        <Picker ItemsSource="{Binding Choices}" ItemDisplayBinding="{Binding Label}" SelectedItem="{Binding Choice}" SemanticProperties.Description="Status" />
                    </Border>

                    <VerticalStackLayout Spacing="10" IsVisible="{Binding ShowDetail}">
                        <Label Text="Reason (shown to members)" Style="{StaticResource Caption}" />
                        <Border Style="{StaticResource Field}">
                            <Entry Text="{Binding Reason}" MaxLength="200" Placeholder="For example maintenance, cleaning, closed" SemanticProperties.Description="Reason" />
                        </Border>
                        <FlexLayout Wrap="Wrap">
                            <!-- quick reasons: the app's chips (9.7) -->
                            <Button Text="Maintenance" Style="{StaticResource FilterChip}" Margin="0,0,8,8" Clicked="OnMaintenance" />
                            <Button Text="Cleaning" Style="{StaticResource FilterChip}" Margin="0,0,8,8" Clicked="OnCleaning" />
                            <Button Text="Closed" Style="{StaticResource FilterChip}" Margin="0,0,8,8" Clicked="OnClosed" />
                        </FlexLayout>
                        <HorizontalStackLayout Spacing="10">
                            <Switch IsToggled="{Binding HasBackAt}" SemanticProperties.Description="I know when it will be back" />
                            <Label Text="I know when it will be back" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Spacing="10" IsVisible="{Binding HasBackAt}">
                            <Border Style="{StaticResource Field}"><DatePicker Date="{Binding BackDate}" SemanticProperties.Description="Return date" /></Border>
                            <Border Style="{StaticResource Field}"><TimePicker Time="{Binding BackTime}" SemanticProperties.Description="Return time" /></Border>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>

                    <HorizontalStackLayout Spacing="10">
                        <Button Text="Save status" Command="{Binding SaveCommand}" />
                        <Button Text="Cancel" Style="{StaticResource OutlineButton}" Command="{Binding CancelCommand}" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <c:CardGrid Columns="{OnIdiom Phone=1, Default=3}" BindableLayout.ItemsSource="{Binding Cards}">
                <BindableLayout.EmptyView><Label Text="No amenities are listed yet." Style="{StaticResource Muted}" /></BindableLayout.EmptyView>
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="svc:AmenityCard">
                        <c:AmenityCardView ActionText="Change status" ActionClicked="OnChange" />
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </c:CardGrid>
        </VerticalStackLayout>

        <!-- who booked: confirmed bookings not yet ended, soonest first; View shows the details and prints the receipt -->
        <VerticalStackLayout Grid.Column="1" Spacing="8">
            <Label Text="Booked" Style="{StaticResource SectionTitle}" />
            <Border Style="{StaticResource Panel}" IsVisible="{Binding IsViewing}" AutomationId="BookedDetails">
                <VerticalStackLayout Spacing="6">
                    <c:CardTitle Text="{Binding Viewing.Who}" />
                    <Label Text="{Binding Viewing.Amenity}" FontFamily="BarlowSemiBold" />
                    <Label Text="{Binding Viewing.When}" />
                    <Label Text="{Binding Viewing.Coach, StringFormat='Coach: {0}'}" IsVisible="{Binding Viewing.Coach, Converter={StaticResource IsNotNull}}" />
                    <Label Text="{Binding Viewing.PaidText}" />
                    <Label Text="{Binding Viewing.MethodText}" Style="{StaticResource Caption}" />
                    <Label Text="{Binding Viewing.ReceiptText, StringFormat='Receipt {0}'}" FontFamily="BarlowSemiBold" />
                    <Label Text="{Binding Viewing.Booking.Id, StringFormat='Booking no. {0}'}" Style="{StaticResource Caption}" />
                    <Label Text="{Binding Viewing.RefundText}" FontFamily="BarlowSemiBold" IsVisible="{Binding Viewing.RefundText, Converter={StaticResource HasText}}" AutomationId="BookingRefundState" />
                    <Label Text="{Binding Viewing.RefundRule}" Style="{StaticResource Caption}" IsVisible="{Binding Viewing.CanRequestRefund}" />
                    <VerticalStackLayout Spacing="8" Margin="0,6,0,0" IsVisible="{Binding IsAskingRefund}">
                        <Label Text="Why is this being refunded? The System admin reads this." Style="{StaticResource Caption}" />
                        <Border Style="{StaticResource Field}"><Entry Text="{Binding RefundReason}" MaxLength="900" Placeholder="Customer can't come" SemanticProperties.Description="Reason for the refund" AutomationId="BookingRefundReason" /></Border>
                        <HorizontalStackLayout Spacing="8">
                            <Button Text="Send request" Style="{StaticResource SmallButton}" Command="{Binding SendRefundCommand}" AutomationId="SendBookingRefund" />
                            <Button Text="Back" Style="{StaticResource SmallOutlineButton}" Command="{Binding KeepRefundCommand}" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                    <FlexLayout Wrap="Wrap" Margin="0,6,0,0" IsVisible="{Binding IsAskingRefund, Converter={StaticResource Not}}">
                        <Button Text="Print receipt" Style="{StaticResource SmallButton}" Margin="0,0,8,8" Command="{Binding PrintReceiptCommand}" AutomationId="PrintBookingReceipt" />
                        <Button Text="{Binding Viewing.RefundButton}" Style="{StaticResource SmallOutlineButton}" Margin="0,0,8,8" Command="{Binding AskRefundCommand}" IsVisible="{Binding Viewing.CanRequestRefund}" AutomationId="RequestBookingRefund" />
                        <Button Text="Close" Style="{StaticResource SmallOutlineButton}" Margin="0,0,8,8" Command="{Binding CloseViewCommand}" />
                    </FlexLayout>
                </VerticalStackLayout>
            </Border>
            <Border Style="{StaticResource Panel}">
                <VerticalStackLayout Spacing="0" BindableLayout.ItemsSource="{Binding Booked}">
                    <BindableLayout.EmptyView><Label Text="No upcoming bookings." Style="{StaticResource Muted}" /></BindableLayout.EmptyView>
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="svc:BookedRow">
                            <VerticalStackLayout>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Padding="0,8">
                                    <VerticalStackLayout VerticalOptions="Center">
                                        <Label Text="{Binding Who}" FontFamily="BarlowSemiBold" LineBreakMode="TailTruncation" />
                                        <Label Text="{Binding Amenity}" Style="{StaticResource Caption}" />
                                        <Label Text="{Binding When}" Style="{StaticResource Caption}" />
                                    </VerticalStackLayout>
                                    <Button Grid.Column="1" Text="View" Style="{StaticResource FilterChip}" VerticalOptions="Center" Clicked="OnViewBooked"
                                            SemanticProperties.Description="{Binding Who, StringFormat='View the booking of {0}'}" />
                                </Grid>
                                <BoxView Style="{StaticResource Hairline}" />
                            </VerticalStackLayout>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
        </Grid>
    </ScrollView>
</v:BasePage>
