<?xml version="1.0" encoding="utf-8" ?>
<v:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
            xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
            xmlns:v="clr-namespace:GymMembership.App.Views"
            xmlns:c="clr-namespace:GymMembership.App.Controls"
            xmlns:vm="clr-namespace:GymMembership.Core.ViewModels;assembly=GymMembership.Core"
            xmlns:svc="clr-namespace:GymMembership.Core.Services;assembly=GymMembership.Core"
            x:Class="GymMembership.App.Views.CheckInPage" x:DataType="vm:CheckInViewModel" Title="Check-in">

    <Grid RowDefinitions="Auto,*" Padding="20,16,20,0" MaximumWidthRequest="920">
        <VerticalStackLayout Spacing="10" Padding="0,0,0,10">
            <!-- D12: a member's QR is identification only; the result comes from live data and a scan never checks in by itself -->
            <Label Text="Scan a member" Style="{StaticResource Heading}" />
            <FlexLayout Wrap="Wrap" AlignItems="Center">
                <Button Text="Scan member QR" Style="{StaticResource SmallButton}" Command="{Binding ToggleCameraCommand}" Margin="0,0,12,8" AutomationId="ScanCamera">
                    <Button.Triggers><DataTrigger TargetType="Button" Binding="{Binding IsScanning}" Value="True"><Setter Property="Text" Value="Stop camera" /></DataTrigger></Button.Triggers>
                </Button>
                <Border Style="{StaticResource Field}" Margin="0,0,0,8" WidthRequest="300">
                    <Entry Text="{Binding ScanInput}" Placeholder="Or use a QR scanner device here" ReturnCommand="{Binding ScanCommand}"
                           AutomationId="ScanInput" SemanticProperties.Description="Member code from a QR scanner device" />
                </Border>
            </FlexLayout>
            <ContentView x:Name="CameraHost" HeightRequest="300" MaximumWidthRequest="420" HorizontalOptions="Start" IsVisible="{Binding IsScanning}" />
            <Border Style="{StaticResource Panel}" Padding="16,12" IsVisible="{Binding HasScan}">
                <VerticalStackLayout Spacing="6">
                    <Label Text="{Binding Scan.Name, TargetNullValue='Unknown code'}" Style="{StaticResource Heading}" AutomationId="ScanName" />
                    <Label Text="{Binding Scan.StatusText}" FontFamily="BarlowMedium" AutomationId="ScanStatus" />
                    <Label Text="{Binding Scan.ExpiryText}" Style="{StaticResource Caption}" />
                    <FlexLayout Wrap="Wrap" Margin="0,6,0,0">
                        <Button Text="Check in" Style="{StaticResource SmallButton}" Margin="0,0,8,8" Command="{Binding CheckInScannedCommand}" IsVisible="{Binding Scan.CanCheckIn}" />
                        <Button Text="Done" Style="{StaticResource SmallOutlineButton}" Margin="0,0,8,8" Command="{Binding ClearScanCommand}" />
                    </FlexLayout>
                </VerticalStackLayout>
            </Border>

            <Label Text="Coaches" Style="{StaticResource Heading}" Margin="0,6,0,0" />
            <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Coaches}">
                <BindableLayout.EmptyView><Label Text="No coaches yet." Style="{StaticResource Muted}" /></BindableLayout.EmptyView>
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="svc:CoachPresenceRow">
                        <Border Style="{StaticResource Panel}" Padding="16,10">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                                <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                    <Label Text="{Binding Name}" FontFamily="BarlowMedium" />
                                    <Label Text="{Binding StateText}" Style="{StaticResource Caption}" />
                                </VerticalStackLayout>
                                <Button Grid.Column="1" Text="{Binding ActionText}" Style="{StaticResource SmallOutlineButton}" Clicked="OnToggleCoach" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
            <Label Text="Members" Style="{StaticResource Heading}" Margin="0,6,0,0" />
            <Border Style="{StaticResource Field}"><SearchBar Placeholder="Search members by name" Text="{Binding Search}" SearchCommand="{Binding SearchCommand}" /></Border>
            <c:Banner Message="{Binding ErrorMessage}" />
            <c:Banner Kind="notice" Message="{Binding Notice}" />
        </VerticalStackLayout>

        <CollectionView Grid.Row="1" ItemsSource="{Binding Hits}">
            <CollectionView.ItemsLayout><LinearItemsLayout Orientation="Vertical" ItemSpacing="10" /></CollectionView.ItemsLayout>
            <CollectionView.EmptyView><Label Text="No members match that name." Style="{StaticResource Muted}" /></CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="svc:MemberHit">
                    <Border Style="{StaticResource Panel}" Padding="16,12">
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="14">
                            <Label Text="{Binding Username}" Style="{StaticResource Heading}" VerticalOptions="Center" />
                            <c:StatusChip Grid.Column="1" Status="{Binding PlanStatus}" VerticalOptions="Center" />
                            <Button Grid.Column="2" Text="Check in" Style="{StaticResource SmallButton}"
                                    Clicked="OnCheckIn" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</v:BasePage>
