<?xml version="1.0" encoding="utf-8" ?>
<v:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
            xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
            xmlns:v="clr-namespace:GymMembership.App.Views"
            xmlns:c="clr-namespace:GymMembership.App.Controls"
            xmlns:vm="clr-namespace:GymMembership.Core.ViewModels;assembly=GymMembership.Core"
            xmlns:svc="clr-namespace:GymMembership.Core.Services;assembly=GymMembership.Core"
            x:Class="GymMembership.App.Views.TraineesPage" x:DataType="vm:TraineesViewModel" Title="Trainees">

    <Grid RowDefinitions="Auto,*" Padding="20,16,20,0" MaximumWidthRequest="920">
        <VerticalStackLayout Spacing="10" Padding="0,0,0,10">
            <Label Text="Members who have hired you. Message them, or remove them when you stop training together." Style="{StaticResource Muted}" />
            <c:Banner Message="{Binding ErrorMessage}" />
            <c:Banner Kind="notice" Message="{Binding Notice}" />
        </VerticalStackLayout>

        <CollectionView Grid.Row="1" ItemsSource="{Binding Trainees}">
            <CollectionView.ItemsLayout><LinearItemsLayout Orientation="Vertical" ItemSpacing="10" /></CollectionView.ItemsLayout>
            <CollectionView.EmptyView><Label Text="No trainees yet. Members appear here when they hire you." Style="{StaticResource Muted}" /></CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="svc:TraineeRow">
                    <Border Style="{StaticResource Panel}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                            <VerticalStackLayout Spacing="3">
                                <Label Text="{Binding Name}" Style="{StaticResource Heading}" />
                                <Label Text="{Binding NextText}" />
                                <Label Text="{Binding Completed, StringFormat='{0} sessions completed'}" Style="{StaticResource Caption}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="8" HorizontalOptions="End">
                                <Button Text="Message" Style="{StaticResource SmallButton}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TraineesViewModel}}, Path=MessageCommand}" CommandParameter="{Binding .}" />
                                <Button Text="Remove" Style="{StaticResource SmallOutlineButton}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TraineesViewModel}}, Path=RemoveCommand}" CommandParameter="{Binding .}" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</v:BasePage>
