<?xml version="1.0" encoding="utf-8" ?>
<v:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
            xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
            xmlns:v="clr-namespace:GymMembership.App.Views"
            xmlns:c="clr-namespace:GymMembership.App.Controls"
            xmlns:vm="clr-namespace:GymMembership.Core.ViewModels;assembly=GymMembership.Core"
            x:Class="GymMembership.App.Views.GymSettingsPage" x:DataType="vm:GymSettingsViewModel" Title="Gym settings">

    <ScrollView MaximumWidthRequest="{StaticResource PageWidth}">
        <VerticalStackLayout Padding="{OnIdiom Phone='20,16,20,24', Default='16,12,16,20'}" Spacing="16">
            <Label Text="What members see when they pay, the price of a day pass, and the float each cash drawer starts with." Style="{StaticResource Muted}" />
            <c:Banner Message="{Binding ErrorMessage}" />
            <c:Banner Kind="notice" Message="{Binding Notice}" />

            <!-- the gym's details and its payment QR, side by side -->
            <c:CardGrid Columns="{OnIdiom Phone=1, Default=2}">
            <Border Style="{StaticResource Panel}">
            <VerticalStackLayout Spacing="16">
            <VerticalStackLayout Spacing="6">
                <Label Text="Gym name" Style="{StaticResource Caption}" />
                <Border Style="{StaticResource Field}"><Entry Text="{Binding GymName}" SemanticProperties.Description="Gym name" /></Border>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="6">
                <!-- F2 (0050): the float sits beside the day-pass price; Start shift on the Cashier page fills it in -->
                <FlexLayout Wrap="Wrap" AlignItems="End">
                    <VerticalStackLayout Spacing="6" Margin="0,0,16,0">
                        <Label Text="Walk-in price (₱)" Style="{StaticResource Caption}" />
                        <Border Style="{StaticResource Field}" WidthRequest="160"><Entry Text="{Binding WalkInPrice}" Keyboard="Numeric" SemanticProperties.Description="Walk-in price" /></Border>
                        <!-- 0098: the Day pass package's price wins while one is on sale -->
                        <Label Text="Used only while no Day pass package is on sale." Style="{StaticResource Caption}" WidthRequest="160" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Opening float (₱)" Style="{StaticResource Caption}" />
                        <Border Style="{StaticResource Field}" WidthRequest="160"><Entry Text="{Binding OpeningFloat}" Keyboard="Numeric" AutomationId="OpeningFloat" SemanticProperties.Description="Opening float, in pesos" /></Border>
                    </VerticalStackLayout>
                    <!-- G13 (0064): the part of an amenity booking paid to reserve it; the rest is paid at the desk -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Booking down payment (%)" Style="{StaticResource Caption}" />
                        <Border Style="{StaticResource Field}" WidthRequest="160"><Entry Text="{Binding DownPaymentPercent}" Keyboard="Numeric" AutomationId="DownPaymentPercent" SemanticProperties.Description="Down payment for amenity bookings, in percent" /></Border>
                    </VerticalStackLayout>
                </FlexLayout>
                <Label Text="The opening float is the cash each cashier counts into their drawer when they start a shift. The booking down payment is the part of an amenity booking paid to reserve it (1 to 100); the rest is paid at the desk." Style="{StaticResource Caption}" />
                <Label Text="Opening hours, every day (Manila time). Coach shifts and bookings must fit inside them, on the hour or half hour." Style="{StaticResource Caption}" Margin="0,10,0,0" />
                <!-- 9.8: each picker says which end of the day it is -->
                <FlexLayout Wrap="Wrap" AlignItems="End">
                    <VerticalStackLayout Spacing="4" Margin="0,0,12,8">
                        <Label Text="Opens" Style="{StaticResource Caption}" />
                        <Border Style="{StaticResource Field}"><TimePicker Time="{Binding OpensAt}" SemanticProperties.Description="Opening time" /></Border>
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="4" Margin="0,0,12,8">
                        <Label Text="Closes" Style="{StaticResource Caption}" />
                        <Border Style="{StaticResource Field}"><TimePicker Time="{Binding ClosesAt}" SemanticProperties.Description="Closing time" /></Border>
                    </VerticalStackLayout>
                </FlexLayout>
            </VerticalStackLayout>
            </VerticalStackLayout>
            </Border>

            </c:CardGrid>

            <Button Text="Save settings" HorizontalOptions="Start" Command="{Binding SaveCommand}" />

            <!-- G16-G18 (0065, approved mockup docs/mockups/gym-closed-days.html): closing a day happens at once, after a confirm; not part of Save settings -->
            <Border Style="{StaticResource Panel}">
                <VerticalStackLayout Spacing="12">
                    <c:CardTitle Text="Closed days" />
                    <Label Text="Close the gym for a whole day. Bookings, sessions and coach shifts that day are cancelled, paid bookings are refunded at the desk, and everyone gets an announcement." Style="{StaticResource Caption}" />
                    <FlexLayout Wrap="Wrap" AlignItems="End">
                        <VerticalStackLayout Spacing="6" Margin="0,0,12,8">
                            <Label Text="Day" Style="{StaticResource Caption}" />
                            <Border Style="{StaticResource Field}"><DatePicker Date="{Binding ClosedDay}" MinimumDate="{Binding MinClosedDay}" AutomationId="ClosedDay" SemanticProperties.Description="Day to close" /></Border>
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="6" Margin="0,0,12,8" FlexLayout.Grow="1" MinimumWidthRequest="260">
                            <Label Text="Why (members see this)" Style="{StaticResource Caption}" />
                            <Border Style="{StaticResource Field}"><Entry Text="{Binding ClosedReason}" MaxLength="200" Placeholder="For example, Holiday" AutomationId="ClosedReason" SemanticProperties.Description="Why the gym is closed" /></Border>
                        </VerticalStackLayout>
                        <Button Text="Close the gym that day" Style="{StaticResource OutlineButton}" Margin="0,0,0,8" Command="{Binding CloseDayCommand}" AutomationId="CloseGymDay" />
                    </FlexLayout>
                    <Label Text="No closed days. The gym is open every day in its opening hours." Style="{StaticResource Muted}" IsVisible="{Binding HasClosures, Converter={StaticResource Not}}" />
                    <VerticalStackLayout Spacing="0" BindableLayout.ItemsSource="{Binding Closures}" IsVisible="{Binding HasClosures}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:GymClosureRow">
                                <VerticalStackLayout Spacing="0">
                                    <BoxView Style="{StaticResource Hairline}" />
                                    <Grid ColumnDefinitions="160,*,Auto" ColumnSpacing="14" Padding="0,10">
                                        <Label Text="{Binding DayText}" FontFamily="BarlowSemiBold" VerticalOptions="Center" />
                                        <Label Grid.Column="1" Text="{Binding Reason}" VerticalOptions="Center" LineBreakMode="WordWrap" />
                                        <Button Grid.Column="2" Text="Open again" Style="{StaticResource SmallOutlineButton}" Clicked="OnReopen" IsVisible="{Binding CanReopen}"
                                                SemanticProperties.Description="{Binding DayText, StringFormat='Open the gym again on {0}'}" />
                                        <c:StatusChip Grid.Column="2" Status="Past" VerticalOptions="Center" IsVisible="{Binding CanReopen, Converter={StaticResource Not}}" />
                                    </Grid>
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</v:BasePage>
