<?xml version="1.0" encoding="utf-8" ?>
<v:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
            xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
            xmlns:v="clr-namespace:GymMembership.App.Views"
            xmlns:c="clr-namespace:GymMembership.App.Controls"
            xmlns:vm="clr-namespace:GymMembership.Core.ViewModels;assembly=GymMembership.Core"
            xmlns:m="clr-namespace:GymMembership.Core.Models;assembly=GymMembership.Core"
            x:Class="GymMembership.App.Views.CatalogAdminPage" x:DataType="vm:CatalogAdminViewModel" Title="Packages and amenities">

    <ScrollView MaximumWidthRequest="{StaticResource PageWidth}">
        <VerticalStackLayout Padding="{OnIdiom Phone='20,16,20,24', Default='16,12,16,20'}" Spacing="14">
            <c:Banner Message="{Binding ErrorMessage}" />
            <c:Banner Kind="notice" Message="{Binding Notice}" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" HorizontalOptions="Start" />

            <Border Style="{StaticResource Panel}" IsVisible="{Binding Deleting, Converter={StaticResource IsNotNull}}">
                <VerticalStackLayout Spacing="10">
                    <c:CardTitle Icon="archive" Text="{Binding Deleting.Name, StringFormat='Archive “{0}”? History will be retained.'}" />
                    <HorizontalStackLayout Spacing="8">
                        <Button Text="Yes, archive" Style="{StaticResource SmallButton}" Command="{Binding ConfirmDeleteCommand}" />
                        <Button Text="Keep it" Style="{StaticResource SmallOutlineButton}" Command="{Binding KeepPackageCommand}" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Label Text="Membership packages" Style="{StaticResource SectionTitle}" />
            <Border Style="{StaticResource Panel}">
                <FlexLayout Wrap="Wrap" AlignItems="End">
                    <VerticalStackLayout Spacing="4" Margin="0,0,12,8" WidthRequest="200">
                        <Label Text="Name" Style="{StaticResource Caption}" />
                        <Border Style="{StaticResource Field}"><Entry Text="{Binding NewPackageName}" /></Border>
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="4" Margin="0,0,12,8" WidthRequest="260">
                        <Label Text="Description" Style="{StaticResource Caption}" />
                        <Border Style="{StaticResource Field}"><Entry Text="{Binding NewDescription}" /></Border>
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="4" Margin="0,0,12,8" WidthRequest="110">
                        <Label Text="Price" Style="{StaticResource Caption}" />
                        <Border Style="{StaticResource Field}"><Entry Text="{Binding NewPrice}" Keyboard="Numeric" /></Border>
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="4" Margin="0,0,12,8" WidthRequest="110">
                        <Label Text="Days" Style="{StaticResource Caption}" />
                        <Border Style="{StaticResource Field}"><Entry Text="{Binding NewDays}" Keyboard="Numeric" /></Border>
                    </VerticalStackLayout>
                    <Button Text="{Binding SaveLabel}" Style="{StaticResource SmallButton}" Margin="0,0,8,8" Command="{Binding SavePackageCommand}" />
                    <Button Text="Cancel edit" Style="{StaticResource SmallOutlineButton}" Margin="0,0,0,8" IsVisible="{Binding IsEditing}" Command="{Binding CancelEditCommand}" />
                </FlexLayout>
            </Border>
            <c:CardGrid Columns="{OnIdiom Phone=1, Default=4}" BindableLayout.ItemsSource="{Binding Packages}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="m:MembershipPackage">
                        <Border Style="{StaticResource Panel}" Padding="16,12">
                            <VerticalStackLayout Spacing="10">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                                    <VerticalStackLayout Spacing="2">
                                        <c:CardTitle Icon="package" Text="{Binding Name}" />
                                        <Label Style="{StaticResource Caption}">
                                            <Label.Text>
                                                <MultiBinding StringFormat="{}₱{0:N2}, {1} days">
                                                    <Binding Path="Price" /><Binding Path="DurationDays" />
                                                </MultiBinding>
                                            </Label.Text>
                                        </Label>
                                    </VerticalStackLayout>
                                    <c:StatusChip Grid.Column="1" VerticalOptions="Center">
                                        <c:StatusChip.Triggers>
                                            <DataTrigger TargetType="c:StatusChip" Binding="{Binding IsActive}" Value="True"><Setter Property="Status" Value="active" /></DataTrigger>
                                            <DataTrigger TargetType="c:StatusChip" Binding="{Binding IsActive}" Value="False"><Setter Property="Status" Value="inactive" /></DataTrigger>
                                        </c:StatusChip.Triggers>
                                    </c:StatusChip>
                                </Grid>
                                <HorizontalStackLayout Spacing="8">
                                    <Button Text="Edit" Style="{StaticResource SmallButton}"
                                            Clicked="OnEditPackage" />
                                    <Button Text="Deactivate" Style="{StaticResource SmallOutlineButton}"
                                            Clicked="OnTogglePackage" />
                                    <Button Text="Archive" Style="{StaticResource SmallOutlineButton}"
                                            Clicked="OnDeletePackage" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </c:CardGrid>

            <Label Text="Amenities" Style="{StaticResource SectionTitle}" />
            <Border Style="{StaticResource Panel}">
                <FlexLayout Wrap="Wrap" AlignItems="End">
                    <VerticalStackLayout Spacing="4" Margin="0,0,12,8" WidthRequest="260">
                        <Label Text="Name" Style="{StaticResource Caption}" />
                        <Border Style="{StaticResource Field}"><Entry Text="{Binding NewAmenityName}" /></Border>
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="4" Margin="0,0,12,8" WidthRequest="110">
                        <Label Text="Price" Style="{StaticResource Caption}" />
                        <Border Style="{StaticResource Field}"><Entry Text="{Binding NewAmenityPrice}" Keyboard="Numeric" /></Border>
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="4" Margin="0,0,12,8" WidthRequest="110">
                        <Label Text="Days of access" Style="{StaticResource Caption}" />
                        <Border Style="{StaticResource Field}"><Entry Text="{Binding NewAmenityDays}" Keyboard="Numeric" /></Border>
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="4" Margin="0,0,12,8" WidthRequest="260">
                        <Label Text="Description" Style="{StaticResource Caption}" />
                        <Border Style="{StaticResource Field}"><Entry Text="{Binding NewAmenityDescription}" Placeholder="What members get" /></Border>
                    </VerticalStackLayout>
                    <Button Text="{Binding AmenitySaveLabel}" Style="{StaticResource SmallButton}" Margin="0,0,8,8" Command="{Binding AddAmenityCommand}" />
                    <Button Text="Cancel edit" Style="{StaticResource SmallOutlineButton}" Margin="0,0,0,8" IsVisible="{Binding IsEditingAmenity}" Command="{Binding CancelAmenityEditCommand}" />
                </FlexLayout>
            </Border>
            <c:CardGrid Columns="{OnIdiom Phone=1, Default=4}" BindableLayout.ItemsSource="{Binding Amenities}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="m:Amenity">
                        <Border Style="{StaticResource Panel}" Padding="16,12">
                            <VerticalStackLayout Spacing="10">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                                    <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                                        <c:CardTitle Icon="waves" Text="{Binding Name}" />
                                        <Label Style="{StaticResource Caption}">
                                            <Label.Text>
                                                <MultiBinding StringFormat="{}₱{0:N2} for {1} days">
                                                    <Binding Path="Price" /><Binding Path="DurationDays" />
                                                </MultiBinding>
                                            </Label.Text>
                                        </Label>
                                        <Label Text="Photo set" Style="{StaticResource Caption}" IsVisible="{Binding ImagePath, Converter={StaticResource IsNotNull}}" />
                                    </VerticalStackLayout>
                                    <c:StatusChip Grid.Column="1" VerticalOptions="Center">
                                        <c:StatusChip.Triggers>
                                            <DataTrigger TargetType="c:StatusChip" Binding="{Binding IsActive}" Value="True"><Setter Property="Status" Value="active" /></DataTrigger>
                                            <DataTrigger TargetType="c:StatusChip" Binding="{Binding IsActive}" Value="False"><Setter Property="Status" Value="inactive" /></DataTrigger>
                                        </c:StatusChip.Triggers>
                                    </c:StatusChip>
                                </Grid>
                                <FlexLayout Wrap="Wrap">
                                    <Button Text="Add or replace photo" Style="{StaticResource SmallOutlineButton}" Margin="0,0,8,8" Clicked="OnUploadAmenityPhoto"
                                            SemanticProperties.Hint="Choose a JPG, PNG or WebP up to 5 MB for this amenity" />
                                    <Button Text="Edit" Style="{StaticResource SmallOutlineButton}" Margin="0,0,8,8" Clicked="OnEditAmenity" />
                                    <Button Text="Deactivate" Style="{StaticResource SmallOutlineButton}" Margin="0,0,8,8" Clicked="OnToggleAmenity" />
                                </FlexLayout>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </c:CardGrid>
        </VerticalStackLayout>
    </ScrollView>
</v:BasePage>
