<?xml version="1.0" encoding="utf-8" ?>
<v:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
            xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
            xmlns:v="clr-namespace:GymMembership.App.Views"
            xmlns:c="clr-namespace:GymMembership.App.Controls"
            xmlns:vm="clr-namespace:GymMembership.Core.ViewModels;assembly=GymMembership.Core"
            xmlns:m="clr-namespace:GymMembership.Core.Models;assembly=GymMembership.Core"
            x:Class="GymMembership.App.Views.CatalogAdminPage" x:DataType="vm:CatalogAdminViewModel" Title="Packages and amenities">

    <!-- 9.8: tables (were grids of cards, a yellow Edit on each package and five buttons on each amenity). Every action stays one click
         away as a chip; the destructive ones last (D28). Narrow windows get the same facts stacked. -->
    <v:BasePage.Resources>
        <DataTemplate x:Key="PackageRow" x:DataType="m:MembershipPackage">
            <VerticalStackLayout>
                <Grid Style="{StaticResource TableRow}" ColumnDefinitions="*,130,80,110,1.6*">
                    <Label Text="{Binding Name}" FontFamily="BarlowSemiBold" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="{Binding Price, StringFormat='₱{0:N2}'}" HorizontalOptions="End" VerticalOptions="Center" />
                    <Label Grid.Column="2" Text="{Binding DurationDays}" HorizontalOptions="End" VerticalOptions="Center" />
                    <c:StatusChip Grid.Column="3" VerticalOptions="Center" Status="{Binding IsActive, Converter={StaticResource RecordStatus}}" />
                    <FlexLayout Grid.Column="4" Wrap="Wrap" JustifyContent="End" Margin="0,8,0,0">
                        <Button Text="Edit" Style="{StaticResource FilterChip}" Margin="8,0,0,8" Clicked="OnEditPackage" />
                        <Button Text="Deactivate" Style="{StaticResource FilterChip}" Margin="8,0,0,8" Clicked="OnTogglePackage">
                            <Button.Triggers><DataTrigger TargetType="Button" Binding="{Binding IsActive}" Value="False"><Setter Property="Text" Value="Activate" /></DataTrigger></Button.Triggers>
                        </Button>
                        <Button Text="Archive" Style="{StaticResource FilterChip}" Margin="8,0,0,8" Clicked="OnDeletePackage" />
                    </FlexLayout>
                </Grid>
                <BoxView Style="{StaticResource Hairline}" />
            </VerticalStackLayout>
        </DataTemplate>
        <DataTemplate x:Key="PackageCard" x:DataType="m:MembershipPackage">
            <VerticalStackLayout>
                <VerticalStackLayout Spacing="4" Padding="14,12">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <Label Text="{Binding Name}" FontFamily="BarlowSemiBold" VerticalOptions="Center" />
                        <c:StatusChip Grid.Column="1" VerticalOptions="Center" Status="{Binding IsActive, Converter={StaticResource RecordStatus}}" />
                    </Grid>
                    <Label Style="{StaticResource Caption}">
                        <Label.Text>
                            <MultiBinding StringFormat="{}₱{0:N2}, {1} days"><Binding Path="Price" /><Binding Path="DurationDays" /></MultiBinding>
                        </Label.Text>
                    </Label>
                    <FlexLayout Wrap="Wrap" Margin="0,4,0,0">
                        <Button Text="Edit" Style="{StaticResource FilterChip}" Margin="0,0,8,8" Clicked="OnEditPackage" />
                        <Button Text="Deactivate" Style="{StaticResource FilterChip}" Margin="0,0,8,8" Clicked="OnTogglePackage">
                            <Button.Triggers><DataTrigger TargetType="Button" Binding="{Binding IsActive}" Value="False"><Setter Property="Text" Value="Activate" /></DataTrigger></Button.Triggers>
                        </Button>
                        <Button Text="Archive" Style="{StaticResource FilterChip}" Margin="0,0,8,8" Clicked="OnDeletePackage" />
                    </FlexLayout>
                </VerticalStackLayout>
                <BoxView Style="{StaticResource Hairline}" />
            </VerticalStackLayout>
        </DataTemplate>

        <DataTemplate x:Key="AmenityRow" x:DataType="m:Amenity">
            <VerticalStackLayout>
                <Grid Style="{StaticResource TableRow}" ColumnDefinitions="*,170,90,110,2*">
                    <Label Text="{Binding Name}" FontFamily="BarlowSemiBold" VerticalOptions="Center" />
                    <Label Grid.Column="1" VerticalOptions="Center" IsVisible="{Binding DurationDays, Converter={StaticResource IsNotNull}}">
                        <Label.Text>
                            <MultiBinding StringFormat="{}₱{0:N2} for {1} days"><Binding Path="Price" /><Binding Path="DurationDays" /></MultiBinding>
                        </Label.Text>
                    </Label>
                    <Label Grid.Column="1" Text="{Binding Price, StringFormat='₱{0:N2} per session'}" VerticalOptions="Center" IsVisible="{Binding DurationDays, Converter={StaticResource IsNull}}" />
                    <Label Grid.Column="2" Text="Set" Style="{StaticResource Muted}" VerticalOptions="Center" IsVisible="{Binding ImagePath, Converter={StaticResource IsNotNull}}" />
                    <Label Grid.Column="2" Text="None" Style="{StaticResource Muted}" VerticalOptions="Center" IsVisible="{Binding ImagePath, Converter={StaticResource IsNull}}" />
                    <c:StatusChip Grid.Column="3" VerticalOptions="Center" Status="{Binding IsActive, Converter={StaticResource RecordStatus}}" />
                    <FlexLayout Grid.Column="4" Wrap="Wrap" JustifyContent="End" Margin="0,8,0,0">
                        <Button Text="Edit" Style="{StaticResource FilterChip}" Margin="8,0,0,8" Clicked="OnEditAmenity" />
                        <Button Text="Add or replace photo" Style="{StaticResource FilterChip}" Margin="8,0,0,8" Clicked="OnUploadAmenityPhoto"
                                SemanticProperties.Hint="Choose a JPG, PNG or WebP up to 5 MB for this amenity" />
                        <Button Text="Set session price" Style="{StaticResource FilterChip}" Margin="8,0,0,8" Clicked="OnSetSessionPrice" AutomationId="SetSessionPrice"
                                IsVisible="{Binding DurationDays, Converter={StaticResource IsNotNull}}" />
                        <Button Text="Deactivate" Style="{StaticResource FilterChip}" Margin="8,0,0,8" Clicked="OnToggleAmenity">
                            <Button.Triggers><DataTrigger TargetType="Button" Binding="{Binding IsActive}" Value="False"><Setter Property="Text" Value="Activate" /></DataTrigger></Button.Triggers>
                        </Button>
                        <Button Text="Archive" Style="{StaticResource FilterChip}" Margin="8,0,0,8" Clicked="OnDeleteAmenity" AutomationId="ArchiveAmenity" />
                    </FlexLayout>
                </Grid>
                <BoxView Style="{StaticResource Hairline}" />
            </VerticalStackLayout>
        </DataTemplate>
        <DataTemplate x:Key="AmenityCard" x:DataType="m:Amenity">
            <VerticalStackLayout>
                <VerticalStackLayout Spacing="4" Padding="14,12">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <Label Text="{Binding Name}" FontFamily="BarlowSemiBold" VerticalOptions="Center" />
                        <c:StatusChip Grid.Column="1" VerticalOptions="Center" Status="{Binding IsActive, Converter={StaticResource RecordStatus}}" />
                    </Grid>
                    <Label Style="{StaticResource Caption}" IsVisible="{Binding DurationDays, Converter={StaticResource IsNotNull}}">
                        <Label.Text>
                            <MultiBinding StringFormat="{}₱{0:N2} for {1} days"><Binding Path="Price" /><Binding Path="DurationDays" /></MultiBinding>
                        </Label.Text>
                    </Label>
                    <Label Text="{Binding Price, StringFormat='₱{0:N2} per session'}" Style="{StaticResource Caption}" IsVisible="{Binding DurationDays, Converter={StaticResource IsNull}}" />
                    <Label Text="Photo set" Style="{StaticResource Caption}" IsVisible="{Binding ImagePath, Converter={StaticResource IsNotNull}}" />
                    <FlexLayout Wrap="Wrap" Margin="0,4,0,0">
                        <Button Text="Edit" Style="{StaticResource FilterChip}" Margin="0,0,8,8" Clicked="OnEditAmenity" />
                        <Button Text="Add or replace photo" Style="{StaticResource FilterChip}" Margin="0,0,8,8" Clicked="OnUploadAmenityPhoto"
                                SemanticProperties.Hint="Choose a JPG, PNG or WebP up to 5 MB for this amenity" />
                        <Button Text="Set session price" Style="{StaticResource FilterChip}" Margin="0,0,8,8" Clicked="OnSetSessionPrice" AutomationId="SetSessionPrice"
                                IsVisible="{Binding DurationDays, Converter={StaticResource IsNotNull}}" />
                        <Button Text="Deactivate" Style="{StaticResource FilterChip}" Margin="0,0,8,8" Clicked="OnToggleAmenity">
                            <Button.Triggers><DataTrigger TargetType="Button" Binding="{Binding IsActive}" Value="False"><Setter Property="Text" Value="Activate" /></DataTrigger></Button.Triggers>
                        </Button>
                        <Button Text="Archive" Style="{StaticResource FilterChip}" Margin="0,0,8,8" Clicked="OnDeleteAmenity" AutomationId="ArchiveAmenity" />
                    </FlexLayout>
                </VerticalStackLayout>
                <BoxView Style="{StaticResource Hairline}" />
            </VerticalStackLayout>
        </DataTemplate>
    </v:BasePage.Resources>

    <ScrollView MaximumWidthRequest="{StaticResource PageWidth}">
        <VerticalStackLayout Padding="{OnIdiom Phone='20,16,20,24', Default='16,12,16,20'}" Spacing="14">
            <c:Banner Message="{Binding ErrorMessage}" />
            <c:Banner Kind="notice" Message="{Binding Notice}" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" HorizontalOptions="Start" />

            <Border Style="{StaticResource Panel}" IsVisible="{Binding PricingAmenity, Converter={StaticResource IsNotNull}}">
                <VerticalStackLayout Spacing="10">
                    <c:CardTitle Text="{Binding PricingAmenity.Name, StringFormat='Sell “{0}” per session'}" />
                    <Label Text="Members will pay for each booking instead of buying a timed pass. Passes already sold stay valid until they expire." Style="{StaticResource Caption}" />
                    <VerticalStackLayout Spacing="4" WidthRequest="160" HorizontalOptions="Start">
                        <Label Text="Price per session" Style="{StaticResource Caption}" />
                        <Border Style="{StaticResource Field}"><Entry Text="{Binding SessionPrice}" Keyboard="Numeric" SemanticProperties.Description="Price per session" AutomationId="SessionPriceInput" /></Border>
                    </VerticalStackLayout>
                    <HorizontalStackLayout Spacing="8">
                        <Button Text="Sell per session" Style="{StaticResource SmallButton}" Command="{Binding SaveSessionPriceCommand}" AutomationId="SaveSessionPrice" />
                        <Button Text="Cancel" Style="{StaticResource SmallOutlineButton}" Command="{Binding CancelSessionPriceCommand}" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Panel}" IsVisible="{Binding DeletingAmenity, Converter={StaticResource IsNotNull}}">
                <VerticalStackLayout Spacing="10">
                    <c:CardTitle Text="{Binding DeletingAmenity.Name, StringFormat='Archive “{0}”? Passes already sold keep working.'}" />
                    <HorizontalStackLayout Spacing="8">
                        <Button Text="Yes, archive" Style="{StaticResource SmallButton}" Command="{Binding ConfirmDeleteAmenityCommand}" AutomationId="ConfirmArchiveAmenity" />
                        <Button Text="Keep it" Style="{StaticResource SmallOutlineButton}" Command="{Binding KeepAmenityCommand}" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Panel}" IsVisible="{Binding Deleting, Converter={StaticResource IsNotNull}}">
                <VerticalStackLayout Spacing="10">
                    <c:CardTitle Text="{Binding Deleting.Name, StringFormat='Archive “{0}”? History will be retained.'}" />
                    <HorizontalStackLayout Spacing="8">
                        <Button Text="Yes, archive" Style="{StaticResource SmallButton}" Command="{Binding ConfirmDeleteCommand}" />
                        <Button Text="Keep it" Style="{StaticResource SmallOutlineButton}" Command="{Binding KeepPackageCommand}" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Label Text="Membership packages" Style="{StaticResource SectionTitle}" />
            <Border Style="{StaticResource Panel}">
                <FlexLayout Wrap="Wrap" AlignItems="End">
                    <VerticalStackLayout Spacing="4" Margin="0,0,12,8" WidthRequest="200">
                        <Label Text="Name" Style="{StaticResource Caption}" />
                        <Border Style="{StaticResource Field}"><Entry Text="{Binding NewPackageName}" /></Border>
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="4" Margin="0,0,12,8" WidthRequest="260">
                        <Label Text="Description" Style="{StaticResource Caption}" />
                        <Border Style="{StaticResource Field}"><Entry Text="{Binding NewDescription}" /></Border>
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="4" Margin="0,0,12,8" WidthRequest="110">
                        <Label Text="Price" Style="{StaticResource Caption}" />
                        <Border Style="{StaticResource Field}"><Entry Text="{Binding NewPrice}" Keyboard="Numeric" /></Border>
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="4" Margin="0,0,12,8" WidthRequest="110">
                        <Label Text="Days" Style="{StaticResource Caption}" />
                        <Border Style="{StaticResource Field}"><Entry Text="{Binding NewDays}" Keyboard="Numeric" /></Border>
                    </VerticalStackLayout>
                    <Button Text="{Binding SaveLabel}" Style="{StaticResource SmallButton}" Margin="0,0,8,8" Command="{Binding SavePackageCommand}" />
                    <Button Text="Cancel edit" Style="{StaticResource SmallOutlineButton}" Margin="0,0,0,8" IsVisible="{Binding IsEditing}" Command="{Binding CancelEditCommand}" />
                </FlexLayout>
            </Border>
            <Border Style="{StaticResource TablePanel}">
                <VerticalStackLayout>
                    <VerticalStackLayout x:Name="PackageHead">
                        <Grid Style="{StaticResource TableHead}" ColumnDefinitions="*,130,80,110,1.6*">
                            <Label Text="Package" Style="{StaticResource Caption}" />
                            <Label Grid.Column="1" Text="Price" Style="{StaticResource Caption}" HorizontalOptions="End" />
                            <Label Grid.Column="2" Text="Days" Style="{StaticResource Caption}" HorizontalOptions="End" />
                            <Label Grid.Column="3" Text="Status" Style="{StaticResource Caption}" />
                        </Grid>
                        <BoxView Style="{StaticResource Hairline}" />
                    </VerticalStackLayout>
                    <c:TableBody BindableLayout.ItemsSource="{Binding Packages}" Header="{x:Reference PackageHead}" WideFrom="900"
                                 RowTemplate="{StaticResource PackageRow}" CardTemplate="{StaticResource PackageCard}"
                                 BindableLayout.ItemTemplate="{OnIdiom Phone={StaticResource PackageCard}, Default={StaticResource PackageRow}}">
                        <BindableLayout.EmptyView><Label Text="No packages yet. Add one above." Style="{StaticResource Muted}" Margin="14" /></BindableLayout.EmptyView>
                    </c:TableBody>
                </VerticalStackLayout>
            </Border>

            <Label Text="Amenities" Style="{StaticResource SectionTitle}" />
            <Border Style="{StaticResource Panel}">
                <FlexLayout Wrap="Wrap" AlignItems="End">
                    <VerticalStackLayout Spacing="4" Margin="0,0,12,8" WidthRequest="260">
                        <Label Text="Name" Style="{StaticResource Caption}" />
                        <Border Style="{StaticResource Field}"><Entry Text="{Binding NewAmenityName}" /></Border>
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="4" Margin="0,0,12,8" WidthRequest="110">
                        <Label Text="{Binding AmenityPriceLabel}" Style="{StaticResource Caption}" />
                        <Border Style="{StaticResource Field}"><Entry Text="{Binding NewAmenityPrice}" Keyboard="Numeric" SemanticProperties.Description="{Binding AmenityPriceLabel}" /></Border>
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="4" Margin="0,0,12,8" WidthRequest="260">
                        <Label Text="Description" Style="{StaticResource Caption}" />
                        <Border Style="{StaticResource Field}"><Entry Text="{Binding NewAmenityDescription}" Placeholder="What members get" /></Border>
                    </VerticalStackLayout>
                    <Button Text="{Binding AmenitySaveLabel}" Style="{StaticResource SmallButton}" Margin="0,0,8,8" Command="{Binding AddAmenityCommand}" />
                    <Button Text="Cancel edit" Style="{StaticResource SmallOutlineButton}" Margin="0,0,0,8" IsVisible="{Binding IsEditingAmenity}" Command="{Binding CancelAmenityEditCommand}" />
                </FlexLayout>
            </Border>
            <Border Style="{StaticResource TablePanel}">
                <VerticalStackLayout>
                    <VerticalStackLayout x:Name="AmenityHead">
                        <Grid Style="{StaticResource TableHead}" ColumnDefinitions="*,170,90,110,2*">
                            <Label Text="Amenity" Style="{StaticResource Caption}" />
                            <Label Grid.Column="1" Text="Price" Style="{StaticResource Caption}" />
                            <Label Grid.Column="2" Text="Photo" Style="{StaticResource Caption}" />
                            <Label Grid.Column="3" Text="Status" Style="{StaticResource Caption}" />
                        </Grid>
                        <BoxView Style="{StaticResource Hairline}" />
                    </VerticalStackLayout>
                    <c:TableBody BindableLayout.ItemsSource="{Binding Amenities}" Header="{x:Reference AmenityHead}" WideFrom="1150"
                                 RowTemplate="{StaticResource AmenityRow}" CardTemplate="{StaticResource AmenityCard}"
                                 BindableLayout.ItemTemplate="{OnIdiom Phone={StaticResource AmenityCard}, Default={StaticResource AmenityRow}}">
                        <BindableLayout.EmptyView><Label Text="No amenities yet. Add one above." Style="{StaticResource Muted}" Margin="14" /></BindableLayout.EmptyView>
                    </c:TableBody>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</v:BasePage>
