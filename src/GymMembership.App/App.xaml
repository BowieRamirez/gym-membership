<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:c="clr-namespace:GymMembership.App.Controls"
             x:Class="GymMembership.App.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <toolkit:InvertedBoolConverter x:Key="Not" />
            <toolkit:IsNullConverter x:Key="IsNull" />
            <toolkit:IsNotNullConverter x:Key="IsNotNull" />
            <toolkit:IsStringNotNullOrEmptyConverter x:Key="HasText" />
            <c:LocalDateConverter x:Key="LocalDate" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
