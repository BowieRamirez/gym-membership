<?xml version="1.0" encoding="UTF-8" ?>
<Shell x:Class="GymMembership.App.StaffShell"
       xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:c="clr-namespace:GymMembership.App.Controls"
       xmlns:views="clr-namespace:GymMembership.App.Views"
       FlyoutBehavior="{OnPlatform WinUI=Locked, Default=Flyout}"
       Title="Gym Membership">

    <Shell.TitleView><c:HeaderBar /></Shell.TitleView>

    <Shell.FlyoutHeader>
        <VerticalStackLayout Padding="20,28,20,16" Spacing="14">
            <Label x:Name="RoleLabel" Text="Front desk" Style="{StaticResource Heading}" />
            <c:LaneView DashColor="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}"
                        TrackColor="{AppThemeBinding Light={StaticResource LineLight}, Dark={StaticResource LineDark}}" />
        </VerticalStackLayout>
    </Shell.FlyoutHeader>

    <FlyoutItem Title="Home" ClassId="desk" Route="home"><ShellContent ContentTemplate="{DataTemplate views:HomePage}" /></FlyoutItem>
    <FlyoutItem Title="Payments to verify" ClassId="desk" Route="verify"><ShellContent ContentTemplate="{DataTemplate views:VerifyPaymentsPage}" /></FlyoutItem>
    <FlyoutItem Title="Cashier" ClassId="desk" Route="cashier"><ShellContent ContentTemplate="{DataTemplate views:CashierPage}" /></FlyoutItem>
    <FlyoutItem Title="Check-in" ClassId="desk" Route="checkin"><ShellContent ContentTemplate="{DataTemplate views:CheckInPage}" /></FlyoutItem>
    <FlyoutItem Title="Amenity Status" ClassId="desk" Route="amenities"><ShellContent ContentTemplate="{DataTemplate views:AmenityStatusPage}" /></FlyoutItem>

    <!-- ClassId="admin": super admin and sub-admin; ClassId="super": super admin only (D15). The front desk gets neither. -->
    <FlyoutItem Title="Users and roles" ClassId="admin"><ShellContent ContentTemplate="{DataTemplate views:UsersPage}" /></FlyoutItem>
    <FlyoutItem Title="Packages and amenities" ClassId="admin"><ShellContent ContentTemplate="{DataTemplate views:CatalogAdminPage}" /></FlyoutItem>
    <FlyoutItem Title="Discounts &amp; Archive" ClassId="admin"><ShellContent ContentTemplate="{DataTemplate views:DiscountsPage}" /></FlyoutItem>
    <FlyoutItem Title="Cancellations &amp; refunds" ClassId="super"><ShellContent ContentTemplate="{DataTemplate views:RefundsPage}" /></FlyoutItem>
    <FlyoutItem Title="Void a payment" ClassId="super"><ShellContent ContentTemplate="{DataTemplate views:VoidPaymentsPage}" /></FlyoutItem>
    <FlyoutItem Title="Gym settings" ClassId="super"><ShellContent ContentTemplate="{DataTemplate views:GymSettingsPage}" /></FlyoutItem>
    <FlyoutItem Title="Revenue" ClassId="admin"><ShellContent ContentTemplate="{DataTemplate views:RevenuePage}" /></FlyoutItem>
    <FlyoutItem Title="Audit log" ClassId="super"><ShellContent ContentTemplate="{DataTemplate views:AuditPage}" /></FlyoutItem>

    <FlyoutItem Title="Messages" Route="messages"><ShellContent ContentTemplate="{DataTemplate views:MessagesPage}" /></FlyoutItem>
    <FlyoutItem Title="Settings" Route="settings"><ShellContent ContentTemplate="{DataTemplate views:SettingsPage}" /></FlyoutItem>
</Shell>
