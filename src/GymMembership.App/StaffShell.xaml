<?xml version="1.0" encoding="UTF-8" ?>
<Shell x:Class="GymMembership.App.StaffShell"
       xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:c="clr-namespace:GymMembership.App.Controls"
       xmlns:views="clr-namespace:GymMembership.App.Views"
       FlyoutBehavior="{OnPlatform WinUI=Locked, Default=Flyout}"
       Title="Slim and Shape">

    <Shell.TitleView><c:HeaderBar /></Shell.TitleView>

    <Shell.FlyoutHeader>
        <VerticalStackLayout Padding="20,28,20,16" Spacing="14">
            <Label x:Name="RoleLabel" Text="Front desk" Style="{StaticResource Heading}" />
            <c:LogoMark Size="36" HorizontalOptions="Start" />
        </VerticalStackLayout>
    </Shell.FlyoutHeader>

    <FlyoutItem Title="Home" ClassId="desk" Route="home"><ShellContent ContentTemplate="{DataTemplate views:HomePage}" /></FlyoutItem>
    <FlyoutItem Title="Cashier" ClassId="desk" Route="cashier"><ShellContent ContentTemplate="{DataTemplate views:CashierPage}" /></FlyoutItem>
    <FlyoutItem Title="Membership checking" ClassId="desk" Route="checkin"><ShellContent ContentTemplate="{DataTemplate views:CheckInPage}" /></FlyoutItem>
    <FlyoutItem Title="Amenity status" ClassId="desk" Route="amenities"><ShellContent ContentTemplate="{DataTemplate views:AmenityStatusPage}" /></FlyoutItem>

    <!-- ClassId="admin": super admin and sub-admin; ClassId="super": super admin only (D15). The front desk gets neither. -->
    <FlyoutItem Title="Users and roles" ClassId="admin" Route="users"><ShellContent ContentTemplate="{DataTemplate views:UsersPage}" /></FlyoutItem>
    <FlyoutItem Title="Packages and amenities" ClassId="admin"><ShellContent ContentTemplate="{DataTemplate views:CatalogAdminPage}" /></FlyoutItem>
    <FlyoutItem Title="Discounts" ClassId="admin"><ShellContent ContentTemplate="{DataTemplate views:DiscountsPage}" /></FlyoutItem>
    <FlyoutItem Title="Refunds" ClassId="super"><ShellContent ContentTemplate="{DataTemplate views:RefundsPage}" /></FlyoutItem>
    <FlyoutItem Title="Gym settings" ClassId="super"><ShellContent ContentTemplate="{DataTemplate views:GymSettingsPage}" /></FlyoutItem>
    <FlyoutItem Title="Revenue" ClassId="admin"><ShellContent ContentTemplate="{DataTemplate views:RevenuePage}" /></FlyoutItem>
    <FlyoutItem Title="Payroll" ClassId="admin" Route="payroll"><ShellContent ContentTemplate="{DataTemplate views:PayrollPage}" /></FlyoutItem>
    <FlyoutItem Title="Scheduling" ClassId="admin"><ShellContent ContentTemplate="{DataTemplate views:SchedulingPage}" /></FlyoutItem>
    <FlyoutItem Title="Attendance" ClassId="admin" Route="attendance"><ShellContent ContentTemplate="{DataTemplate views:AttendanceReviewPage}" /></FlyoutItem>
    <FlyoutItem Title="Damage reports" ClassId="admin"><ShellContent ContentTemplate="{DataTemplate views:DamageReportsPage}" /></FlyoutItem>
    <FlyoutItem Title="Announcements" ClassId="admin"><ShellContent ContentTemplate="{DataTemplate views:AnnouncementsPage}" /></FlyoutItem>
    <FlyoutItem Title="Logs &amp; Archive" ClassId="super"><ShellContent ContentTemplate="{DataTemplate views:AuditPage}" /></FlyoutItem>

    <FlyoutItem Title="Messages" Route="messages"><ShellContent ContentTemplate="{DataTemplate views:MessagesPage}" /></FlyoutItem>
    <FlyoutItem Title="Settings" Route="settings"><ShellContent ContentTemplate="{DataTemplate views:SettingsPage}" /></FlyoutItem>
</Shell>
