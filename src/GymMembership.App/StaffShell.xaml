<?xml version="1.0" encoding="UTF-8" ?>
<Shell x:Class="GymMembership.App.StaffShell"
       xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:c="clr-namespace:GymMembership.App.Controls"
       xmlns:views="clr-namespace:GymMembership.App.Views"
       FlyoutBehavior="{OnPlatform WinUI=Locked, Default=Flyout}"
       Title="Gym Membership">

    <Shell.FlyoutHeader>
        <VerticalStackLayout Padding="20,28,20,16" Spacing="14">
            <Label x:Name="RoleLabel" Text="Front desk" Style="{StaticResource Heading}" />
            <c:LaneView DashColor="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}"
                        TrackColor="{AppThemeBinding Light={StaticResource LineLight}, Dark={StaticResource LineDark}}" />
        </VerticalStackLayout>
    </Shell.FlyoutHeader>

    <FlyoutItem Title="Payments to verify"><ShellContent ContentTemplate="{DataTemplate views:VerifyPaymentsPage}" /></FlyoutItem>
    <FlyoutItem Title="Check-in"><ShellContent ContentTemplate="{DataTemplate views:CheckInPage}" /></FlyoutItem>
    <FlyoutItem Title="Amenity visits"><ShellContent ContentTemplate="{DataTemplate views:VerifyAmenityUsagesPage}" /></FlyoutItem>

    <!-- Admin only: ClassId="admin" items are removed for the front-desk role -->
    <FlyoutItem Title="Users and roles" ClassId="admin"><ShellContent ContentTemplate="{DataTemplate views:UsersPage}" /></FlyoutItem>
    <FlyoutItem Title="Packages and amenities" ClassId="admin"><ShellContent ContentTemplate="{DataTemplate views:CatalogAdminPage}" /></FlyoutItem>
    <FlyoutItem Title="Discounts" ClassId="admin"><ShellContent ContentTemplate="{DataTemplate views:DiscountsPage}" /></FlyoutItem>
    <FlyoutItem Title="Revenue" ClassId="admin"><ShellContent ContentTemplate="{DataTemplate views:RevenuePage}" /></FlyoutItem>
    <FlyoutItem Title="Audit log" ClassId="admin"><ShellContent ContentTemplate="{DataTemplate views:AuditPage}" /></FlyoutItem>

    <FlyoutItem Title="Alerts"><ShellContent ContentTemplate="{DataTemplate views:NotificationsPage}" /></FlyoutItem>
    <FlyoutItem Title="Settings"><ShellContent ContentTemplate="{DataTemplate views:SettingsPage}" /></FlyoutItem>
</Shell>
